# Every text file is LF in every checkout, Windows included (#978): tests
# parse catalogs on "\n\n" and compare fixtures byte for byte, and the Windows
# runner checked them out as CRLF. Binaries stay untouched (text=auto, and the
# LFS rules below mark theirs -text).
* text=auto eol=lf
*.so filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.nam filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
deps/NeuralAmpModelerCore.tar.gz filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
# #1093: VST3 bundle binaries carry no .so/.dylib/.dll extension on macOS
# (Contents/MacOS/<Name>) and a .vst3 one on Windows (Contents/*-win/).
plugins/source/vst3/**/Contents/MacOS/** filter=lfs diff=lfs merge=lfs -text
plugins/source/vst3/**/Contents/*-win/** filter=lfs diff=lfs merge=lfs -text
