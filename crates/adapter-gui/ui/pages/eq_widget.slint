// Responsibility: renders the graphic EQ.
import { Theme, Gear } from "../theme.slint";
import { MultiSliderPoint, CurveEditorPoint } from "../models.slint";

import "../fonts/BebasNeue.ttf";
import { Locale } from "../locale_globals.slint";

// Vertical band slider built from primitives — track + fader cap + value
// readout. No sprite, so it scales to any height the parent gives it.
//
// #398: a thin groove, a short zero tick, the boost or cut drawn in the
// filter colour from zero to the cap, and a white fader cap with a dark
// centre line. The readout sits above in dB, the frequency below.
component EqBandSlider inherits Rectangle {
    in property <string> path;
    in property <string> freq-label;
    in property <float> value;
    in property <float> min-val;
    in property <float> max-val;
    in property <float> step;
    in property <bool> tight;       // narrow slot — drop labels

    callback changed(string, float);

    private property <float> drag-y0: 0;
    private property <float> drag-val0: 0;
    private property <bool> preview-active: false;
    private property <float> preview-val: 0;
    private property <float> shown-val:
        root.preview-active ? root.preview-val : root.value;
    private property <float> norm: root.max-val > root.min-val
        ? Math.max(0.0, Math.min(1.0,
            (root.shown-val - root.min-val) / (root.max-val - root.min-val)))
        : 0.5;
    private property <bool> crosses-zero: root.min-val < 0 && root.max-val > 0;

    // Layout slots
    // #954: 22px slots — the 18px readout / frequency label need them.
    private property <length> top-h: root.tight ? 0px : 22px;
    private property <length> bottom-h: root.tight ? 0px : 22px;
    private property <length> gap: root.tight ? 0px : 8px;
    private property <length> cap-w: Math.min(Math.max(root.width - 4px, 14px), 26px);
    private property <length> cap-h: 14px;
    // The cap's centre travels the whole track; half a cap of room at each end.
    private property <length> track-y: root.top-h + root.gap;
    private property <length> track-h: root.height - root.top-h - root.bottom-h - 2 * root.gap;
    private property <length> travel-y: root.track-y + root.cap-h / 2;
    private property <length> travel-h: root.track-h - root.cap-h;
    private property <length> handle-y: root.travel-y + (1.0 - root.norm) * root.travel-h;
    private property <length> zero-y: root.travel-y + root.travel-h / 2;

    background: transparent;

    // ── dB readout (top) ──
    if !root.tight : Text {
        x: 0; y: 0;
        width: parent.width;
        height: root.top-h;
        text: (root.shown-val > 0.05 ? "+" : "")
            + (Math.abs(root.shown-val) < 0.05 ? "0.0" : root.shown-val.to-fixed(1))
            + (root.width >= 64px ? " dB" : "");
        color: Theme.ink-2;
        font-family: Locale.mono-font-family;
        font-size: Theme.min-font;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    // ── Track: a thin groove ──
    Rectangle {
        x: (parent.width - 3px) / 2;
        y: root.track-y;
        width: 3px;
        height: root.track-h;
        border-radius: 2px;
        background: Theme.groove;
    }

    // ── 0 dB tick (only when range crosses zero) ──
    if root.crosses-zero : Rectangle {
        x: (parent.width - 14px) / 2;
        y: root.zero-y - 0.5px;
        width: 14px;
        height: 1px;
        background: Theme.ink-3;
    }

    // ── Boost or cut: zero to the cap ──
    Rectangle {
        property <length> from-y: root.crosses-zero ? root.zero-y : root.travel-y + root.travel-h;
        x: (parent.width - 2px) / 2;
        y: Math.min(root.handle-y, self.from-y);
        width: 2px;
        height: Math.max(1px, Math.abs(root.handle-y - self.from-y));
        background: Theme.c-filter;
    }

    // ── Cap: white key plastic with a dark centre line ──
    Rectangle {
        x: (parent.width - root.cap-w) / 2;
        y: root.handle-y - root.cap-h / 2;
        width: root.cap-w;
        height: root.cap-h;
        border-radius: 3px;
        background: ta.pressed
            ? @linear-gradient(180deg, Gear.key-mid 0%, Gear.key-lo 100%)
            : @linear-gradient(180deg, Gear.white 0%, Gear.key-lo 100%);
        border-width: 1px;
        border-color: Gear.edge-soft;
        drop-shadow-blur: ta.pressed ? 1px : 3px;
        drop-shadow-offset-y: ta.pressed ? 1px : 2px;
        drop-shadow-color: Gear.shadow;

        Rectangle {
            x: 4px;
            y: (parent.height - 2px) / 2;
            width: parent.width - 8px;
            height: 2px;
            background: Gear.key-ink;
        }
    }

    // ── Frequency label (bottom) ──
    if !root.tight : Text {
        x: 0;
        y: parent.height - root.bottom-h;
        width: parent.width;
        height: root.bottom-h;
        text: root.freq-label;
        color: Theme.ink-2;
        font-family: Locale.display-font-family;
        font-size: 18px;
        letter-spacing: 0.06 * 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    // ── Drag interaction ──
    ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        mouse-cursor: ta.pressed ? none : ns-resize;

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.drag-y0 = ta.mouse-y / 1px;
                root.drag-val0 = root.value;
                root.preview-active = true;
                root.preview-val = root.value;
            }
            if (ev.kind == PointerEventKind.up) {
                if (root.preview-active) {
                    root.changed(root.path, root.preview-val);
                    root.preview-active = false;
                }
            }
        }

        moved => {
            if (ta.pressed) {
                let delta-px = root.drag-y0 - ta.mouse-y / 1px;
                let range = root.max-val - root.min-val;
                let raw = root.drag-val0 + delta-px * range / 120.0;
                let clamped = raw < root.min-val
                    ? root.min-val
                    : (raw > root.max-val ? root.max-val : raw);
                let stepped = root.step > 0.0
                    ? Math.round(clamped / root.step) * root.step
                    : clamped;
                root.preview-val = stepped;
            }
        }

        // Double-click resets to 0 dB (range crosses zero) or to mid-range
        double-clicked => {
            let target = root.min-val < 0 && root.max-val > 0
                ? 0
                : (root.max-val + root.min-val) / 2;
            root.changed(root.path, target);
        }
    }
}

// Graphic-EQ widget — bands carry only a gain value.
export component MultiSliderControl inherits Rectangle {
    in property <[MultiSliderPoint]> points;
    callback update-parameter(string, float);

    background: Theme.well;
    border-radius: 4px;

    private property <length> pad-x: root.width >= 400px ? 18px : 8px;
    private property <length> pad-y: root.height >= 200px ? 16px : 8px;
    private property <length> available-w: root.width - 2 * root.pad-x;
    private property <length> slot-w: root.points.length > 0
        ? Math.max(18px, root.available-w / root.points.length)
        : 64px;
    private property <bool> tight-slot: root.slot-w < 32px;

    for point[i] in root.points : EqBandSlider {
        x: root.pad-x + i * root.slot-w;
        y: root.pad-y;
        width: root.slot-w;
        height: parent.height - 2 * root.pad-y;
        path: point.path;
        freq-label: point.label;
        value: point.value;
        min-val: point.min-val;
        max-val: point.max-val;
        step: point.step;
        tight: root.tight-slot;
        changed(p, v) => { root.update-parameter(p, v); }
    }
}

// Parametric-EQ widget — bands have a gain plus a formatted frequency.
export component CurveEditorControl inherits Rectangle {
    in property <[CurveEditorPoint]> points;
    in property <string> total-curve;     // unused — kept for prop compatibility
    in property <[string]> band-curves;   // unused — kept for prop compatibility
    callback update-parameter(string, float);

    background: Theme.well;
    border-radius: 4px;

    private property <length> pad-x: root.width >= 400px ? 18px : 8px;
    private property <length> pad-y: root.height >= 200px ? 16px : 8px;
    private property <length> available-w: root.width - 2 * root.pad-x;
    private property <length> slot-w: root.points.length > 0
        ? Math.max(18px, root.available-w / root.points.length)
        : 64px;
    private property <bool> tight-slot: root.slot-w < 32px;

    for point[i] in root.points : EqBandSlider {
        x: root.pad-x + i * root.slot-w;
        y: root.pad-y;
        width: root.slot-w;
        height: parent.height - 2 * root.pad-y;
        path: point.y-path;
        freq-label: point.x-label;
        value: point.y-value;
        min-val: point.y-min;
        max-val: point.y-max;
        step: point.y-step > 0 ? point.y-step : 0.1;
        tight: root.tight-slot;
        changed(p, v) => { root.update-parameter(p, v); }
    }
}
