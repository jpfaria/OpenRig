// Responsibility: renders the metronome window.
// MetronomeWindow / MetronomePanel — top-bar utility, issue #14.
//
// #398: the dark tool bar with a POWER pill, then on the well an LCD with the
// tempo and the bar's lamps (the two things read mid-song, at a size that
// survives a glance from a metre away), a row of knob cells (tempo with its
// nudges, the white TAP key, count-in, time signature, subdivision, timbre,
// volume), and the output endpoint field.
//
// The panel reads its state from the `MetronomeBridge` global rather than from
// bound properties, so the same component serves the standalone window and the
// inline (fullscreen/touch) placement without either one threading ~16 values
// through the widget tree.
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { SelectorKnob } from "../components/selector_knob.slint";
import { PanelKnob } from "../components/panel_knob.slint";
import { BeatLamp, ControlCell, PillButton, TapKey, ToggleKnob } from "../components/metronome_controls.slint";
import { MetronomeBridge } from "../components/metronome_globals.slint";
import { OutputField, OutputRow } from "../components/output_picker.slint";
import { LcdGlass } from "../components/lcd_glass.slint";
import { ToolBar } from "../components/tool_bar.slint";
import { ToolBarClose } from "../components/tool_bar_close.slint";
import { PillSwitch } from "../components/pill_switch.slint";
import { FieldCaption } from "../components/field_caption.slint";
import { Locale } from "../locale_globals.slint";
import { WindowBoundsProbe } from "../components/window_bounds.slint";
import { HoverTipLayer } from "../components/hover_tip_layer.slint";

// ── MetronomePanel — reusable content (Window and inline modes) ───────────
export component MetronomePanel inherits Rectangle {
    // The one per-placement flag: the inline overlay needs a close button, the
    // standalone window closes via its own chrome.
    in property <bool> show-close-button: false;

    background: Theme.well;

    VerticalLayout {
        ToolBar {
            icon: @image-url("../assets/metronome.svg");
            title: @tr("label-metronome");

            PillSwitch {
                text: @tr("label-power");
                on: MetronomeBridge.metronome-enabled;
                toggled => { MetronomeBridge.toggle-enabled(!MetronomeBridge.metronome-enabled); }
            }

            if root.show-close-button : ToolBarClose {
                clicked => { MetronomeBridge.close-metronome(); }
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 14px;

            // ── LCD — the tempo and the bar, the two things read mid-song ──
            LcdGlass {
                vertical-stretch: 0;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 18px;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: Math.round(MetronomeBridge.bpm);
                            color: MetronomeBridge.metronome-enabled ? Theme.lcd-glow : Theme.lcd-off;
                            font-family: Locale.display-font-family;
                            font-size: 76px;
                            height: 70px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: @tr("label-bpm");
                            color: Theme.lcd-dim;
                            font-family: Locale.display-font-family;
                            font-size: Theme.min-font;
                            letter-spacing: 0.14 * Theme.min-font;
                        }
                    }

                    // Slots past the current time signature collapse to zero
                    // width, so the lamps stay packed whatever the bar length.
                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;
                        for slot[idx] in 16 : VerticalLayout {
                            alignment: center;
                            width: idx < MetronomeBridge.beats-per-bar ? 26px : 0px;
                            if idx < MetronomeBridge.beats-per-bar : BeatLamp {
                                lit: MetronomeBridge.metronome-enabled && idx == MetronomeBridge.current-beat;
                                downbeat: idx == 0;
                                counting-in: MetronomeBridge.counting-in;
                            }
                        }
                    }
                }
            }

            // ── Knob row: tempo, tap, then the settings ──────────────────
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    alignment: end;
                    spacing: 6px;
                    ControlCell {
                        caption: @tr("label-bpm");
                        PanelKnob {
                            x: (parent.width - self.width) / 2; y: parent.knob-y;
                            width: parent.knob-size; height: parent.knob-size + 23px;
                            value: MetronomeBridge.bpm;
                            min-val: 40;
                            max-val: 240;
                            step: 1;
                            path: "metronome.bpm";
                            changed(p, v) => { MetronomeBridge.set-bpm(v); }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        PillButton {
                            label: "−";
                            clicked => { MetronomeBridge.set-bpm(MetronomeBridge.bpm - 1); }
                        }
                        PillButton {
                            label: "+";
                            clicked => { MetronomeBridge.set-bpm(MetronomeBridge.bpm + 1); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    spacing: 6px;
                    Text {
                        text: @tr("action-tap-tempo");
                        color: Theme.ink-2;
                        font-size: Theme.knob-caption-font;
                        font-weight: 600;
                        letter-spacing: 0.1 * Theme.knob-caption-font;
                        horizontal-alignment: center;
                    }
                    TapKey {
                        label: @tr("action-tap-tempo");
                        clicked => { MetronomeBridge.tap(); }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    ControlCell {
                        caption: @tr("label-count-in");
                        value: MetronomeBridge.count-in ? @tr("label-count-in-on") : @tr("label-count-in-off");
                        ToggleKnob {
                            x: (parent.width - self.width) / 2; y: parent.knob-y;
                            width: parent.knob-size; height: parent.knob-size;
                            label: @tr("label-count-in");
                            active: MetronomeBridge.count-in;
                            toggled => { MetronomeBridge.set-count-in(!MetronomeBridge.count-in); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    ControlCell {
                        caption: @tr("label-time-signature");
                        value: MetronomeBridge.time-signature-label;
                        SelectorKnob {
                            x: (parent.width - self.width) / 2; y: parent.knob-y;
                            width: parent.knob-size; height: parent.knob-size;
                            num-options: 7;
                            selected-index: MetronomeBridge.time-signature-index;
                            select(i) => { MetronomeBridge.set-time-signature(i); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    ControlCell {
                        caption: @tr("label-subdivision");
                        value: MetronomeBridge.subdivision-label;
                        SelectorKnob {
                            x: (parent.width - self.width) / 2; y: parent.knob-y;
                            width: parent.knob-size; height: parent.knob-size;
                            num-options: 4;
                            selected-index: MetronomeBridge.subdivision-index;
                            select(i) => { MetronomeBridge.set-subdivision(i); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    ControlCell {
                        caption: @tr("label-timbre");
                        value: MetronomeBridge.timbre-label;
                        SelectorKnob {
                            x: (parent.width - self.width) / 2; y: parent.knob-y;
                            width: parent.knob-size; height: parent.knob-size;
                            num-options: 3;
                            selected-index: MetronomeBridge.timbre-index;
                            select(i) => { MetronomeBridge.set-timbre(i); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    ControlCell {
                        caption: @tr("label-click-volume");
                        value: Math.round(MetronomeBridge.volume * 100) + "%";
                        PanelKnob {
                            x: (parent.width - self.width) / 2; y: parent.knob-y;
                            width: parent.knob-size; height: parent.knob-size;
                            value: MetronomeBridge.volume;
                            min-val: 0.0;
                            max-val: 1.0;
                            step: 0.01;
                            path: "metronome.volume";
                            changed(p, v) => { MetronomeBridge.set-volume(v); }
                        }
                    }
                }
            }

            // ── Output endpoint ──────────────────────────────────────────
            VerticalLayout {
                spacing: 6px;
                FieldCaption {
                    text: @tr("label-output").to-uppercase();
                }
                OutputField {
                    label: MetronomeBridge.output-label;
                    placeholder: @tr("placeholder-metronome-output");
                    open => {
                        MetronomeBridge.output-opened();
                        MetronomeBridge.output-picker-open = true;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }

    // ── Output picker overlay — clickable rows, click-outside to dismiss ──
    if MetronomeBridge.output-picker-open : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.scrim;

        TouchArea {
            clicked => { MetronomeBridge.output-picker-open = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 80px;
            width: parent.width - 96px;
            height: min(parent.height - 130px,
                MetronomeBridge.output-options.length * 44px + 56px);
            border-radius: 8px;
            background: Theme.panel-lo;
            border-width: 1px;
            border-color: Theme.hair;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow;

            Text {
                x: 16px; y: 14px;
                width: parent.width - 32px; height: 22px;
                text: @tr("label-metronome-output");
                color: Theme.ink-2;
                font-size: 18px;
                letter-spacing: 2.0px;
            }

            if MetronomeBridge.output-options.length == 0 : Text {
                x: 0; y: 0; width: parent.width; height: parent.height;
                text: @tr("status-no-outputs");
                color: Theme.ink-3;
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            ScrollView {
                x: 8px; y: 44px;
                width: parent.width - 16px;
                height: parent.height - 52px;
                VerticalLayout {
                    spacing: 4px;
                    for opt in MetronomeBridge.output-options : OutputRow {
                        label: opt.label;
                        active: opt.key == MetronomeBridge.output-key;
                        pick => {
                            MetronomeBridge.pick-output(opt.key);
                            MetronomeBridge.output-picker-open = false;
                        }
                    }
                }
            }
        }
    }
}

export component MetronomeWindow inherits Window {
    icon: @image-url("../assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 18px;
    title: @tr("title-window-metronome");
    min-width: 560px;
    min-height: 410px;
    preferred-width: 600px;
    preferred-height: 410px;
    background: Theme.well;

    MetronomePanel {
        width: 100%;
        height: 100%;
        show-close-button: false;
    }

    WindowBoundsProbe { }
    HoverTipLayer { }
}
