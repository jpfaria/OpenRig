// Responsibility: renders the spectrum window.
// SpectrumWindow — top-bar feature replacing the spectrum_analyzer block.
// One row per terminal output entry of every enabled chain.
//
// #398: a dark tool bar with the POWER pill, then one teal scope per output
// on the well: 63 bars (1/6-octave) lit from teal to yellow, labelled at the
// decade markers, with a faint peak hold over each bar.
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { AnalyzerBridge } from "../analyzer_globals.slint";
import { SpectrumRow } from "../analyzer_rows.slint";
import { LcdGlass } from "../components/lcd_glass.slint";
import { ToolBar } from "../components/tool_bar.slint";
import { ToolBarClose } from "../components/tool_bar_close.slint";
import { PillSwitch } from "../components/pill_switch.slint";
import { Locale } from "../locale_globals.slint";
import { WindowBoundsProbe } from "../components/window_bounds.slint";
import { HoverTipLayer } from "../components/hover_tip_layer.slint";
import { ElidedText } from "../components/elided_text.slint";
import { BarButton } from "../components/bar_button.slint";
import { SpectrumFilterOverlay } from "../components/spectrum_filter_overlay.slint";
import { ChannelOptionItem } from "../models.slint";
export { SpectrumRow }

// One decade label under the bars, centred on its band and kept inside.
component AxisLabel inherits Text {
    in property <length> at;
    in property <length> span;

    x: Math.clamp(root.at - self.width / 2, 0px, root.span - self.width);
    y: 0;
    width: self.preferred-width;
    color: Theme.scope-axis;
    font-family: Locale.mono-font-family;
    font-size: Theme.min-font;
    vertical-alignment: center;
}

// ── One output's scope ───────────────────────────────────────────────────
component SpectrumCard inherits Rectangle {
    in property <SpectrumRow> data;

    property <length> bars-h: 120px;

    height: 188px;

    LcdGlass {
        width: 100%;
        height: 100%;
        glass: Theme.scope;

        bands := Text {
            x: parent.width - 14px - self.width; y: 10px;
            width: self.preferred-width; height: 22px;
            text: @tr("label-spectrum-bands", root.data.levels.length > 0 ? root.data.levels.length : 63);
            font-family: Locale.mono-font-family;
            color: Theme.scope-mid;
            font-size: Theme.min-font;
            letter-spacing: 0.08 * Theme.min-font;
            vertical-alignment: center;
        }

        ElidedText {
            x: 14px; y: 10px;
            width: parent.width - 38px - bands.width; height: 22px;
            text: root.data.label;
            font-family: Locale.mono-font-family;
            color: Theme.scope-mid;
            font-size: Theme.min-font;
            letter-spacing: 0.08 * Theme.min-font;
            vertical-alignment: center;
        }

        if !root.data.active : Text {
            x: 0; y: 40px;
            width: parent.width; height: root.bars-h;
            text: @tr("—");
            color: Theme.scope-axis;
            font-family: Locale.display-font-family;
            font-size: 26px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // Bars — one per band, each lit from teal at its foot to yellow at
        // its top, standing on the baseline.
        if root.data.active : Rectangle {
            x: 14px; y: 40px;
            width: parent.width - 28px;
            height: root.bars-h;

            property <length> stride: self.width / 63;

            for level[i] in root.data.levels : Rectangle {
                x: i * parent.stride;
                y: parent.height - self.height;
                width: parent.stride - 1px;
                height: max(2px, parent.height * level);
                border-top-left-radius: 1px;
                border-top-right-radius: 1px;
                background: @linear-gradient(0deg, Theme.scope-lo 0%, Theme.scope-mid 70%, Theme.scope-hi 100%);
            }

            // Peak hold — a faint line where each band last peaked.
            for peak[i] in root.data.peaks : Rectangle {
                x: i * parent.stride;
                y: parent.height * (1.0 - peak) - 1px;
                width: parent.stride - 1px;
                height: 1px;
                background: Theme.scope-hi;
                opacity: 0.5;
            }
        }

        // Decade labels on bands 0, 14, 34, 54 and 60 — the ones
        // `feature_dsp::spectrum_fft::BAND_LABELS` names.
        Rectangle {
            x: 14px; y: 40px + root.bars-h;
            width: parent.width - 28px; height: 22px;

            property <length> stride: self.width / 63;

            AxisLabel { at: 0.5 * parent.stride; span: parent.width; height: parent.height; text: @tr("20"); }
            AxisLabel { at: 14.5 * parent.stride; span: parent.width; height: parent.height; text: @tr("100"); }
            AxisLabel { at: 34.5 * parent.stride; span: parent.width; height: parent.height; text: @tr("1k"); }
            AxisLabel { at: 54.5 * parent.stride; span: parent.width; height: parent.height; text: @tr("10k"); }
            AxisLabel { at: 62.5 * parent.stride; span: parent.width; height: parent.height; text: @tr("20k"); }
        }
    }
}

// ── SpectrumPanel — reusable content (used in both Window and inline modes) ──
export component SpectrumPanel inherits Rectangle {
    in property <[SpectrumRow]> spectrum-rows;
    in property <bool> spectrum-enabled: false;
    in property <bool> show-close-button: false;
    // The output filter: one checkbox per output, and how many are checked.
    in property <[ChannelOptionItem]> filter-items;
    in property <int> filter-shown;
    callback close-spectrum();
    callback toggle-enabled(bool);
    callback filter-toggled(int /* output */, bool /* shown */);

    property <length> bar-h: 46px;

    background: Theme.well;

    ToolBar {
        x: 0; y: 0;
        width: parent.width;
        icon: @image-url("../assets/spectrum.svg");
        title: @tr("label-spectrum");

        if root.filter-items.length > 0 : filter-button := BarButton {
            label: @tr("label-spectrum-outputs-shown-button {} {}", root.filter-shown, root.filter-items.length);
            clicked => { filter.open = !filter.open; }
        }

        PillSwitch {
            text: @tr("label-power");
            on: root.spectrum-enabled;
            toggled => { root.toggle-enabled(!root.spectrum-enabled); }
        }

        if root.show-close-button : ToolBarClose {
            clicked => { root.close-spectrum(); }
        }
    }

    // ── Empty state: the scope says why it is blank ──────────────────────
    if root.spectrum-rows.length == 0 && root.filter-shown == 0 && root.filter-items.length > 0 : LcdGlass {
        x: 14px; y: root.bar-h + 14px;
        width: parent.width - 28px;
        height: 84px;
        glass: Theme.scope;

        Text {
            text: @tr("status-spectrum-outputs-hidden");
            color: Theme.scope-mid;
            font-size: 26px;
            letter-spacing: 0.08 * 26px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.spectrum-rows.length == 0 && root.filter-items.length == 0 : LcdGlass {
        x: 14px; y: root.bar-h + 14px;
        width: parent.width - 28px;
        height: empty-col.preferred-height;
        glass: Theme.scope;

        empty-col := VerticalLayout {
            padding-top: 28px;
            padding-bottom: 28px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;

            Text {
                text: @tr("status-no-active-outputs");
                color: Theme.scope-mid;
                font-size: 26px;
                letter-spacing: 0.08 * 26px;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("status-spectrum-empty-help");
                color: Theme.scope-axis;
                font-size: Theme.min-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // ── One scope per output ─────────────────────────────────────────────
    if root.spectrum-rows.length > 0 : ScrollView {
        x: 0; y: root.bar-h;
        width: parent.width;
        height: parent.height - root.bar-h;
        content-height: 14px + root.spectrum-rows.length * 200px;

        for row[index] in root.spectrum-rows : SpectrumCard {
            x: 14px;
            y: 14px + index * 200px;
            width: parent.width - 28px;
            data: row;
        }
    }

    filter := SpectrumFilterOverlay {
        width: parent.width;
        height: parent.height;
        top: root.bar-h + 6px;
        items: root.filter-items;
        shown: root.filter-shown;
        toggled(output, on) => { root.filter-toggled(output, on); }
    }
}

export component SpectrumWindow inherits Window {
    icon: @image-url("../assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 18px;
    title: @tr("title-window-spectrum");
    min-width: 560px;
    min-height: 280px;
    preferred-width: 720px;
    preferred-height: 480px;
    background: Theme.well;

    // Rows and power come from the bridge — the channel `spectrum_wiring`
    // publishes on (#873), same pattern as MetronomeWindow.
    out property <bool> spectrum-enabled: AnalyzerBridge.spectrum-enabled;
    callback close-spectrum-window();
    callback toggle-enabled(bool);

    SpectrumPanel {
        width: 100%;
        height: 100%;
        spectrum-rows: AnalyzerBridge.spectrum-rows;
        spectrum-enabled: AnalyzerBridge.spectrum-enabled;
        filter-items: AnalyzerBridge.spectrum-filter;
        filter-shown: AnalyzerBridge.spectrum-filter-shown;
        show-close-button: false;
        close-spectrum => { root.close-spectrum-window(); }
        toggle-enabled(e) => { root.toggle-enabled(e); }
        filter-toggled(output, on) => { AnalyzerBridge.toggle-spectrum-filter(output, on); }
    }

    WindowBoundsProbe { }
    HoverTipLayer { }
}
