// Responsibility: renders the editor of an insert block.
// #881 — the editor of an INSERT block (an external send/return loop placed
// between effects).
//
// Since #716 (model A) an insert carries exactly ONE thing: the E/S binding its
// loop runs through — the SEND goes out that binding's output, the RETURN comes
// back on its input. Device / mode / channels belong to the E/S itself and are
// edited in the I/O bindings screen.
//
// #398: a dialog — the dark bar with the block's power lamp, the title and the
// trash, the E/S field with its help on the panel, then Cancel / OK.

import { Theme } from "../theme.slint";
import { BlockDialogBar } from "../components/block_dialog_bar.slint";
import { DialogFoot } from "../components/dialog_foot.slint";
import { DropSelect } from "../components/drop_select.slint";
import { FieldCaption } from "../components/field_caption.slint";
import { FormButton, FormButtonKind } from "../components/form_button.slint";

export component ChainInsertEditorPage inherits Rectangle {
    in property <[string]> binding-options;
    in-out property <int> selected-binding-index;
    in property <bool> block-enabled: true;
    in property <bool> show-binding-warning;

    callback select-binding(int);
    callback toggle-enabled();
    callback delete-block();
    callback save();
    callback cancel();

    background: Theme.panel;

    VerticalLayout {
        BlockDialogBar {
            vertical-stretch: 0;
            title: @tr("title-section-configure-insert");
            block-enabled: root.block-enabled;
            toggle-enabled => { root.toggle-enabled(); }
            delete-block => { root.delete-block(); }
        }

        VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding: 18px;
            spacing: 14px;

            VerticalLayout {
                spacing: 6px;
                FieldCaption { text: @tr("label-io-binding"); }
                DropSelect {
                    model: root.binding-options;
                    current <=> root.selected-binding-index;
                    picked(index) => { root.select-binding(index); }
                }
            }

            Text {
                text: @tr("msg-insert-loop-uses-binding");
                color: Theme.ink-3;
                font-size: Theme.min-font;
                wrap: word-wrap;
            }

            if root.show-binding-warning : Text {
                text: @tr("msg-pick-io-binding");
                color: Theme.accent;
                font-size: Theme.min-font;
                wrap: word-wrap;
            }
        }

        DialogFoot {
            vertical-stretch: 0;
            FormButton {
                label: @tr("btn-cancel");
                clicked => { root.cancel(); }
            }
            FormButton {
                kind: FormButtonKind.primary;
                label: @tr("btn-ok");
                clicked => { root.save(); }
            }
        }
    }
}
