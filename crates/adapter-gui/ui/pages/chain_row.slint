// Responsibility: composes one chain card from the pieces that draw it.
//
// The row owns the card geometry — how many block rows fit at this width, how
// tall the card has to be for the per-stream meters — and hands each piece to
// the file that draws it: `chain_row_header`, `chain_row_blocks`,
// `chain_row_meters`.

import { ProjectChainItem, ChainBlockItem, BlockParamSummaryEntry, ChainRigNav } from "../models.slint";
import { ChainRowHeader } from "chain_row_header.slint";
import { ChainRowMeters } from "chain_row_meters.slint";
import { ChainRowBlocks } from "chain_row_blocks.slint";
import { PowerSwitch } from "../components/power_switch.slint";
import { ChainActionIcon, ChainEndpointChip, ChainPowerToggle, HeaderIconAction } from "../components/chain_chips.slint";
import { ChainVolumeButton } from "../components/chain_volume_button.slint";
import { ChainDiLoopButton } from "../components/chain_di_loop_button.slint"; import { ChainLooperButton } from "../components/chain_looper_button.slint"; import { ChainToneDoctorButton } from "../components/chain_tone_doctor_button.slint";
import { BlockChip } from "../components/block_chip.slint";
import { BlockInsertSlot } from "../components/block_insert_slot.slint";
import { BlockHoverTooltip } from "../components/block_hover_tooltip.slint";

export component ChainRow inherits Rectangle {
    in property <ProjectChainItem> chain;
    in property <ChainRigNav> rig-nav;
    callback switch-chain-preset(int);
    callback switch-chain-scene(int);
    callback rename-chain-preset(string);
    in property <int> chain-index;
    in property <int> chain-count;
    in property <int> selected-block-chain-index;
    in property <int> selected-block-index;
    // #591: UI index of the block the footswitch block-toggle acts on.
    in property <int> selected-block-neighbor-index: -1;
    // #591: gates the selection markers — they only show while a MIDI
    // command is recent (last 10s).
    in property <bool> midi-selection-active: false;
    in property <bool> fullscreen: false;
    callback toggle-chain-enabled(int);
    callback chain-volume-changed(int, int);
    // #614: DI loop callbacks (chain-index, …)
    callback di-loop-source-selected(int, string);
    callback di-loop-choose-file(int);
    callback di-loop-play(int);
    callback di-loop-stop(int);
    callback remove-chain(int);
    callback move-chain-up(int);
    callback move-chain-down(int);
    callback configure-chain(int);
    callback configure-chain-input(int);
    callback configure-chain-output(int);
    callback configure-chain-preset(int);
    callback save-chain-preset(int);
    callback probe-chain-latency(int);
    callback select-chain-block(int, int);
    // #591: select the whole chain as the footswitch's active chain
    // (no specific block). Fired by tapping empty header space.
    callback select-chain(int);
    callback toggle-chain-block-enabled(int, int);
    callback start-block-insert(int, int);
    callback reorder-chain-block(int, int, int);
    callback open-compact-chain-view(int);
    // Drag state is SHARED across rows (a chip can be dragged from one chain
    // into another), so the page owns it and each row passes it into its strip.
    in-out property <int> dragging-chain-index: -1;
    in-out property <int> dragging-block-index: -1;
    in-out property <int> drag-hover-before-index: -1;
    property <int> blocks-per-row: Math.max(1, Math.floor((root.width - 188px) / 132px));
    property <int> block-row-count: root.chain.blocks.length == 0 ? 1 : Math.floor((root.chain.blocks.length - 1) / root.blocks-per-row) + 1;
    property <int> last-block-col: root.chain.blocks.length == 0 ? 0 : Math.mod(root.chain.blocks.length - 1, root.blocks-per-row);
    property <int> last-block-row: root.chain.blocks.length == 0 ? 0 : Math.floor((root.chain.blocks.length - 1) / root.blocks-per-row);
    // Out sempre fixo na borda direita da linha do último bloco
    property <length> out-chip-x: root.width - 108px;
    property <length> out-chip-y: root.last-block-row * 108px + 24px;
    out property <bool> any-chip-hovered: blocks.any-chip-hovered;
    // Tracks which BlockChip in the for-loop is currently hovered. -1
    // means no block is hovered. Updated by `hover-state-changed` from
    // each BlockChip — set when entering, clear only if the leaving chip
    // is the current hovered one (so a fast move from one chip to the
    // next does not flicker through -1 in between). Drives the
    // BlockHoverTooltip render below the for-loop.


    background: transparent;
    border-radius: 6px;
    // #591: outline the row when this chain is the active selection AND a
    // MIDI command is recent (last 10s). The marker is MIDI-activity
    // feedback — it appears on a footswitch command and fades out after
    // 10s of no stimulus (`midi-selection-active` flips false). Lit when
    // the chain is enabled, dimmer when disabled.
    property <bool> chain-selected: root.selected-block-chain-index == root.chain-index;
    border-width: (root.chain-selected && root.midi-selection-active) ? 2px : 0px;
    border-color: root.chain.enabled ? #f0a020 : #f0a02055;
    animate border-width { duration: 350ms; easing: ease-out; }
    animate border-color { duration: 350ms; easing: ease-out; }
    // 74 + n*108 used to land the IN/OUT meters at y = root.height - 22,
    // which collided with the block grid (bottom at y = 62 + n*108).
    // Add 32px of breathing room so the meters sit clearly below the
    // last row of blocks. Per-stream meter rows (one per stream) stack
    // downward from the base meter `y`: every extra stream beyond the
    // first adds 22 px so the card grows and the rows don't bleed into
    // the next chain card (user feedback: "tem que dar espaço").
    height: 106px + (root.block-row-count * 108px)
        + (root.chain.stream_meters.length > 1
            ? (root.chain.stream_meters.length - 1) * 22px
            : 0px)
        // #717: one extra row for the DI stream's own IN/OUT meter while it plays.
        + (root.chain.di_loop_playing ? 22px : 0px);

    ChainRowHeader {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 58px;
        chain: root.chain;
        rig-nav: root.rig-nav;
        chain-index: root.chain-index;
        chain-count: root.chain-count;
        fullscreen: root.fullscreen;
        switch-chain-preset(slot) => { root.switch-chain-preset(slot); }
        switch-chain-scene(s) => { root.switch-chain-scene(s); }
        rename-chain-preset(name) => { root.rename-chain-preset(name); }
        toggle-chain-enabled(ci) => { root.toggle-chain-enabled(ci); }
        chain-volume-changed(ci, v) => { root.chain-volume-changed(ci, v); }
        select-chain(ci) => { root.select-chain(ci); }
        configure-chain(ci) => { root.configure-chain(ci); }
        configure-chain-preset(ci) => { root.configure-chain-preset(ci); }
        save-chain-preset(ci) => { root.save-chain-preset(ci); }
        probe-chain-latency(ci) => { root.probe-chain-latency(ci); }
        open-compact-chain-view(ci) => { root.open-compact-chain-view(ci); }
        move-chain-up(ci) => { root.move-chain-up(ci); }
        move-chain-down(ci) => { root.move-chain-down(ci); }
        remove-chain(ci) => { root.remove-chain(ci); }
    }

    blocks := ChainRowBlocks {
        x: 18px;
        y: 62px;
        width: parent.width - 36px;
        height: root.block-row-count * 108px;
        chain: root.chain;
        chain-index: root.chain-index;
        selected-block-chain-index: root.selected-block-chain-index;
        selected-block-index: root.selected-block-index;
        selected-block-neighbor-index: root.selected-block-neighbor-index;
        midi-selection-active: root.midi-selection-active;
        blocks-per-row: root.blocks-per-row;
        block-row-count: root.block-row-count;
        out-chip-x: root.out-chip-x;
        out-chip-y: root.out-chip-y;
        dragging-chain-index <=> root.dragging-chain-index;
        dragging-block-index <=> root.dragging-block-index;
        drag-hover-before-index <=> root.drag-hover-before-index;
        select-chain-block(ci, bi) => { root.select-chain-block(ci, bi); }
        start-block-insert(ci, before) => { root.start-block-insert(ci, before); }
        reorder-chain-block(ci, from, before) => { root.reorder-chain-block(ci, from, before); }
    }

    ChainRowMeters {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        chain: root.chain;
    }
}

