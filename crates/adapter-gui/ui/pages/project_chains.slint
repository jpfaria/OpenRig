// Responsibility: renders the chains page.
import { ListView, ScrollView } from "std-widgets.slint";
import { BlockEditorBridge } from "../block_editor_globals.slint";
import { ProjectChainItem, ChainRigNav, BlockModelPickerItem, BlockParameterItem, BlockTypePickerItem, MultiSliderPoint, CurveEditorPoint, BlockStreamData, BlockKnobOverlay } from "../models.slint";
import { BlockPanelEditor } from "./block_panel_editor.slint";
import { ChainRow } from "./chain_row.slint";
import { BlockEditorPanel } from "./block_editor_panel.slint";
import { HeaderIconAction } from "../components/chain_chips.slint";
import { BlockTypeCard } from "../components/block_value_widgets.slint";
import { MetronomeBridge } from "../components/metronome_globals.slint";
import { BlockParamTabs } from "../components/block_param_tabs_globals.slint";

export component ProjectChainsPage inherits Rectangle {
    in property <string> project-title;
    in property <string> project-path-label;
    in property <bool> project-dirty;
    in property <bool> auto-save: false;
    in property <bool> fullscreen: false;
    in property <bool> skip-launcher: false;
    in property <[ProjectChainItem]> project-chains;
    in property <int> selected-chain-block-chain-index;
    in property <int> selected-chain-block-index;
    in property <int> selected-chain-block-neighbor-index: -1;
    in property <bool> midi-selection-active: false;
    in property <bool> show-inline-block-drawer: true;
    in-out property <string> status-message;
    property <int> dragging-chain-index: -1;
    property <int> dragging-block-index: -1;
    property <int> drag-hover-before-index: -1;
    callback back-to-launcher();
    callback add-chain();
    callback save-project();
    callback configure-project();
    callback open-tuner-window();
    callback open-spectrum-window();
    callback open-metronome-window();
    callback remove-chain(int);
    in property <[ChainRigNav]> chain-rig-nav;
    callback switch-chain-preset(int, int);
    callback switch-chain-scene(int, int);
    callback rename-chain-preset(int, string);
    callback toggle-chain-enabled(int);
    callback chain-volume-changed(int, int);
    // #614: DI loop callbacks
    callback di-loop-source-selected(int, string);
    callback di-loop-choose-file(int);
    callback di-loop-play(int);
    callback di-loop-stop(int);
    callback move-chain-up(int);
    callback move-chain-down(int);
    callback configure-chain(int);
    callback configure-chain-input(int);
    callback configure-chain-output(int);
    callback configure-chain-preset(int);
    callback save-chain-preset(int);
    callback probe-chain-latency(int);
    callback open-compact-chain-view(int);
    callback select-chain-block(int, int);
    callback select-chain(int);
    callback clear-chain-block();
    callback toggle-chain-block-enabled(int, int);
    callback start-block-insert(int, int);
    callback reorder-chain-block(int, int, int);
    callback show-plugin-info(string, string);  // effect_type, model_id

    background: #1f2023;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(135deg, #0d1a2e 0%, #08090d 65%);

        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => {
                if root.dragging-block-index >= 0 {
                    root.dragging-chain-index = -1;
                    root.dragging-block-index = -1;
                    root.drag-hover-before-index = -1;
                }
            }
        }
    }

    Rectangle {
        x: 24px;
        y: 18px;
        width: parent.width - 48px;
        height: 52px;
        background: transparent;

        Text {
            x: 0px;
            y: 6px;
            width: 360px;
            height: 36px;
            text: root.project-title;
            color: #f1f4f8;
            font-size: 28px;
            font-weight: 700;
            vertical-alignment: center;
        }

        if !root.skip-launcher : HeaderIconAction {
            x: parent.width - 280px;
            y: 14px;
            icon: @image-url("../assets/arrow-left.svg");
            tooltip: @tr("tooltip-back");
            clicked => { root.back-to-launcher(); }
        }

        HeaderIconAction {
            x: parent.width - 240px;
            y: 14px;
            icon: @image-url("../assets/spectrum.svg");
            tooltip: @tr("tooltip-spectrum");
            clicked => { root.open-spectrum-window(); }
        }

        HeaderIconAction {
            x: parent.width - 200px;
            y: 14px;
            icon: @image-url("../assets/tuner.svg");
            tooltip: @tr("tooltip-tuner");
            clicked => { root.open-tuner-window(); }
        }

        HeaderIconAction {
            x: parent.width - 160px;
            y: 14px;
            icon: @image-url("../assets/metronome.svg");
            // Lit while the click is playing, so a closed metronome is still
            // visibly running from the top bar.
            active: MetronomeBridge.metronome-enabled;
            tooltip: @tr("tooltip-metronome");
            clicked => { root.open-metronome-window(); }
        }

        HeaderIconAction {
            x: root.auto-save ? parent.width - 80px : parent.width - 120px;
            y: 14px;
            icon: @image-url("../assets/gear.svg");
            tooltip: @tr("tooltip-project-settings");
            clicked => { root.configure-project(); }
        }

        if !root.auto-save : HeaderIconAction {
            x: parent.width - 80px;
            y: 14px;
            icon: @image-url("../assets/save.svg");
            tint: root.project-dirty ? #f3c64f : #eef2f8;
            tooltip: @tr("tooltip-save");
            clicked => { root.save-project(); }
        }

        HeaderIconAction {
            x: parent.width - 40px;
            y: 14px;
            icon: @image-url("../assets/plus.svg");
            tooltip: @tr("tooltip-new-chain");
            clicked => { root.add-chain(); }
        }

    }

    Rectangle {
        x: 24px;
        y: 78px;
        width: parent.width - 48px;
        height: 1px;
        background: #34383f;
    }

    TouchArea {
        x: 24px;
        y: 96px;
        width: parent.width - 48px;
        height: parent.height - 96px;
        clicked => {
            if root.dragging-block-index >= 0 {
                root.dragging-chain-index = -1;
                root.dragging-block-index = -1;
                root.drag-hover-before-index = -1;
            }
        }
    }

    // Virtualized chains list: ListView only instantiates ChainRow instances
    // visible in the viewport. Each row is wrapped in a Rectangle to add 12px
    // of bottom spacing (ListView does not support `spacing` like VerticalBox).
    // Fixes #290 — previous ScrollView + for instantiated every ChainRow upfront,
    // causing heavy SVG rasterization per frame on macOS retina during scroll.
    ListView {
        x: 24px;
        y: 96px;
        width: parent.width - 48px;
        height: parent.height - 96px;

        for chain[index] in root.project-chains : Rectangle {
            background: transparent;
            height: row.height + 12px;

            row := ChainRow {
                x: 0px;
                y: 0px;
                width: parent.width;
                chain: chain;
                rig-nav: root.chain-rig-nav[index];
                switch-chain-preset(slot) => {
                    root.switch-chain-preset(index, slot);
                }
                switch-chain-scene(s) => {
                    root.switch-chain-scene(index, s);
                }
                rename-chain-preset(name) => {
                    root.rename-chain-preset(index, name);
                }
                chain-index: index;
                chain-count: root.project-chains.length;
                fullscreen: root.fullscreen;
                selected-block-chain-index: root.selected-chain-block-chain-index;
                selected-block-index: root.selected-chain-block-index;
                selected-block-neighbor-index: root.selected-chain-block-neighbor-index;
                midi-selection-active: root.midi-selection-active;
                toggle-chain-enabled(index) => { root.toggle-chain-enabled(index); }
                chain-volume-changed(index, v) => { root.chain-volume-changed(index, v); }
                di-loop-source-selected(index, src) => { root.di-loop-source-selected(index, src); }
                di-loop-choose-file(index) => { root.di-loop-choose-file(index); }
                di-loop-play(index) => { root.di-loop-play(index); }
                di-loop-stop(index) => { root.di-loop-stop(index); }
                remove-chain(index) => { root.remove-chain(index); }
                move-chain-up(index) => { root.move-chain-up(index); }
                move-chain-down(index) => { root.move-chain-down(index); }
                configure-chain(index) => { root.configure-chain(index); }
                configure-chain-input(index) => { root.configure-chain-input(index); }
                configure-chain-output(index) => { root.configure-chain-output(index); }
                configure-chain-preset(index) => { root.configure-chain-preset(index); }
                save-chain-preset(index) => { root.save-chain-preset(index); }
                probe-chain-latency(index) => { root.probe-chain-latency(index); }
                open-compact-chain-view(index) => { root.open-compact-chain-view(index); }
                select-chain-block(chain-index, block-index) => { root.select-chain-block(chain-index, block-index); }
                select-chain(chain-index) => { root.select-chain(chain-index); }
                toggle-chain-block-enabled(chain-index, block-index) => { root.toggle-chain-block-enabled(chain-index, block-index); }
                start-block-insert(chain-index, before-index) => { root.start-block-insert(chain-index, before-index); }
                reorder-chain-block(chain-index, from-index, before-index) => {
                    root.reorder-chain-block(chain-index, from-index, before-index);
                    root.dragging-chain-index = -1;
                    root.dragging-block-index = -1;
                    root.drag-hover-before-index = -1;
                }
                dragging-chain-index <=> root.dragging-chain-index;
                dragging-block-index <=> root.dragging-block-index;
                drag-hover-before-index <=> root.drag-hover-before-index;
            }
        }
    }

    if root.show-inline-block-drawer && BlockEditorBridge.show-block-drawer : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #0405068a;

        // Same use-panel-editor logic as BlockEditorWindow
        property <bool> use-panel-editor:
            BlockEditorBridge.block-drawer-selected-type-index >= 0
            && BlockEditorBridge.block-drawer-selected-type-index < BlockEditorBridge.block-type-options.length
            && BlockEditorBridge.block-type-options[BlockEditorBridge.block-drawer-selected-type-index].use_panel_editor;

        // Dynamic width matching BlockEditorWindow
        property <int> param-count: BlockEditorBridge.block-parameter-items.length;
        property <length> needed-width: param-count > 0 ? param-count * 64px + 80px : 520px;
        property <bool> has-eq-widget:
            BlockEditorBridge.curve-editor-points.length > 0 || BlockEditorBridge.multi-slider-points.length > 0;
        property <length> eq-panel-width:
            BlockEditorBridge.multi-slider-points.length > 0 ?
                Math.max(600px, Math.min(1400px, BlockEditorBridge.multi-slider-points.length * 35px + 80px)) :
            BlockEditorBridge.curve-editor-points.length > 0 ?
                Math.max(600px, Math.min(1200px, BlockEditorBridge.curve-editor-points.length * 200px + 80px)) :
                600px;
        property <length> panel-width:
            use-panel-editor ?
                // #819: the knob grid width MUST match the #500 policy (capped at
                // MAX_COLS), or it disagrees with the policy's inner height and the
                // bottom knob row clips. Fall back to the local estimate only until
                // Rust publishes the computed width.
                (has-eq-widget
                    ? eq-panel-width
                    : (BlockParamTabs.panel-width > 0px ? BlockParamTabs.panel-width : Math.max(900px, needed-width))) :
                520px;
        property <length> eq-widget-height:
            BlockEditorBridge.curve-editor-points.length > 0 ? 200px :
            BlockEditorBridge.multi-slider-points.length > 0 ? 180px : 0px;
        property <bool> has-stream-data:
            BlockEditorBridge.block-stream-data.stream-kind != ""
            && BlockEditorBridge.block-stream-data.stream-kind != "spectrum";
        property <length> eq-extra-height:
            has-eq-widget ? (48px + 60px + 8px + eq-widget-height + 8px) : 275px;
        // #819: prefer the #500 Rust policy (knob wrap + tab bar) so the panel
        // never clips its knobs; fall back to the local estimate until Rust
        // publishes a height.
        property <length> panel-height:
            use-panel-editor
                ? (BlockParamTabs.panel-height > 0px
                    ? BlockParamTabs.panel-height
                    : (has-stream-data ? Math.max(420px, eq-extra-height) : eq-extra-height))
                : parent.height;

        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { BlockEditorBridge.close-block-drawer(); }
        }

        // Panel editor (preamp/amp with knobs)
        if use-panel-editor : BlockPanelEditor {
            x: (parent.width - parent.panel-width) / 2;
            y: (parent.height - parent.panel-height) / 2;
            width: parent.panel-width;
            height: parent.panel-height;
            // #819: same parameter tabs the detached editor shows.
            block-parameter-groups: BlockParamTabs.groups;
            active-parameter-group: BlockParamTabs.active;
            select-parameter-group(i) => { BlockParamTabs.select(i); }
            // #819: same #500 inner knob-grid dimensions the detached window
            // gets from apply_panel_dimensions, so a param-heavy block doesn't
            // clip. Fall back to the component defaults until Rust computes them.
            panel-knob-inner-height: BlockParamTabs.inner-height > 0px ? BlockParamTabs.inner-height : 225px;
            panel-grid-cols: BlockParamTabs.grid-cols;
            panel-grid-rows: BlockParamTabs.grid-rows;
            show-plugin-info(effect_type, model_id) => { root.show-plugin-info(effect_type, model_id); }
        }

        // Form editor (other block types)
        if !use-panel-editor : BlockEditorPanel {
            x: parent.width - 520px;
            y: 0px;
            width: 520px;
            height: parent.height;
            show-plugin-info(effect_type, model_id) => { root.show-plugin-info(effect_type, model_id); }
        }
    }

    if BlockEditorBridge.show-block-type-picker : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #0405069a;

        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { BlockEditorBridge.cancel-block-picker(); }
        }

        picker-modal := Rectangle {
            property <int> row-count: Math.max(1, Math.floor((BlockEditorBridge.block-type-options.length - 1) / 4) + 1);
            property <length> content-height: self.row-count * 100px;
            x: (parent.width - 472px) / 2;
            y: (parent.height - self.height) / 2;
            width: 472px;
            height: Math.min(parent.height - 80px, self.content-height + 40px);
            background: #171a20f8;
            border-width: 1px;
            border-color: #2d3340;
            border-radius: 6px;

            ScrollView {
                x: 20px;
                y: 20px;
                width: parent.width - 40px;
                height: parent.height - 40px;
                viewport-height: picker-modal.content-height;

                for type-item[index] in BlockEditorBridge.block-type-options : BlockTypeCard {
                    x: Math.mod(index, 4) * 106px;
                    y: Math.floor(index / 4) * 100px;
                    item: type-item;
                    selected: false;
                    clicked => { BlockEditorBridge.choose-block-type(index); }
                }
            }
        }
    }
}
