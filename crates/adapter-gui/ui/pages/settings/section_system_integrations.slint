// Responsibility: renders the integrations section.
// System / Integrations — master switches for the MIDI/BLE-MIDI adapter
// and the MCP server (issue #712). Enablement is per-machine config
// (config.yaml), not a CLI flag, so packaged builds — launched with no
// arguments — can bring these subsystems up. The toggles dispatch
// SetMidiEnabled / SetMcpEnabled through the command bus; the change is
// persisted and takes effect on next launch (the subsystems are wired at
// bootstrap), hence the restart hint.
//
// #398: each subsystem is a raised card — its name, a quiet one-line
// description, and an on/off switch at the right.

import { Theme } from "../../theme.slint";
import { SettingsBridge } from "../../settings_globals.slint";
import { SettingsCard } from "../../components/settings_card.slint";
import { ToggleSwitch } from "../../components/toggle_switch.slint";
import { SectionSystemTone3000Key } from "section_system_tone3000_key.slint";

component OptionCard inherits SettingsCard {
    in property <string> title;
    in property <string> description;
    in property <bool> on;
    callback toggled();

    min-height: info.preferred-height;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        info := VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.ink;
                font-size: Theme.min-font;
                font-weight: 600;
            }
            Text {
                text: root.description;
                color: Theme.ink-3;
                font-size: Theme.min-font;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            ToggleSwitch {
                width: 34px;
                height: 18px;
                off-track: Theme.field-line;
                on: root.on;
                label: root.title;
                toggled => { root.toggled(); }
            }
        }
    }
}

export component SectionSystemIntegrations inherits Rectangle {

    background: transparent;

    VerticalLayout {
        spacing: 10px;
        alignment: start;

        OptionCard {
            title: @tr("label-midi-enabled");
            description: @tr("desc-midi-enabled");
            on: SettingsBridge.midi-enabled;
            toggled => { SettingsBridge.set-midi-enabled(!SettingsBridge.midi-enabled); }
        }

        OptionCard {
            title: @tr("label-mcp-enabled");
            description: @tr("desc-mcp-enabled");
            on: SettingsBridge.mcp-enabled;
            toggled => { SettingsBridge.set-mcp-enabled(!SettingsBridge.mcp-enabled); }
        }

        // Restart hint — both switches take effect on next launch.
        Text {
            text: @tr("hint-restart-to-apply");
            color: Theme.ink-3;
            font-size: Theme.min-font;
            wrap: word-wrap;
        }

        // #879: the TONE3000 key applies at once, so it sits after the hint.
        SectionSystemTone3000Key { }
    }
}
