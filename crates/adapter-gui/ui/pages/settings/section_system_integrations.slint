// Responsibility: renders the integrations section.
// System / Integrations — master switches for the MIDI/BLE-MIDI adapter
// and the MCP server (issue #712). Enablement is per-machine config
// (config.yaml), not a CLI flag, so packaged builds — launched with no
// arguments — can bring these subsystems up. The toggles dispatch
// SetMidiEnabled / SetMcpEnabled through the command bus; the change is
// persisted and takes effect on next launch (the subsystems are wired at
// bootstrap), hence the restart hint.
//
// Visual language mirrors the device-row toggle in
// section_system_midi_devices.slint (blue check-square) for cross-screen
// consistency.

import { Theme } from "../../theme.slint";
import { SettingsBridge } from "../../settings_globals.slint";

export component SectionSystemIntegrations inherits Rectangle {

    background: transparent;

    VerticalLayout {
        spacing: 12px;

        // ── MIDI adapter row ──
        // Row grows with the wrapped description instead of eliding it.
        Rectangle {
            height: max(56px, midi-info.preferred-height + 16px);
            background: Theme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: SettingsBridge.midi-enabled ? Theme.accent-line : Theme.hair;
            animate border-color { duration: 200ms; }

            midi-info := VerticalLayout {
                x: 16px;
                width: parent.width - 16px - 56px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: @tr("label-midi-enabled");
                    color: Theme.ink;
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: @tr("desc-midi-enabled");
                    color: Theme.ink-2;
                    font-size: 18px;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                x: parent.width - 36px;
                y: (parent.height - 20px) / 2;
                width: 20px;
                height: 20px;
                background: SettingsBridge.midi-enabled ? Theme.accent : Theme.panel-hi;
                border-width: 1px;
                border-color: SettingsBridge.midi-enabled ? Theme.accent : Theme.field-line;
                border-radius: 8px;

                if SettingsBridge.midi-enabled : Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    source: @image-url("../../assets/check.svg");
                    colorize: Theme.on-accent;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { SettingsBridge.set-midi-enabled(!SettingsBridge.midi-enabled); }
                }
            }
        }

        // ── MCP server row ──
        Rectangle {
            height: max(56px, mcp-info.preferred-height + 16px);
            background: Theme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: SettingsBridge.mcp-enabled ? Theme.accent-line : Theme.hair;
            animate border-color { duration: 200ms; }

            mcp-info := VerticalLayout {
                x: 16px;
                width: parent.width - 16px - 56px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: @tr("label-mcp-enabled");
                    color: Theme.ink;
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: @tr("desc-mcp-enabled");
                    color: Theme.ink-2;
                    font-size: 18px;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                x: parent.width - 36px;
                y: (parent.height - 20px) / 2;
                width: 20px;
                height: 20px;
                background: SettingsBridge.mcp-enabled ? Theme.accent : Theme.panel-hi;
                border-width: 1px;
                border-color: SettingsBridge.mcp-enabled ? Theme.accent : Theme.field-line;
                border-radius: 8px;

                if SettingsBridge.mcp-enabled : Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    source: @image-url("../../assets/check.svg");
                    colorize: Theme.on-accent;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { SettingsBridge.set-mcp-enabled(!SettingsBridge.mcp-enabled); }
                }
            }
        }

        // Restart hint — both switches take effect on next launch.
        Text {
            text: @tr("hint-restart-to-apply");
            color: Theme.ink-3;
            font-size: 18px;
            wrap: word-wrap;
        }
    }
}
