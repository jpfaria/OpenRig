// Responsibility: renders the bindings section.
// System / I/O bindings editor (#716).
// Pure dispatcher (LAW): callbacks fire upward; Rust owns mutation + Commands.
// Colours come from the Theme tokens (#398): IN = Theme.in, OUT = Theme.out.
//
// #398: each binding is a raised card. Collapsed, its header reads the name in
// the display face and two pills — "1 IN" in the input colour, "1 OUT" in the
// output colour. Opened, the inputs and outputs each get a framed list and,
// under it, either a quiet "+ add" button or the add form (device, mode as a
// segmented choice, channels, Cancel / Add).

import { Theme } from "../../theme.slint";
import { SettingsBridge } from "../../settings_globals.slint";
import { ChannelPicker } from "../../components/channel_picker.slint";
import { FormButton, FormButtonKind } from "../../components/form_button.slint";
import { SegControl } from "../../components/seg_control.slint";
import { DropSelect } from "../../components/drop_select.slint";
import { FieldCaption } from "../../components/field_caption.slint";
import { ListBox } from "../../components/list_box.slint";
import { TagPill } from "../../components/tag_pill.slint";
import { IoEndpointRow, RowIconButton } from "io_endpoint_row.slint";

// The framed panel the add form sits in.
component AddPanel inherits Rectangle {
    border-radius: 4px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.hair-2;
    min-height: body.preferred-height;

    body := VerticalLayout {
        padding: 12px;
        spacing: 12px;
        @children
    }
}

// A captioned field of the add form.
component Field inherits VerticalLayout {
    in property <string> caption;
    spacing: 6px;
    FieldCaption { text: root.caption; }
    @children
}

export component SectionSystemIoBindings inherits Rectangle {
    // ── Private state ─────────────────────────────────────────────────────────
    // Which add-row is open: "<binding>|in" / "<binding>|out" ("" = none).
    private property <string> active-add: "";
    private property <int> add-device-index: -1;
    private property <int> add-mode-index: 0; // 0 mono, 1 stereo, 2 dual
    // Name of the endpoint being edited ("" = adding a brand-new endpoint).
    private property <string> editing-endpoint: "";
    // Id of the binding whose name is being renamed inline ("" = none).
    private property <string> renaming-binding-id: "";
    // Live draft of the name being edited (so the confirm button, in a separate
    // conditional branch, can read it — Slint can't reach an id across branches).
    private property <string> rename-draft: "";
    // Accordion (#716): id of the expanded binding ("" = all collapsed). Each
    // E/S shows only its name + In/Out counts until opened — progressive
    // disclosure to keep the list readable when several bindings exist.
    private property <string> expanded-binding-id: "";

    background: transparent;

    VerticalLayout {
        spacing: 12px;
        alignment: start;

        // Helper + primary action (the page title is the shell's heading).
        HorizontalLayout {
            spacing: 16px;
            Text {
                horizontal-stretch: 1;
                text: @tr("help-io-bindings");
                color: Theme.ink-3;
                font-size: Theme.min-font;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            VerticalLayout {
                alignment: center;
                new-binding-btn := FormButton {
                    icon: @image-url("../../assets/plus.svg");
                    label: @tr("btn-new-binding");
                    clicked => { root.expanded-binding-id = SettingsBridge.create-io-binding(""); }
                }
            }
        }

        if SettingsBridge.io-binding-error != "" : Rectangle {
            height: 40px;
            border-radius: 4px;
            background: Theme.bad-soft;
            border-width: 1px;
            border-color: Theme.bad;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 6px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: SettingsBridge.io-binding-error;
                    color: Theme.bad;
                    font-size: Theme.min-font;
                    vertical-alignment: center;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    RowIconButton {
                        icon: @image-url("../../assets/close.svg");
                        label: @tr("btn-close");
                        clicked => { SettingsBridge.io-binding-error = ""; }
                    }
                }
            }
        }

        if SettingsBridge.io-bindings.length == 0 : Rectangle {
            // Grows with the (wrapped) hint instead of clipping it.
            min-height: 96px;
            border-radius: 5px;
            background: Theme.panel-hi;
            border-width: 1px;
            border-color: Theme.hair;
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                padding: 16px;
                Text { text: @tr("empty-no-bindings"); color: Theme.ink; font-size: Theme.min-font; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: @tr("empty-no-bindings-hint"); color: Theme.ink-3; font-size: Theme.min-font; horizontal-alignment: center; wrap: word-wrap; }
            }
        }

        for binding[bi] in SettingsBridge.io-bindings : Rectangle {
            border-radius: 5px;
            clip: true;
            background: Theme.panel-hi;
            border-width: 1px;
            border-color: Theme.hair;

            VerticalLayout {
                // ── Header — name, or the inline editor while renaming ──
                HorizontalLayout {
                    min-height: 48px;
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 10px;

                    // Chevron — points down when expanded, right when collapsed.
                    if root.renaming-binding-id != binding.id : Rectangle {
                        width: 16px;
                        Image {
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            width: 11px; height: 11px;
                            source: @image-url("../../assets/chevron-down.svg");
                            colorize: chev-ta.has-hover ? Theme.ink : Theme.ink-3;
                            transform-rotation: root.expanded-binding-id == binding.id ? 0deg : -90deg;
                            animate transform-rotation { duration: 150ms; easing: ease-in-out; }
                        }
                        chev-ta := TouchArea { mouse-cursor: pointer; clicked => {
                            root.expanded-binding-id = root.expanded-binding-id == binding.id ? "" : binding.id; } }
                    }
                    // Name + In/Out counts. Clicking the row toggles expand.
                    if root.renaming-binding-id != binding.id : Rectangle {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: binding.name;
                                color: Theme.ink;
                                font-family: "Bebas Neue";
                                font-size: 24px;
                                letter-spacing: 0.05 * 24px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            VerticalLayout { alignment: center;
                                TagPill { text: @tr("label-count-in {}", binding.inputs.length); tone: Theme.in; } }
                            VerticalLayout { alignment: center;
                                TagPill { text: @tr("label-count-out {}", binding.outputs.length); tone: Theme.out; } }
                        }
                        name-ta := TouchArea { mouse-cursor: pointer; clicked => {
                            root.expanded-binding-id = root.expanded-binding-id == binding.id ? "" : binding.id; } }
                    }
                    if root.renaming-binding-id == binding.id : VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Rectangle {
                            height: 36px;
                            border-radius: 3px;
                            background: Theme.field;
                            border-width: name-input.has-focus ? 2px : 1px;
                            border-color: name-input.has-focus ? Theme.accent : Theme.field-line;
                            // Auto-focus AFTER first layout. Calling focus() from the
                            // TextInput's init (while this conditional is still being
                            // laid out, mid mouse-event) recurses on item_geometry and
                            // aborts the process. A one-shot Timer defers it safely.
                            focus-timer := Timer {
                                interval: 1ms;
                                triggered => { name-input.focus(); name-input.select-all(); focus-timer.running = false; }
                            }
                            HorizontalLayout { padding-left: 10px; padding-right: 10px;
                                name-input := TextInput {
                                    text <=> root.rename-draft;
                                    color: Theme.ink; font-size: Theme.min-font; font-weight: 600;
                                    vertical-alignment: center; single-line: true;
                                    // Commit on Enter and on losing focus (blur).
                                    // Leave edit mode BEFORE dispatching: rename
                                    // re-projects the list and rebuilds this repeater
                                    // synchronously, tearing this field down — a reset
                                    // placed after the call is lost and the row stays
                                    // stuck in edit mode (looks like "nothing happened").
                                    accepted => {
                                        root.renaming-binding-id = "";
                                        SettingsBridge.rename-io-binding(binding.id, root.rename-draft);
                                    }
                                    changed has-focus => {
                                        if !self.has-focus && root.renaming-binding-id == binding.id {
                                            root.renaming-binding-id = "";
                                            SettingsBridge.rename-io-binding(binding.id, root.rename-draft);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Resting actions: rename + delete. Hidden while editing the
                    // name so the only actions are confirm / cancel.
                    if root.renaming-binding-id != binding.id : VerticalLayout { alignment: center;
                        rename-btn := RowIconButton { icon: @image-url("../../assets/pencil.svg"); label: @tr("btn-edit"); clicked => {
                            root.rename-draft = binding.name;
                            root.renaming-binding-id = binding.id;
                        } } }
                    if root.renaming-binding-id != binding.id : VerticalLayout { alignment: center;
                        delete-btn := RowIconButton { icon: @image-url("../../assets/trash.svg"); label: @tr("btn-delete"); danger: true; clicked => {
                            let err = SettingsBridge.delete-io-binding(binding.id); if err != "" { SettingsBridge.io-binding-error = err; } } } }
                    // Editing actions: confirm commits the rename, cancel discards.
                    if root.renaming-binding-id == binding.id : VerticalLayout { alignment: center;
                        confirm-rename-btn := RowIconButton { icon: @image-url("../../assets/check.svg"); label: @tr("btn-save"); clicked => {
                            // Reset before dispatch — see the accepted/blur note above.
                            root.renaming-binding-id = "";
                            SettingsBridge.rename-io-binding(binding.id, root.rename-draft);
                        } } }
                    if root.renaming-binding-id == binding.id : VerticalLayout { alignment: center;
                        RowIconButton { icon: @image-url("../../assets/close.svg"); label: @tr("btn-cancel"); clicked => {
                            root.renaming-binding-id = "";
                        } } }
                }

                // ── Body — shown only when expanded (accordion #716) ──
                if root.expanded-binding-id == binding.id : Rectangle {
                    min-height: bb.preferred-height;

                    Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: Theme.hair-2; }

                    bb := VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 12px;
                        padding-bottom: 16px;
                        spacing: 10px;

                        // ── Inputs ──
                        HorizontalLayout { alignment: start;
                            TagPill { text: @tr("label-group-inputs"); tone: Theme.in; } }
                        if binding.inputs.length == 0 : Text { text: @tr("empty-no-input-endpoints"); color: Theme.ink-3; font-size: Theme.min-font; }
                        if binding.inputs.length > 0 : ListBox {
                            for ep[ii] in binding.inputs : IoEndpointRow {
                                divided: ii > 0;
                                endpoint: ep;
                                edit-requested => {
                                    SettingsBridge.edit-endpoint(binding.id, ep.name, true);
                                    root.add-device-index = SettingsBridge.io-edit-prefill-device-index;
                                    root.add-mode-index = SettingsBridge.io-edit-prefill-mode-index;
                                    root.editing-endpoint = ep.name;
                                    root.active-add = binding.id + "|in";
                                }
                                remove-requested => { SettingsBridge.remove-endpoint(binding.id, ep.name, true); }
                            }
                        }
                        if root.active-add != (binding.id + "|in") : HorizontalLayout { alignment: start;
                            add-input-btn := FormButton {
                                kind: FormButtonKind.ghost;
                                small: true;
                                label: @tr("btn-add-input");
                                clicked => { root.active-add = binding.id + "|in"; root.add-device-index = -1; root.add-mode-index = 0; root.editing-endpoint = ""; }
                            } }
                        if root.active-add == (binding.id + "|in") : AddPanel {
                            HorizontalLayout { spacing: 12px;
                                Field { caption: @tr("label-endpoint-device"); horizontal-stretch: 1;
                                    DropSelect { model: SettingsBridge.input-device-names; current <=> root.add-device-index; placeholder: @tr("placeholder-pick-device");
                                        picked(i) => { SettingsBridge.endpoint-device-changed(binding.id, true, SettingsBridge.input-device-ids[i]); } } }
                                Field { caption: @tr("label-endpoint-mode"); horizontal-stretch: 0;
                                    SegControl { height: 36px; label: @tr("label-endpoint-mode");
                                        options: [@tr("mode-mono"), @tr("mode-stereo"), @tr("mode-dual-mono")]; current: root.add-mode-index;
                                        picked(i) => { root.add-mode-index = i; } } }
                            }
                            Field { caption: @tr("label-endpoint-channels");
                                ChannelPicker {
                                    channels: SettingsBridge.io-binding-channel-options;
                                    single-select: root.add-mode-index == 0;
                                    empty-hint: @tr("hint-channels-pick-device");
                                    toggled(ci, sel) => { SettingsBridge.toggle-endpoint-channel(ci, sel,
                                        root.add-mode-index == 0 ? "mono" : root.add-mode-index == 1 ? "stereo" : "dual_mono"); } } }
                            HorizontalLayout { spacing: 8px; alignment: end;
                                FormButton { label: @tr("btn-cancel"); clicked => { root.active-add = ""; root.editing-endpoint = ""; } }
                                add-input-submit-btn := FormButton { kind: FormButtonKind.primary; label: root.editing-endpoint != "" ? @tr("btn-save") : @tr("btn-add"); clicked => {
                                    // Close the form BEFORE dispatching. The handler
                                    // re-projects the binding list, which rebuilds this
                                    // repeater synchronously and tears this button down
                                    // mid-handler — so a state reset placed AFTER the
                                    // call never runs and the form stays stuck open.
                                    // (editing-endpoint is still needed by the call
                                    // below; it's reset on the next form open.)
                                    root.active-add = "";
                                    SettingsBridge.add-input-endpoint(binding.id, root.add-device-index >= 0 ? SettingsBridge.input-device-ids[root.add-device-index] : "",
                                        root.add-mode-index == 0 ? "mono" : root.add-mode-index == 1 ? "stereo" : "dual_mono", root.editing-endpoint); } }
                            }
                        }

                        Rectangle { height: 6px; }

                        // ── Outputs ──
                        HorizontalLayout { alignment: start;
                            TagPill { text: @tr("label-group-outputs"); tone: Theme.out; } }
                        if binding.outputs.length == 0 : Text { text: @tr("empty-no-output-endpoints"); color: Theme.ink-3; font-size: Theme.min-font; }
                        if binding.outputs.length > 0 : ListBox {
                            for ep[oi] in binding.outputs : IoEndpointRow {
                                divided: oi > 0;
                                endpoint: ep;
                                edit-requested => {
                                    SettingsBridge.edit-endpoint(binding.id, ep.name, false);
                                    root.add-device-index = SettingsBridge.io-edit-prefill-device-index;
                                    root.add-mode-index = SettingsBridge.io-edit-prefill-mode-index;
                                    root.editing-endpoint = ep.name;
                                    root.active-add = binding.id + "|out";
                                }
                                remove-requested => { SettingsBridge.remove-endpoint(binding.id, ep.name, false); }
                            }
                        }
                        if root.active-add != (binding.id + "|out") : HorizontalLayout { alignment: start;
                            FormButton {
                                kind: FormButtonKind.ghost;
                                small: true;
                                label: @tr("btn-add-output");
                                clicked => { root.active-add = binding.id + "|out"; root.add-device-index = -1; root.add-mode-index = 0; root.editing-endpoint = ""; }
                            } }
                        if root.active-add == (binding.id + "|out") : AddPanel {
                            HorizontalLayout { spacing: 12px;
                                Field { caption: @tr("label-endpoint-device"); horizontal-stretch: 1;
                                    DropSelect { model: SettingsBridge.output-device-names; current <=> root.add-device-index; placeholder: @tr("placeholder-pick-device");
                                        picked(i) => { SettingsBridge.endpoint-device-changed(binding.id, false, SettingsBridge.output-device-ids[i]); } } }
                                Field { caption: @tr("label-endpoint-mode"); horizontal-stretch: 0;
                                    SegControl { height: 36px; label: @tr("label-endpoint-mode");
                                        options: [@tr("mode-mono"), @tr("mode-stereo")]; current: root.add-mode-index;
                                        picked(i) => { root.add-mode-index = i; } } }
                            }
                            Field { caption: @tr("label-endpoint-channels");
                                ChannelPicker {
                                    channels: SettingsBridge.io-binding-channel-options;
                                    single-select: root.add-mode-index == 0;
                                    empty-hint: @tr("hint-channels-pick-device");
                                    toggled(ci, sel) => { SettingsBridge.toggle-endpoint-channel(ci, sel,
                                        root.add-mode-index == 0 ? "mono" : "stereo"); } } }
                            HorizontalLayout { spacing: 8px; alignment: end;
                                FormButton { label: @tr("btn-cancel"); clicked => { root.active-add = ""; root.editing-endpoint = ""; } }
                                add-output-submit-btn := FormButton { kind: FormButtonKind.primary; label: root.editing-endpoint != "" ? @tr("btn-save") : @tr("btn-add"); clicked => {
                                    // Close the form BEFORE dispatching — see the
                                    // add-input submit note: reproject rebuilds this
                                    // repeater and a reset after the call is lost.
                                    root.active-add = "";
                                    SettingsBridge.add-output-endpoint(binding.id, root.add-device-index >= 0 ? SettingsBridge.output-device-ids[root.add-device-index] : "",
                                        root.add-mode-index == 0 ? "mono" : "stereo", root.editing-endpoint); } }
                            }
                        }
                    }
                }
            }
        }
    }
}
