// Responsibility: renders one existing endpoint row.
// One existing-endpoint row in the I/O bindings editor (#716): the device,
// its mode and channels in the quiet ink, then edit and remove. Pure
// presentation — the events fire upward; Rust owns the mutation.
//
// #398: a row of the framed endpoint list.

import { Theme } from "../../theme.slint";
import { IoEndpointModel } from "../../models.slint";
import { ListRow } from "../../components/list_box.slint";
import { ElidedText } from "../../components/elided_text.slint";

// A square icon action that lights on hover; `danger` reddens it.
export component RowIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: !ta.has-hover ? transparent : root.danger ? Theme.bad-soft : Theme.hover;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: !ta.has-hover ? Theme.ink-3 : root.danger ? Theme.bad : Theme.ink;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

export component IoEndpointRow inherits ListRow {
    in property <IoEndpointModel> endpoint;
    callback edit-requested();
    callback remove-requested();

    private property <string> mode-text: root.endpoint.mode == "mono" ? @tr("mode-mono")
        : root.endpoint.mode == "stereo" ? @tr("mode-stereo")
        : @tr("mode-dual-mono");

    ElidedText {
        horizontal-stretch: 1;
        text: root.endpoint.device_label;
        color: Theme.ink;
        font-size: Theme.min-font;
        vertical-alignment: center;
    }

    // #880: a many-channel endpoint must not push the row's actions out.
    ElidedText {
        max-width: 260px;
        text: @tr("label-endpoint-summary {} {}", root.mode-text, root.endpoint.channels_label);
        color: Theme.ink-3;
        font-size: Theme.min-font;
        vertical-alignment: center;
    }

    VerticalLayout {
        alignment: center;
        RowIconButton {
            icon: @image-url("../../assets/pencil.svg");
            label: @tr("btn-edit");
            clicked => { root.edit-requested(); }
        }
    }

    VerticalLayout {
        alignment: center;
        RowIconButton {
            icon: @image-url("../../assets/trash.svg");
            label: @tr("btn-delete");
            danger: true;
            clicked => { root.remove-requested(); }
        }
    }
}
