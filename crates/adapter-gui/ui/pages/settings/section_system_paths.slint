// Responsibility: renders the paths section.
// System / Paths section (#513). Rows for each configurable
// directory — presets, plugins, evaluations (#582) — each a label +
// current path + Choose…/Reset. Empty path means "use OS default"
// (the resolver handles it). All rows share a fixed-width label
// column so they line up vertically.
//
// #561 adds a row for the plugin catalog: a "Reload" button that
// dispatches `Command::ReloadPluginCatalog`, plus a status text
// showing the post-reload counts. Lives in the same section because
// the action is bound to the plugins directory above it.

import { Button } from "std-widgets.slint";
import { SettingsBridge } from "../../settings_globals.slint";

export component SectionSystemPaths inherits Rectangle {
    background: transparent;

    VerticalLayout {
        spacing: 16px;
        alignment: start;

        // ── Presets directory row ─────────────────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 32px;
            Text {
                text: @tr("label-presets-path");
                color: #cfd5e0;
                font-size: 16px;
                width: 140px;
                vertical-alignment: center;
            }
            Text {
                text: SettingsBridge.presets-path == ""
                    ? @tr("placeholder-default-path")
                    : SettingsBridge.presets-path;
                color: SettingsBridge.presets-path == "" ? #8a92a3 : #dde3ec;
                font-size: 14px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: @tr("btn-choose-path");
                clicked => { SettingsBridge.pick-presets-path(); }
            }
            Button {
                text: @tr("btn-reset-path");
                clicked => { SettingsBridge.reset-presets-path(); }
            }
        }

        // ── Plugins directory row ─────────────────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 32px;
            Text {
                text: @tr("label-plugins-path");
                color: #cfd5e0;
                font-size: 16px;
                width: 140px;
                vertical-alignment: center;
            }
            Text {
                text: SettingsBridge.plugins-path == ""
                    ? @tr("placeholder-default-path")
                    : SettingsBridge.plugins-path;
                color: SettingsBridge.plugins-path == "" ? #8a92a3 : #dde3ec;
                font-size: 14px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: @tr("btn-choose-path");
                clicked => { SettingsBridge.pick-plugins-path(); }
            }
            Button {
                text: @tr("btn-reset-path");
                clicked => { SettingsBridge.reset-plugins-path(); }
            }
        }

        // ── Evaluations directory row (#582) ──────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 32px;
            Text {
                text: @tr("label-evaluations-path");
                color: #cfd5e0;
                font-size: 16px;
                width: 140px;
                vertical-alignment: center;
            }
            Text {
                text: SettingsBridge.evaluations-path == ""
                    ? @tr("placeholder-default-path")
                    : SettingsBridge.evaluations-path;
                color: SettingsBridge.evaluations-path == "" ? #8a92a3 : #dde3ec;
                font-size: 14px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: @tr("btn-choose-path");
                clicked => { SettingsBridge.pick-evaluations-path(); }
            }
            Button {
                text: @tr("btn-reset-path");
                clicked => { SettingsBridge.reset-evaluations-path(); }
            }
        }

        // ── Plugin catalog reload row (#561) ──────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 32px;
            Text {
                text: @tr("label-plugin-catalog");
                color: #cfd5e0;
                font-size: 16px;
                width: 140px;
                vertical-alignment: center;
            }
            Text {
                text: SettingsBridge.plugin-catalog-status == ""
                    ? @tr("status-plugin-catalog-idle")
                    : SettingsBridge.plugin-catalog-status;
                color: SettingsBridge.plugin-catalog-status == "" ? #8a92a3 : #dde3ec;
                font-size: 14px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: @tr("btn-reload-plugin-catalog");
                clicked => { SettingsBridge.reload-plugin-catalog(); }
            }
        }
    }
}
