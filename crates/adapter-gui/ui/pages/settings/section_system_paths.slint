// Responsibility: renders the paths section.
// System / Paths section (#513). Rows for each configurable
// directory — presets, plugins, evaluations (#582), backing tracks — each a label +
// current path + Choose…/Reset. Empty path means "use OS default"
// (the resolver handles it). All rows share a fixed-width label
// column so they line up vertically.
//
// #561 adds a row for the plugin catalog: a "Reload" button that
// dispatches `Command::ReloadPluginCatalog`, plus a status text
// showing the post-reload counts. Lives in the same section because
// the action is bound to the plugins directory above it.
//
// #398: the path sits in a read-only field (the default reads "(default)"
// in the quiet ink), Choose… is a normal button and Reset a ghost one.

import { Theme } from "../../theme.slint";
import { SettingsBridge } from "../../settings_globals.slint";
import { TextField } from "../../components/text_field.slint";
import { FormButton, FormButtonKind } from "../../components/form_button.slint";

// One directory: its label, the path, Choose… and Reset.
component PathRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> path;
    in property <length> label-width;
    out property <length> label-preferred: label-text.preferred-width;
    callback choose();
    callback reset();

    spacing: 10px;

    label-text := Text {
        width: root.label-width;
        text: root.label;
        color: Theme.ink-2;
        font-size: Theme.min-font;
        font-weight: 600;
        vertical-alignment: center;
    }
    TextField {
        horizontal-stretch: 1;
        read-only: true;
        text: root.path;
        placeholder: @tr("placeholder-default-path");
    }
    FormButton {
        label: @tr("btn-choose-path");
        clicked => { root.choose(); }
    }
    FormButton {
        kind: FormButtonKind.ghost;
        label: @tr("btn-reset-path");
        clicked => { root.reset(); }
    }
}

export component SectionSystemPaths inherits Rectangle {
    // Shared label column: at least 150px, wider when a translation needs it.
    private property <length> label-width: max(150px, presets.label-preferred,
        plugins.label-preferred, evaluations.label-preferred,
        backing-tracks.label-preferred, catalog-label.preferred-width);

    background: transparent;

    VerticalLayout {
        spacing: 10px;
        alignment: start;

        presets := PathRow {
            label: @tr("label-presets-path");
            label-width: root.label-width;
            path: SettingsBridge.presets-path;
            choose => { SettingsBridge.pick-presets-path(); }
            reset => { SettingsBridge.reset-presets-path(); }
        }
        plugins := PathRow {
            label: @tr("label-plugins-path");
            label-width: root.label-width;
            path: SettingsBridge.plugins-path;
            choose => { SettingsBridge.pick-plugins-path(); }
            reset => { SettingsBridge.reset-plugins-path(); }
        }
        evaluations := PathRow {
            label: @tr("label-evaluations-path");
            label-width: root.label-width;
            path: SettingsBridge.evaluations-path;
            choose => { SettingsBridge.pick-evaluations-path(); }
            reset => { SettingsBridge.reset-evaluations-path(); }
        }
        backing-tracks := PathRow {
            label: @tr("label-backing-tracks-path");
            label-width: root.label-width;
            path: SettingsBridge.backing-tracks-path;
            choose => { SettingsBridge.pick-backing-tracks-path(); }
            reset => { SettingsBridge.reset-backing-tracks-path(); }
        }

        // ── Plugin catalog reload row (#561) ──────────────────────
        HorizontalLayout {
            spacing: 10px;
            padding-top: 6px;

            catalog-label := Text {
                width: root.label-width;
                text: @tr("label-plugin-catalog");
                color: Theme.ink-2;
                font-size: Theme.min-font;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: SettingsBridge.plugin-catalog-status == ""
                    ? @tr("status-plugin-catalog-idle")
                    : SettingsBridge.plugin-catalog-status;
                color: Theme.ink-3;
                font-size: Theme.min-font;
                vertical-alignment: center;
                overflow: elide;
            }
            FormButton {
                label: @tr("btn-reload-plugin-catalog");
                clicked => { SettingsBridge.reload-plugin-catalog(); }
            }
        }
    }
}
