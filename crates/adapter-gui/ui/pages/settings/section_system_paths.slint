// Responsibility: renders the paths section.
// System / Paths section (#513). Rows for each configurable
// directory — presets, plugins, evaluations (#582), backing tracks — each a label +
// current path + Choose…/Reset. Empty path means "use OS default"
// (the resolver handles it). All rows share a fixed-width label
// column so they line up vertically.
//
// #561 adds a row for the plugin catalog: a "Reload" button that
// dispatches `Command::ReloadPluginCatalog`, plus a status text
// showing the post-reload counts. Lives in the same section because
// the action is bound to the plugins directory above it.

import { Theme } from "../../theme.slint";
import { Button } from "std-widgets.slint";
import { SettingsBridge } from "../../settings_globals.slint";

export component SectionSystemPaths inherits Rectangle {
    // Shared label column: at least 140px, wider when a translation needs it.
    private property <length> label-width: max(140px, presets-label.preferred-width,
        plugins-label.preferred-width, evaluations-label.preferred-width,
        backing-tracks-label.preferred-width, catalog-label.preferred-width);

    background: transparent;

    VerticalLayout {
        spacing: 16px;
        alignment: start;

        // ── Presets directory row ─────────────────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 32px;
            presets-label := Text {
                text: @tr("label-presets-path");
                color: Theme.ink;
                font-size: 18px;
                width: root.label-width;
                vertical-alignment: center;
            }
            Text {
                text: SettingsBridge.presets-path == ""
                    ? @tr("placeholder-default-path")
                    : SettingsBridge.presets-path;
                color: SettingsBridge.presets-path == "" ? Theme.ink-2 : Theme.ink;
                font-size: 18px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: @tr("btn-choose-path");
                clicked => { SettingsBridge.pick-presets-path(); }
            }
            Button {
                text: @tr("btn-reset-path");
                clicked => { SettingsBridge.reset-presets-path(); }
            }
        }

        // ── Plugins directory row ─────────────────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 32px;
            plugins-label := Text {
                text: @tr("label-plugins-path");
                color: Theme.ink;
                font-size: 18px;
                width: root.label-width;
                vertical-alignment: center;
            }
            Text {
                text: SettingsBridge.plugins-path == ""
                    ? @tr("placeholder-default-path")
                    : SettingsBridge.plugins-path;
                color: SettingsBridge.plugins-path == "" ? Theme.ink-2 : Theme.ink;
                font-size: 18px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: @tr("btn-choose-path");
                clicked => { SettingsBridge.pick-plugins-path(); }
            }
            Button {
                text: @tr("btn-reset-path");
                clicked => { SettingsBridge.reset-plugins-path(); }
            }
        }

        // ── Evaluations directory row (#582) ──────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 32px;
            evaluations-label := Text {
                text: @tr("label-evaluations-path");
                color: Theme.ink;
                font-size: 18px;
                width: root.label-width;
                vertical-alignment: center;
            }
            Text {
                text: SettingsBridge.evaluations-path == ""
                    ? @tr("placeholder-default-path")
                    : SettingsBridge.evaluations-path;
                color: SettingsBridge.evaluations-path == "" ? Theme.ink-2 : Theme.ink;
                font-size: 18px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: @tr("btn-choose-path");
                clicked => { SettingsBridge.pick-evaluations-path(); }
            }
            Button {
                text: @tr("btn-reset-path");
                clicked => { SettingsBridge.reset-evaluations-path(); }
            }
        }

        // ── Backing tracks directory row ──────────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 32px;
            backing-tracks-label := Text {
                text: @tr("label-backing-tracks-path");
                color: Theme.ink;
                font-size: 18px;
                width: root.label-width;
                vertical-alignment: center;
            }
            Text {
                text: SettingsBridge.backing-tracks-path == ""
                    ? @tr("placeholder-default-path")
                    : SettingsBridge.backing-tracks-path;
                color: SettingsBridge.backing-tracks-path == "" ? Theme.ink-2 : Theme.ink;
                font-size: 18px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: @tr("btn-choose-path");
                clicked => { SettingsBridge.pick-backing-tracks-path(); }
            }
            Button {
                text: @tr("btn-reset-path");
                clicked => { SettingsBridge.reset-backing-tracks-path(); }
            }
        }

        // ── Plugin catalog reload row (#561) ──────────────────────
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 32px;
            catalog-label := Text {
                text: @tr("label-plugin-catalog");
                color: Theme.ink;
                font-size: 18px;
                width: root.label-width;
                vertical-alignment: center;
            }
            Text {
                text: SettingsBridge.plugin-catalog-status == ""
                    ? @tr("status-plugin-catalog-idle")
                    : SettingsBridge.plugin-catalog-status;
                color: SettingsBridge.plugin-catalog-status == "" ? Theme.ink-2 : Theme.ink;
                font-size: 18px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: @tr("btn-reload-plugin-catalog");
                clicked => { SettingsBridge.reload-plugin-catalog(); }
            }
        }
    }
}
