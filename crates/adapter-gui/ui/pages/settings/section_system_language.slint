// Responsibility: renders the language section.
// #398: one captioned field, the language picker, kept narrow — a language
// name never needs the whole pane.

import { Theme } from "../../theme.slint";
import { SettingsBridge } from "../../settings_globals.slint";
import { FieldCaption } from "../../components/field_caption.slint";
import { DropSelect } from "../../components/drop_select.slint";

export component SectionSystemLanguage inherits Rectangle {

    background: transparent;

    VerticalLayout {
        spacing: 6px;
        alignment: start;

        FieldCaption {
            text: @tr("label-language");
        }

        HorizontalLayout {
            alignment: start;

            combo := DropSelect {
                width: 320px;
                model: SettingsBridge.language-options;
                current: SettingsBridge.selected-language-index;
                picked(i) => { SettingsBridge.language-selected(i); }
            }
        }
    }
}
