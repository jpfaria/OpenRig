// Responsibility: renders the MIDI devices section.
// Master-detail content for System / MIDI devices (issue #513). The
// SettingsPage shell renders the section title.
//
// #398: the ports sit in one framed list — a check box to use the port, its
// name, and the alias the rig shows for it in a field on the right.

import { Theme } from "../../theme.slint";
import { SettingsBridge } from "../../settings_globals.slint";
import { CheckMark } from "../../components/check_mark.slint";
import { FormButton, FormButtonKind } from "../../components/form_button.slint";
import { ListBox, ListRow } from "../../components/list_box.slint";
import { TextField } from "../../components/text_field.slint";

export component SectionSystemMidiDevices inherits Rectangle {

    background: transparent;

    VerticalLayout {
        spacing: 10px;
        alignment: start;

        HorizontalLayout {
            alignment: end;

            FormButton {
                icon-only: true;
                kind: FormButtonKind.ghost;
                small: true;
                icon: @image-url("../../modules/surrealism-ui/icons/refresh.svg");
                label: @tr("btn-refresh-devices");
                clicked => { SettingsBridge.refresh-midi-devices(); }
            }
        }

        if SettingsBridge.midi-devices.length == 0 : Text {
            text: @tr("empty-no-midi-devices");
            color: Theme.ink-3;
            font-size: Theme.min-font;
            wrap: word-wrap;
        }

        if SettingsBridge.midi-devices.length > 0 : ListBox {
            for d[i] in SettingsBridge.midi-devices : ListRow {
                divided: i > 0;

                VerticalLayout {
                    alignment: center;
                    toggle := Rectangle {
                        width: 18px;
                        height: 18px;
                        CheckMark { checked: d.enabled; }
                        toggle-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { SettingsBridge.toggle-midi-device(i, !d.enabled); }
                        }
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: d.instance == 0 ? d.name : "\{d.name} (#\{d.instance})";
                    color: d.enabled ? Theme.ink : Theme.ink-2;
                    font-size: Theme.min-font;
                    vertical-alignment: center;
                    overflow: elide;
                }

                VerticalLayout {
                    alignment: center;
                    alias-input := TextField {
                        width: 200px;
                        text: d.alias;
                        placeholder: @tr("placeholder-midi-alias");
                        edited(t) => { SettingsBridge.edit-midi-device-alias(i, t); }
                    }
                }
            }
        }
    }
}
