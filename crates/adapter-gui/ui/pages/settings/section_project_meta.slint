// Responsibility: renders the project metadata section.
// Project / Metadata section (#513). Master-detail content pane —
// the SettingsPage shell renders the title. Holds the project's
// display name, shows the on-disk file path, and exposes an explicit
// "Save project" button. Name edits auto-dispatch UpdateProjectName,
// but the user expects a Save affordance — the button forwards to
// AppWindow.save-project (Command::SaveProject).
//
// #398: captioned fields of one width stacked on the left — the name
// editable, the file read-only — and the save button under them.

import { Theme } from "../../theme.slint";
import { Locale } from "../../locale_globals.slint";
import { SettingsBridge } from "../../settings_globals.slint";
import { FieldCaption } from "../../components/field_caption.slint";
import { TextField } from "../../components/text_field.slint";
import { FormButton } from "../../components/form_button.slint";

export component SectionProjectMeta inherits Rectangle {
    callback save-project();

    background: transparent;

    VerticalLayout {
        spacing: 16px;
        alignment: start;

        VerticalLayout {
            spacing: 6px;
            FieldCaption { text: @tr("label-name"); }
            HorizontalLayout {
                alignment: start;
                name-edit := TextField {
                    width: 420px;
                    text: SettingsBridge.project-name;
                    edited(t) => { SettingsBridge.edit-project-name(t); }
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            FieldCaption { text: @tr("label-file"); }
            HorizontalLayout {
                alignment: start;
                file-field := TextField {
                    width: name-edit.width;
                    read-only: true;
                    text: SettingsBridge.project-path-display;
                    font-family: Locale.mono-font-family;
                    placeholder: @tr("placeholder-project-unsaved");
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            FormButton {
                icon-only: true;
                icon: @image-url("../../assets/save.svg");
                label: @tr("btn-save-project");
                clicked => { root.save-project(); }
            }
        }
    }
}
