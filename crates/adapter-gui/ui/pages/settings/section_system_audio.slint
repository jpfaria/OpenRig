// Responsibility: renders the audio section.
// Master-detail right pane content for System / Audio (issue #513).
// The SettingsPage shell renders the section title; this component only
// renders the body.
//
// #398: every device is a raised card — a check box, the name with its
// channel counts, and the sample rates side by side. A selected device gets a
// second card under it with its buffer and bit depth, also side by side.

import { Theme } from "../../theme.slint";
import { DeviceSelectionItem } from "../../models.slint";
import { SettingsBridge } from "../../settings_globals.slint";
import { SettingsCard } from "../../components/settings_card.slint";
import { CheckMark } from "../../components/check_mark.slint";
import { SegControl } from "../../components/seg_control.slint";
import { FormButton, FormButtonKind } from "../../components/form_button.slint";
import { ElidedText } from "../../components/elided_text.slint";

// Inline helper — not promoted to components/ because it is only used here.
component AudioDeviceRow inherits Rectangle {
    in property <DeviceSelectionItem> device;
    in property <[string]> sample-rate-options;
    in property <[string]> buffer-size-options;
    in property <[string]> bit-depth-options;
    callback toggled(bool);
    callback sample-rate-selected(string);
    callback buffer-size-selected(string);
    callback bit-depth-selected(string);

    pure function sample-rate-index(value: string) -> int {
        return value == "44100" ? 0
            : value == "48000" ? 1
            : value == "88200" ? 2
            : value == "96000" ? 3
            : value == "192000" ? 4
            : 1;
    }

    pure function buffer-size-index(value: string) -> int {
        return value == "32" ? 0
            : value == "64" ? 1
            : value == "128" ? 2
            : value == "256" ? 3
            : value == "512" ? 4
            : value == "1024" ? 5
            : value == "2048" ? 6
            : 3;
    }

    pure function bit-depth-index(value: string) -> int {
        return value == "16" ? 0
            : value == "24" ? 1
            : value == "32" ? 2
            : 2;
    }

    min-height: col.preferred-height;

    col := VerticalLayout {
        spacing: 8px;

        card := SettingsCard {
            height: 64px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    CheckMark { checked: root.device.selected; }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    dev-name := ElidedText {
                        text: root.device.name;
                        color: root.device.selected ? Theme.ink : Theme.ink-2;
                        font-size: 20px;
                        own-hover: false;
                        hovered: device-ta.has-hover && device-ta.absolute-position.y + device-ta.mouse-y < dev-name.absolute-position.y + dev-name.height;
                    }

                    if root.device.input-channels + root.device.output-channels > 0 : ElidedText {
                        text: @tr("label-device-channels {} {}", root.device.input-channels, root.device.output-channels);
                        color: Theme.ink-3;
                        font-size: Theme.min-font;
                        own-hover: false;
                        hovered: device-ta.has-hover && device-ta.absolute-position.y + device-ta.mouse-y >= dev-name.absolute-position.y + dev-name.height;
                    }
                }

                // Always laid out (visible:) so the toggle's hit region can
                // stop where the rates begin.
                rate-box := VerticalLayout {
                    alignment: center;

                    SegControl {
                        visible: root.device.selected;
                        options: root.sample-rate-options;
                        kilohertz: true;
                        label: @tr("label-hz");
                        current: root.sample-rate-index(root.device.sample_rate_text);
                        picked(i) => { root.sample-rate-selected(root.sample-rate-options[i]); }
                    }
                }
            }

            // #581: the toggle stops where the rates begin, so picking a rate
            // never deselects the device.
            device-ta := TouchArea {
                x: 0;
                width: root.device.selected ? rate-box.x - 6px : parent.width;
                mouse-cursor: pointer;
                clicked => { root.toggled(!root.device.selected); }
            }
        }

        if root.device.selected : SettingsCard {
            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;

                        Text {
                            text: @tr("label-buffer");
                            color: Theme.ink;
                            font-size: 20px;
                        }
                        ElidedText {
                            text: @tr("help-buffer-latency");
                            color: Theme.ink-3;
                            font-size: Theme.min-font;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        SegControl {
                            options: root.buffer-size-options;
                            label: @tr("label-buffer");
                            current: root.buffer-size-index(root.device.buffer_size_text);
                            picked(i) => { root.buffer-size-selected(root.buffer-size-options[i]); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    Text {
                        horizontal-stretch: 1;
                        text: @tr("label-bits");
                        color: Theme.ink;
                        font-size: 20px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        SegControl {
                            options: root.bit-depth-options;
                            label: @tr("label-bits");
                            current: root.bit-depth-index(root.device.bit_depth_text);
                            picked(i) => { root.bit-depth-selected(root.bit-depth-options[i]); }
                        }
                    }
                }
            }
        }
    }
}

export component SectionSystemAudio inherits Rectangle {
    in property <[string]> sample-rate-options;
    in property <[string]> buffer-size-options;
    in property <[string]> bit-depth-options;
    callback save-audio-settings();

    background: transparent;

    VerticalLayout {
        spacing: 10px;

        // Re-scan the interfaces; Apply lives in the page footer.
        HorizontalLayout {
            alignment: end;

            FormButton {
                icon-only: true;
                kind: FormButtonKind.ghost;
                small: true;
                icon: @image-url("../../modules/surrealism-ui/icons/refresh.svg");
                label: @tr("btn-refresh-devices");
                clicked => { SettingsBridge.refresh-devices(); }
            }
        }

        for device[index] in SettingsBridge.project-devices : AudioDeviceRow {
            device: device;
            sample-rate-options: root.sample-rate-options;
            buffer-size-options: root.buffer-size-options;
            bit-depth-options: root.bit-depth-options;
            toggled(selected) => { SettingsBridge.toggle-project-device(index, selected); }
            sample-rate-selected(value) => { SettingsBridge.update-project-sample-rate(index, value); }
            buffer-size-selected(value) => { SettingsBridge.update-project-buffer-size(index, value); }
            bit-depth-selected(value) => { SettingsBridge.update-project-bit-depth(index, value); }
        }
    }
}
