// Responsibility: renders the chain editor.
// #398: a dialog — the dark bar with the title, then the name, the instrument
// tiles and the checklist of I/O bindings on the panel, and the footer with
// Cancel and the primary save on the low panel.
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { ChainBindingChoice } from "../models.slint";
import { ToolBar } from "../components/tool_bar.slint";
import { FieldCaption } from "../components/field_caption.slint";
import { TextField } from "../components/text_field.slint";
import { FormButton, FormButtonKind } from "../components/form_button.slint";
import { ListBox, ListRow } from "../components/list_box.slint";
import { CheckMark } from "../components/check_mark.slint";
import { TagPill } from "../components/tag_pill.slint";
import { DialogFoot } from "../components/dialog_foot.slint";
import { ElidedText } from "../components/elided_text.slint";

// One instrument tile: the icon over its name; the picked one has the accent
// ring and an accent icon.
component InstrumentTile inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> on;
    callback clicked();

    // Equal columns, like a grid; a long label only widens its own tile.
    preferred-width: 92px;
    min-width: max(92px, tile-lbl.preferred-width + 16px);
    height: 76px;
    border-radius: 4px;
    background: ta.has-hover && !root.on ? Theme.hover : Theme.field;
    border-width: root.on ? 2px : 1px;
    border-color: root.on ? Theme.accent : Theme.hair;

    Image {
        x: (parent.width - self.width) / 2; y: 12px;
        width: 26px; height: 26px;
        source: root.icon;
        image-fit: contain;
        colorize: root.on ? Theme.accent : Theme.ink-2;
    }

    tile-lbl := Text {
        x: 0; y: 44px;
        width: parent.width; height: 24px;
        text: root.label;
        color: root.on ? Theme.ink : Theme.ink-2;
        font-size: Theme.min-font;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

export component ChainEditorPage inherits Rectangle {
    in property <string> title;
    in property <string> save-label;
    in-out property <string> chain-name;
    // #716: the I/O bindings this chain can select (checklist replaces the old
    // per-endpoint add-input/add-output flow).
    in property <[ChainBindingChoice]> bindings;
    in-out property <string> status-message;
    in property <bool> is-create-mode: true;
    in-out property <int> selected-instrument-index: 0;
    in property <[string]> instrument-labels: [
        @tr("instrument-guitar"),
        @tr("instrument-acoustic-guitar"),
        @tr("instrument-bass"),
        @tr("instrument-voice"),
        @tr("instrument-keyboard"),
        @tr("instrument-drums"),
        @tr("instrument-other"),
    ];
    callback update-chain-name(string);
    callback save-chain();
    callback cancel-chain();
    callback select-instrument(int);
    // #716: toggle whether the chain uses binding at `index` (selected on/off).
    callback toggle-binding(int, bool);

    background: Theme.panel;

    VerticalLayout {
        ToolBar {
            vertical-stretch: 0;
            title: root.is-create-mode ? @tr("title-new-chain") : @tr("title-configure-chain");
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: start;
                padding: 22px;
                spacing: 18px;

                VerticalLayout {
                    spacing: 6px;
                    FieldCaption { text: @tr("label-name"); }
                    TextField {
                        text: root.chain-name;
                        edited(value) => { root.update-chain-name(value); }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    FieldCaption { text: @tr("label-instrument"); }
                    // #954: each tile follows its translated label.
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: stretch;
                        for label[index] in root.instrument-labels : InstrumentTile {
                            horizontal-stretch: 1;
                            label: label;
                            on: index == root.selected-instrument-index;
                            icon: index == 0 ? @image-url("../../../../assets/instruments/electric_guitar.svg")
                                : index == 1 ? @image-url("../../../../assets/instruments/acoustic_guitar.svg")
                                : index == 2 ? @image-url("../../../../assets/instruments/bass.svg")
                                : index == 3 ? @image-url("../../../../assets/instruments/voice.svg")
                                : index == 4 ? @image-url("../../../../assets/instruments/keys.svg")
                                : index == 5 ? @image-url("../../../../assets/instruments/drums.svg")
                                : @image-url("../../../../assets/instruments/generic.svg");
                            clicked => {
                                root.selected-instrument-index = index;
                                root.select-instrument(index);
                            }
                        }
                    }
                }

                // --- I/O bindings checklist (#716) ---
                // The chain SELECTS which I/O bindings it uses; input/output is
                // discovered from those bindings.
                VerticalLayout {
                    spacing: 6px;
                    FieldCaption { text: @tr("label-chain-io-bindings"); }

                    if root.bindings.length == 0 : Text {
                        text: @tr("empty-no-bindings-for-chain");
                        color: Theme.ink-3;
                        font-size: Theme.min-font;
                        wrap: word-wrap;
                    }

                    if root.bindings.length > 0 : ListBox {
                        for choice[index] in root.bindings : chain-binding-cell := Rectangle {
                            min-height: 46px;
                            background: cell-ta.has-hover ? Theme.hover : transparent;

                            ListRow {
                                width: parent.width;
                                height: parent.height;
                                divided: index > 0;

                                VerticalLayout { alignment: center;
                                    CheckMark { checked: choice.selected; } }
                                ElidedText {
                                    horizontal-stretch: 1;
                                    text: choice.name;
                                    color: choice.selected ? Theme.ink : Theme.ink-2;
                                    font-size: Theme.min-font;
                                    font-weight: choice.selected ? 600 : 500;
                                    vertical-alignment: center;
                                    own-hover: false;
                                    hovered: cell-ta.has-hover;
                                }
                                if choice.inputs-label != "" : VerticalLayout { alignment: center;
                                    TagPill { text: @tr("label-pill-in {}", choice.inputs-label); tone: Theme.in; } }
                                if choice.outputs-label != "" : VerticalLayout { alignment: center;
                                    TagPill { text: @tr("label-pill-out {}", choice.outputs-label); tone: Theme.out; } }
                            }

                            cell-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-binding(index, !choice.selected); }
                            }
                            accessible-role: checkbox;
                            accessible-label: choice.name;
                            accessible-checked: choice.selected;
                            accessible-action-default => { root.toggle-binding(index, !choice.selected); }
                        }
                    }
                }
            }
        }

        // Footer: the status at the left, Cancel and the save at the right.
        DialogFoot {
            vertical-stretch: 0;
            alignment: stretch;

            ElidedText {
                horizontal-stretch: 1;
                text: root.status-message;
                color: Theme.accent;
                font-size: Theme.min-font;
                vertical-alignment: center;
            }
            cancel-btn := FormButton {
                icon-only: true;
                icon: @image-url("../assets/close.svg");
                label: @tr("btn-cancel");
                clicked => { root.cancel-chain(); }
            }
            save-btn := FormButton {
                icon-only: true;
                icon: root.is-create-mode ? @image-url("../assets/check.svg") : @image-url("../assets/save.svg");
                kind: FormButtonKind.primary;
                label: root.is-create-mode ? @tr("btn-create-chain") : @tr("btn-save-chain");
                clicked => { root.save-chain(); }
            }
        }
    }
}
