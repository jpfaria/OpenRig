// Responsibility: renders the compact chain view.
import { Theme } from "../theme.slint";
import { ToolBar } from "../components/tool_bar.slint";
import { ToolBarClose } from "../components/tool_bar_close.slint";
import { ScrollView } from "std-widgets.slint";
import { CompactBlockItem, BlockTypePickerItem, BlockModelPickerItem, ChainRigNav, StreamMeter } from "../models.slint";
import { BlockTypeCard, BlockTypeGrid } from "../components/block_value_widgets.slint";
import { CompactBlockRow } from "compact_block_row.slint";
import { CompactChainViewHeader } from "compact_chain_view_header.slint";
import { CompactModelSelectOverlay } from "../components/compact_model_select_overlay.slint";
import { CompactChainSections } from "../components/compact_chain_sections.slint";

import "../fonts/BebasNeue.ttf";

export component CompactChainViewPage inherits Rectangle {
    in property <string> chain-title;
    in property <int> chain-index;
    in property <[CompactBlockItem]> compact-blocks;
    // Measured DSP latency for this chain (#613). >0 ⇒ the badge shows
    // for the probe's 10 s window; mirrors the main chain row's badge so
    // the result renders where the user clicked (the compact view), not
    // only on the chains list behind the overlay.
    in property <float> latency-ms: 0.0;

    // Preset / scene model (same shape the main chains screen uses
    // — issue #436 #1). Empty `preset_labels` ⇒ combobox is hidden.
    in property <ChainRigNav> rig-nav;
    // Per-chain peak meters (#496) — same range as the main row.
    in property <float> meter-in-dbfs: -120.0;
    in property <float> meter-out-dbfs: -120.0;
    // Per-stream IN/OUT meter rows. Empty ⇒ fall back to the single
    // aggregate `meter-in-dbfs` / `meter-out-dbfs` pair so old wiring
    // keeps working. Non-empty ⇒ render one IN/OUT bar per stream
    // (multi-input chains, same shape `ChainRow` uses on the main page).
    in property <[StreamMeter]> stream-meters;
    // Chain output volume %, 0..200 (#440). Hooked to the volume button.
    in property <int> volume: 100;

    // #614: DI loop state for the focused chain — mirrors ProjectChainItem.
    // Populated by the header polling timer (same as volume / enabled).
    in property <bool> di-loop-playing: false;
    in property <[string]> di-loop-sources: [];
    in property <int> di-loop-selected-index: -1;
    in property <[bool]> di-loop-take-rows: []; // deletable takes
    in property <[string]> di-loop-outputs: [];
    in property <int> di-output-selected-index: -1;
    // #717: the DI stream's own INPUT/OUTPUT meter, shown while the DI plays.
    in property <StreamMeter> di-graph-meter;

    in property <bool> chain-enabled;
    callback toggle-chain-enabled(int);
    // #614: DI loop callbacks — forwarded to Rust wiring, targeting the
    // focused chain (chain-index). Same shape as chain_row.slint's 4 callbacks
    // minus the leading chain-index arg (already known by the compact view).
    callback di-loop-source-selected(string);
    callback di-loop-choose-file();
    callback di-loop-play();
    callback di-loop-stop();
    callback di-loop-output-selected(int);
    // #1022: the Doctor section runs and applies on this chain.
    callback tone-doctor-run(int);
    callback tone-doctor-apply(int);
    callback toggle-block-enabled(int, int);
    callback update-block-parameter-number(int, int, string, float);
    callback update-block-parameter-bool(int, int, string, bool);
    callback select-block-parameter-option(int, int, string, int);
    // #787: switch the parameter tab a compact block shows (chain, block, group).
    callback select-block-parameter-group(int, int, int);
    // #787: rows have their own heights, so the drop slot and its indicator come
    // from Rust (`compact_block_layout`) instead of a fixed 112px stride.
    pure callback slot-at(length) -> int;
    pure callback slot-y(int) -> length;
    private property <length> drag-pointer-y;
    callback choose-block-model(int, int, int);
    callback choose-block-model-by-id(int, int, string);
    callback search-block-model(int, int, string);
    callback insert-block(int, int); // chain_index, before_index
    callback reorder-block(int, int, int); // chain_index, from_index, before_index
    callback open-block-detail(int, int);
    callback close-compact-view();
    callback choose-block-type(int, int, int); // chain_index, before_index, type_index
    callback remove-block(int, int); // chain_index, block_index

    // I/O device configuration (reuses the chain list's configure flow)
    callback configure-input(int); // chain_index
    callback configure-output(int); // chain_index
    // Preset & chain admin — mirror the main row's callbacks so the
    // compact view is feature-parity with the chains screen.
    callback switch-chain-preset(int);          // bank slot or sentinel (-1 add, -2 remove)
    callback switch-chain-scene(int);           // scene index or sentinel (-1 add, -2 remove)
    callback rename-chain-preset(string);       // new name typed in the popup
    callback load-chain-preset();
    callback save-chain-preset-as();
    callback configure-chain(int);              // chain config dialog
    callback probe-chain-latency(int);
    callback chain-volume-changed(int, int);    // chain_index, value
    callback remove-chain(int);

    // Type picker state
    in property <[BlockTypePickerItem]> block-type-options;
    private property <bool> show-type-picker: false;
    private property <int> insert-before-index: 0;

    // #761: model-select overlay state — rendered at THIS page's root
    // (below) instead of inside a `CompactBlockRow`'s `PopupWindow`, so it
    // isn't clipped by the row / Flickable. `model-select-array-index` is
    // the position within `compact-blocks` (captured from the `for` loop
    // below at open time) used to read that row's `filtered-models`;
    // `model-select-chain/block-index` are the REAL indices forwarded to
    // `choose-model-by-id`.
    private property <bool> model-select-open: false;
    private property <int> model-select-array-index: -1;
    private property <int> model-select-chain-index: -1;
    private property <int> model-select-block-index: -1;
    private property <length> model-select-x: 0px;
    private property <length> model-select-y: 0px;
    private property <length> model-select-width: 260px;

    // Drag-to-reorder state
    private property <int> dragging-block-index: -1;
    private property <int> drag-hover-before-index: -1;
    private property <float> drag-start-y: 0;
    private property <float> drag-current-y: 0;
    private property <bool> drag-active: false;

    background: Theme.well;

    // Header — preset select + scene bar + chain action cluster.
    // Extracted to `compact_chain_view_header.slint` (file-size cap).
    CompactChainViewHeader {
        z: 10;
        x: 0; y: 0; width: parent.width;
        chain-enabled: root.chain-enabled;
        chain-index: root.chain-index;
        chain-title: root.chain-title;
        rig-nav: root.rig-nav;
        volume: root.volume;
        latency-ms: root.latency-ms;
        toggle-chain-enabled(ci) => { root.toggle-chain-enabled(ci); }
        switch-chain-preset(slot) => { root.switch-chain-preset(slot); }
        switch-chain-scene(s) => { root.switch-chain-scene(s); }
        rename-chain-preset(name) => { root.rename-chain-preset(name); }
        load-chain-preset => { root.load-chain-preset(); }
        save-chain-preset-as => { root.save-chain-preset-as(); }
        chain-volume-changed(ci, v) => { root.chain-volume-changed(ci, v); }
        probe-chain-latency(ci) => { root.probe-chain-latency(ci); }
        configure-chain(ci) => { root.configure-chain(ci); }
        remove-chain(ci) => { root.remove-chain(ci); }
    }

    // Block rows with insert slots between them
    Flickable {
        x: 0; y: 66px;
        width: parent.width;
        // #1022: leave room at the bottom for the section accordion.
        height: parent.height - 66px - sections.total-height;
        // #787: rows have their own heights now — the viewport is exactly the
        // trailing insert slot (the same geometry the drop indicator uses).
        viewport-height: root.slot-y(root.compact-blocks.length);
        interactive: false;

        // Insert slot before first block (invisible until hover)
        Rectangle {
            x: 0; y: 0;
            width: parent.width; height: 12px;

            insert0-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.insert-before-index = 0; root.show-type-picker = true; }
            }

            Rectangle {
                x: 4px; y: 5px;
                width: parent.width - 8px; height: 2px;
                background: Theme.accent;
                border-radius: 1px;
                opacity: insert0-ta.has-hover ? 1.0 : 0.0;
            }
            // #954: the "+" pill is 22px tall for its 18px glyph; it spills
            // below the 12px slot (the Flickable clips anything above y 0).
            Rectangle {
                x: (parent.width - 24px) / 2; y: 0;
                width: 24px; height: 22px;
                border-radius: 11px;
                background: Theme.accent;
                opacity: insert0-ta.has-hover ? 1.0 : 0.0;

                Text {
                    width: 100%; height: 100%;
                    text: @tr("+"); color: Theme.on-accent; font-size: 18px; font-weight: 800;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }

        for block-item[bi] in root.compact-blocks : Rectangle {
            y: block-item.row-y;
            width: parent.width;
            height: block-item.row-height;
            // Dim the row being dragged
            opacity: root.drag-active && root.dragging-block-index == bi ? 0.3 : 1.0;

            // #328: a row inside a split's path is indented by how deep it sits.
            // #398: the rack keeps a 14px gutter on the left for the grip.
            CompactBlockRow {
                x: 14px + block-item.path-depth * 16px;
                width: parent.width - self.x - 8px;
                height: block-item.row-height;
                block-data: block-item;
                toggle-enabled(ci, bi2) => { root.toggle-block-enabled(ci, bi2); }
                update-parameter-number(ci, bi2, p, v) => { root.update-block-parameter-number(ci, bi2, p, v); }
                update-parameter-bool(ci, bi2, p, v) => { root.update-block-parameter-bool(ci, bi2, p, v); }
                select-parameter-option(ci, bi2, p, oi) => { root.select-block-parameter-option(ci, bi2, p, oi); }
                choose-model(ci, bi2, mi) => { root.choose-block-model(ci, bi2, mi); }
                choose-model-by-id(ci, bi2, mid) => { root.choose-block-model-by-id(ci, bi2, mid); }
                search-model(ci, bi2, text) => { root.search-block-model(ci, bi2, text); }
                request-model-popup(ci, bi2, x, y, w) => {
                    root.model-select-open = true;
                    root.model-select-array-index = bi;
                    root.model-select-chain-index = ci;
                    root.model-select-block-index = bi2;
                    root.model-select-x = x;
                    root.model-select-y = y;
                    root.model-select-width = w;
                }
                open-block-detail(ci, bi2) => { root.open-block-detail(ci, bi2); }
                remove-block(ci, bi2) => { root.remove-block(ci, bi2); }
                select-parameter-group(ci, bi2, gi) => { root.select-block-parameter-group(ci, bi2, gi); }
            }

            // Drag handle — a quiet grip in the rack's left gutter, beside the
            // card (below its lane bar).
            Rectangle {
                x: 2px; y: block-item.lane-bar ? 30px : 0px;
                width: 10px; height: parent.height - self.y;
                border-radius: 2px;
                background: drag-ta.has-hover ? Theme.hover : transparent;

                Rectangle { x: 3px; y: parent.height / 2 - 10px; width: 4px; height: 4px; border-radius: 2px; background: drag-ta.has-hover ? Theme.ink-2 : Theme.ink-3; }
                Rectangle { x: 3px; y: parent.height / 2 - 2px;  width: 4px; height: 4px; border-radius: 2px; background: drag-ta.has-hover ? Theme.ink-2 : Theme.ink-3; }
                Rectangle { x: 3px; y: parent.height / 2 + 6px;  width: 4px; height: 4px; border-radius: 2px; background: drag-ta.has-hover ? Theme.ink-2 : Theme.ink-3; }
            }

            drag-ta := TouchArea {
                x: 0; y: block-item.lane-bar ? 30px : 0px;
                width: 14px; height: parent.height - self.y;
                mouse-cursor: grab;

                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down {
                        root.drag-start-y = self.absolute-position.y / 1px + self.mouse-y / 1px;
                        root.drag-current-y = root.drag-start-y;
                        root.dragging-block-index = bi;
                        root.drag-hover-before-index = -1;
                    }
                    if ev.kind == PointerEventKind.up {
                        if root.drag-active && root.drag-hover-before-index >= 0
                            && root.drag-hover-before-index != root.dragging-block-index
                            && root.drag-hover-before-index != root.dragging-block-index + 1 {
                            root.reorder-block(root.chain-index, root.dragging-block-index, root.drag-hover-before-index);
                        }
                        root.dragging-block-index = -1;
                        root.drag-hover-before-index = -1;
                        root.drag-active = false;
                    }
                }

                moved => {
                    if self.pressed && root.dragging-block-index >= 0 {
                        root.drag-current-y = self.absolute-position.y / 1px + self.mouse-y / 1px;
                        let delta = root.drag-current-y - root.drag-start-y;
                        if !root.drag-active && (delta > 8.0 || delta < -8.0) {
                            root.drag-active = true;
                        }
                        if root.drag-active {
                            // #787: rows have different heights, so the target slot
                            // comes from where the pointer sits, not from a fixed
                            // stride: count the rows whose middle it has passed.
                            root.drag-pointer-y = block-item.row-y + block-item.row-height / 2
                                + delta * 1px;
                            root.drag-hover-before-index = root.slot-at(root.drag-pointer-y);
                        }
                    }
                }
            }
        }

        // Drop indicator line (shown during drag)
        if root.drag-active && root.drag-hover-before-index >= 0
            && root.drag-hover-before-index != root.dragging-block-index
            && root.drag-hover-before-index != root.dragging-block-index + 1 : Rectangle {
            x: 8px;
            y: root.slot-y(root.drag-hover-before-index) - 1px;
            width: parent.width - 16px;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.accent;
        }

        // Insert slots after each block
        for block-item[bi] in root.compact-blocks : Rectangle {
            x: 0; y: block-item.row-y + block-item.row-height;
            width: parent.width; height: 12px;
            visible: !root.drag-active;

            insert-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.insert-before-index = bi + 1; root.show-type-picker = true; }
            }

            Rectangle {
                x: 4px; y: 5px;
                width: parent.width - 8px; height: 2px;
                background: Theme.accent;
                border-radius: 1px;
                opacity: insert-ta.has-hover ? 1.0 : 0.0;
            }
            // #954: 22px pill centred on the 12px slot.
            Rectangle {
                x: (parent.width - 24px) / 2; y: (parent.height - 22px) / 2;
                width: 24px; height: 22px;
                border-radius: 11px;
                background: Theme.accent;
                opacity: insert-ta.has-hover ? 1.0 : 0.0;

                Text {
                    width: 100%; height: 100%;
                    text: @tr("+"); color: Theme.on-accent; font-size: 18px; font-weight: 800;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }

    // ── #1022: Mixer, DI, Looper, Doctor and Meters as accordion sections ──
    // Anchored at the bottom; an open section grows upwards over the block
    // list, which always keeps at least 120px.
    sections := CompactChainSections {
        x: 0; y: parent.height - self.total-height;
        width: parent.width; height: self.total-height;
        chain-index: root.chain-index;
        chain-enabled: root.chain-enabled;
        max-body-height: max(120px, parent.height - 66px - 120px - 5 * 36px);
        di-loop-playing: root.di-loop-playing;
        di-loop-sources: root.di-loop-sources;
        di-loop-selected-index: root.di-loop-selected-index;
        di-loop-take-rows: root.di-loop-take-rows;
        di-loop-outputs: root.di-loop-outputs;
        di-output-selected-index: root.di-output-selected-index;
        stream-meters: root.stream-meters;
        meter-in-dbfs: root.meter-in-dbfs;
        meter-out-dbfs: root.meter-out-dbfs;
        di-graph-meter: root.di-graph-meter;
        di-loop-source-selected(s) => { root.di-loop-source-selected(s); }
        di-loop-choose-file => { root.di-loop-choose-file(); }
        di-loop-play => { root.di-loop-play(); }
        di-loop-stop => { root.di-loop-stop(); }
        di-loop-output-selected(i) => { root.di-loop-output-selected(i); }
        tone-doctor-run(ci) => { root.tone-doctor-run(ci); }
        tone-doctor-apply(ci) => { root.tone-doctor-apply(ci); }
    }

    // ── Type picker modal overlay ──
    if root.show-type-picker : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.scrim;

        TouchArea {
            width: 100%; height: 100%;
            clicked => { root.show-type-picker = false; }
        }

        Rectangle {
            property <int> row-count: Math.max(1, Math.floor((root.block-type-options.length - 1) / 4) + 1);
            property <length> content-height: self.row-count * BlockTypeGrid.step - BlockTypeGrid.step + BlockTypeGrid.cell;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 3 * BlockTypeGrid.step + BlockTypeGrid.cell + 56px;
            height: Math.min(parent.height - 80px, self.content-height + 46px + 36px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.hair;
            border-radius: 6px;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.shadow;

            // Swallow clicks on the card so only the scrim closes it.
            TouchArea { }

            // #398: the dialog's dark bar with its title and close cross.
            ToolBar {
                x: 0; y: 0;
                width: parent.width;
                title: @tr("title-add-block");
                ToolBarClose {
                    clicked => { root.show-type-picker = false; }
                }
            }

            ScrollView {
                x: 18px; y: 46px + 18px;
                width: parent.width - 36px;
                height: parent.height - 46px - 36px;
                viewport-height: parent.content-height;

                // Same BlockTypeCard the main chains screen uses (#613) —
                // single source of truth for the tile icons, so VST3 /
                // input / output / insert match across both pickers.
                for type-item[index] in root.block-type-options : BlockTypeCard {
                    x: Math.mod(index, 4) * BlockTypeGrid.step;
                    y: Math.floor(index / 4) * BlockTypeGrid.step;
                    item: type-item;
                    selected: false;
                    clicked => {
                        root.show-type-picker = false;
                        root.choose-block-type(root.chain-index, root.insert-before-index, index);
                    }
                }
            }
        }
    }

    // ── Model-select overlay (#761) — rendered at the page root so it
    // escapes the block row's `clip: true` and the block list's
    // `Flickable`. See the state block above for why `PopupWindow` isn't
    // used (PopupWindow content never received the row click reliably).
    if root.model-select-open : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;

        TouchArea {
            width: 100%; height: 100%;
            clicked => { root.model-select-open = false; }
        }

        CompactModelSelectOverlay {
            x: root.model-select-x - root.absolute-position.x;
            y: root.model-select-y - root.absolute-position.y + 44px;
            width: root.model-select-width;
            filtered-models: root.model-select-array-index >= 0
                && root.model-select-array-index < root.compact-blocks.length
                ? root.compact-blocks[root.model-select-array-index].filtered-models : [];
            selected-model: root.model-select-array-index >= 0
                && root.model-select-array-index < root.compact-blocks.length
                && root.compact-blocks[root.model-select-array-index].model-selected-index >= 0
                && root.compact-blocks[root.model-select-array-index].model-selected-index < root.compact-blocks[root.model-select-array-index].models.length
                ? root.compact-blocks[root.model-select-array-index].models[root.compact-blocks[root.model-select-array-index].model-selected-index]
                : { effect_type: "", model_id: "", label: "", display_name: "", subtitle: "", icon_kind: "", brand: "", type_label: "", panel_bg: Colors.transparent, panel_text: Colors.transparent, brand_strip_bg: Colors.transparent, model_font: "" };
            select(model-id) => {
                root.choose-block-model-by-id(root.model-select-chain-index, root.model-select-block-index, model-id);
                root.model-select-open = false;
            }
            search-text-changed(text) => {
                root.search-block-model(root.model-select-chain-index, root.model-select-block-index, text);
            }
        }
    }
}
