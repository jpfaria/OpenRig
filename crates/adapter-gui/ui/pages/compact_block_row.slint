// Responsibility: renders one block row of the compact view.
import { Theme, Gear } from "../theme.slint";
import { CompactBlockItem } from "../models.slint";
import { EffectTypeIcon } from "../components/effect_type_icon.slint";
import { BrandLogo } from "../components/brand_logo.slint";
import { ModelSelectWithSearch } from "../components/model_select_with_search.slint";
import { PanelKnob } from "../components/panel_knob.slint";
import { ParamTabBar } from "../components/param_tab_bar.slint";
import { BlockStreamMiniDisplay } from "../components/block_stream_mini_display.slint";
import { CurveEditorControl, MultiSliderControl } from "eq_widget.slint";
import { CompactBlockParamStrip } from "compact_block_param_strip.slint";

// Single block row in the compact chain view. Exported so
// CompactChainViewPage (in compact_chain_view.slint) can use it.
//
// #398: a module card. A row that opens a split lane carries the lane bar
// (its icon and colour) on top. The card's side column holds the category strip
// (power, icon, category, badge), then the brand and the model field, then the
// parameter tabs; the knobs read left to right beside it.
export component CompactBlockRow inherits Rectangle {
    in property <CompactBlockItem> block-data;

    // True when the block exposes a graphic/parametric EQ widget. Replaces
    // the generic param strip with the dedicated EQ widget — otherwise
    // per-band enable/type controls render as a 16-widget mess (#342).
    private property <bool> has-eq:
        root.block-data.multi-slider-points.length > 0
        || root.block-data.curve-editor-points.length > 0;
    callback toggle-enabled(int, int);
    callback update-parameter-number(int, int, string, float);
    callback update-parameter-bool(int, int, string, bool);
    callback select-parameter-option(int, int, string, int);
    callback choose-model(int, int, int); // chain_index, block_index, model_index (legacy)
    callback choose-model-by-id(int, int, string); // chain_index, block_index, model_id
    callback search-model(int, int, string); // chain_index, block_index, search_text
    // #761: the model picker's option list can't live inside this row (it's
    // `clip: true`, so the ~320px popup gets cut to the row height). Forward
    // the closed-button's position so the page root can render the list
    // itself, unclipped. (chain_index, block_index, x, y, width)
    callback request-model-popup(int, int, length, length, length);
    callback open-block-detail(int, int);
    callback remove-block(int, int);
    // #787: the block shows one parameter group at a time (chain, block, group).
    callback select-parameter-group(int, int, int);

    private property <bool> has-param-tabs: root.block-data.parameter-groups.length > 1;
    // #328: a split has no model — its card is the strip and its kind only.
    private property <bool> is-split: root.block-data.effect-type == "split";
    private property <bool> bypassed: !root.block-data.enabled;
    private property <color> category: root.block-data.accent-color;

    // #787: the row grows with its parameter strip. `row-height` is computed in
    // Rust (`compact_block_layout`) and already holds the lane bar.
    height: root.block-data.row-height;
    private property <length> lane-h: root.block-data.lane-bar ? 30px : 0px;
    private property <length> card-h: root.height - root.lane-h;
    private property <length> side-w: 340px;
    private property <length> strip-h: 34px;
    private property <length> lines-h: root.block-data.parameter-lines.length * 90px
        + Math.max(0, root.block-data.parameter-lines.length - 1) * 12px;
    private property <length> overlay-h: root.block-data.overlay-lines.length * 90px
        + Math.max(0, root.block-data.overlay-lines.length - 1) * 12px;
    background: transparent;

    // ── Lane bar: the path this row opens ──
    // Told apart by colour and icon, never by a written "PATH A" (#398): the
    // split icon opens a path, the mix icon closes them; the line carries the
    // lane's colour across the row.
    private property <color> lane-color: root.block-data.path-label == "A" ? Theme.accent
        : root.block-data.path-label == "B" ? Theme.c-rvb
        : root.block-data.path-label == "C" ? Theme.c-dly
        : root.block-data.path-label == "" ? Theme.ink-3
        : Theme.c-mod;
    if root.block-data.lane-bar : Rectangle {
        x: 4px;
        y: 0;
        width: root.width - 8px;
        height: root.lane-h;

        lane-icon := Image {
            x: 0;
            y: (parent.height - 6px - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.block-data.path-label != ""
                ? @image-url("../assets/graph-split.svg")
                : @image-url("../assets/graph-mix.svg");
            colorize: root.lane-color;
        }

        Rectangle {
            x: lane-icon.width + 8px;
            y: lane-icon.y + (lane-icon.height - self.height) / 2;
            width: parent.width - self.x;
            height: 1.5px;
            background: root.lane-color;
        }
    }

    // ── The card ──
    Rectangle {
        x: 0;
        y: root.lane-h;
        width: root.width;
        height: root.card-h;
        border-radius: 6px;
        background: Theme.panel;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.shadow;
    }

    card := Rectangle {
        x: 0;
        y: root.lane-h;
        width: root.width;
        height: root.card-h;
        border-radius: 6px;
        background: Theme.panel-hi;
        border-width: 1px;
        border-color: Theme.hair;
        clip: true;

        // ── Side column ──
        Rectangle {
            x: 0;
            y: 0;
            width: root.side-w;
            height: parent.height;
            background: Theme.side-tint;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.hair;
            }

            // Category strip.
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: root.strip-h;
                background: root.bypassed
                    ? @linear-gradient(90deg, Gear.off 0%, Gear.off 100%)
                    : @linear-gradient(90deg, root.category 0%, root.category.darker(0.28) 100%);

                // Power.
                Rectangle {
                    x: 6px;
                    y: (parent.height - 24px) / 2;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: Gear.black.with-alpha(pwr-ta.has-hover ? 0.4 : 0.25);

                    Image {
                        x: 5px;
                        y: 5px;
                        width: 14px;
                        height: 14px;
                        source: @image-url("../assets/power-line.svg");
                        colorize: Gear.white;
                    }

                    pwr-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-enabled(root.block-data.chain-index, root.block-data.block-index);
                        }
                    }
                    accessible-role: button;
                    accessible-label: @tr("compact-block-power");
                }

                EffectTypeIcon {
                    x: 40px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    icon-kind: root.block-data.icon-kind;
                    tint: Gear.white;
                }

                Text {
                    x: 68px;
                    width: parent.width - 68px - badge.width - 16px;
                    height: parent.height;
                    text: root.block-data.display-label;
                    color: Gear.white;
                    font-size: Theme.min-font;
                    font-weight: 700;
                    letter-spacing: 0.12 * Theme.min-font;
                    vertical-alignment: center;
                    overflow: elide;
                }

                badge := Rectangle {
                    visible: root.block-data.type-label != "";
                    x: parent.width - self.width - 8px;
                    y: (parent.height - 22px) / 2;
                    width: root.block-data.type-label == "" ? 0px : badge-text.preferred-width + 10px;
                    height: 22px;
                    border-radius: 2px;
                    background: Gear.black.with-alpha(0.3);

                    badge-text := Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.block-data.type-label.to-uppercase();
                        color: Gear.white;
                        font-size: Theme.min-font;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Identity: brand on the left, the model field (and tabs) beside it.
            Rectangle {
                x: 0;
                y: root.strip-h;
                width: parent.width;
                height: parent.height - root.strip-h;
                opacity: root.bypassed ? 0.45 : 1.0;

                property <length> stack-h: root.has-param-tabs ? 32px + 6px + 30px : 32px;

                Rectangle {
                    x: 12px;
                    y: (parent.height - 40px) / 2;
                    width: 92px;
                    height: 40px;

                    brand-logo := BrandLogo {
                        x: 2px;
                        y: 5px;
                        width: 88px;
                        height: 30px;
                        brand: root.block-data.brand;
                        tint: Theme.ink;
                    }

                    if !brand-logo.has-logo : EffectTypeIcon {
                        x: (parent.width - 28px) / 2;
                        y: (parent.height - 28px) / 2;
                        width: 28px;
                        height: 28px;
                        icon-kind: root.block-data.icon-kind;
                        tint: root.category;
                    }

                    brand-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-block-detail(root.block-data.chain-index, root.block-data.block-index);
                        }
                    }
                }

                if !root.is-split : ModelSelectWithSearch {
                    x: 116px;
                    y: (parent.height - parent.stack-h) / 2;
                    width: parent.width - 116px - 12px;
                    height: 32px;
                    show-badge: false;
                    popup-height: 320px;
                    external-popup: true;
                    filtered-models: root.block-data.filtered-models;
                    selected-model: root.block-data.model-selected-index >= 0
                        && root.block-data.model-selected-index < root.block-data.models.length
                        ? root.block-data.models[root.block-data.model-selected-index]
                        : { effect_type: "", model_id: "", label: "", display_name: "", subtitle: "", icon_kind: "", brand: "", type_label: "", panel_bg: Colors.transparent, panel_text: Colors.transparent, brand_strip_bg: Colors.transparent, model_font: "" };
                    open-requested(x, y, w) => {
                        root.request-model-popup(root.block-data.chain-index, root.block-data.block-index, x, y, w);
                    }
                    select(model-id) => {
                        root.choose-model-by-id(root.block-data.chain-index, root.block-data.block-index, model-id);
                    }
                    search-text-changed(text) => {
                        root.search-model(root.block-data.chain-index, root.block-data.block-index, text);
                    }
                }

                if root.has-param-tabs : ParamTabBar {
                    x: 116px;
                    y: (parent.height - parent.stack-h) / 2 + 32px + 6px;
                    width: parent.width - 116px - 12px;
                    height: 30px;
                    groups: root.block-data.parameter-groups;
                    active: root.block-data.active-parameter-group;
                    select(i) => {
                        root.select-parameter-group(root.block-data.chain-index, root.block-data.block-index, i);
                    }
                }
            }
        }

        // ── Knob area ──
        Rectangle {
            x: root.side-w;
            y: 0;
            width: parent.width - root.side-w;
            height: parent.height;
            opacity: root.bypassed ? 0.45 : 1.0;

            // Curated knob overlays, wrapping across strip lines.
            VerticalLayout {
                visible: root.block-data.knob-overlays.length > 0;
                x: 0;
                y: (parent.height - root.overlay-h) / 2;
                width: parent.width;
                height: root.overlay-h;
                spacing: 12px;

                for line[li] in root.block-data.overlay-lines : HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    padding-left: 14px;
                    padding-right: 14px;
                    height: 90px;

                    for knob[ki] in line.knobs : Rectangle {
                        min-width: 56px;
                        preferred-width: 66px;
                        height: 90px;

                        Text {
                            x: 0; y: 0; width: parent.width; height: 22px;
                            text: knob.label;
                            color: Theme.ink-2;
                            font-size: Theme.knob-caption-font;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        PanelKnob {
                            // Centred on the cell, like the label above it (#915).
                            x: (parent.width - 38px) / 2; y: 26px;
                            width: 38px; height: 62px;
                            value: knob.value;
                            min-val: knob.min_val;
                            max-val: knob.max_val;
                            step: knob.step;
                            path: knob.path;
                            tint: root.category;
                            changed(p, v) => { root.update-parameter-number(root.block-data.chain-index, root.block-data.block-index, p, v); }
                        }
                    }
                }
            }

            // EQ widget (graphic) — replaces the generic param strip.
            if root.has-eq && root.block-data.curve-editor-points.length == 0 : MultiSliderControl {
                x: 14px;
                y: 8px;
                width: parent.width - 58px;
                height: parent.height - 16px;
                points: root.block-data.multi-slider-points;
                update-parameter(p, v) => {
                    root.update-parameter-number(root.block-data.chain-index, root.block-data.block-index, p, v);
                }
            }

            // EQ widget (parametric).
            if root.has-eq && root.block-data.curve-editor-points.length > 0 : CurveEditorControl {
                x: 14px;
                y: 8px;
                width: parent.width - 58px;
                height: parent.height - 16px;
                points: root.block-data.curve-editor-points;
                total-curve: "";
                band-curves: [];
                update-parameter(p, v) => {
                    root.update-parameter-number(root.block-data.chain-index, root.block-data.block-index, p, v);
                }
            }

            // Every parameter of the active tab (#787), left to right.
            CompactBlockParamStrip {
                visible: root.block-data.knob-overlays.length == 0
                    && !root.block-data.has-external-gui
                    && !root.has-eq;
                x: 0;
                y: (parent.height - root.lines-h) / 2;
                width: parent.width;
                height: root.lines-h;
                block-data: root.block-data;
                update-parameter-number(ci, bi, p, v) => { root.update-parameter-number(ci, bi, p, v); }
                update-parameter-bool(ci, bi, p, v) => { root.update-parameter-bool(ci, bi, p, v); }
                select-parameter-option(ci, bi, p, oi) => { root.select-parameter-option(ci, bi, p, oi); }
            }

            // Live readout (tuner pitch, spectrum bars) at the card's right.
            BlockStreamMiniDisplay {
                visible: !root.has-eq;
                x: root.block-data.stream-data.stream-kind == "spectrum" ? 14px : parent.width - self.width - 40px;
                y: 8px;
                width: root.block-data.stream-data.stream-kind == "spectrum"
                    ? parent.width - 58px
                    : Math.min(260px, parent.width / 2);
                height: parent.height - 16px;
                stream-data: root.block-data.stream-data;
                panel-text: Theme.ink;
            }

            // Delete (top-right corner, brighter on hover).
            Rectangle {
                x: parent.width - 32px;
                y: 6px;
                width: 26px;
                height: 26px;
                border-radius: 3px;
                background: del-ta.has-hover ? Theme.bad : transparent;
                opacity: del-ta.has-hover ? 1.0 : 0.6;

                Image {
                    x: 5px; y: 5px; width: 16px; height: 16px;
                    source: @image-url("../assets/trash.svg");
                    image-fit: contain;
                    colorize: del-ta.has-hover ? Theme.hero-fg : Theme.ink-3;
                }

                del-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.remove-block(root.block-data.chain-index, root.block-data.block-index); }
                }
                accessible-role: button;
                accessible-label: @tr("compact-block-remove");
            }
        }
    }
}

// Main page
