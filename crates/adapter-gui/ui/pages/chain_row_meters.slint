// Responsibility: renders one chain card's per-stream peak meters.
//
// Issue #496 / #32 / #36: the IN/OUT bars sit at the FOOTER of the card, one
// full row per stream the chain runs, stacked upward from the original slot so
// the rows never bleed into the next card. #717 adds the DI stream's own row
// above them while the loop plays.

import { ProjectChainItem } from "../models.slint";

export component ChainRowMeters inherits Rectangle {
    in property <ProjectChainItem> chain;
    background: transparent;

    // Issue #496 / #32 / #36: per-chain IN/OUT peak-meter bars,
    // placed at the FOOTER of the chain card — outside the inner
    // routing rectangle so `root.height` (ChainRow height) lands at
    // Per-stream INPUT + OUTPUT bars: one full row per stream the
    // chain runs (label + bar + dB text on left for INPUT and on
    // right for OUTPUT), stacked vertically. User ask 24 May 2026:
    // "eh so ter uma linha dessa para cada guitarra porra". Single-
    // stream chains render one row at the original position; N-stream
    // chains stack UPWARD from there — the LAST stream lands at the
    // original meter slot (y = root.height - 22px), earlier streams
    // above it. Combined with the `(N-1)*22px` height bump above,
    // every row stays inside the card and the rows don't bleed into
    // the next chain card.
    // #717: the DI stream's own IN/OUT meter — one row above the chain's stream
    // rows while the DI plays, with a DI accent so it reads as the DI.
    if root.chain.di_loop_playing : Rectangle {
        x: 0px;
        y: root.height - 22px - root.chain.stream_meters.length * 22px;
        width: root.width;
        height: 16px;

        Rectangle {
            x: 60px; y: 0px; width: 220px; height: 16px;
            Text {
                x: 0px; y: 0px; width: 44px; height: parent.height;
                text: "DI";
                font-size: 8px; font-weight: 800; color: #6e8aff;
                horizontal-alignment: right; vertical-alignment: center;
            }
            Rectangle {
                x: 48px; y: 2px; width: 130px; height: 12px;
                border-width: 1px;
                border-color: root.chain.di_meter.in_dbfs > 0.0 ? #f87171 : #6e8aff66;
                border-radius: 2px;
                background: @linear-gradient(90deg, #facc1560 0%, #facc15 6%, #facc15 35%,
                    #4ade80 50%, #4ade80 88%, #f87171 95%, #f87171 100%);
                Rectangle {
                    x: parent.width * Math.max(0.0, Math.min(1.0, (root.chain.di_meter.in_dbfs + 60.0) / 60.0));
                    width: parent.width * (1.0 - Math.max(0.0, Math.min(1.0, (root.chain.di_meter.in_dbfs + 60.0) / 60.0)));
                    height: parent.height;
                    background: #0b0e13e8;
                }
            }
            Text {
                x: 182px; y: 0px; width: 36px; height: parent.height;
                text: root.chain.di_meter.in_dbfs <= -119.0 ? "—" : Math.round(root.chain.di_meter.in_dbfs) + " dB";
                font-size: 9px; font-weight: 700;
                color: root.chain.di_meter.in_dbfs <= -119.0 ? #6b7280
                     : root.chain.di_meter.in_dbfs > -3.0 ? #f87171
                     : root.chain.di_meter.in_dbfs >= -30.0 ? #4ade80 : #facc15;
                vertical-alignment: center;
            }
        }
        Rectangle {
            x: parent.width - 240px; y: 0px; width: 230px; height: 16px;
            Text {
                x: 0px; y: 0px; width: 50px; height: parent.height;
                text: "DI OUT";
                font-size: 8px; font-weight: 800; color: #6e8aff;
                horizontal-alignment: right; vertical-alignment: center;
            }
            Rectangle {
                x: 54px; y: 2px; width: 130px; height: 12px;
                border-width: 1px;
                border-color: root.chain.di_meter.out_dbfs > 0.0 ? #f87171 : #6e8aff66;
                border-radius: 2px;
                background: @linear-gradient(90deg, #facc1560 0%, #facc15 6%, #facc15 35%,
                    #4ade80 50%, #4ade80 88%, #f87171 95%, #f87171 100%);
                Rectangle {
                    x: parent.width * Math.max(0.0, Math.min(1.0, (root.chain.di_meter.out_dbfs + 60.0) / 60.0));
                    width: parent.width * (1.0 - Math.max(0.0, Math.min(1.0, (root.chain.di_meter.out_dbfs + 60.0) / 60.0)));
                    height: parent.height;
                    background: #0b0e13e8;
                }
            }
            Text {
                x: 188px; y: 0px; width: 40px; height: parent.height;
                text: root.chain.di_meter.out_dbfs <= -119.0 ? "—" : Math.round(root.chain.di_meter.out_dbfs) + " dB";
                font-size: 9px; font-weight: 700;
                color: root.chain.di_meter.out_dbfs <= -119.0 ? #6b7280
                     : root.chain.di_meter.out_dbfs > -3.0 ? #f87171
                     : root.chain.di_meter.out_dbfs >= -30.0 ? #4ade80 : #facc15;
                vertical-alignment: center;
            }
        }
    }

    for stream[i] in root.chain.stream_meters: Rectangle {
        x: 0px;
        y: root.height - 22px - (root.chain.stream_meters.length - 1 - i) * 22px;
        width: root.width;
        height: 16px;

        // ── INPUT (left): label + bar + dB text ──
        Rectangle {
            x: 60px; y: 0px;
            width: 220px; height: 16px;
            Text {
                x: 0px; y: 0px;
                width: 44px; height: parent.height;
                text: "INPUT";
                font-size: 8px;
                font-weight: 700;
                color: #9ca3af;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Rectangle {
                x: 48px; y: 2px;
                width: 130px; height: 12px;
                border-width: 1px;
                border-color: stream.in_dbfs > 0.0 ? #f87171 : #2a313a;
                border-radius: 2px;
                background: @linear-gradient(90deg,
                    #facc1560 0%,
                    #facc15 6%,
                    #facc15 35%,
                    #4ade80 50%,
                    #4ade80 88%,
                    #f87171 95%,
                    #f87171 100%);
                Rectangle {
                    x: parent.width * Math.max(0.0,
                        Math.min(1.0, (stream.in_dbfs + 60.0) / 60.0));
                    y: 0px;
                    width: parent.width * (1.0 - Math.max(0.0,
                        Math.min(1.0, (stream.in_dbfs + 60.0) / 60.0)));
                    height: parent.height;
                    background: #0b0e13e8;
                }
            }
            Text {
                x: 182px; y: 0px;
                width: 36px; height: parent.height;
                text: stream.in_dbfs <= -119.0
                    ? "—"
                    : Math.round(stream.in_dbfs) + " dB";
                font-size: 9px;
                font-weight: 700;
                color: stream.in_dbfs <= -119.0 ? #6b7280
                     : stream.in_dbfs > -3.0     ? #f87171
                     : stream.in_dbfs >= -30.0   ? #4ade80
                     :                              #facc15;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }

        // ── OUTPUT (right): label + bar + dB text ──
        Rectangle {
            x: parent.width - 240px; y: 0px;
            width: 230px; height: 16px;
            Text {
                x: 0px; y: 0px;
                width: 50px; height: parent.height;
                text: "OUTPUT";
                font-size: 8px;
                font-weight: 700;
                color: #9ca3af;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Rectangle {
                x: 54px; y: 2px;
                width: 130px; height: 12px;
                border-width: 1px;
                border-color: stream.out_dbfs > 0.0 ? #f87171 : #2a313a;
                border-radius: 2px;
                background: @linear-gradient(90deg,
                    #facc1560 0%,
                    #facc15 6%,
                    #facc15 35%,
                    #4ade80 50%,
                    #4ade80 88%,
                    #f87171 95%,
                    #f87171 100%);
                Rectangle {
                    x: parent.width * Math.max(0.0,
                        Math.min(1.0, (stream.out_dbfs + 60.0) / 60.0));
                    y: 0px;
                    width: parent.width * (1.0 - Math.max(0.0,
                        Math.min(1.0, (stream.out_dbfs + 60.0) / 60.0)));
                    height: parent.height;
                    background: #0b0e13e8;
                }
            }
            Text {
                x: 188px; y: 0px;
                width: 40px; height: parent.height;
                text: stream.out_dbfs <= -119.0
                    ? "—"
                    : Math.round(stream.out_dbfs) + " dB";
                font-size: 9px;
                font-weight: 700;
                color: stream.out_dbfs <= -119.0 ? #6b7280
                     : stream.out_dbfs > -3.0     ? #f87171
                     : stream.out_dbfs >= -30.0   ? #4ade80
                     :                               #facc15;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }
}
