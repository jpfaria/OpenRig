// Responsibility: renders one chain card's per-stream peak meters.
//
// Issue #496 / #32 / #36: one full row per stream the chain runs, the input
// on the left half and the output on the right half. #398 moves the rows to
// a band under the chain header (the host places this panel); the rows stack
// upward from the band's bottom. #717 adds the DI stream's own row above them
// while the loop plays.

import { Theme } from "../theme.slint";
import { ProjectChainItem } from "../models.slint";
import { ElidedText } from "../components/elided_text.slint";

// The E/S name on a meter.
component MeterName inherits ElidedText {
    font-size: Theme.min-font;
    font-weight: 600;
    color: Theme.ink-2;
    horizontal-stretch: 1;
    vertical-alignment: center;
}

// The direction and channels on a meter, in the direction's colour.
component MeterChannels inherits Text {
    font-size: Theme.min-font;
    font-weight: 700;
    letter-spacing: 1px;
    horizontal-stretch: 0;
    vertical-alignment: center;
}

// One meter: the label (the host's MeterName + MeterChannels), a thin track
// that fills green → yellow → red, and the peak in dB.
component MeterCell inherits Rectangle {
    in property <float> dbfs;
    in property <bool> silent;
    in property <bool> clipping;
    property <float> level: Math.max(0.0, Math.min(1.0, (root.dbfs + 60.0) / 60.0));

    HorizontalLayout {
        spacing: 10px;
        HorizontalLayout {
            width: Math.min(260px, root.width * 0.42);
            spacing: 6px;
            @children
        }
        Rectangle {
            horizontal-stretch: 1;
            track := Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 6px;
                border-radius: 1px;
                background: Theme.groove;
                border-width: root.clipping ? 1px : 0px;
                border-color: Theme.bad;
                clip: true;
                Rectangle {
                    x: 0px;
                    width: parent.width * root.level;
                    height: parent.height;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: track.width;
                        height: parent.height;
                        background: @linear-gradient(90deg, Theme.ok 0%, Theme.ok 70%, Theme.warn 70%, Theme.warn 88%, Theme.bad 88%, Theme.bad 100%);
                    }
                }
            }
        }
        Text {
            width: 64px;
            text: root.silent ? "—" : Math.round(root.dbfs) + " dB";
            font-size: Theme.min-font;
            font-weight: 600;
            color: root.silent ? Theme.ink-3
                 : root.dbfs > -3.0 ? Theme.bad
                 : root.dbfs >= -30.0 ? Theme.ok
                 : Theme.warn;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component ChainRowMeters inherits Rectangle {
    in property <ProjectChainItem> chain;
    // #954: one meter row must hold an 18px label (>= 22px tall). `row-pitch`
    // is the single source for the row step — the host card (`chain_row`)
    // grows by it per stream / DI row.
    out property <length> row-height: 24px;
    out property <length> row-pitch: 28px;
    // The band's own padding around the rows (10 above, 12 below).
    out property <length> frame: 22px;
    property <length> side: 14px;
    property <length> gap: 22px;
    property <length> half: (root.width - 2 * root.side - root.gap) / 2;
    background: Theme.panel-hi;

    Rectangle {
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.hair;
    }

    // #717: the DI stream's own IN/OUT meter — one row above the chain's
    // stream rows while the DI plays, its name in the accent.
    if root.chain.di_loop_playing : Rectangle {
        x: 0px;
        y: root.height - 12px - root.row-pitch - root.chain.stream_meters.length * root.row-pitch;
        width: root.width;
        height: root.row-height;

        MeterCell {
            x: root.side;
            width: root.half;
            dbfs: root.chain.di_meter.in_dbfs;
            silent: root.chain.di_meter.in_dbfs <= -119.0;
            clipping: root.chain.di_meter.in_dbfs > 0.0;
            MeterName { text: "DI"; }
            MeterChannels { text: "IN"; color: Theme.accent; }
        }
        MeterCell {
            x: root.side + root.half + root.gap;
            width: root.half;
            dbfs: root.chain.di_meter.out_dbfs;
            silent: root.chain.di_meter.out_dbfs <= -119.0;
            clipping: root.chain.di_meter.out_dbfs > 0.0;
            MeterName { text: "DI"; }
            MeterChannels { text: "OUT"; color: Theme.accent; }
        }
    }

    // Per-stream INPUT + OUTPUT bars: one full row per stream, stacked
    // UPWARD from the band's bottom — the LAST stream lands on the bottom
    // row, earlier streams above it.
    for stream[i] in root.chain.stream_meters: Rectangle {
        x: 0px;
        y: root.height - 12px - root.row-pitch - (root.chain.stream_meters.length - 1 - i) * root.row-pitch;
        width: root.width;
        height: root.row-height;

        // #1006: each input is listed once; its other outputs only fill
        // the right half.
        if !stream.in_repeated : MeterCell {
            x: root.side;
            width: root.half;
            dbfs: stream.in_dbfs;
            silent: stream.in_dbfs <= -119.0;
            clipping: stream.in_dbfs > 0.0;
            in-name := MeterName { text: stream.in_label; }
            in-channels := MeterChannels {
                text: stream.in_channels == "" ? "IN" : "IN " + stream.in_channels;
                color: Theme.in;
            }
        }
        MeterCell {
            x: root.side + root.half + root.gap;
            width: root.half;
            dbfs: stream.out_dbfs;
            silent: stream.out_dbfs <= -119.0;
            clipping: stream.out_dbfs > 0.0;
            out-name := MeterName { text: stream.out_label; }
            out-channels := MeterChannels {
                text: stream.out_channels == "" ? "OUT" : "OUT " + stream.out_channels;
                color: Theme.out;
            }
        }
    }
}
