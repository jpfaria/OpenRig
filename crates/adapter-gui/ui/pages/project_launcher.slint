// Responsibility: renders the launcher page.
import { ScrollView } from "std-widgets.slint";
import { RecentProjectItem } from "../models.slint";
import { AppVersionBadge } from "../components/app_version_badge.slint";
import { Theme } from "../theme.slint";

component LauncherButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();

    // #954: the button follows its translated label.
    width: max(primary ? 156px : 150px, lbl.preferred-width + 24px);
    height: 40px;
    background: primary ? Theme.accent : Theme.chrome-2;
    border-width: 1px;
    border-color: primary ? Theme.accent : Theme.hero-line;
    border-radius: 4px;

    lbl := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.primary ? Theme.on-accent : Theme.hero-fg;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 18px;
        font-weight: 600;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component IconLauncherButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    callback clicked();

    width: 40px;
    height: 40px;
    background: Theme.chrome-2;
    border-width: 1px;
    border-color: Theme.hero-line;
    border-radius: 4px;

    Image {
        x: 10px;
        y: 10px;
        width: 20px;
        height: 20px;
        source: root.icon;
        image-fit: contain;
        colorize: Theme.hero-fg-2;
    }

    hover-area := TouchArea {
        clicked => { root.clicked(); }
    }

    // Tooltip below — launcher header sits at the top of the page (#329).
    // #954: the tooltip follows its translated text, centred under the button.
    if hover-area.has-hover && root.tooltip != "" : Rectangle {
        x: (root.width - self.width) / 2;
        y: 44px;
        width: max(76px, tip-lbl.preferred-width + 12px);
        height: 24px;
        background: Theme.chrome;
        border-width: 1px;
        border-color: Theme.chrome-line;
        border-radius: 4px;
        z: 50;

        tip-lbl := Text {
            x: 6px;
            y: 0px;
            width: parent.width - 12px;
            height: parent.height;
            text: root.tooltip;
            color: Theme.chrome-fg;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component RecentProjectRow inherits Rectangle {
    in property <int> original-index;
    in property <string> title;
    in property <string> subtitle;
    callback open(int);
    callback remove(int);

    height: 74px;
    background: main-area.has-hover ? Theme.hover : transparent;

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hair-2;
    }

    Rectangle {
        x: 16px;
        y: 19px;
        width: 18px;
        height: 18px;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.field-line;
        border-radius: 3px;

        Rectangle { x: 4px; y: 4px; width: 3px; height: 3px; background: Theme.ink-3; border-radius: 1.5px; }
        Rectangle { x: 10px; y: 10px; width: 3px; height: 3px; background: Theme.ink-2; border-radius: 1.5px; }
    }

    Text {
        x: 46px;
        y: 12px;
        width: parent.width - 148px;
        height: 24px;
        text: root.title;
        color: Theme.ink;
        font-size: 18px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 46px;
        y: 38px;
        width: parent.width - 148px;
        height: 22px;
        text: root.subtitle;
        color: Theme.ink-3;
        font-size: 18px;
        vertical-alignment: center;
        overflow: elide;
    }

    Image {
        x: parent.width - 30px;
        y: 21px;
        width: 18px;
        height: 18px;
        source: @image-url("../assets/trash.svg");
        colorize: Theme.ink-3;
    }

    main-area := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width - 44px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.open(root.original-index); }
    }

    delete-area := TouchArea {
        x: parent.width - 38px;
        y: 17px;
        width: 28px;
        height: 28px;
        mouse-cursor: pointer;
        clicked => { root.remove(root.original-index); }
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    callback changed(string);

    height: 34px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.field-line;
    border-radius: 4px;
    clip: true;

    if root.text == "" : Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: @tr("placeholder-search-projects");
        color: Theme.ink-3;
        vertical-alignment: center;
        font-size: 18px;
    }

    TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: Theme.ink;
        single-line: true;
        vertical-alignment: center;
        font-size: 18px;
        edited => {
            root.text = self.text;
            root.changed(self.text);
        }
    }
}

export component ProjectLauncherPage inherits Rectangle {
    in property <[RecentProjectItem]> recent-projects;
    in-out property <string> status-message;
    in-out property <string> recent-project-search;
    in property <string> app-version;
    callback open-project-file();
    callback create-project-file();
    callback open-recent-project(int);
    callback remove-recent-project(int);
    callback filter-recent-projects(string);
    in property <[string]> language-options;
    in property <[string]> language-codes;
    in property <int> selected-language-index;
    callback change-language(int);

    background: Theme.hero-bg;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.hero-bg;

        Image {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/launcher-block-bg.jpg");
            image-fit: cover;
            opacity: 1;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(180deg, Theme.hero-shade-top 0%, Theme.hero-shade-mid 38%, Theme.hero-shade-bottom 100%);
        }
    }

    Rectangle {
        x: 24px;
        y: 18px;
        width: parent.width - 48px;
        height: 52px;
        background: transparent;

        Image {
            x: 0px;
            y: -4px;
            width: 68px;
            height: 68px;
            source: @image-url("../assets/openrig-logomark.svg");
            image-fit: contain;
        }

        Image {
            x: 40px;
            y: 2px;
            width: 210px;
            height: 52px;
            source: @image-url("../assets/openrig-logotype.png");
            image-fit: contain;
        }

        IconLauncherButton {
            x: new-btn.x - 16px - self.width;
            y: 6px;
            icon: @image-url("../assets/open-file.svg");
            tooltip: @tr("tooltip-open-project");
            clicked => { root.open-project-file(); }
        }

        new-btn := LauncherButton {
            x: parent.width - 56px - self.width;
            y: 6px;
            label: @tr("btn-new-project");
            primary: true;
            clicked => { root.create-project-file(); }
        }
    }

    Rectangle {
        x: 24px;
        y: 78px;
        width: parent.width - 48px;
        height: 1px;
        background: Theme.hero-line;
    }

    if root.app-version != "" : AppVersionBadge {
        x: parent.width - 16px - self.width;
        y: parent.height - 2px - self.height;
        height: 26px;
        version: root.app-version;
    }

    Rectangle {
        x: 24px;
        y: 96px;
        width: parent.width - 48px;
        height: parent.height - 126px;
        background: Theme.panel.with-alpha(0.92);
        border-width: 1px;
        border-color: Theme.hair;
        border-radius: 6px;

        SearchField {
            x: 18px;
            y: 16px;
            width: 260px;
            text: root.recent-project-search;
            changed(text) => {
                root.recent-project-search = text;
                root.filter-recent-projects(text);
            }
        }

        Rectangle {
            x: 18px;
            y: 62px;
            width: parent.width - 36px;
            height: 1px;
            background: Theme.hair-2;
        }

        ScrollView {
            x: 18px;
            y: 64px;
            width: parent.width - 36px;
            height: parent.height - 82px;
            viewport-height: recent-projects.length * 74px;

            for recent[index] in root.recent-projects : RecentProjectRow {
                y: index * 74px;
                width: parent.width - 2px;
                original-index: recent.original_index;
                title: recent.title;
                subtitle: recent.subtitle;
                open(index) => { root.open-recent-project(index); }
                remove(index) => { root.remove-recent-project(index); }
            }
        }
    }

    // Global LanguageSelector removed (#513) — language now lives only
    // inside Settings → Language. The launcher no longer needs a floating
    // top-corner picker.
}
