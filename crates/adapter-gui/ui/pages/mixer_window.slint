// Responsibility: renders the global mixer window.
// #1007 — one strip per input and output endpoint configured in the I/O
// bindings, one tab per side (inputs, outputs). Header mirrors the metronome's; the body scrolls
// sideways when a machine has more endpoints than the window is wide.
//
// The panel reads its state from `MixerBridge`, so the same component serves
// the standalone window and the inline (fullscreen/touch) placement.

import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { MixerBridge, MixerStripRow } from "../components/mixer_globals.slint";
import { MixerSection } from "../components/mixer_section.slint";
import { ParamTabBar } from "../components/param_tab_bar.slint";
import { ToolBar } from "../components/tool_bar.slint";
import { Locale } from "../locale_globals.slint";
import { WindowBoundsProbe } from "../components/window_bounds.slint";
import { HoverTipLayer } from "../components/hover_tip_layer.slint";

export component MixerPanel inherits Rectangle {
    // The inline overlay needs a close button; the standalone window closes via
    // its own chrome.
    in property <bool> show-close-button: false;

    // 0 = inputs tab, 1 = outputs tab.
    private property <int> tab: 0;
    private property <[MixerStripRow]> shown: root.tab == 0 ? MixerBridge.inputs : MixerBridge.outputs;
    // The host window fits its width to this (`mixer_window_size.rs`).
    out property <int> shown-count: root.shown.length;
    private property <length> bar-height: 46px;
    private property <length> tabs-height: 44px;
    private property <length> body-top: root.bar-height + root.tabs-height;

    background: Theme.well;

    ToolBar {
        x: 0; y: 0;
        width: parent.width; height: root.bar-height;
        icon: @image-url("../assets/mixer-faders.svg");
        icon-tint: Theme.chrome-fg-2;
        title: @tr("label-mixer");

        if root.show-close-button : Rectangle {
            width: 30px;
            border-radius: 4px;
            background: close-ta.has-hover ? Theme.chrome-2 : transparent;

            Image {
                x: (parent.width - 14px) / 2; y: (parent.height - 14px) / 2;
                width: 14px; height: 14px;
                source: @image-url("../assets/close.svg");
                colorize: close-ta.has-hover ? Theme.chrome-fg : Theme.chrome-fg-2;
            }

            close-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { MixerBridge.close-mixer(); }
            }

            accessible-role: button;
            accessible-label: @tr("btn-close");
            accessible-action-default => { MixerBridge.close-mixer(); }
        }
    }

    // ── Tabs — one side at a time ────────────────────────────────────────
    ParamTabBar {
        x: 0; y: root.bar-height;
        width: parent.width; height: root.tabs-height;
        groups: [@tr("label-mixer-inputs"), @tr("label-mixer-outputs")];
        active: root.tab;
        boxed: true;
        display: true;
        select(i) => { root.tab = i; }
    }

    // ── Empty state — nothing on this side to mix ────────────────────────
    if root.shown.length == 0 : Text {
        x: 24px; y: root.body-top;
        width: parent.width - 48px; height: parent.height - root.body-top;
        text: @tr("status-mixer-no-endpoints");
        color: Theme.ink-3;
        font-size: Theme.min-font;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // ── Strips of the active tab, on the well ────────────────────────────
    Rectangle {
        x: 0; y: root.body-top;
        width: parent.width; height: parent.height - root.body-top;
        background: Theme.well;

        ScrollView {
            x: 16px; y: 14px;
            width: parent.width - 32px;
            height: parent.height - 28px;
            viewport-width: max(self.width, root.shown.length * 120px);
            viewport-height: self.height;

            MixerSection {
                x: 0; y: 0;
                width: root.shown.length * 120px;
                height: parent.height - 12px;
                strips: root.shown;
            }
        }
    }
}

export component MixerWindow inherits Window {
    icon: @image-url("../assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 18px;
    title: @tr("title-window-mixer");
    min-width: 360px;
    min-height: 520px;
    preferred-width: 720px;
    preferred-height: 600px;
    background: Theme.page;

    out property <int> shown-strip-count: panel.shown-count;

    panel := MixerPanel {
        width: 100%;
        height: 100%;
        show-close-button: false;
    }

    WindowBoundsProbe { }
    HoverTipLayer { }
}
