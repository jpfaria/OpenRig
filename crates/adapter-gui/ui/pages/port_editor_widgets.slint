// Responsibility: renders the footer button the port editors share.
import { Theme } from "../theme.slint";
// Footer button shared by the I/O port editor (#85). Same visual language as
// the insert editor's footer.

export component PortEditorFooterButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();

    // #954: the button follows its translated label.
    width: max(96px, lbl.preferred-width + 24px);
    height: 36px;
    background: root.primary ? Theme.accent : Theme.panel-hi;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.field-line;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    lbl := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 18px;
        font-weight: 700;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
