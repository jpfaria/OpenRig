// Responsibility: renders the settings page.
// Settings rendered as a master-detail panel (issue #513): the section list
// on the left, the chosen section on the right.
//
// #398: a dark bar titled SETTINGS with a close cross; the list is a darker
// rail with a scope label per group and an icon per section, the chosen one
// lit by an accent edge; the section name is a display heading, with the
// section's primary action at the right end of its row; Close and Apply sit
// in a footer strip under the content.

import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { SectionSystemAudio } from "settings/section_system_audio.slint";
import { SectionSystemLanguage } from "settings/section_system_language.slint";
import { SectionSystemAppearance } from "settings/section_system_appearance.slint";
import { SectionSystemMidiDevices } from "settings/section_system_midi_devices.slint";
import { SectionSystemIntegrations } from "settings/section_system_integrations.slint";
import { SectionSystemPaths } from "settings/section_system_paths.slint";
import { SectionProjectMeta } from "settings/section_project_meta.slint";
import { SectionSystemIoBindings } from "settings/section_io_bindings.slint";
import { ToolBar } from "../components/tool_bar.slint";
import { ToolBarClose } from "../components/tool_bar_close.slint";
import { FormButton, FormButtonKind } from "../components/form_button.slint";
import { Locale } from "../locale_globals.slint";
import { SettingsBridge } from "../settings_globals.slint";
import { ElidedText } from "../components/elided_text.slint";

// A group label of the rail (SYSTEM, PROJECT).
component NavScope inherits Rectangle {
    in property <string> text;
    in property <length> gap-above: 0;

    height: 34px + root.gap-above;

    ElidedText {
        x: 16px; y: root.gap-above;
        width: parent.width - 32px; height: 34px;
        text: root.text;
        color: Theme.ink-3;
        font-size: Theme.min-font;
        letter-spacing: 0.14 * Theme.min-font;
        vertical-alignment: center;
    }
}

// One section of the rail: its icon and name; the chosen one sits on the
// content's colour with an accent edge.
component NavRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    height: 40px;
    // The row asks for its label's full width so the rail grows to fit the
    // longest translated section name instead of eliding it.
    min-width: nav-label.preferred-width + 60px;
    background: root.selected ? Theme.panel : ta.has-hover ? Theme.hover : transparent;

    if root.selected : Rectangle {
        x: 0; y: 0;
        width: 3px; height: parent.height;
        background: Theme.accent;
    }

    Image {
        x: 16px; y: (parent.height - 18px) / 2;
        width: 18px; height: 18px;
        source: root.icon;
        colorize: root.selected ? Theme.accent : Theme.ink-3;
    }

    nav-label := ElidedText {
        x: 44px; y: 0;
        width: parent.width - 52px; height: parent.height;
        text: root.label;
        color: root.selected ? Theme.ink : Theme.ink-2;
        font-size: Theme.min-font;
        letter-spacing: 0.04 * Theme.min-font;
        vertical-alignment: center;
        own-hover: false;
        hovered: ta.has-hover;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

export component SettingsPage inherits Rectangle {
    // Anchor a min size so the inner layouts can resolve without
    // bubbling preferred-width upward (which produces binding loops
    // through the ScrollView content-width).
    min-width: 720px;
    min-height: 480px;
    preferred-width: 960px;
    preferred-height: 640px;

    // ── Forwarded property surface (UNCHANGED from previous version) ──
    // Kept for callsite compatibility — the old layout used these to
    // edit the project name at the top of the page. The new layout
    // edits the name from SectionProjectMeta via `edit-project-name`.
    in-out property <string> project-name-draft;
    in-out property <string> status-message;

    in property <[string]> sample-rate-options;
    in property <[string]> buffer-size-options;
    in property <[string]> bit-depth-options;
    // Retained for callsite compatibility (old top-of-page FieldBox).
    callback update-project-name(string);
    callback save-audio-settings();
    // Project / Metadata "Save project" button (#513). Forwards to the
    // app-level save-project callback so Settings can trigger the same
    // Command::SaveProject path the toolbar Save button uses.
    callback save-project();
    callback close-settings();

    // Active section index (sidebar selection). 0 = Audio, default.
    in-out property <int> selected-section: 0;
    // The I/O binding opened on the bindings page, so the title row's
    // "New binding" can open the one it creates.
    private property <string> io-expanded-binding: "";

    background: Theme.panel;

    // The new binding lands at the end of the list: once the list has laid
    // it out (the next tick, not inside the click), bring it into view.
    scroll-to-end := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            section-scroll.content-y = min(0px, section-scroll.visible-height - section-scroll.content-height);
        }
    }

    VerticalLayout {
        ToolBar {
            title: @tr("title-settings");

            ToolBarClose {
                clicked => { root.close-settings(); }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // ── Rail ───────────────────────────────────────────────────
            Rectangle {
                min-width: 210px;
                horizontal-stretch: 0;
                background: Theme.panel-lo;

                Rectangle {
                    x: parent.width - 1px; y: 0;
                    width: 1px; height: parent.height;
                    background: Theme.hair;
                }

                VerticalLayout {
                    padding-top: 8px;
                    padding-right: 1px;
                    spacing: 2px;
                    alignment: start;

                    NavScope { text: @tr("nav-group-system"); }
                    NavRow {
                        icon: @image-url("../assets/nav-audio.svg");
                        label: @tr("title-section-audio-interface");
                        selected: root.selected-section == 0;
                        clicked => { root.selected-section = 0; }
                    }
                    NavRow {
                        icon: @image-url("../assets/nav-io.svg");
                        label: @tr("title-section-io-bindings");
                        selected: root.selected-section == 6;
                        clicked => { root.selected-section = 6; }
                    }
                    NavRow {
                        icon: @image-url("../assets/globe.svg");
                        label: @tr("title-section-language");
                        selected: root.selected-section == 1;
                        clicked => { root.selected-section = 1; }
                    }
                    NavRow {
                        icon: @image-url("../assets/nav-appearance.svg");
                        label: @tr("title-section-appearance");
                        selected: root.selected-section == 7;
                        clicked => { root.selected-section = 7; }
                    }
                    NavRow {
                        icon: @image-url("../assets/nav-midi.svg");
                        label: @tr("title-section-midi-devices");
                        selected: root.selected-section == 2;
                        clicked => { root.selected-section = 2; }
                    }
                    NavRow {
                        icon: @image-url("../assets/open-file.svg");
                        label: @tr("title-section-paths");
                        selected: root.selected-section == 3;
                        clicked => { root.selected-section = 3; }
                    }
                    NavRow {
                        icon: @image-url("../assets/nav-integrations.svg");
                        label: @tr("title-section-integrations");
                        selected: root.selected-section == 5;
                        clicked => { root.selected-section = 5; }
                    }
                    NavScope { gap-above: 12px; text: @tr("nav-group-project"); }
                    NavRow {
                        icon: @image-url("../assets/nav-meta.svg");
                        label: @tr("title-section-project-meta");
                        selected: root.selected-section == 4;
                        clicked => { root.selected-section = 4; }
                    }
                }
            }

            // ── Content ────────────────────────────────────────────────
            VerticalLayout {
                horizontal-stretch: 1;

                VerticalLayout {
                    vertical-stretch: 1;
                    padding-top: 20px;
                    padding-bottom: 12px;
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 14px;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 16px;

                        section-title := Text {
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            text:
                                root.selected-section == 0 ? @tr("title-section-audio-interface")
                                : root.selected-section == 1 ? @tr("title-section-language")
                                : root.selected-section == 2 ? @tr("title-section-midi-devices")
                                : root.selected-section == 3 ? @tr("title-section-paths")
                                : root.selected-section == 5 ? @tr("title-section-integrations")
                                : root.selected-section == 6 ? @tr("title-section-io-bindings")
                                : root.selected-section == 7 ? @tr("title-section-appearance")
                                : @tr("title-section-project-meta");
                            color: Theme.ink;
                            font-family: Locale.display-font-family;
                            font-size: 26px;
                            letter-spacing: 0.05 * 26px;
                        }

                        if root.selected-section == 6 : VerticalLayout {
                            alignment: center;
                            new-binding-btn := FormButton {
                                icon-only: true;
                                icon: @image-url("../assets/plus.svg");
                                label: @tr("btn-new-binding");
                                clicked => {
                                    root.io-expanded-binding = SettingsBridge.create-io-binding("");
                                    scroll-to-end.running = true;
                                }
                            }
                        }
                    }

                    // Over-tall sections scroll inside the pane.
                    section-scroll := ScrollView {
                        vertical-stretch: 1;

                        // A ScrollView only auto-sizes its viewport (and thus
                        // scrolls) when its DIRECT child is a single layout;
                        // `alignment: start` makes it report the sections'
                        // preferred height instead of stretching them.
                        VerticalLayout {
                            alignment: start;
                            padding-right: 8px;

                            if root.selected-section == 0 : SectionSystemAudio {
                                sample-rate-options: root.sample-rate-options;
                                buffer-size-options: root.buffer-size-options;
                                bit-depth-options: root.bit-depth-options;
                                save-audio-settings => { root.save-audio-settings(); }
                            }
                            if root.selected-section == 1 : SectionSystemLanguage {}
                            if root.selected-section == 7 : SectionSystemAppearance {}
                            if root.selected-section == 2 : SectionSystemMidiDevices {}
                            if root.selected-section == 3 : SectionSystemPaths {}
                            if root.selected-section == 5 : SectionSystemIntegrations {}
                            if root.selected-section == 6 : SectionSystemIoBindings {
                                expanded-binding-id <=> root.io-expanded-binding;
                            }
                            if root.selected-section == 4 : SectionProjectMeta {
                                save-project => { root.save-project(); }
                            }
                        }
                    }
                }

                // Footer strip: Apply only on the Audio section — the one
                // that needs an explicit save (runtime restart).
                Rectangle {
                    height: 58px;
                    background: Theme.panel-lo;

                    Rectangle {
                        x: 0; y: 0;
                        width: parent.width; height: 1px;
                        background: Theme.hair;
                    }

                    HorizontalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;
                        padding-left: 22px;
                        padding-right: 22px;
                        spacing: 8px;
                        alignment: end;

                        FormButton {
                            icon-only: true;
                            icon: @image-url("../assets/close.svg");
                            label: @tr("btn-close");
                            clicked => { root.close-settings(); }
                        }
                        if root.selected-section == 0 : FormButton {
                            icon-only: true;
                            icon: @image-url("../assets/save.svg");
                            kind: FormButtonKind.primary;
                            label: @tr("btn-save-audio-settings");
                            clicked => { root.save-audio-settings(); }
                        }
                    }
                }
            }
        }
    }
}
