// Responsibility: renders the tuner window.
// TunerWindow — top-bar feature replacing the chromatic_tuner plugin block.
// One row per active input channel of each enabled chain.
//
// #398: a dark tool bar with MUTE and POWER pills, then one LCD per input on
// the well. Each LCD reads like a strobe tuner: the input and its pitch across
// the top, a cents scale with a lit needle, and the note large on the right.
// Amber while tuning, green in tune, dim with no signal.
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { AnalyzerBridge } from "../analyzer_globals.slint";
import { TunerRow } from "../analyzer_rows.slint";
import { LcdGlass } from "../components/lcd_glass.slint";
import { ToolBar } from "../components/tool_bar.slint";
import { ToolBarClose } from "../components/tool_bar_close.slint";
import { PillSwitch } from "../components/pill_switch.slint";
export { TunerRow }

// ── One input's LCD ──────────────────────────────────────────────────────
component TunerCard inherits Rectangle {
    in property <TunerRow> data;

    property <bool> in-tune: data.active && Math.abs(data.cents) < 5.0;
    property <color> lit: !data.active ? Theme.lcd-off : in-tune ? Theme.lcd-in : Theme.lcd-glow;
    property <length> note-w: 120px;
    property <length> scale-h: 80px;
    // The ticks stand on this line; the scale's numbers sit under it.
    property <length> base: scale-h - 22px;

    height: 136px;

    LcdGlass {
        width: 100%;
        height: 100%;

        hz := Text {
            x: parent.width - 16px - self.width; y: 10px;
            width: self.preferred-width; height: 22px;
            text: !root.data.active || root.data.frequency <= 0.0
                ? "— Hz"
                : (root.data.cents > 0 ? "+" : "") + Math.round(root.data.cents) + " ct · "
                    + Math.round(root.data.frequency * 100) / 100 + " Hz";
            color: Theme.lcd-dim;
            font-family: "Bebas Neue";
            font-size: Theme.min-font;
            letter-spacing: 0.08 * Theme.min-font;
            vertical-alignment: center;
        }

        Text {
            x: 16px; y: 10px;
            width: parent.width - 42px - hz.width; height: 22px;
            text: root.data.label;
            color: Theme.lcd-dim;
            font-family: "Bebas Neue";
            font-size: Theme.min-font;
            letter-spacing: 0.08 * Theme.min-font;
            vertical-alignment: center;
            overflow: elide;
        }

        // The cents scale: 21 ticks from -50 to +50, every fifth one taller.
        Rectangle {
            x: 16px; y: 42px;
            width: parent.width - 32px - root.note-w;
            height: root.scale-h;

            for t[i] in 21 : Rectangle {
                x: parent.width * i / 20 - 0.5px;
                y: root.base - self.height;
                width: 1px;
                height: Math.mod(i, 5) != 0 ? 10px : (i == 10 ? 40px : 20px);
                background: i == 10 ? Theme.lcd-faint : Theme.lcd-off;
            }

            for v in [-50, -25, 0, 25, 50] : Text {
                x: parent.width * (v + 50) / 100 - self.width / 2;
                y: root.base + 1px;
                width: self.preferred-width; height: 22px;
                text: (v > 0 ? "+" : "") + v;
                color: Theme.lcd-faint;
                font-family: "Bebas Neue";
                font-size: Theme.min-font;
            }

            if root.data.active : Rectangle {
                x: parent.width * (Math.clamp(root.data.cents, -50.0, 50.0) + 50) / 100 - 1.5px;
                y: root.base - 54px;
                width: 3px; height: 54px;
                border-radius: 2px;
                background: root.lit;
                drop-shadow-blur: 8px;
                drop-shadow-color: root.lit;
            }
        }

        // The note, large, with its octave raised beside it.
        Rectangle {
            x: parent.width - 16px - root.note-w; y: 36px;
            width: root.note-w; height: parent.height - 46px;

            property <length> pair-w: note.width + 2px + octave.width;

            note := Text {
                x: (parent.width - parent.pair-w) / 2; y: 0;
                width: self.preferred-width; height: parent.height;
                text: root.data.active ? root.data.note : "—";
                color: root.lit;
                font-family: "Bebas Neue";
                font-size: 64px;
                vertical-alignment: center;
            }

            octave := Text {
                x: note.x + note.width + 2px; y: parent.height / 2 - 30px;
                width: self.preferred-width; height: 22px;
                text: root.data.active ? root.data.octave : "";
                color: root.lit;
                font-family: "Bebas Neue";
                font-size: 20px;
            }
        }
    }
}

// ── TunerPanel — reusable content (used in both Window and inline modes) ──
// In windowed mode, TunerWindow wraps this in a separate native Window.
// In fullscreen / touch mode, DesktopMain and TouchMain render this inline
// over the chain page (same pattern as SettingsPage).
export component TunerPanel inherits Rectangle {
    in property <[TunerRow]> tuner-rows;
    in property <bool> mute-active;
    in property <bool> tuner-enabled: false;
    in property <bool> show-close-button: false;
    callback close-tuner();
    callback toggle-mute(bool);
    callback toggle-enabled(bool);

    property <length> bar-h: 46px;

    background: Theme.well;

    ToolBar {
        x: 0; y: 0;
        width: parent.width;
        icon: @image-url("../assets/tuner.svg");
        title: @tr("label-tuner");

        // MUTE only acts while the tuner is on.
        PillSwitch {
            text: @tr("label-mute");
            on: root.mute-active;
            warn: true;
            enabled: root.tuner-enabled;
            toggled => { root.toggle-mute(!root.mute-active); }
        }

        PillSwitch {
            text: @tr("label-power");
            on: root.tuner-enabled;
            toggled => { root.toggle-enabled(!root.tuner-enabled); }
        }

        if root.show-close-button : ToolBarClose {
            clicked => { root.close-tuner(); }
        }
    }

    // ── Empty state: the LCD says why it is blank ────────────────────────
    if root.tuner-rows.length == 0 : LcdGlass {
        x: 14px; y: root.bar-h + 14px;
        width: parent.width - 28px;
        height: empty-col.preferred-height;

        empty-col := VerticalLayout {
            padding-top: 28px;
            padding-bottom: 28px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;

            Text {
                text: @tr("status-no-active-inputs");
                color: Theme.lcd-glow;
                font-family: "Bebas Neue";
                font-size: 26px;
                letter-spacing: 0.08 * 26px;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("status-tuner-empty-help");
                color: Theme.lcd-dim;
                font-size: Theme.min-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // ── One LCD per input ────────────────────────────────────────────────
    if root.tuner-rows.length > 0 : ScrollView {
        x: 0; y: root.bar-h;
        width: parent.width;
        height: parent.height - root.bar-h;
        viewport-height: 14px + root.tuner-rows.length * 148px;

        for row[index] in root.tuner-rows : TunerCard {
            x: 14px;
            y: 14px + index * 148px;
            width: parent.width - 28px;
            data: row;
        }
    }
}

export component TunerWindow inherits Window {
    icon: @image-url("../assets/openrig-logomark.svg");
    default-font-family: "Bebas Neue";
    default-font-size: 18px;
    title: @tr("title-window-tuner");
    min-width: 480px;
    min-height: 220px;
    preferred-width: 560px;
    preferred-height: 380px;
    background: Theme.well;

    // Rows and power come from the bridge — that is the channel
    // `tuner_wiring` publishes on, the same way MetronomeWindow reads
    // MetronomeBridge (#873). Mute stays a plain property: the wiring pushes
    // it back through `set_mute_active` on this window.
    out property <bool> tuner-enabled: AnalyzerBridge.tuner-enabled;
    in property <bool> mute-active;
    callback close-tuner-window();
    callback toggle-mute(bool);
    callback toggle-enabled(bool);

    TunerPanel {
        width: 100%;
        height: 100%;
        tuner-rows: AnalyzerBridge.tuner-rows;
        mute-active: root.mute-active;
        tuner-enabled: AnalyzerBridge.tuner-enabled;
        show-close-button: false;
        close-tuner => { root.close-tuner-window(); }
        toggle-mute(m) => { root.toggle-mute(m); }
        toggle-enabled(e) => { root.toggle-enabled(e); }
    }
}
