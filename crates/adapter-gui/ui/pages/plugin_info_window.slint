// Responsibility: renders the plugin info.
import { Theme } from "../theme.slint";
// Plugin info — both a standalone Window (windowed mode) and a Rectangle panel
// used as inline overlay in fullscreen, where secondary windows do not surface
// reliably (e.g. Orange Pi / kiosk).

export component PluginInfoPanel inherits Rectangle {
    in property <image> screenshot;
    in property <bool> has-screenshot: false;
    in property <string> plugin-name: "";
    in property <string> brand: "";
    in property <string> type-label: "";
    in property <string> description: "";
    in property <string> license: "";
    in property <string> homepage: "";
    in property <bool> has-homepage: false;
    in property <bool> show-close-button: false;

    callback open-homepage();
    callback close-window();

    background: Theme.panel-lo;

    VerticalLayout {
        alignment: start;

        // ── Screenshot area (fixed 200px) ────────────────────────────────────
        Rectangle {
            height: 200px;
            background: Theme.well;
            clip: true;

            if root.has-screenshot : Image {
                width: parent.width;
                height: parent.height;
                source: root.screenshot;
                image-fit: cover;
            }

            if !root.has-screenshot : Rectangle {
                width: parent.width; height: parent.height;
                background: Theme.well;
                Image {
                    x: (parent.width - 72px) / 2;
                    y: (parent.height - 72px) / 2;
                    width: 72px; height: 72px;
                    source: @image-url("../assets/openrig-logomark.svg");
                    image-fit: contain;
                    opacity: 0.4;
                }
            }

            // Gradient overlay at bottom of screenshot
            Rectangle {
                y: parent.height - 60px;
                width: parent.width; height: 60px;
                background: @linear-gradient(180deg, transparent 0%, Theme.panel-lo 100%);
            }
        }

        // ── Content ───────────────────────────────────────────────────────────
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            alignment: start;

            // Plugin name
            Text {
                text: root.plugin-name;
                font-size: 20px;
                font-weight: 700;
                color: Theme.ink;
                wrap: word-wrap;
            }

            // Brand + type badge row
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                if root.brand != "" : Text {
                    text: root.brand;
                    font-size: 18px;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                }

                if root.brand != "" && root.type-label != "" : Text {
                    text: @tr("·");
                    font-size: 18px;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }

                if root.type-label != "" : Rectangle {
                    height: max(22px, type-badge-text.preferred-height + 4px);
                    width: type-badge-text.preferred-width + 12px;
                    border-radius: 4px;
                    background: root.type-label == "LV2" ? Theme.b-lv2.with-alpha(0.14)
                        : root.type-label == "NAM/A2" ? Theme.warn.with-alpha(0.14)
                        : (root.type-label == "NAM" || root.type-label == "NAM/A1") ? Theme.b-nam.with-alpha(0.14)
                        : root.type-label == "IR" ? Theme.b-ir.with-alpha(0.14)
                        : Theme.panel-hi;

                    type-badge-text := Text {
                        x: 6px;
                        height: parent.height;
                        text: root.type-label;
                        font-size: 18px;
                        font-weight: 600;
                        color: root.type-label == "LV2" ? Theme.b-lv2
                            : root.type-label == "NAM/A2" ? Theme.warn
                            : (root.type-label == "NAM" || root.type-label == "NAM/A1") ? Theme.b-nam
                            : root.type-label == "IR" ? Theme.b-ir
                            : Theme.ink-2;
                        vertical-alignment: center;
                    }
                }
            }

            // Divider
            Rectangle { height: 1px; background: Theme.hair; }

            // Description
            if root.description != "" : VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("label-description");
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.ink-3;
                    letter-spacing: 1px;
                }
                Text {
                    text: root.description;
                    font-size: 18px;
                    color: Theme.ink-2;
                    wrap: word-wrap;
                }
            }

            // License
            if root.license != "" : HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: @tr("label-license");
                    font-size: 18px;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }
                Text {
                    text: root.license;
                    font-size: 18px;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                }
            }

            // Homepage button
            if root.has-homepage : Rectangle {
                height: 36px;
                border-radius: 6px;
                background: hp-ta.has-hover ? Theme.ok-soft : Theme.ok.with-alpha(0.1);
                border-width: 1px;
                border-color: hp-ta.has-hover ? Theme.ok : Theme.ok.with-alpha(0.4);

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    padding: 0px;

                    Text {
                        text: @tr("↗");
                        font-size: 18px;
                        color: Theme.ok;
                        vertical-alignment: center;
                    }
                    Text {
                        text: @tr("btn-open-homepage");
                        font-size: 18px;
                        color: Theme.ok;
                        vertical-alignment: center;
                    }
                }

                hp-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-homepage(); }
                }

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }
            }
        }
    }

    // Floating close button — drawn last so it overlays the screenshot.
    if root.show-close-button : Rectangle {
        x: parent.width - 44px;
        y: 12px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: close-ta.has-hover ? Theme.bad.with-alpha(0.25) : Theme.scrim;

        Image {
            x: (parent.width - 14px) / 2;
            y: (parent.height - 14px) / 2;
            width: 14px;
            height: 14px;
            source: @image-url("../assets/close.svg");
            colorize: close-ta.has-hover ? Theme.ink : Theme.ink-2;
        }

        close-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.close-window(); }
        }

        animate background { duration: 120ms; }
    }
}

export component PluginInfoWindow inherits Window {
    title: "Plugin Info";
    width: 480px;
    min-height: 400px;
    background: Theme.panel-lo;

    in property <image> screenshot;
    in property <bool> has-screenshot: false;
    in property <string> plugin-name: "";
    in property <string> brand: "";
    in property <string> type-label: "";
    in property <string> description: "";
    in property <string> license: "";
    in property <string> homepage: "";
    in property <bool> has-homepage: false;

    callback open-homepage();
    callback close-window();

    PluginInfoPanel {
        width: parent.width;
        height: parent.height;
        screenshot: root.screenshot;
        has-screenshot: root.has-screenshot;
        plugin-name: root.plugin-name;
        brand: root.brand;
        type-label: root.type-label;
        description: root.description;
        license: root.license;
        homepage: root.homepage;
        has-homepage: root.has-homepage;
        show-close-button: false;
        open-homepage => { root.open-homepage(); }
        close-window => { root.close-window(); }
    }
}
