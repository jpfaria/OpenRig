// Responsibility: renders the drum machine panel.
// #398: the dark tool bar with a POWER pill, then on the well an LCD with the
// bar number, the beat lamps and the tempo; the kit and groove fields; the
// round FILL button beside the volume knob; and the output field. POWER is the
// one transport switch. The panel reads `DrumsBridge`, so the same component
// serves the standalone window and the inline fullscreen/touch overlay.
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PanelKnob } from "../components/panel_knob.slint";
import { BeatLamp, ControlCell } from "../components/metronome_controls.slint";
import { DrumFootSwitch, DrumPickerField, DrumPickRowView } from "../components/drums_controls.slint";
import { DrumsBridge, DrumPickRow } from "../components/drums_globals.slint";
import { LcdGlass } from "../components/lcd_glass.slint";
import { ToolBar } from "../components/tool_bar.slint";
import { ToolBarClose } from "../components/tool_bar_close.slint";
import { PillSwitch } from "../components/pill_switch.slint";
import { Locale } from "../locale_globals.slint";
import { WindowBoundsProbe } from "../components/window_bounds.slint";
import { HoverTipLayer } from "../components/hover_tip_layer.slint";

export component DrumsPanel inherits Rectangle {
    // The inline overlay needs a close button; the window closes via its chrome.
    in property <bool> show-close-button: false;

    // A list always opens unfiltered.
    function open-picker(which: int) {
        DrumsBridge.query = "";
        DrumsBridge.query-changed("");
        DrumsBridge.picker = which;
    }

    background: Theme.well;

    VerticalLayout {
        ToolBar {
            icon: @image-url("../assets/drums.svg");
            title: @tr("label-drums");

            PillSwitch {
                text: @tr("label-power");
                on: DrumsBridge.playing;
                toggled => { DrumsBridge.toggle-enabled(!DrumsBridge.playing); }
            }

            if root.show-close-button : ToolBarClose {
                clicked => { DrumsBridge.close-drums(); }
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 14px;

            // ── LCD — the bar, its beats and the tempo ───────────────────
            LcdGlass {
                vertical-stretch: 0;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 18px;

                    Text {
                        text: @tr("label-drums-bar", DrumsBridge.current-bar + 1);
                        color: DrumsBridge.playing ? Theme.lcd-dim : Theme.lcd-off;
                        font-family: Locale.display-font-family;
                        font-size: 20px;
                        letter-spacing: 0.06 * 20px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }

                    // Slots past the current time signature collapse to zero
                    // width, so the lamps stay centred whatever the bar length.
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        horizontal-stretch: 1;
                        for slot[idx] in 16 : VerticalLayout {
                            alignment: center;
                            width: idx < DrumsBridge.beats-per-bar ? 26px : 0px;
                            if idx < DrumsBridge.beats-per-bar : BeatLamp {
                                lit: DrumsBridge.playing && idx == DrumsBridge.current-beat;
                                downbeat: idx == 0;
                                counting-in: DrumsBridge.in-fill;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Text {
                            text: Math.round(DrumsBridge.bpm);
                            color: DrumsBridge.playing ? Theme.lcd-glow : Theme.lcd-off;
                            font-family: Locale.display-font-family;
                            font-size: 76px;
                            height: 70px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            text: @tr("label-bpm");
                            color: Theme.lcd-dim;
                            font-family: Locale.display-font-family;
                            font-size: Theme.min-font;
                            letter-spacing: 0.14 * Theme.min-font;
                            horizontal-alignment: right;
                        }
                    }
                }
            }

            // ── Kit and groove ───────────────────────────────────────────
            HorizontalLayout {
                spacing: 12px;

                DrumPickerField {
                    caption: @tr("label-drum-kit");
                    label: DrumsBridge.kit-label;
                    placeholder: @tr("placeholder-drum-kit");
                    icon: @image-url("../assets/drums.svg");
                    open => { root.open-picker(1); }
                }

                DrumPickerField {
                    caption: @tr("label-drum-groove");
                    label: DrumsBridge.groove-label;
                    placeholder: @tr("placeholder-drum-groove");
                    icon: @image-url("../assets/loop.svg");
                    open => { root.open-picker(2); }
                }
            }

            // ── FILL and volume ──────────────────────────────────────────
            HorizontalLayout {
                alignment: space-around;

                VerticalLayout {
                    alignment: center;
                    DrumFootSwitch {
                        caption: @tr("action-drums-fill");
                        active: DrumsBridge.in-fill;
                        // A fill lands on a running groove only.
                        enabled: DrumsBridge.playing;
                        pressed => { DrumsBridge.fill(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    ControlCell {
                        caption: @tr("label-click-volume");
                        value: Math.round(DrumsBridge.volume * 100) + "%";
                        PanelKnob {
                            x: (parent.width - self.width) / 2; y: parent.knob-y;
                            width: parent.knob-size; height: parent.knob-size;
                            value: DrumsBridge.volume;
                            min-val: 0.0;
                            max-val: 1.0;
                            step: 0.01;
                            path: "drums.volume";
                            changed(p, v) => { DrumsBridge.set-volume(v); }
                        }
                    }
                }
            }

            // ── Output endpoint ──────────────────────────────────────────
            DrumPickerField {
                caption: @tr("label-output");
                label: DrumsBridge.output-label;
                placeholder: @tr("placeholder-metronome-output");
                icon: @image-url("../assets/headphones.svg");
                open => {
                    root.open-picker(3);
                    DrumsBridge.output-opened();
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }

    // ── Picker list — clickable rows, click outside to dismiss ───────────
    if DrumsBridge.picker != 0 : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.scrim;

        scrim := TouchArea {
            clicked => { DrumsBridge.picker = 0; }
        }

        list-box := Rectangle {
            private property <[DrumPickRow]> rows: DrumsBridge.picker == 1 ? DrumsBridge.kit-rows
                : DrumsBridge.picker == 2 ? DrumsBridge.groove-rows
                : DrumsBridge.output-rows;
            private property <string> current: DrumsBridge.picker == 1 ? DrumsBridge.kit-key
                : DrumsBridge.picker == 2 ? DrumsBridge.groove-key
                : DrumsBridge.output-key;

            x: (parent.width - self.width) / 2;
            y: 80px;
            width: min(parent.width - 32px, 480px);
            height: min(parent.height - self.y - 16px, max(self.rows.length, 1) * 38px + 104px);
            border-radius: 6px;
            background: Theme.panel-hi;
            border-width: 1px;
            border-color: Theme.hair;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow;

            // Swallows clicks on the box itself so only the scrim dismisses.
            TouchArea { }

            Text {
                x: 16px; y: 14px;
                width: parent.width - 32px; height: 22px;
                text: DrumsBridge.picker == 1 ? @tr("label-drum-kit")
                    : DrumsBridge.picker == 2 ? @tr("label-drum-groove")
                    : @tr("label-output");
                color: Theme.ink-2;
                font-family: Locale.display-font-family;
                font-size: 20px;
                letter-spacing: 0.08 * 20px;
            }

            // ── Search — narrows the list as you type ──
            Rectangle {
                x: 8px; y: 44px;
                width: parent.width - 16px; height: 36px;
                border-radius: 3px;
                background: Theme.field;
                border-width: search.has-focus ? 2px : 1px;
                border-color: search.has-focus ? Theme.accent : Theme.field-line;

                Image {
                    x: 10px; y: (parent.height - 16px) / 2;
                    width: 16px; height: 16px;
                    source: @image-url("../modules/surrealism-ui/icons/search.svg");
                    colorize: Theme.ink-3;
                }

                search := TextInput {
                    x: 34px;
                    width: parent.width - 34px - (DrumsBridge.query == "" ? 8px : 32px);
                    height: parent.height;
                    text <=> DrumsBridge.query;
                    color: Theme.ink;
                    font-size: Theme.min-font;
                    vertical-alignment: center;
                    single-line: true;
                    edited => { DrumsBridge.query-changed(self.text); }
                }

                if DrumsBridge.query == "" : Text {
                    x: 34px;
                    width: parent.width - 42px; height: parent.height;
                    text: @tr("placeholder-drums-search");
                    color: Theme.ink-3;
                    font-size: Theme.min-font;
                    vertical-alignment: center;
                }

                if DrumsBridge.query != "" : TouchArea {
                    x: parent.width - 32px;
                    width: 28px; height: parent.height;
                    mouse-cursor: pointer;
                    clicked => {
                        DrumsBridge.query = "";
                        DrumsBridge.query-changed("");
                    }
                    Image {
                        x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2;
                        width: 12px; height: 12px;
                        source: @image-url("../modules/surrealism-ui/icons/close.svg");
                        colorize: Theme.ink-2;
                    }
                }
            }

            if list-box.rows.length == 0 : Text {
                x: 0; y: 92px; width: parent.width; height: parent.height - 92px;
                text: DrumsBridge.query != "" ? @tr("status-drums-no-match")
                    : DrumsBridge.picker == 3 ? @tr("status-no-outputs") : @tr("status-no-drum-content");
                color: Theme.ink-3;
                font-size: Theme.min-font;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // The list: one closed field, rows divided by hairlines.
            Rectangle {
                x: 8px; y: 92px;
                width: parent.width - 16px;
                height: parent.height - 100px;
                border-radius: 4px;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.hair;
                clip: true;

                ScrollView {
                    width: 100%; height: 100%;
                    VerticalLayout {
                        for item in list-box.rows : DrumPickRowView {
                            label: item.label;
                            header: item.header;
                            active: item.key == list-box.current;
                            pick => {
                                if DrumsBridge.picker == 1 {
                                    DrumsBridge.pick-kit(item.key);
                                } else if DrumsBridge.picker == 2 {
                                    DrumsBridge.pick-groove(item.key);
                                } else {
                                    DrumsBridge.pick-output(item.key);
                                }
                                DrumsBridge.picker = 0;
                            }
                        }
                    }
                }
            }
        }
    }
}

// The standalone window is only a host for the panel.
export component DrumsWindow inherits Window {
    icon: @image-url("../assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 18px;
    title: @tr("title-window-drums");
    min-width: 480px;
    min-height: 470px;
    preferred-width: 560px;
    preferred-height: 470px;
    background: Theme.well;

    DrumsPanel {
        width: 100%;
        height: 100%;
        show-close-button: false;
    }

    WindowBoundsProbe { }
    HoverTipLayer { }
}
