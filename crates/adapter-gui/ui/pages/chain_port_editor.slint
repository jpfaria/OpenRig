// Responsibility: renders the editor of a mid-chain port.
// #85 — the editor of a mid-chain I/O PORT (an `Input`/`Output` block the user
// placed between effects).
//
// A port has no model and no parameters: what it carries is WHERE it reads from
// / writes to. That is exactly one E/S binding plus one endpoint of it, which is
// what the model persists (`SaveChainInputEndpoints` /
// `SaveChainOutputEndpoints`) — so those are the only two choices this page
// offers. Device / mode / channels belong to the E/S itself and are edited in
// the I/O bindings screen, not here.
//
// #398: a dialog — the dark bar with the block's power lamp, the title and the
// trash, the E/S and point fields on the panel, then Cancel / OK.

import { Theme } from "../theme.slint";
import { BlockDialogBar } from "../components/block_dialog_bar.slint";
import { DialogFoot } from "../components/dialog_foot.slint";
import { DropSelect } from "../components/drop_select.slint";
import { FieldCaption } from "../components/field_caption.slint";
import { FormButton, FormButtonKind } from "../components/form_button.slint";

export component ChainPortEditorPage inherits Rectangle {
    in property <bool> is-input;
    in property <[string]> binding-options;
    in-out property <int> selected-binding-index;
    in property <[string]> endpoint-options;
    in-out property <int> selected-endpoint-index;
    in property <bool> block-enabled: true;
    in property <bool> show-endpoint-warning;

    callback select-binding(int);
    callback select-endpoint(int);
    callback toggle-enabled();
    callback delete-block();
    callback save();
    callback cancel();

    background: Theme.panel;

    VerticalLayout {
        BlockDialogBar {
            vertical-stretch: 0;
            title: root.is-input ? @tr("title-section-configure-input") : @tr("title-section-configure-output");
            block-enabled: root.block-enabled;
            toggle-enabled => { root.toggle-enabled(); }
            delete-block => { root.delete-block(); }
        }

        VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding: 18px;
            spacing: 14px;

            VerticalLayout {
                spacing: 6px;
                FieldCaption { text: @tr("label-io-binding"); }
                DropSelect {
                    model: root.binding-options;
                    current <=> root.selected-binding-index;
                    picked(index) => { root.select-binding(index); }
                }
            }

            VerticalLayout {
                spacing: 6px;
                FieldCaption { text: @tr("label-io-endpoint"); }
                DropSelect {
                    model: root.endpoint-options;
                    current <=> root.selected-endpoint-index;
                    picked(index) => { root.select-endpoint(index); }
                }
            }

            if root.show-endpoint-warning : Text {
                text: @tr("msg-pick-io-endpoint");
                color: Theme.accent;
                font-size: Theme.min-font;
                wrap: word-wrap;
            }
        }

        DialogFoot {
            vertical-stretch: 0;
            FormButton {
                icon-only: true;
                icon: @image-url("../assets/close.svg");
                label: @tr("btn-cancel");
                clicked => { root.cancel(); }
            }
            FormButton {
                icon-only: true;
                icon: @image-url("../assets/check.svg");
                kind: FormButtonKind.primary;
                label: @tr("btn-ok");
                clicked => { root.save(); }
            }
        }
    }
}
