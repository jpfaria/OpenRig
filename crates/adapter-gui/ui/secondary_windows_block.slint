import { ChannelOptionItem, BlockKnobOverlay, BlockParameterItem, BlockTypePickerItem, BlockModelPickerItem, BlockStreamData, MultiSliderPoint, CurveEditorPoint, CompactBlockItem, ChainRigNav, StreamMeter, ChainBlockItem } from "models.slint";
import { OverlayBridge } from "overlay_globals.slint";
import { BlockEditorBridge } from "block_editor_globals.slint";
import { Locale } from "locale_globals.slint";
import { BlockEditorPanel, BlockPanelEditor, CompactChainViewPage } from "pages/pages.slint";
import { Toast } from "components/toast.slint";
import { ConfirmDeleteBlockDialog } from "components/confirm_delete_dialog.slint";
import { ConfirmDeleteChainDialog } from "components/confirm_delete_chain_dialog.slint";
import { DiLoopPanel } from "components/di_loop_panel.slint";
import { DiPanel } from "components/di_panel_globals.slint";
import { ToneDoctorPanel } from "components/tone_doctor_panel.slint";
import { ToneDoctorState } from "components/tone_doctor_globals.slint";

export component BlockEditorWindow inherits Window {
    icon: @image-url("assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 13px;
    in property <[string]> block-parameter-groups;
    in property <int> active-parameter-group: 0;
    in property <string> block-window-title: @tr("title-window-block-editor");
    // Issue #360: in-window delete confirmation (no `rfd::MessageDialog`).
    // The Rust side flips `show-confirm-delete-block` from
    // `delete-block-drawer` and dispatches the actual removal only on
    // `confirm-delete-block`. `cancel-delete-block` just hides it.
    callback show-plugin-info(string, string);
    callback select-parameter-group(int);

    // Realtime data stream from engine (tuner, meter, analyzer, etc.)

    // Computed: should this block type use the visual panel editor?
    private property <bool> use-panel-editor:
        BlockEditorBridge.block-drawer-selected-type-index >= 0
        && BlockEditorBridge.block-drawer-selected-type-index < BlockEditorBridge.block-type-options.length
        && BlockEditorBridge.block-type-options[BlockEditorBridge.block-drawer-selected-type-index].use_panel_editor;

    // Knob-grid dimensions come from Rust (`block_panel_dimensions::compute`).
    // The wrap policy is universal: NAM, native, IR, LV2 — every block
    // kind that uses the panel editor goes through the same Rust formula
    // and reads back the result via these `in` properties. The math is
    // covered by `block_panel_dimensions_tests`; do not re-derive it here.
    in property <length> panel-knob-window-width: 900px;
    in property <length> panel-knob-window-height: 275px;
    in property <length> panel-knob-inner-height: 225px;
    in property <int> panel-grid-cols: 0;
    in property <int> panel-grid-rows: 0;

    // Outer-window dimensions. EQ branch keeps its dedicated widget
    // formula; everything else reads the Rust-computed knob-grid sizes
    // (single source of truth for #500). Rust calls `window().set_size()`
    // with these values right after populating the param/overlay model
    // — Linux WMs ignore min/max/preferred-* without that explicit call
    // (#479).
    // The form editor (`!use-panel-editor`) reads its window size from the
    // same Rust-computed properties: width is fixed (520) and height grows
    // with the parameter count so every row shows without scrolling — the
    // window is locked min=max=preferred, so a fixed 820 hid the lower
    // params (issue #622). `block_panel_dimensions::form_dimensions` is the
    // single source for both.
    // Every block kind — EQ included — is sized by `block_panel_dimensions`.
    // The window used to carry its own EQ formula, which disagreed with the
    // panel laid out inside it: the widget started lower than `max-height`
    // allowed and the bottom row of frequency labels was cut off (#878, #358).
    out property <length> panel-width: root.panel-knob-window-width;
    out property <length> panel-height: root.panel-knob-window-height;

    title: root.block-window-title;
    min-width: panel-width;
    min-height: panel-height;
    max-width: panel-width;
    max-height: panel-height;
    preferred-width: panel-width;
    preferred-height: panel-height;
    background: #040708;

    // Amp head: visual panel editor
    if root.use-panel-editor : BlockPanelEditor {
        width: parent.width;
        height: parent.height;
        block-parameter-groups: root.block-parameter-groups;
        active-parameter-group: root.active-parameter-group;
        panel-knob-inner-height: root.panel-knob-inner-height;
        panel-grid-cols: root.panel-grid-cols;
        panel-grid-rows: root.panel-grid-rows;
        show-plugin-info(effect_type, model_id) => { root.show-plugin-info(effect_type, model_id); }
        select-parameter-group(i) => { root.select-parameter-group(i); }
    }

    // Other block types: existing form-based editor
    if !root.use-panel-editor : BlockEditorPanel {
        width: parent.width;
        height: parent.height;
        show-plugin-info(effect_type, model_id) => { root.show-plugin-info(effect_type, model_id); }
    }

    Toast {
        message: OverlayBridge.toast-message;
        level: OverlayBridge.toast-level;
        container-width: root.width;
        container-height: root.height;
    }

    // Issue #360: in-window delete confirmation overlay (replaces the
    // native `rfd::MessageDialog` that used to gate `delete-block-drawer`).
    if OverlayBridge.show-confirm-delete-block : ConfirmDeleteBlockDialog {
        width: root.width;
        height: root.height;
        block-name: OverlayBridge.confirm-delete-block-name;
        confirm => { OverlayBridge.confirm-delete-block(); }
        cancel => { OverlayBridge.cancel-delete-block(); }
    }
}

export component CompactChainViewWindow inherits Window {
    icon: @image-url("assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 13px;
    title: @tr("title-window-chain-view");
    // Defaults pinned to the screenshot the user attached in #559:
    // 1305×840. `min-width` keeps the row layout legible; below
    // ~1000 px the per-block knobs collide with the brand logo.
    min-width: 1000px;
    min-height: 480px;
    preferred-width: 1305px;
    preferred-height: 840px;
    background: #0a0c10;

    in property <string> chain-title;
    in property <int> chain-index;
    // Measured DSP latency mirrored from the main chains row (#613) so the
    // probe result shows inside the compact view, not only on the list.
    in property <float> latency-ms: 0.0;
    in property <bool> chain-enabled;
    in property <[CompactBlockItem]> compact-blocks;
    // Preset/scene model + meters + volume — parity with the main row.
    in property <ChainRigNav> rig-nav;
    in property <float> meter-in-dbfs: -120.0;
    in property <float> meter-out-dbfs: -120.0;
    // Per-stream meter rows — mirrors `ProjectChainItem.stream_meters`.
    // Multi-input chain (e.g. 3 inputs) ⇒ 3 entries ⇒ 3 IN/OUT bars at
    // the footer (parity with the main `ChainRow`).
    in property <[StreamMeter]> stream-meters;
    in property <int> volume: 100;

    // #614: DI loop state for the focused chain.
    in property <bool> di-loop-playing: false;
    in property <[string]> di-loop-sources: [];
    // #717: which source is selected — without it the compact panel opens with
    // no selection, so it shows nothing picked and hides the play/stop button.
    in property <int> di-loop-selected-index: -1;
    // #771: the chain's bound output endpoints + the persisted pick.
    in property <[string]> di-loop-outputs: [];
    in property <int> di-output-selected-index: -1;
    // #717: dedicated DI-stream graph payload (the DI's own blocks + live
    // meters + chosen output label), shown while the DI plays.
    in property <StreamMeter> di-graph-meter;

    // I/O device configuration
    callback configure-input(int); // chain_index
    callback configure-output(int); // chain_index
    // #614: DI loop callbacks — forwarded from CompactChainViewPage.
    callback di-loop-source-selected(string);
    callback di-loop-choose-file();
    callback di-loop-play();
    callback di-loop-stop();
    // #771: an output endpoint was picked (index into di-loop-outputs).
    callback di-loop-output-selected(int);
    // #791: Tone Doctor — run the offline diagnosis / apply its suggested fix.
    callback tone-doctor-run(int);
    callback tone-doctor-apply(int);

    callback toggle-chain-enabled(int);
    callback toggle-block-enabled(int, int);
    callback update-block-parameter-number(int, int, string, float);
    callback update-block-parameter-bool(int, int, string, bool);
    callback select-block-parameter-option(int, int, string, int);
    // #787: switch the parameter tab a compact block shows, and the row geometry
    // the drag/drop indicator needs (rows no longer share a fixed stride).
    callback select-block-parameter-group(int, int, int);
    pure callback slot-at(length) -> int;
    pure callback slot-y(int) -> length;
    callback choose-block-model(int, int, int);
    callback choose-block-model-by-id(int, int, string);
    callback search-block-model(int, int, string);
    callback insert-block(int, int);
    callback reorder-block(int, int, int);
    callback open-block-detail(int, int);
    callback close-compact-view();
    callback choose-block-type(int, int, int);
    callback remove-block(int, int);
    // Preset / chain admin callbacks — same shape `chain_row` exposes
    // so the same wiring on the Rust side serves both views.
    callback switch-chain-preset(int);
    callback switch-chain-scene(int);
    callback rename-chain-preset(string);
    callback load-chain-preset();
    callback save-chain-preset-as();
    callback configure-chain(int);
    callback probe-chain-latency(int);
    callback chain-volume-changed(int, int);
    callback remove-chain(int);

    // Issue #360: in-window delete confirmations (replaces the previous
    // implicit delegation to AppWindow's overlay, which used to surface
    // the modal on the wrong window).

    CompactChainViewPage {
        width: parent.width; height: parent.height;
        chain-title: root.chain-title;
        chain-index: root.chain-index;
        latency-ms: root.latency-ms;
        chain-enabled: root.chain-enabled;
        compact-blocks: root.compact-blocks;
        block-type-options: BlockEditorBridge.block-type-options;
        rig-nav: root.rig-nav;
        meter-in-dbfs: root.meter-in-dbfs;
        meter-out-dbfs: root.meter-out-dbfs;
        stream-meters: root.stream-meters;
        volume: root.volume;
        di-loop-playing: root.di-loop-playing;
        di-loop-sources: root.di-loop-sources;
        di-loop-selected-index: root.di-loop-selected-index;
        di-loop-outputs: root.di-loop-outputs;
        di-output-selected-index: root.di-output-selected-index;
        di-graph-meter: root.di-graph-meter;
        configure-input(ci) => { root.configure-input(ci); }
        configure-output(ci) => { root.configure-output(ci); }
        di-loop-source-selected(src) => { root.di-loop-source-selected(src); }
        di-loop-choose-file => { root.di-loop-choose-file(); }
        di-loop-play => { root.di-loop-play(); }
        di-loop-stop => { root.di-loop-stop(); }
        toggle-chain-enabled(ci) => { root.toggle-chain-enabled(ci); }
        toggle-block-enabled(ci, bi) => { root.toggle-block-enabled(ci, bi); }
        update-block-parameter-number(ci, bi, p, v) => { root.update-block-parameter-number(ci, bi, p, v); }
        update-block-parameter-bool(ci, bi, p, v) => { root.update-block-parameter-bool(ci, bi, p, v); }
        select-block-parameter-option(ci, bi, p, oi) => { root.select-block-parameter-option(ci, bi, p, oi); }
        select-block-parameter-group(ci, bi, gi) => { root.select-block-parameter-group(ci, bi, gi); }
        slot-at(y) => { root.slot-at(y) }
        slot-y(i) => { root.slot-y(i) }
        choose-block-model(ci, bi, mi) => { root.choose-block-model(ci, bi, mi); }
        choose-block-model-by-id(ci, bi, mid) => { root.choose-block-model-by-id(ci, bi, mid); }
        search-block-model(ci, bi, text) => { root.search-block-model(ci, bi, text); }
        insert-block(ci, before) => { root.insert-block(ci, before); }
        reorder-block(ci, from, before) => { root.reorder-block(ci, from, before); }
        open-block-detail(ci, bi) => { root.open-block-detail(ci, bi); }
        close-compact-view => { root.close-compact-view(); }
        choose-block-type(ci, before, ti) => { root.choose-block-type(ci, before, ti); }
        remove-block(ci, bi) => { root.remove-block(ci, bi); }
        switch-chain-preset(slot) => { root.switch-chain-preset(slot); }
        switch-chain-scene(s) => { root.switch-chain-scene(s); }
        rename-chain-preset(name) => { root.rename-chain-preset(name); }
        load-chain-preset => { root.load-chain-preset(); }
        save-chain-preset-as => { root.save-chain-preset-as(); }
        configure-chain(ci) => { root.configure-chain(ci); }
        probe-chain-latency(ci) => { root.probe-chain-latency(ci); }
        chain-volume-changed(ci, v) => { root.chain-volume-changed(ci, v); }
        remove-chain(ci) => { root.remove-chain(ci); }
    }

    // Issue #360: in-window delete-block + delete-chain confirmation
    // overlays. The Rust side flips show-confirm-delete-* from the
    // remove handlers and dispatches the actual removal only on
    // confirm-delete-*. cancel-delete-* hides without side effect.
    if OverlayBridge.show-confirm-delete-block : ConfirmDeleteBlockDialog {
        width: root.width;
        height: root.height;
        block-name: OverlayBridge.confirm-delete-block-name;
        confirm => { OverlayBridge.confirm-delete-block(); }
        cancel => { OverlayBridge.cancel-delete-block(); }
    }
    if OverlayBridge.show-confirm-delete-chain : ConfirmDeleteChainDialog {
        width: root.width;
        height: root.height;
        chain-name: OverlayBridge.confirm-delete-chain-name;
        confirm => { OverlayBridge.confirm-delete-chain(); }
        cancel => { OverlayBridge.cancel-delete-chain(); }
    }

    // #717: DI panel overlay for the DETACHED compact window. The fone
    // (ChainDiLoopButton) sets `DiPanel.open` on this window's own global;
    // without this overlay the click had no visible effect ("botão não faz
    // nada"). Mirrors app-window's DI overlay, but the window's DI callbacks
    // are single-chain (no chain index).
    if DiPanel.open : Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        TouchArea { clicked => { DiPanel.open = false; } }
        DiLoopPanel {
            x: DiPanel.x;
            y: DiPanel.y;
            sources: DiPanel.sources;
            selected-index: DiPanel.selected-index;
            playing: DiPanel.playing;
            outputs: DiPanel.outputs;
            output-selected-index: DiPanel.output-selected-index;
            source-picked(i, s) => {
                DiPanel.selected-index = i;
                root.di-loop-source-selected(s);
            }
            choose-file => { root.di-loop-choose-file(); }
            play => {
                DiPanel.playing = true;
                root.di-loop-play();
            }
            stop => {
                DiPanel.playing = false;
                root.di-loop-stop();
            }
            output-picked(i, s) => {
                DiPanel.output-selected-index = i;
                root.di-loop-output-selected(i);
            }
        }
    }

    // #791: Tone Doctor panel overlay for the detached compact window. The
    // stethoscope (ChainToneDoctorButton) sets `ToneDoctorState.open`; Rust
    // fills the result fields after the offline run.
    if ToneDoctorState.open : Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        TouchArea { clicked => { ToneDoctorState.open = false; } }
        ToneDoctorPanel {
            x: ToneDoctorState.x;
            y: ToneDoctorState.y;
            running: ToneDoctorState.running;
            has-result: ToneDoctorState.has-result;
            symptom-level: ToneDoctorState.symptom-level;
            symptom-text: ToneDoctorState.symptom-text;
            culprit-label: ToneDoctorState.culprit-label;
            suggestion-text: ToneDoctorState.suggestion-text;
            has-suggestion: ToneDoctorState.has-suggestion;
            fizz-value: ToneDoctorState.fizz-value;
            fizz-limit: ToneDoctorState.fizz-limit;
            mud-value: ToneDoctorState.mud-value;
            mud-limit: ToneDoctorState.mud-limit;
            boom-value: ToneDoctorState.boom-value;
            boom-limit: ToneDoctorState.boom-limit;
            clip-value: ToneDoctorState.clip-value;
            clip-limit: ToneDoctorState.clip-limit;
            analyze-seconds: ToneDoctorState.analyze-seconds;
            can-diagnose: ToneDoctorState.can-diagnose;
            seconds-picked(s) => { ToneDoctorState.analyze-seconds = s; }
            run-diagnosis => { root.tone-doctor-run(ToneDoctorState.chain-index); }
            apply-suggestion => { root.tone-doctor-apply(ToneDoctorState.chain-index); }
        }
    }
}
