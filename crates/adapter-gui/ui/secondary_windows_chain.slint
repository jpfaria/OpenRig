import { ChannelOptionItem, DeviceSelectionItem, ChainBindingChoice, IoBindingModel, MidiDeviceRow, MidiBindingRow } from "models.slint";
import { ChainEditorBridge } from "chain_editor_globals.slint";
import { Locale } from "locale_globals.slint";
import { SettingsPage, ChainEditorPage, ChainInsertEditorPage, ChainPortEditorPage } from "pages/pages.slint";

export component ProjectSettingsWindow inherits Window {
    icon: @image-url("assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 13px;
    in-out property <string> project-name-draft;
    in-out property <string> status-message;
    in property <[string]> sample-rate-options;
    in property <[string]> buffer-size-options;
    in property <[string]> bit-depth-options;
    // Issue #513 — forward the full SettingsPage surface so the
    // master-detail panel renders identically inside the secondary
    // window. Without these the inner SettingsPage saw empty language
    // dropdowns, empty MIDI devices list, empty MIDI mapping commands
    // and empty project metadata.
    callback update-project-name(string);
    callback save-audio-settings();
    // Project / Metadata "Save project" button (#513). Mirror of the
    // main AppWindow callback so the secondary settings window can
    // dispatch Command::SaveProject through the same Rust handler.
    callback save-project();
    callback close-settings();
    // #712: System / Integrations master switches.
    // #716: System / I/O bindings section.
    // Exposed so navigation can be driven (e.g. interaction tests jumping
    // straight to the I/O bindings section).
    in-out property <int> settings-selected-section: 0;
    // System / Paths section (#513 + #582). Empty = OS default.
    // #561: plugin catalog reload row in the Paths section.
    title: @tr("title-window-project-settings");
    min-width: 860px;
    min-height: 540px;
    preferred-width: 1100px;
    preferred-height: 640px;
    background: #040708;

    SettingsPage {
        width: parent.width;
        height: parent.height;
        project-name-draft <=> root.project-name-draft;
        sample-rate-options: root.sample-rate-options;
        buffer-size-options: root.buffer-size-options;
        bit-depth-options: root.bit-depth-options;
        status-message: root.status-message;
        selected-section <=> root.settings-selected-section;
        update-project-name(value) => { root.update-project-name(value); }
        save-audio-settings => { root.save-audio-settings(); }
        save-project => { root.save-project(); }
        close-settings => { root.close-settings(); }
    }
}

export component ChainEditorWindow inherits Window {
    icon: @image-url("assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 13px;
    in property <string> editor-title;
    in property <string> editor-save-label;
    in-out property <string> chain-name;
    // #716: I/O bindings the chain can select (checklist).
    in property <[ChainBindingChoice]> bindings;
    in-out property <string> status-message;
    in property <bool> is-create-mode: true;
    in-out property <int> selected-instrument-index: 0;
    callback select-instrument(int);
    title: @tr("title-window-chain-editor");
    min-width: 860px;
    min-height: 540px;
    preferred-width: 1100px;
    preferred-height: 640px;
    background: #040708;

    ChainEditorPage {
        width: parent.width;
        height: parent.height;
        title: root.editor-title;
        save-label: root.editor-save-label;
        chain-name: root.chain-name;
        bindings: root.bindings;
        status-message: root.status-message;
        is-create-mode: root.is-create-mode;
        selected-instrument-index: root.selected-instrument-index;
        update-chain-name(value) => { ChainEditorBridge.update-chain-name(value); }
        toggle-binding(index, on) => { ChainEditorBridge.toggle-binding(index, on); }
        save-chain => { ChainEditorBridge.save-chain(); }
        cancel-chain => { ChainEditorBridge.cancel-chain(); }
        select-instrument(index) => { root.select-instrument(index); }
    }
}

// #881 — the editor of an INSERT block. Model A (#716): an insert points at ONE
// E/S binding — send on its output, return on its input — so that single pick is
// the whole window.
export component ChainInsertWindow inherits Window {
    icon: @image-url("assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 13px;

    in property <[string]> binding-options;
    in-out property <int> selected-binding-index;
    in property <bool> block-enabled: true;
    in property <bool> show-binding-warning;

    callback select-binding(int);
    callback toggle-enabled();
    callback delete-block();
    callback save();
    callback cancel();

    title: @tr("title-window-chain-insert");
    min-width: 460px;
    min-height: 380px;
    preferred-width: 520px;
    preferred-height: 420px;
    background: #040708;

    ChainInsertEditorPage {
        width: parent.width;
        height: parent.height;
        binding-options: root.binding-options;
        selected-binding-index <=> root.selected-binding-index;
        block-enabled: root.block-enabled;
        show-binding-warning: root.show-binding-warning;
        select-binding(index) => { root.select-binding(index); }
        toggle-enabled => { root.toggle-enabled(); }
        delete-block => { root.delete-block(); }
        save => { root.save(); }
        cancel => { root.cancel(); }
    }
}


// #85 — the editor of a mid-chain I/O port. A port carries no model and no
// parameters: it points at one E/S binding endpoint, which is what the model
// persists, so those are the only two choices offered.
export component ChainPortWindow inherits Window {
    icon: @image-url("assets/openrig-logomark.svg");
    default-font-family: Locale.font-family;
    default-font-size: 13px;

    in property <bool> is-input;
    in property <[string]> binding-options;
    in-out property <int> selected-binding-index;
    in property <[string]> endpoint-options;
    in-out property <int> selected-endpoint-index;
    in property <bool> block-enabled: true;
    in property <bool> show-endpoint-warning;

    callback select-binding(int);
    callback select-endpoint(int);
    callback toggle-enabled();
    callback delete-block();
    callback save();
    callback cancel();

    title: @tr("title-window-chain-port");
    min-width: 460px;
    min-height: 380px;
    preferred-width: 520px;
    preferred-height: 420px;
    background: #040708;

    ChainPortEditorPage {
        width: parent.width;
        height: parent.height;
        is-input: root.is-input;
        binding-options: root.binding-options;
        selected-binding-index <=> root.selected-binding-index;
        endpoint-options: root.endpoint-options;
        selected-endpoint-index <=> root.selected-endpoint-index;
        block-enabled: root.block-enabled;
        show-endpoint-warning: root.show-endpoint-warning;
        select-binding(index) => { root.select-binding(index); }
        select-endpoint(index) => { root.select-endpoint(index); }
        toggle-enabled => { root.toggle-enabled(); }
        delete-block => { root.delete-block(); }
        save => { root.save(); }
        cancel => { root.cancel(); }
    }
}
