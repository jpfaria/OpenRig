// Responsibility: renders the clickable header of a collapsible section.
import { Theme } from "../theme.slint";
// #1007 — a chevron (right = collapsed, down = expanded), the section's icon
// and its title across the whole header; a click asks for the opposite state through
// `toggled`. The owner keeps the state and feeds it back into `expanded`, so
// every view decides for itself where it lives (the compact mixer in the
// view, a chain card in its row model) and always opens collapsed.

export component SectionToggle inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <bool> expanded: false;
    callback toggled(bool);

    // #398: a raised strip with a hairline under it; the chevron turns down
    // when the section is open.
    background: Theme.panel-hi;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.flip(); }

    function flip() {
        root.toggled(!root.expanded);
    }

    Rectangle {
        background: area.has-hover ? Theme.hover : transparent;
    }

    Path {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        fill: transparent;
        stroke: Theme.ink-3;
        stroke-width: 1.6px;
        MoveTo { x: root.expanded ? 1 : 3; y: root.expanded ? 3 : 1; }
        LineTo { x: root.expanded ? 5 : 7; y: root.expanded ? 7 : 5; }
        LineTo { x: root.expanded ? 9 : 3; y: root.expanded ? 3 : 9; }
    }

    icon := Image {
        x: 34px;
        y: (parent.height - self.height) / 2;
        width: 18px; height: 18px;
        source: root.icon;
        colorize: Theme.ink-3;
    }

    Text {
        x: 62px; y: 0;
        width: parent.width - 76px; height: parent.height;
        text: root.title;
        color: root.expanded || area.has-hover ? Theme.ink : Theme.ink-2;
        font-family: "Bebas Neue";
        font-size: Theme.min-font;
        letter-spacing: 0.08 * Theme.min-font;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hair-2;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }
}
