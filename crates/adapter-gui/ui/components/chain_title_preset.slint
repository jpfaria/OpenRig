// Responsibility: renders the title slot of a chain row.
// #436 #1 — the chain row's title slot. For a rig chain it IS the
// preset picker (a dark, big-type select like the title) + an "add
// preset" button + a dynamic scene bar (scenes grow on demand: a
// preset starts with scene 1, the user adds 2, 3…). For a non-rig
// chain it falls back to the plain clickable title. Own file so
// chain_row.slint (over the 500-line cap) shrinks instead of growing.

import { Theme } from "../theme.slint";
import { ChainRigNav } from "../models.slint";
import { PresetSelect } from "preset_select.slint";
import { HeaderIconStyle } from "header_icon_style.slint";
import { Locale } from "../locale_globals.slint";

// Small square icon button (press to fire), drawn like every chain
// header icon (HeaderIconStyle).
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <string> a11y;
    in property <bool> on-chrome: false;
    callback clicked();
    width: HeaderIconStyle.size;
    height: HeaderIconStyle.size;
    border-radius: HeaderIconStyle.radius;
    background: root.on-chrome ? HeaderIconStyle.chrome-fill(ta.has-hover) : HeaderIconStyle.fill(ta.has-hover);
    animate background { duration: 150ms; }
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: HeaderIconStyle.icon;
        height: HeaderIconStyle.icon;
        source: root.icon;
        image-fit: contain;
        colorize: root.on-chrome ? HeaderIconStyle.chrome-tint(root.active, ta.has-hover) : HeaderIconStyle.tint(root.active, ta.has-hover);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    accessible-role: button;
    accessible-label: root.a11y;
}

// One compact scene number button: a field, the active one filled with the
// accent. Only the number — no dropdown.
component SceneBtn inherits Rectangle {
    in property <int> idx;
    in property <bool> active;
    in property <bool> on-chrome: false;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 3px;
    background: root.active ? Theme.accent : root.on-chrome ? Theme.chrome-field : Theme.field;
    border-width: root.active ? 0px : 1px;
    border-color: root.on-chrome
        ? (sta.has-hover ? Theme.chrome-fg-2 : Theme.chrome-field-line)
        : (sta.has-hover ? Theme.ink-3 : Theme.field-line);
    animate background { duration: 120ms; }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.idx;
        color: root.active ? Theme.on-accent : root.on-chrome ? Theme.chrome-fg : Theme.ink-2;
        font-size: Theme.min-font;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    sta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    accessible-role: button;
    accessible-label: @tr("Scene {}", root.idx);
}

// Dynamic scene bar: one button per existing scene (1..scene-count;
// max 8), the active one highlighted, plus a "+" that adds the next
// scene. Scenes grow on demand — a preset starts with just scene 1.
component SceneBar inherits HorizontalLayout {
    in property <int> scene;
    in property <int> scene-count;
    in property <bool> on-chrome: false;
    callback picked(int);
    spacing: 4px;

    if root.scene-count >= 1 : SceneBtn { idx: 1; on-chrome: root.on-chrome; active: root.scene == 1; clicked => { root.picked(1); } }
    if root.scene-count >= 2 : SceneBtn { idx: 2; on-chrome: root.on-chrome; active: root.scene == 2; clicked => { root.picked(2); } }
    if root.scene-count >= 3 : SceneBtn { idx: 3; on-chrome: root.on-chrome; active: root.scene == 3; clicked => { root.picked(3); } }
    if root.scene-count >= 4 : SceneBtn { idx: 4; on-chrome: root.on-chrome; active: root.scene == 4; clicked => { root.picked(4); } }
    if root.scene-count >= 5 : SceneBtn { idx: 5; on-chrome: root.on-chrome; active: root.scene == 5; clicked => { root.picked(5); } }
    if root.scene-count >= 6 : SceneBtn { idx: 6; on-chrome: root.on-chrome; active: root.scene == 6; clicked => { root.picked(6); } }
    if root.scene-count >= 7 : SceneBtn { idx: 7; on-chrome: root.on-chrome; active: root.scene == 7; clicked => { root.picked(7); } }
    if root.scene-count >= 8 : SceneBtn { idx: 8; on-chrome: root.on-chrome; active: root.scene == 8; clicked => { root.picked(8); } }
    if root.scene-count < 8 : IconButton {
        on-chrome: root.on-chrome;
        icon: @image-url("../assets/plus.svg");
        a11y: @tr("Add scene");
        clicked => {
            root.picked(-1);
        }
    }
    // Remove the last scene (stack pop). Hidden when only scene 1
    // exists — a preset must keep at least one scene.
    if root.scene-count > 1 : IconButton {
        on-chrome: root.on-chrome;
        icon: @image-url("../assets/trash.svg");
        a11y: @tr("Remove last scene");
        clicked => {
            root.picked(-2);
        }
    }
}

export component ChainTitlePreset inherits Rectangle {
    in property <string> title;
    in property <ChainRigNav> nav;
    in property <bool> fullscreen: false;
    // A switched-off chain prints its name in the quiet ink.
    in property <bool> enabled: true;
    // #398: sits on the dark chrome bar (the compact view's header): the
    // title, icons, preset and scenes read chrome-fg on Theme.chrome-field.
    in property <bool> on-chrome: false;
    callback open-compact();
    // preset-picked(slot): slot >= 0 selects that combo entry; the
    // sentinel -1 means "add a new preset". scene-picked(s): s >= 1
    // selects scene s; the sentinel -1 means "add the next scene".
    // Both reuse one callback so no new one is threaded through the
    // over-cap shells.
    callback preset-picked(int);
    callback scene-picked(int);
    // Issue: rename the currently active preset. Carries the new
    // name typed in the rename popup. Empty string ⇒ user pressed
    // OK with no text; the Rust wiring treats it as a no-op.
    callback rename-preset(string);
    // Issue: open the load-preset file picker. Routed to the
    // existing `configure-chain-preset` callback on chain_row.
    callback load-preset();
    // Issue: save the chain's processing chain as a preset file.
    // Routed to the existing `save-chain-preset` callback.
    callback save-preset();

    // Active-preset label, used to pre-fill the rename popup.
    property <string> active-preset-label:
        root.nav.active-preset-index >= 0
            && root.nav.active-preset-index < root.nav.preset-labels.length
        ? root.nav.preset-labels[root.nav.active-preset-index]
        : "";
    // Working copy the popup's TextInput edits.
    property <string> rename-draft: "";

    // Issue #496: preset select + scene bar + "+" buttons are shown
    // ALWAYS (rig or not). Without a rig, the select is empty and the
    // "+" creates the rig + first preset on click; same for scenes.
    HorizontalLayout {
        spacing: Theme.spaces.small;
        alignment: start;

        // Title — still clickable to open the compact view. It gives up
        // width (eliding) before the row runs under the header's action
        // cluster in a narrow window (#1007).
        Rectangle {
            min-width: 96px;
            preferred-width: title-text.preferred-width + 8px;
            max-width: 320px;
            horizontal-stretch: 1;
            title-text := Text {
                width: parent.width;
                height: parent.height;
                text: root.title;
                color: root.on-chrome
                    ? (!root.enabled ? Theme.chrome-fg-2 : Theme.chrome-fg)
                    : (!root.enabled ? Theme.ink-3 : title-ta.has-hover ? Theme.accent : Theme.ink);
                font-family: Locale.display-font-family;
                font-size: 28px;
                letter-spacing: 1px;
                vertical-alignment: center;
                overflow: elide;
            }
            title-ta := TouchArea {
                mouse-cursor: root.fullscreen ? default : pointer;
                clicked => {
                    if !root.fullscreen {
                        root.open-compact();
                    }
                }
            }
        }

        // Preset action cluster BEFORE the select — open, save, add,
        // rename, delete. Grouping them with the combobox so it's
        // unambiguous that they act on the *preset* (not the chain).
        VerticalLayout {
            alignment: center;
            IconButton {
                on-chrome: root.on-chrome;
                icon: @image-url("../assets/open-file.svg");
                a11y: @tr("tooltip-open-preset");
                clicked => {
                    root.load-preset();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                on-chrome: root.on-chrome;
                icon: @image-url("../assets/save.svg");
                a11y: @tr("tooltip-save-preset");
                clicked => {
                    root.save-preset();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                on-chrome: root.on-chrome;
                icon: @image-url("../assets/plus.svg");
                a11y: @tr("Add preset");
                clicked => {
                    root.preset-picked(-1);
                }
            }
        }
        if root.nav.preset-labels.length > 0 : VerticalLayout {
            alignment: center;
            IconButton {
                on-chrome: root.on-chrome;
                icon: @image-url("../assets/pencil.svg");
                a11y: @tr("Rename preset");
                clicked => {
                    root.rename-draft = root.active-preset-label;
                    rename-pop.show();
                }
            }
        }
        if root.nav.preset-labels.length > 1 : VerticalLayout {
            alignment: center;
            IconButton {
                on-chrome: root.on-chrome;
                icon: @image-url("../assets/trash.svg");
                a11y: @tr("Remove preset");
                clicked => {
                    root.preset-picked(-2);
                }
            }
        }

        // Preset select — empty placeholder when no rig yet.
        // Shrinks (eliding its label) before the row runs under the action
        // cluster, so the scene bar keeps its place.
        PresetSelect {
            min-width: 120px;
            preferred-width: 220px;
            max-width: 220px;
            horizontal-stretch: 1;
            on-chrome: root.on-chrome;
            labels: root.nav.preset-labels;
            active-index: root.nav.active-preset-index;
            picked(i) => {
                root.preset-picked(i);
            }
        }

        // Scene bar — also always visible. Scene-count == 0 ⇒ shows
        // only the "+ add scene" affordance the bar itself renders.
        VerticalLayout {
            alignment: center;
            SceneBar {
                on-chrome: root.on-chrome;
                scene: root.nav.scene;
                scene-count: root.nav.scene-count;
                picked(s) => {
                    root.scene-picked(s);
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }

    // Rename-preset popup. Opened by the pencil icon; pre-fills with
    // the active preset name. Enter (or OK) fires `rename-preset`;
    // Esc / click-outside / Cancel just close.
    rename-pop := PopupWindow {
        x: 240px;
        y: 44px;
        width: 280px;
        // Follows its content so 18px text never clips (#954).
        height: rename-box.preferred-height;
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.well;
            border-width: 1px;
            border-color: Theme.hair;
            border-radius: 6px;
            rename-box := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: @tr("Rename preset");
                    color: Theme.ink-2;
                    font-size: Theme.min-font;
                }
                Rectangle {
                    height: 32px;
                    background: Theme.panel-lo;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.hair;
                    name-input := TextInput {
                        x: 8px;
                        y: 0;
                        width: parent.width - 16px;
                        height: parent.height;
                        text <=> root.rename-draft;
                        single-line: true;
                        font-size: Theme.min-font;
                        color: Theme.ink;
                        vertical-alignment: center;
                        accepted => {
                            root.rename-preset(self.text);
                            rename-pop.close();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Rectangle {
                        width: Math.max(70px, cancel-label.preferred-width + 20px);
                        height: 30px;
                        background: cancel-ta.has-hover ? Theme.panel-hi : transparent;
                        border-width: 1px;
                        border-color: Theme.hair;
                        border-radius: 4px;
                        cancel-label := Text {
                            text: @tr("Cancel");
                            color: Theme.ink;
                            font-size: Theme.min-font;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cancel-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                rename-pop.close();
                            }
                        }
                    }
                    Rectangle {
                        width: Math.max(70px, ok-label.preferred-width + 20px);
                        height: 30px;
                        background: ok-ta.has-hover
                            ? Theme.palette.accent-end
                            : Theme.palette.accent-start;
                        border-radius: 4px;
                        ok-label := Text {
                            text: @tr("OK");
                            color: Theme.on-accent;
                            font-size: Theme.min-font;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ok-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.rename-preset(root.rename-draft);
                                rename-pop.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
