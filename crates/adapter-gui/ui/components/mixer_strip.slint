// Responsibility: renders one mixer fader strip.
// Level readout, a vertical fader, a row of small buttons under it (S, the
// mute speaker, reset to 0 dB), and the strip's label at the bottom (binding
// name + interface channels, like the scribble strip under a console fader).
// The strip only reports intent: the fader position it was dragged to, a
// reset (double-click or the reset button), a solo or mute press.

import { Theme } from "../theme.slint";
import { MixerStripRow } from "mixer_globals.slint";
import { StripLabel } from "strip_label.slint";

// A small console button (S / mute / reset): lit in its colour while its
// state is on. Shows its icon when it has one, its text otherwise.
component StripButton inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> lit;
    in property <color> lit-color;
    in property <color> lit-hover;
    in property <color> lit-border;
    // Hover of the TouchArea the strip places inside the button.
    in property <bool> hovered;
    callback pressed();

    width: 28px;
    height: 30px;
    border-radius: 5px;
    background: root.lit
        ? (root.hovered ? root.lit-hover : root.lit-color)
        : (root.hovered ? Theme.ktrack : Theme.panel);
    border-width: 1px;
    border-color: root.lit ? root.lit-border : Theme.hair;
    animate background { duration: 120ms; }

    if !root.has-icon : Text {
        width: 100%; height: 100%;
        text: root.text;
        color: root.lit ? Theme.on-accent : Theme.ink;
        font-family: "Bebas Neue";
        font-size: 18px;
        letter-spacing: 2.0px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.has-icon : Image {
        x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2;
        width: 16px; height: 16px;
        source: root.icon;
        image-fit: contain;
        colorize: root.lit ? Theme.on-accent : Theme.ink;
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.lit;
    accessible-action-default => { root.pressed(); }
}

export component MixerStripView inherits Rectangle {
    in property <MixerStripRow> strip;
    callback fader-moved(string, float);
    callback fader-reset(string);
    callback mute-toggled(string);
    callback solo-toggled(string);
    // The compact view's dual strip hosts two faders in one frame with one
    // shared label; its single faders (DI, LOOPER, MASTER) have no buttons.
    in property <bool> has-solo: true;
    in property <bool> has-mute: true;
    in property <bool> has-label: true;
    in property <bool> framed: true;
    in property <brush> face: Theme.well;

    width: 112px;
    border-radius: 6px;
    background: root.face;
    border-width: root.framed ? 1px : 0px;
    border-color: root.strip.soloed ? Theme.warn : Theme.hair-2;

    // Muted, or silenced by another strip's solo: the strip reads dim.
    private property <bool> silent: root.strip.muted || root.strip.solo-silenced;
    private property <length> cap-height: 20px;
    private property <length> fader-top: 36px;
    // The one-line name + the channels line, then the button row above them.
    private property <length> label-height: root.has-label ? 66px : 0px;
    private property <length> buttons-height: 30px;
    private property <length> fader-bottom: root.buttons-height + root.label-height + 16px;

    Text {
        x: 6px; y: 8px;
        width: parent.width - 12px; height: 22px;
        text: root.strip.gain-label;
        color: root.silent ? Theme.ink-3 : Theme.in;
        font-family: "Bebas Neue";
        font-size: 18px;
        horizontal-alignment: center;
    }

    fader := Rectangle {
        x: 0; y: root.fader-top;
        width: parent.width;
        height: parent.height - root.fader-top - root.fader-bottom;
        private property <length> travel: self.height - root.cap-height;
        // While held, the cap follows the pointer itself instead of waiting
        // for the app to redraw the strip from the dispatcher.
        private property <float> drag-position;
        private property <float> shown-position: fader-ta.pressed ? self.drag-position : root.strip.position;

        // Track.
        Rectangle {
            x: (parent.width - 6px) / 2; y: root.cap-height / 2;
            width: 6px; height: parent.travel;
            border-radius: 3px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.hair;
        }

        // Cap.
        cap := Rectangle {
            x: (parent.width - 44px) / 2;
            y: (1 - parent.shown-position) * parent.travel;
            width: 44px; height: root.cap-height;
            border-radius: 4px;
            background: fader-ta.pressed ? Theme.ink : (fader-ta.has-hover ? Theme.ink-2 : Theme.ink-2);
            opacity: root.silent ? 0.5 : 1.0;
            border-width: 1px;
            border-color: Theme.shadow;
            drop-shadow-blur: 4px;
            drop-shadow-color: Theme.shadow;

            Rectangle {
                x: 6px; y: (parent.height - 2px) / 2;
                width: parent.width - 12px; height: 2px;
                background: Theme.panel-hi;
            }
        }

        fader-ta := TouchArea {
            mouse-cursor: MouseCursor.ns-resize;
            private property <float> dragged:
                max(0, min(1, 1 - (self.mouse-y - root.cap-height / 2) / parent.travel));
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    parent.drag-position = self.dragged;
                    root.fader-moved(root.strip.id, self.dragged);
                }
            }
            moved => {
                if self.pressed {
                    parent.drag-position = self.dragged;
                    root.fader-moved(root.strip.id, self.dragged);
                }
            }
            double-clicked => { root.fader-reset(root.strip.id); }
        }
        accessible-role: slider;
        accessible-label: root.strip.name;
        accessible-value: root.strip.gain-label;
    }

    // ── Buttons: S, the mute speaker and reset, side by side under the fader ──
    HorizontalLayout {
        x: 4px; y: parent.height - root.label-height - 38px;
        width: parent.width - 8px; height: root.buttons-height;
        alignment: center;
        spacing: 4px;

        if root.has-solo : solo-btn := StripButton {
            text: @tr("action-mixer-solo-short");
            label: @tr("action-mixer-solo");
            lit: root.strip.soloed;
            lit-color: Theme.warn;
            lit-hover: Theme.warn.brighter(0.15);
            lit-border: Theme.warn.brighter(0.4);
            hovered: solo-ta.has-hover;
            pressed => { root.solo-toggled(root.strip.id); }
            solo-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.solo-toggled(root.strip.id); }
            }
        }

        if root.has-mute : mute-btn := StripButton {
            label: @tr("action-mixer-mute");
            has-icon: true;
            icon: root.strip.muted ? @image-url("../assets/volume-off.svg") : @image-url("../assets/volume.svg");
            lit: root.strip.muted;
            lit-color: Theme.bad;
            lit-hover: Theme.bad.brighter(0.15);
            lit-border: Theme.bad.brighter(0.4);
            hovered: mute-ta.has-hover;
            pressed => { root.mute-toggled(root.strip.id); }
            mute-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.mute-toggled(root.strip.id); }
            }
        }

        reset-btn := StripButton {
            label: @tr("action-mixer-reset");
            has-icon: true;
            icon: @image-url("../assets/undo.svg");
            hovered: reset-ta.has-hover;
            pressed => { root.fader-reset(root.strip.id); }
            reset-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.fader-reset(root.strip.id); }
            }
        }
    }

    // ── Label: which endpoint this is, at the bottom like a scribble strip ──
    StripLabel {
        x: 4px; y: parent.height - root.label-height - 4px;
        width: parent.width - 8px; height: root.label-height;
        visible: root.has-label;
        name: root.strip.name;
        detail: root.strip.detail;
        is-input: root.strip.is-input;
    }
}
