// Responsibility: renders one global mixer strip.
// #1007 — name, level readout, a vertical fader and a mute button, the way a
// console channel reads top to bottom. The strip only reports intent: the
// fader position it was dragged to, a double-click reset, a mute press.

import { MixerStripRow } from "mixer_globals.slint";
import { Theme } from "../theme.slint";

export component MixerStripView inherits Rectangle {
    in property <MixerStripRow> strip;
    callback fader-moved(string, float);
    callback fader-reset(string);
    callback mute-toggled(string);

    width: 96px;
    border-radius: 6px;
    background: #0c0f14;
    border-width: 1px;
    border-color: #1f2530;

    private property <length> cap-height: 20px;
    private property <length> fader-top: 80px;
    private property <length> fader-bottom: 54px;

    Text {
        x: 6px; y: 8px;
        width: parent.width - 12px; height: 22px;
        text: root.strip.name;
        color: #e5ebf2;
        font-family: "Bebas Neue";
        font-size: 18px;
        letter-spacing: 1.0px;
        horizontal-alignment: center;
        overflow: elide;
    }

    Text {
        x: 6px; y: 30px;
        width: parent.width - 12px; height: 22px;
        text: root.strip.detail;
        color: #6f7a8a;
        font-size: Theme.min-font;
        horizontal-alignment: center;
        overflow: elide;
    }

    Text {
        x: 6px; y: 52px;
        width: parent.width - 12px; height: 22px;
        text: root.strip.gain-label;
        color: root.strip.muted ? #6f7a8a : #9fd3ff;
        font-family: "Bebas Neue";
        font-size: 18px;
        horizontal-alignment: center;
    }

    fader := Rectangle {
        x: 0; y: root.fader-top;
        width: parent.width;
        height: parent.height - root.fader-top - root.fader-bottom;
        private property <length> travel: self.height - root.cap-height;

        // Track.
        Rectangle {
            x: (parent.width - 6px) / 2; y: root.cap-height / 2;
            width: 6px; height: parent.travel;
            border-radius: 3px;
            background: #1b212b;
            border-width: 1px;
            border-color: #2b3340;
        }

        // Cap.
        cap := Rectangle {
            x: (parent.width - 44px) / 2;
            y: (1 - root.strip.position) * parent.travel;
            width: 44px; height: root.cap-height;
            border-radius: 4px;
            background: fader-ta.pressed ? #d8e0ec : (fader-ta.has-hover ? #c5cdd9 : #aeb8c6);
            border-width: 1px;
            border-color: #00000080;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000080;

            Rectangle {
                x: 6px; y: (parent.height - 2px) / 2;
                width: parent.width - 12px; height: 2px;
                background: #2a3038;
            }
        }

        fader-ta := TouchArea {
            mouse-cursor: MouseCursor.ns-resize;
            private property <float> dragged:
                max(0, min(1, 1 - (self.mouse-y - root.cap-height / 2) / parent.travel));
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.fader-moved(root.strip.id, self.dragged);
                }
            }
            moved => {
                if self.pressed {
                    root.fader-moved(root.strip.id, self.dragged);
                }
            }
            double-clicked => { root.fader-reset(root.strip.id); }
        }
        accessible-role: slider;
        accessible-label: root.strip.name;
        accessible-value: root.strip.gain-label;
    }

    mute-btn := Rectangle {
        x: 10px; y: parent.height - 44px;
        width: parent.width - 20px; height: 34px;
        border-radius: 5px;
        background: root.strip.muted
            ? (mute-ta.has-hover ? #e0625c : #c8443e)
            : (mute-ta.has-hover ? #2a3340 : #1c2028);
        border-width: 1px;
        border-color: root.strip.muted ? #f08a84 : #2c323d;
        animate background { duration: 120ms; }

        Text {
            width: 100%; height: 100%;
            text: @tr("action-mixer-mute");
            color: root.strip.muted ? #1a0706 : #d8e0ec;
            font-family: "Bebas Neue";
            font-size: 18px;
            letter-spacing: 2.0px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        mute-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.mute-toggled(root.strip.id); }
        }
        accessible-role: button;
        accessible-label: @tr("action-mixer-mute");
        accessible-checked: root.strip.muted;
    }
}
