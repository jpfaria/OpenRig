// Responsibility: renders one mixer fader strip.
// Level readout, a vertical fader, a row of small buttons under it (S, the
// mute speaker, reset to 0 dB), and the strip's label at the bottom (binding
// name + interface channels, like the scribble strip under a console fader).
// The strip only reports intent: the fader position it was dragged to, a
// reset (double-click or the reset button), a solo or mute press.
// #398: a raised card — the level in a field, a thin groove lit in `tint` up
// to a white cap, a unity mark, small field buttons and a quiet label.

import { Theme, Gear } from "../theme.slint";
import { Locale } from "../locale_globals.slint";
import { MixerStripRow, MixerBridge } from "mixer_globals.slint";
import { StripLabel } from "strip_label.slint";

// A small console button (S / mute / reset): a field key, lit in its colour
// while its state is on. Shows its icon when it has one, its text otherwise.
component StripButton inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> lit;
    // Solo fills with its colour; mute only rings and inks in it.
    in property <bool> fill-when-lit;
    in property <color> lit-color;
    // Hover of the TouchArea the strip places inside the button.
    in property <bool> hovered;
    callback pressed();

    private property <color> ink: root.lit
        ? (root.fill-when-lit ? Gear.print : root.lit-color)
        : (root.hovered ? Theme.ink : Theme.ink-2);

    width: 28px;
    height: 24px;
    border-radius: 4px;
    background: root.lit && root.fill-when-lit ? root.lit-color
        : (root.hovered ? Theme.hover : Theme.field);
    border-width: 1px;
    border-color: root.lit ? root.lit-color : Theme.hair;
    animate background { duration: 120ms; }

    if !root.has-icon : Text {
        width: 100%; height: 100%;
        text: root.text;
        color: root.ink;
        font-size: Theme.min-font;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.has-icon : Image {
        x: (parent.width - 14px) / 2; y: (parent.height - 14px) / 2;
        width: 14px; height: 14px;
        source: root.icon;
        image-fit: contain;
        colorize: root.ink;
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.lit;
    accessible-action-default => { root.pressed(); }
}

export component MixerStripView inherits Rectangle {
    in property <MixerStripRow> strip;
    callback fader-moved(string, float);
    callback fader-reset(string);
    callback mute-toggled(string);
    callback solo-toggled(string);
    // The compact view's dual strip hosts two faders in one frame with one
    // shared label; its single faders (DI, LOOPER, MASTER) have no buttons.
    in property <bool> has-solo: true;
    in property <bool> has-mute: true;
    in property <bool> has-label: true;
    in property <bool> framed: true;
    in property <brush> face: Theme.panel-hi;
    // The lit part of the groove.
    in property <color> tint: Theme.accent;
    // The chain's MASTER strip carries an accent line on top.
    in property <bool> master: false;

    width: 112px;
    border-radius: 5px;
    background: root.face;
    border-width: root.strip.soloed ? 2px : (root.framed ? 1px : 0px);
    border-color: root.strip.soloed ? Theme.warn : Theme.hair;

    // Muted, or silenced by another strip's solo: the strip reads dim.
    private property <bool> silent: root.strip.muted || root.strip.solo-silenced;
    private property <length> pad: root.framed ? 10px : 4px;
    private property <length> readout-height: 26px;
    private property <length> cap-height: 20px;
    private property <length> buttons-height: 24px;
    private property <length> label-height: root.has-label ? 54px : 0px;
    private property <length> fader-top: root.pad + root.readout-height + 8px;
    private property <length> buttons-y:
        root.height - root.pad - root.label-height - (root.has-label ? 10px : 0px) - root.buttons-height;
    private property <length> fader-bottom: root.height - root.buttons-y + 8px;

    if root.master : Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }

    // ── The level, in a field ──
    Rectangle {
        x: (parent.width - self.width) / 2; y: root.pad;
        width: max(70px, readout.preferred-width + 12px);
        height: root.readout-height;
        border-radius: 3px;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.hair;

        readout := Text {
            text: root.strip.gain-label;
            font-family: Locale.mono-font-family;
            color: root.silent ? Theme.ink-3 : Theme.ink;
            font-size: Theme.min-font;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    fader := Rectangle {
        x: 0; y: root.fader-top;
        width: parent.width;
        height: parent.height - root.fader-top - root.fader-bottom;
        private property <length> travel: self.height - root.cap-height;
        // While held, the cap follows the pointer itself instead of waiting
        // for the app to redraw the strip from the dispatcher.
        private property <float> drag-position;
        private property <float> shown-position: fader-ta.pressed ? self.drag-position : root.strip.position;
        private property <length> cap-y: (1 - self.shown-position) * self.travel;

        // The groove, lit from the bottom up to the cap.
        Rectangle {
            x: (parent.width - 3px) / 2; y: root.cap-height / 2;
            width: 3px; height: parent.travel;
            border-radius: 1.5px;
            background: Theme.groove;
            clip: true;

            Rectangle {
                x: 0; y: parent.height - self.height;
                width: parent.width;
                height: parent.height * fader.shown-position;
                background: root.silent ? Theme.ink-3 : root.tint;
            }
        }

        // The unity mark.
        Rectangle {
            x: 22px; y: root.cap-height / 2 + (1 - MixerBridge.unity-position) * parent.travel;
            width: parent.width - 44px; height: 1px;
            background: Theme.ink-3;
            opacity: 0.5;
        }

        // The cap's drop.
        Rectangle {
            x: (parent.width - 46px) / 2; y: parent.cap-y + 2px;
            width: 46px; height: root.cap-height;
            border-radius: 4px;
            background: Gear.knob-drop;
            opacity: root.silent ? 0.55 : 1.0;
        }

        // The white cap with its centre line.
        cap := Rectangle {
            x: (parent.width - 46px) / 2; y: parent.cap-y;
            width: 46px; height: root.cap-height;
            border-radius: 4px;
            background: Gear.knob-edge;
            border-width: 1px;
            border-color: Gear.edge-soft;
            clip: true;
            opacity: root.silent ? 0.55 : 1.0;

            Rectangle {
                x: 1px; y: 1px;
                width: parent.width - 2px; height: parent.height * 0.55;
                background: Gear.white;
            }

            Rectangle {
                x: 1px; y: parent.height * 0.55;
                width: parent.width - 2px; height: parent.height * 0.25;
                background: Gear.knob-mid;
            }

            Rectangle {
                x: 7px; y: (parent.height - 2px) / 2;
                width: parent.width - 14px; height: 2px;
                background: fader-ta.pressed ? Theme.accent : Gear.print;
            }
        }

        fader-ta := TouchArea {
            mouse-cursor: MouseCursor.ns-resize;
            private property <float> dragged:
                max(0, min(1, 1 - (self.mouse-y - root.cap-height / 2) / parent.travel));
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    parent.drag-position = self.dragged;
                    root.fader-moved(root.strip.id, self.dragged);
                }
            }
            moved => {
                if self.pressed {
                    parent.drag-position = self.dragged;
                    root.fader-moved(root.strip.id, self.dragged);
                }
            }
            double-clicked => { root.fader-reset(root.strip.id); }
        }
        accessible-role: slider;
        accessible-label: root.strip.name;
        accessible-value: root.strip.gain-label;
    }

    // ── Buttons: S, the mute speaker and reset, side by side under the fader ──
    HorizontalLayout {
        x: 4px; y: root.buttons-y;
        width: parent.width - 8px; height: root.buttons-height;
        alignment: center;
        spacing: 4px;

        if root.has-solo : solo-btn := StripButton {
            text: @tr("action-mixer-solo-short");
            label: @tr("action-mixer-solo");
            lit: root.strip.soloed;
            fill-when-lit: true;
            lit-color: Theme.warn;
            hovered: solo-ta.has-hover;
            pressed => { root.solo-toggled(root.strip.id); }
            solo-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.solo-toggled(root.strip.id); }
            }
        }

        if root.has-mute : mute-btn := StripButton {
            label: @tr("action-mixer-mute");
            has-icon: true;
            icon: root.strip.muted ? @image-url("../assets/volume-off.svg") : @image-url("../assets/volume.svg");
            lit: root.strip.muted;
            lit-color: Theme.bad;
            hovered: mute-ta.has-hover;
            pressed => { root.mute-toggled(root.strip.id); }
            mute-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.mute-toggled(root.strip.id); }
            }
        }

        reset-btn := StripButton {
            label: @tr("action-mixer-reset");
            has-icon: true;
            icon: @image-url("../assets/undo.svg");
            hovered: reset-ta.has-hover;
            pressed => { root.fader-reset(root.strip.id); }
            reset-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.fader-reset(root.strip.id); }
            }
        }
    }

    // ── Label: which endpoint this is, at the bottom like a scribble strip ──
    StripLabel {
        x: 4px; y: parent.height - root.pad - root.label-height;
        width: parent.width - 8px; height: root.label-height;
        visible: root.has-label;
        name: root.strip.name;
        detail: root.strip.detail;
        is-input: root.strip.is-input;
    }
}
