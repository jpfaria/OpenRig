// Responsibility: renders one global mixer strip.
// #1007 — level readout, a vertical fader, SOLO and MUTE, and the strip's
// label at the bottom (binding name + interface channels, like the scribble
// strip under a console fader). The strip only reports intent: the fader
// position it was dragged to, a double-click reset, a solo or mute press.

import { MixerStripRow } from "mixer_globals.slint";
import { Theme } from "../theme.slint";

// A console button (SOLO / MUTE): lit in its colour while its state is on.
component StripButton inherits Rectangle {
    in property <string> label;
    in property <bool> lit;
    in property <color> lit-color;
    in property <color> lit-hover;
    in property <color> lit-border;
    // Hover of the TouchArea the strip places inside the button.
    in property <bool> hovered;
    callback pressed();

    height: 30px;
    border-radius: 5px;
    background: root.lit
        ? (root.hovered ? root.lit-hover : root.lit-color)
        : (root.hovered ? #2a3340 : #1c2028);
    border-width: 1px;
    border-color: root.lit ? root.lit-border : #2c323d;
    animate background { duration: 120ms; }

    Text {
        width: 100%; height: 100%;
        text: root.label;
        color: root.lit ? #14100a : #d8e0ec;
        font-family: "Bebas Neue";
        font-size: 18px;
        letter-spacing: 2.0px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.lit;
    accessible-action-default => { root.pressed(); }
}

export component MixerStripView inherits Rectangle {
    in property <MixerStripRow> strip;
    callback fader-moved(string, float);
    callback fader-reset(string);
    callback mute-toggled(string);
    callback solo-toggled(string);

    width: 112px;
    border-radius: 6px;
    background: #0c0f14;
    border-width: 1px;
    border-color: root.strip.soloed ? #b8962e : #1f2530;

    // Muted, or silenced by another strip's solo: the strip reads dim.
    private property <bool> silent: root.strip.muted || root.strip.solo-silenced;
    private property <length> cap-height: 20px;
    private property <length> fader-top: 36px;
    // The one-line name + the channels line, then SOLO + MUTE above them.
    private property <length> label-height: 66px;
    private property <length> buttons-height: 66px;
    private property <length> fader-bottom: root.buttons-height + root.label-height + 16px;

    Text {
        x: 6px; y: 8px;
        width: parent.width - 12px; height: 22px;
        text: root.strip.gain-label;
        color: root.silent ? #6f7a8a : #9fd3ff;
        font-family: "Bebas Neue";
        font-size: 18px;
        horizontal-alignment: center;
    }

    fader := Rectangle {
        x: 0; y: root.fader-top;
        width: parent.width;
        height: parent.height - root.fader-top - root.fader-bottom;
        private property <length> travel: self.height - root.cap-height;
        // While held, the cap follows the pointer itself instead of waiting
        // for the app to redraw the strip from the dispatcher.
        private property <float> drag-position;
        private property <float> shown-position: fader-ta.pressed ? self.drag-position : root.strip.position;

        // Track.
        Rectangle {
            x: (parent.width - 6px) / 2; y: root.cap-height / 2;
            width: 6px; height: parent.travel;
            border-radius: 3px;
            background: #1b212b;
            border-width: 1px;
            border-color: #2b3340;
        }

        // Cap.
        cap := Rectangle {
            x: (parent.width - 44px) / 2;
            y: (1 - parent.shown-position) * parent.travel;
            width: 44px; height: root.cap-height;
            border-radius: 4px;
            background: fader-ta.pressed ? #d8e0ec : (fader-ta.has-hover ? #c5cdd9 : #aeb8c6);
            opacity: root.silent ? 0.5 : 1.0;
            border-width: 1px;
            border-color: #00000080;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000080;

            Rectangle {
                x: 6px; y: (parent.height - 2px) / 2;
                width: parent.width - 12px; height: 2px;
                background: #2a3038;
            }
        }

        fader-ta := TouchArea {
            mouse-cursor: MouseCursor.ns-resize;
            private property <float> dragged:
                max(0, min(1, 1 - (self.mouse-y - root.cap-height / 2) / parent.travel));
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    parent.drag-position = self.dragged;
                    root.fader-moved(root.strip.id, self.dragged);
                }
            }
            moved => {
                if self.pressed {
                    parent.drag-position = self.dragged;
                    root.fader-moved(root.strip.id, self.dragged);
                }
            }
            double-clicked => { root.fader-reset(root.strip.id); }
        }
        accessible-role: slider;
        accessible-label: root.strip.name;
        accessible-value: root.strip.gain-label;
    }

    solo-btn := StripButton {
        x: 10px; y: parent.height - root.label-height - root.buttons-height - 8px;
        width: parent.width - 20px;
        label: @tr("action-mixer-solo");
        lit: root.strip.soloed;
        lit-color: #d9b43a;
        lit-hover: #e8c552;
        lit-border: #f2d77e;
        hovered: solo-ta.has-hover;
        pressed => { root.solo-toggled(root.strip.id); }
        solo-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.solo-toggled(root.strip.id); }
        }
    }

    mute-btn := StripButton {
        x: 10px; y: solo-btn.y + 36px;
        width: parent.width - 20px;
        label: @tr("action-mixer-mute");
        lit: root.strip.muted;
        lit-color: #c8443e;
        lit-hover: #e0625c;
        lit-border: #f08a84;
        hovered: mute-ta.has-hover;
        pressed => { root.mute-toggled(root.strip.id); }
        mute-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.mute-toggled(root.strip.id); }
        }
    }

    // ── Label: which endpoint this is, at the bottom like a scribble strip ──
    // The name is ONE elided line and the box clips, so a long binding name
    // can never climb over the buttons; hovering shows the full name.
    label-box := Rectangle {
        x: 4px; y: parent.height - root.label-height - 4px;
        width: parent.width - 8px; height: root.label-height;
        border-radius: 4px;
        background: #121720;
        clip: true;

        Text {
            x: 4px; y: 6px;
            width: parent.width - 8px; height: 30px;
            text: root.strip.name;
            color: #e5ebf2;
            font-family: "Bebas Neue";
            font-size: 18px;
            letter-spacing: 0.5px;
            wrap: no-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        name-ta := TouchArea {}

        Text {
            x: 4px; y: 38px;
            width: parent.width - 8px; height: 22px;
            text: root.strip.detail;
            color: root.strip.is-input ? #7fc4ff : #ffb86b;
            font-family: "Bebas Neue";
            font-size: Theme.min-font;
            letter-spacing: 1.0px;
            horizontal-alignment: center;
        }
    }

    // Full name on hover, just above the label box (same look as IconTooltip).
    if name-ta.has-hover : Rectangle {
        x: 2px;
        y: label-box.y - self.height - 2px;
        width: parent.width - 4px;
        height: full-name.preferred-height + 8px;
        background: #11141aef;
        border-width: 1px;
        border-color: #3b4250;
        border-radius: 4px;

        full-name := Text {
            x: 4px; y: 4px;
            width: parent.width - 8px;
            text: root.strip.name;
            color: #dde4ef;
            font-size: 18px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}
