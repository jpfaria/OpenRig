// Responsibility: renders the looper endpoint picker modal.
// The option list of a loop's record-from or play-to select: a root-level
// overlay (never a PopupWindow, so every option is a reachable in-tree
// TouchArea). Shared by the main window's looper overlay and the compact view.
//
// #398: the same dialog card as the preset picker — the title in the display
// face over one framed list, the current endpoint tinted with an accent edge.

import { Theme } from "../theme.slint";
import { LooperPanel } from "looper_panel_globals.slint";
import { ListBox, ListRow } from "list_box.slint";
import { Locale } from "../locale_globals.slint";

export component LooperEndpointPicker inherits Rectangle {
    in property <[string]> input-options;
    in property <[string]> output-options;
    // (chain-index, uid, option-index) — the picked endpoint.
    callback input-picked(int, int, int);
    callback output-picked(int, int, int);

    private property <bool> is-output: LooperPanel.endpoint-picker-kind == 1;
    private property <[string]> options: root.is-output ? root.output-options : root.input-options;

    background: Theme.scrim;

    // Click-outside closes without changing the endpoint.
    TouchArea { clicked => { LooperPanel.endpoint-picker-uid = -1; } }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 32px, 420px);
        height: min(root.height - 80px, 18px + 24px + 10px + root.options.length * 44px + 2px + 18px);
        background: Theme.panel;
        border-radius: 6px;
        clip: true;
        border-width: 1px;
        border-color: Theme.hair;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.shadow;

        // Swallow clicks on the card so only the scrim closes it.
        TouchArea { }

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                height: 24px;
                text: root.is-output ? @tr("looper-output") : @tr("looper-input");
                color: Theme.ink;
                font-family: Locale.display-font-family;
                font-size: 24px;
                letter-spacing: 0.05 * 24px;
                vertical-alignment: center;
            }

            Flickable {
                viewport-height: options-box.preferred-height;
                options-box := ListBox {
                    width: parent.width;

                    for option[i] in root.options : Rectangle {
                        min-height: 44px;
                        background: opt-ta.has-hover ? Theme.hover : transparent;

                        opt-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if root.is-output {
                                    root.output-picked(LooperPanel.chain-index, LooperPanel.endpoint-picker-uid, i);
                                } else {
                                    root.input-picked(LooperPanel.chain-index, LooperPanel.endpoint-picker-uid, i);
                                }
                                LooperPanel.endpoint-picker-uid = -1;
                            }
                        }

                        ListRow {
                            width: parent.width;
                            height: parent.height;
                            divided: i > 0;
                            on: i == LooperPanel.endpoint-picker-selected;
                            Text {
                                horizontal-stretch: 1;
                                text: option;
                                color: Theme.ink;
                                font-size: Theme.min-font;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        accessible-role: button;
                        accessible-label: option;
                        accessible-checked: i == LooperPanel.endpoint-picker-selected;
                    }
                }
            }
        }
    }
}
