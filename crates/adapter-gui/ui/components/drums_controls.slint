// Responsibility: renders the drum machine's building-block controls.
import { Theme } from "../theme.slint";
// Kept out of `pages/drums_window.slint` so the page stays about layout. The
// lamps, knob cells and power switch come from the metronome's controls, so
// both utilities speak the same pedal vocabulary.

// A captioned footswitch: FILL. Same sprite as POWER, larger, because it is
// pressed mid-song.
export component DrumFootSwitch inherits Rectangle {
    in property <string> caption;
    in property <bool> active;
    in property <bool> enabled: true;
    callback pressed();

    width: max(72px, caption-text.preferred-width);
    height: 108px;

    Rectangle {
        x: (parent.width - 64px) / 2; y: 4px;
        width: 64px; height: 64px;
        clip: true;
        opacity: root.enabled ? 1.0 : 0.35;
        // Sprite is vertical: two square frames, top = pressed/on.
        Image {
            source: @image-url("../assets/sprites/footswitch.png");
            x: 0;
            y: root.active ? -parent.height : 0;
            width: parent.width;
            height: 2 * parent.height;
            image-fit: fill;
            image-rendering: smooth;
        }
        // Named so the headless interaction test can find and press it.
        ta := TouchArea {
            mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                if root.enabled {
                    root.pressed();
                }
            }
        }
    }

    caption-text := Text {
        x: 0; y: parent.height - 30px;
        width: parent.width; height: 22px;
        text: root.caption;
        color: root.active ? Theme.warn : Theme.ink-3;
        font-family: "Bebas Neue";
        font-size: 18px;
        letter-spacing: 1.6px;
        horizontal-alignment: center;
    }

    accessible-role: button;
    accessible-label: root.caption;
}

// Captioned closed field showing the current choice; click opens its list.
export component DrumPickerField inherits Rectangle {
    in property <string> caption;
    in property <string> label;
    in property <string> placeholder;
    in property <image> icon;
    callback open();

    height: 62px;

    Text {
        x: 0; y: 0;
        width: parent.width; height: 22px;
        text: root.caption;
        color: Theme.ink-3;
        font-family: "Bebas Neue";
        font-size: 18px;
        letter-spacing: 1.6px;
    }

    Rectangle {
        x: 0; y: 24px;
        width: parent.width; height: 38px;
        border-radius: 6px;
        background: Theme.well;
        border-width: 1px;
        border-color: ta.has-hover ? Theme.field-line : Theme.hair;

        Image {
            x: 10px; y: (parent.height - 16px) / 2;
            width: 16px; height: 16px;
            source: root.icon;
            colorize: Theme.ink-2;
        }
        Text {
            x: 34px;
            width: parent.width - 64px;
            height: parent.height;
            text: root.label != "" ? root.label : root.placeholder;
            color: root.label != "" ? Theme.ink : Theme.ink-3;
            font-size: 18px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Image {
            x: parent.width - 30px; y: (parent.height - 16px) / 2;
            width: 16px; height: 16px;
            source: @image-url("../assets/arrow-down.svg");
            colorize: Theme.ink-2;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(); }
        }
    }

    accessible-role: button;
    accessible-label: root.caption;
}

// One row of a picker list: a genre header, or a clickable choice. A plain
// Rectangle + TouchArea — rows inside a PopupWindow do not receive clicks.
export component DrumPickRowView inherits Rectangle {
    in property <string> label;
    in property <bool> header;
    in property <bool> active;
    callback pick();

    height: root.header ? 32px : 40px;

    if root.header : genre := Text {
        x: 12px; y: 6px;
        width: parent.width - 24px; height: parent.height - 6px;
        text: root.label;
        color: Theme.warn;
        font-family: "Bebas Neue";
        font-size: 18px;
        letter-spacing: 2.0px;
        vertical-alignment: center;
        accessible-role: text;
        accessible-label: root.label;
    }

    if !root.header : Rectangle {
        width: 100%; height: 100%;
        border-radius: 5px;
        background: root.active ? Theme.accent-soft : (ta.has-hover ? Theme.panel-hi : transparent);

        Text {
            x: 24px;
            width: parent.width - 36px;
            height: parent.height;
            text: root.label;
            color: Theme.ink;
            font-size: 18px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pick(); }
        }
        accessible-role: button;
        accessible-label: root.label;
    }
}
