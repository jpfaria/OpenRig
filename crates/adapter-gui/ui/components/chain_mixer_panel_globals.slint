// Responsibility: carries the state of the chain list's mixer overlay.
// #1007 — a chain card's mixer button opens THAT chain's mixer over the chain
// list. `chain-index` names the chain; `opened` asks Rust to draw it. The
// global halves of its dual strips are only that chain's endpoints, so they
// live here instead of on `MixerBridge` (which carries every endpoint for the
// Mixer window). The chain's own faders stay on `ChainMixerBridge`.

import { MixerStripRow } from "mixer_globals.slint";

export global ChainMixerPanel {
    in-out property <bool> open: false;
    in-out property <int> chain-index: -1;
    in-out property <[MixerStripRow]> global-inputs;
    in-out property <[MixerStripRow]> global-outputs;
    // The mixer of chain `index` was just opened.
    callback opened(int);
}
