// Responsibility: renders the button that installs a newer OpenRig release.
import { Theme } from "../theme.slint";

export component UpdateButton inherits Rectangle {
    in property <string> latest-version;
    callback clicked();

    width: row.preferred-width;
    height: 26px;
    border-radius: 4px;
    background: touch.pressed ? Theme.accent.darker(0.15) : touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent;
    border-width: 1px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: @tr("btn-update-to {}", root.latest-version);
    accessible-action-default => { root.clicked(); }

    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../assets/arrow-down.svg");
            colorize: Theme.on-accent;
        }

        Text {
            text: @tr("btn-update-to {}", root.latest-version);
            color: Theme.on-accent;
            font-size: Theme.min-font;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
