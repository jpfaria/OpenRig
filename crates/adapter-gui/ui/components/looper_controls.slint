// Responsibility: renders the looper's controls.
// #323 — the small reusable pieces of the looper panel: a round icon button
// with a 40 px touch target, a quiet row action, a 0..100 slider and a
// segmented choice. Kept apart from `looper_row.slint` so both stay well under
// the 500-line cap.
//
// #398: every drawer control is a captioned field — the caption above, the
// control below on a 32 px line — so the drawer lays out as a grid.

import { Theme, Gear } from "../theme.slint";
import { FieldCaption } from "field_caption.slint";

export component LooperIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;          // accessible name, already translated
    in property <color> tint: Theme.ink-2;
    in property <color> active-background: transparent;
    // A lit button drops the ring unless the caller draws its own.
    in property <color> ring: root.active-background != transparent ? transparent : Theme.field-line;
    in property <bool> is-enabled: true;

    callback clicked();

    // #398: a round 40 px transport button on a field, ringed by the field
    // line, the icon quiet until the button is lit. Positioned by the caller
    // (the transport is an absolute cluster).
    width: 40px;
    height: 40px;
    border-radius: 20px;
    opacity: root.is-enabled ? 1.0 : 0.35;
    background: root.active-background != transparent ? root.active-background
        : ta.has-hover && root.is-enabled ? Theme.panel-hi
        : Theme.field;
    border-width: 1px;
    border-color: root.ring;

    Image {
        x: 11px;
        y: 11px;
        width: 18px;
        height: 18px;
        source: root.icon;
        image-fit: contain;
        colorize: root.tint;
    }

    ta := TouchArea {
        enabled: root.is-enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.is-enabled;
    accessible-action-default => { root.clicked(); }
}

// A quiet row action (edit, save, parameters, remove): the icon alone, ink-3
// until hovered, accent while its drawer is open. 40 px tall so the touch
// target matches the transport beside it.
export component LooperRowAction inherits Rectangle {
    in property <image> icon;
    in property <string> label;          // accessible name, already translated
    in property <bool> active;
    in property <bool> is-enabled: true;
    callback clicked();

    width: 30px;
    height: 40px;
    opacity: root.is-enabled ? 1.0 : 0.35;

    Rectangle {
        y: 5px;
        width: 30px;
        height: 30px;
        border-radius: 4px;
        background: ta.has-hover && root.is-enabled ? Theme.panel-lo : transparent;

        Image {
            x: 7px;
            y: 7px;
            width: 16px;
            height: 16px;
            source: root.icon;
            image-fit: contain;
            colorize: root.active ? Theme.accent
                : ta.has-hover && root.is-enabled ? Theme.ink
                : Theme.ink-3;
        }
    }

    ta := TouchArea {
        enabled: root.is-enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.is-enabled;
    accessible-action-default => { root.clicked(); }
}

/// 0..100 slider under its caption. Dragging only previews; the value is
/// reported on release, so a drag does not flood the command bus.
export component LooperSlider inherits Rectangle {
    in property <string> label;
    in-out property <int> value;
    // What the readout says; empty shows the value as a percentage.
    in property <string> value-label;
    callback value-changed(int);

    private property <length> value-w: max(44px, value-text.preferred-width);

    height: 60px;

    FieldCaption {
        x: 0;
        y: 0;
        width: parent.width;
        height: 22px;
        text: root.label;
    }

    // The groove, its accent fill and a metal knob riding on the value.
    track := Rectangle {
        x: 8px;
        y: 28px + 16px - 1.5px;
        width: parent.width - 16px - root.value-w - 8px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.groove;

        Rectangle {
            x: 0;
            width: parent.width * root.value / 100;
            height: parent.height;
            border-radius: 1.5px;
            background: Theme.accent;
        }

        Rectangle {
            x: parent.width * root.value / 100 - 8px;
            y: -6.5px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: @linear-gradient(180deg, Gear.white 0%, Gear.key-lo 100%);
            border-width: 1px;
            border-color: drag.has-hover || drag.pressed ? Theme.accent : Gear.edge-soft;
        }

        drag := TouchArea {
            x: -8px;
            y: -14px;
            width: parent.width + 16px;
            height: parent.height + 28px;
            mouse-cursor: pointer;

            moved => {
                if (self.pressed) {
                    root.value = Math.max(0, Math.min(100,
                        Math.round((self.mouse-x - 8px) / track.width * 100)));
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.value = Math.max(0, Math.min(100,
                        Math.round((self.mouse-x - 8px) / track.width * 100)));
                }
                if (e.kind == PointerEventKind.up) {
                    root.value-changed(root.value);
                }
            }
        }
    }

    value-text := Text {
        x: parent.width - root.value-w;
        y: 28px;
        width: root.value-w;
        height: 32px;
        vertical-alignment: center;
        horizontal-alignment: right;
        text: root.value-label != "" ? root.value-label : root.value + "%";
        color: Theme.ink;
        font-size: Theme.min-font;
        font-weight: 500;
    }

    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
}

/// A few choices under their caption, all shown, the current one lit — used
/// for the playback speed.
export component LooperSegmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index;
    in property <string> label;
    callback picked(int);

    height: 60px;

    FieldCaption {
        x: 0;
        y: 0;
        width: parent.width;
        height: 22px;
        text: root.label;
    }

    Rectangle {
        x: 0;
        y: 28px;
        width: min(parent.width, row.preferred-width);
        height: 32px;
        border-radius: 4px;
        clip: true;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.field-line;

        row := HorizontalLayout {
            padding: 1px;

            for option[index] in root.options : Rectangle {
                min-width: max(44px, opt-text.preferred-width + 24px);
                background: index == root.selected-index ? Theme.accent
                    : opt-ta.has-hover ? Theme.panel-hi
                    : transparent;

                if index > 0 && index != root.selected-index && index - 1 != root.selected-index : Rectangle {
                    x: 0;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Theme.hair-2;
                }

                opt-text := Text {
                    text: option;
                    color: index == root.selected-index ? Theme.on-accent : Theme.ink-2;
                    font-size: Theme.min-font;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                opt-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(index); }
                }

                accessible-role: button;
                accessible-label: option;
                accessible-action-default => { root.picked(index); }
            }
        }
    }
}
