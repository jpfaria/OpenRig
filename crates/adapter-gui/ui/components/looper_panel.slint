// Responsibility: renders the chain's looper panel.
// #323 — the looper "janela": the chain's loopers as a stacked list, one row
// each with its own transport. Opened by the loop button in the chain header,
// rendered at the window root (see looper_overlay.slint) so the chain list
// never clips it.
//
// INLINE (inherits Rectangle), NOT a PopupWindow — same reason as the DI panel
// (#749/#761): a panel can grow when a row's drawer opens, and every click is
// a normal in-tree TouchArea the headless interaction test can actuate.
//
// #398: a tool window — the dark bar with the loop icon, the title and the
// panel's actions (play all, stop all, new looper), then one card per looper
// on the panel. Embedded in a compact section, the actions head the body.

import { Theme } from "../theme.slint";
import { LooperItem } from "../models.slint";
import { LooperRow } from "looper_row.slint";
import { ToolBar } from "tool_bar.slint";
import { PanelActionButton } from "panel_action_button.slint";

export component LooperPanelView inherits Rectangle {
    in property <[LooperItem]> loopers;
    in property <int> expanded-uid: -1;
    in property <bool> can-add: true;
    // #323: the chain's input / output endpoint labels, shared by every row's
    // record-from / play-to selects.
    in property <[string]> input-options;
    in property <[string]> output-options;
    // #323 phase 2: the chain's preset options (index 0 = follow the chain).
    in property <[string]> preset-options;

    // Inside a compact-view section the section is the panel: no box of its
    // own, no title (the section header names it), no inset gutter.
    in property <bool> embedded: false;
    // The most the panel may take: its host caps it to the window, and the
    // body scrolls under the bar past that (#398).
    in property <length> height-cap: 100000px;

    callback add();
    // #903: the panel's global transport — the whole chain at once. A row's
    // own play stays single: the owner wants both, one loop alone or the
    // take together.
    callback play-all();
    callback stop-all();
    callback record(int);
    callback play-stop(int);
    callback undo(int);
    callback redo(int);
    callback clear(int);
    callback remove(int);
    callback toggle-drawer(int);
    callback mix-changed(int, int);
    callback decay-changed(int, int);
    callback speed-picked(int, int);
    callback reverse-toggled(int, bool);
    // (uid, kind, selected) — open a loop's endpoint list; kind 0 is the
    // record-from list, 1 the play-to list.
    callback endpoint-open(int, int, int);
    callback preset-open(int, int);
    // #826: open the waveform editor for this loop.
    callback edit(int);
    // #827: open the save-take dialog for this loop.
    callback save-take(int);

    private property <bool> is-empty: root.loopers.length == 0;
    private property <length> bar-h: root.embedded ? 0px : 46px;
    // Embedded, the actions take the first line of the body.
    private property <length> actions-h: root.embedded ? 40px : 0px;

    width: 600px;
    height: min(root.bar-h + root.actions-h + body.preferred-height, root.height-cap);
    border-radius: root.embedded ? 0px : 6px;
    background: root.embedded ? transparent : Theme.panel;
    border-width: root.embedded ? 0px : 1px;
    border-color: Theme.hair;
    drop-shadow-blur: root.embedded ? 0px : 24px;
    drop-shadow-offset-y: root.embedded ? 0px : 8px;
    drop-shadow-color: Theme.shadow;
    clip: true;

    // A click on the panel's own surface stays in the panel (the overlay's
    // backdrop behind it closes the panel).
    TouchArea { }

    if !root.embedded : title := ToolBar {
        x: 0;
        y: 0;
        width: parent.width;
        icon: @image-url("../assets/loop.svg");
        title: @tr("looper-panel-title");
    }

    // ── the panel's actions ─────────────────────────────────────────────
    // #903: the global transport acts on the whole chain at once; a row's own
    // play stays single. Dead while there is no loop.
    HorizontalLayout {
        x: parent.width - self.width - (root.embedded ? 0px : 12px);
        y: root.embedded ? 0px : 9px;
        width: self.preferred-width;
        height: 28px;
        spacing: 6px;

        play-all-btn := PanelActionButton {
            icon-only: true;
            icon: @image-url("../assets/play.svg");
            label: @tr("looper-play-all");
            on-bar: !root.embedded;
            enabled: !root.is-empty;
            hovered: play-all-ta.has-hover;
            clicked => { root.play-all(); }

            play-all-ta := TouchArea {
                enabled: !root.is-empty;
                mouse-cursor: pointer;
                clicked => { root.play-all(); }
            }
        }

        stop-all-btn := PanelActionButton {
            icon-only: true;
            icon: @image-url("../assets/stop.svg");
            label: @tr("looper-stop-all");
            on-bar: !root.embedded;
            enabled: !root.is-empty;
            hovered: stop-all-ta.has-hover;
            clicked => { root.stop-all(); }

            stop-all-ta := TouchArea {
                enabled: !root.is-empty;
                mouse-cursor: pointer;
                clicked => { root.stop-all(); }
            }
        }

        add-button := PanelActionButton {
            icon-only: true;
            icon: @image-url("../assets/plus.svg");
            label: @tr("looper-add");
            primary: true;
            enabled: root.can-add;
            hovered: add-ta.has-hover;
            clicked => { root.add(); }

            add-ta := TouchArea {
                enabled: root.can-add;
                mouse-cursor: pointer;
                clicked => { root.add(); }
            }
        }
    }

    // ── the loopers ─────────────────────────────────────────────────────
    scroll := Flickable {
        x: 0;
        y: root.bar-h + root.actions-h;
        width: parent.width;
        height: parent.height - self.y;
        content-width: self.width;
        content-height: body.preferred-height;
        // Wheel always; drag only when there is something to scroll, so a
        // short panel's sliders are never taken for a flick.
        interactive: self.content-height > self.height;

        body := VerticalLayout {
            width: parent.width;
            height: self.preferred-height;
            padding-left: root.embedded ? 0px : 16px;
            padding-right: root.embedded ? 0px : 16px;
            padding-top: root.embedded ? 0px : 14px;
            padding-bottom: root.embedded ? 4px : 16px;
            spacing: 10px;

            // No loop yet: say so on a card where the first loop will appear.
            if root.is-empty : Rectangle {
                height: empty-col.preferred-height;
                border-radius: 5px;
                background: Theme.panel-hi;
                border-width: 1px;
                border-color: Theme.hair;

                empty-col := VerticalLayout {
                    padding: 20px;
                    spacing: 6px;

                    Text {
                        text: @tr("looper-empty-title");
                        color: Theme.ink-2;
                        font-size: Theme.min-font;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: @tr("looper-empty-hint");
                        color: Theme.ink-3;
                        font-size: Theme.min-font;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            for item[index] in root.loopers : LooperRow {
                looper: item;
                expanded: item.uid == root.expanded-uid;
                input-options: root.input-options;
                output-options: root.output-options;
                preset-options: root.preset-options;
                record => { root.record(item.uid); }
                play-stop => { root.play-stop(item.uid); }
                undo => { root.undo(item.uid); }
                redo => { root.redo(item.uid); }
                clear => { root.clear(item.uid); }
                remove => { root.remove(item.uid); }
                toggle-drawer => { root.toggle-drawer(item.uid); }
                mix-changed(v) => { root.mix-changed(item.uid, v); }
                decay-changed(v) => { root.decay-changed(item.uid, v); }
                speed-picked(v) => { root.speed-picked(item.uid, v); }
                reverse-toggled(v) => { root.reverse-toggled(item.uid, v); }
                input-open => { root.endpoint-open(item.uid, 0, item.input_index); }
                output-open => { root.endpoint-open(item.uid, 1, item.output_index); }
                preset-open => { root.preset-open(item.uid, item.preset_index); }
                edit => { root.edit(item.uid); }
                save-take => { root.save-take(item.uid); }
            }
        }
    }
}
