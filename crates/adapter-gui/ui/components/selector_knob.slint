// Responsibility: renders a rotary selector knob.
// #398: the same drawn knob as PanelKnob, its pointer snapped to one of
// `num-options` positions from seven to five o'clock; a click cycles to the
// next one. Knob-only: the option labels are rendered by the parent.
import { KnobArc } from "knob_arc.slint";

export component SelectorKnob inherits Rectangle {
    in property <int> num-options;
    in property <int> selected-index;
    callback select(int);

    private property <length> ks: root.width;

    background: transparent;

    KnobArc {
        x: 0;
        y: 0;
        width: root.ks;
        height: root.ks;
        angle: root.num-options <= 1 ? -135
            : -135 + 270 * Math.max(0, Math.min(root.selected-index, root.num-options - 1)) / (root.num-options - 1);
        show-value: false;
    }

    // Click on knob cycles. Named so headless interaction tests can press it.
    ta := TouchArea {
        x: 0;
        y: 0;
        width: root.ks;
        height: root.ks;
        mouse-cursor: pointer;
        clicked => {
            root.select(root.selected-index >= root.num-options - 1 ? 0 : root.selected-index + 1);
        }
    }
}
