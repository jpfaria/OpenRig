// Responsibility: renders the looper trigger of a chain header.
// #323 — the looper trigger in a chain header, beside the DI fone and the
// stethoscope. Clicking it opens the looper panel at the window root via the
// `LooperPanel` global, seeded with this chain's rows and the button's
// absolute position (the DI button's proven pattern, #749).

import { HeaderIconStyle } from "header_icon_style.slint";
import { LooperPanel } from "looper_panel_globals.slint";
import { IconTooltip } from "icon_tooltip.slint";

export component ChainLooperButton inherits Rectangle {
    in property <bool> active: false;      // any looper recording or playing
    in property <int> chain-index;
    // #323: the chain's input / output endpoint labels — the options every
    // looper's record-from / play-to select shows. Seeded into the panel on open.
    in property <[string]> input-options;
    in property <[string]> output-options;

    width: HeaderIconStyle.size;
    height: HeaderIconStyle.size;
    border-radius: HeaderIconStyle.radius;
    background: HeaderIconStyle.fill(ta.has-hover);
    animate background { duration: 150ms; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: HeaderIconStyle.icon;
        height: HeaderIconStyle.icon;
        source: @image-url("../assets/loop.svg");
        image-fit: contain;
        colorize: HeaderIconStyle.tint(root.active, ta.has-hover);
        animate colorize { duration: 150ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            LooperPanel.chain-index = root.chain-index;
            LooperPanel.expanded-uid = -1;
            LooperPanel.input-options = root.input-options;
            LooperPanel.output-options = root.output-options;
            // Open below the button, the panel's right edge near it.
            LooperPanel.x = root.absolute-position.x - 572px;
            LooperPanel.y = root.absolute-position.y + 32px;
            LooperPanel.anchor-top = root.absolute-position.y;
            LooperPanel.open = true;
        }
    }

    IconTooltip { text: @tr("looper-button-label"); show: ta.has-hover; }

    accessible-role: button;
    accessible-label: @tr("looper-button-label");
}
