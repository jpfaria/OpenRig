// Responsibility: carries the looper panel state.
// #323 — shared state for the looper panel, mirroring the DI panel (#749):
// the loop button in a chain row seeds these and flips `open`; a single root
// overlay renders LooperPanel so it is never clipped by the chain list.
// One panel open at a time.

export global LooperPanel {
    in-out property <bool> open;
    // window-absolute position, from the triggering button's `absolute-position`.
    in-out property <length> x;
    in-out property <length> y;
    // The button's top edge: the panel opens above it when there is no room
    // below (#398).
    in-out property <length> anchor-top;
    // routes every action back to the right chain.
    in-out property <int> chain-index;
    // which row has its parameter drawer open; -1 = none.
    in-out property <int> expanded-uid: -1;
    // #323: the chain's bound input / output endpoint labels — the options for
    // every looper's input/output select (the choice per looper is the row's
    // input_index / output_index).
    in-out property <[string]> input-options;
    in-out property <[string]> output-options;
    // #323 phase 2: which looper's preset picker is open; -1 = none. The picker
    // is a root-level modal (click-reachable), so a single uid drives it.
    in-out property <int> preset-picker-uid: -1;
    // The open loop's current preset option index, so the modal marks it.
    in-out property <int> preset-picker-selected;
    // Which looper's record-from / play-to list is open; -1 = none. Kind 0 is
    // the input list, 1 the output list; selected marks the current endpoint.
    in-out property <int> endpoint-picker-uid: -1;
    in-out property <int> endpoint-picker-kind;
    in-out property <int> endpoint-picker-selected;
}

// #826 — the waveform editor's own state. Separate from `LooperPanel` because
// the editor is its own root-level overlay: the panel may be closed while a
// loop is being reshaped.
export global LooperEditor {
    in-out property <bool> open;
    // Which loop is being edited (the chain's index in the rig, and the uid).
    in-out property <int> chain-index;
    in-out property <int> uid;
    // The loop's peak envelope, 0..=1 per bar, computed in Rust.
    in-out property <[float]> peaks;
    // The selection, as ratios of the loop. Rust turns them into frames.
    in-out property <float> sel-start: 0.0;
    in-out property <float> sel-end: 1.0;
    // The loop's length, formatted in Rust ("0:08") — the editor says how much
    // audio it is reshaping instead of leaving the drawing to be guessed at.
    in-out property <string> length-label;
    // Whether the loop is sounding right now. An edit is judged by ear, so the
    // editor runs the loop itself — and while it runs, the edits are dead (the
    // store refuses to reshape a live take).
    in-out property <bool> playing;
    // Where the loop is while it plays, as a ratio of its length. Refreshed by
    // the same poll tick that drives the panel's meters.
    in-out property <float> playhead;
    // What the last edit did: 0 quiet, 1 it changed nothing, 2 it was refused.
    // A silent button is indistinguishable from a broken one, so the editor
    // says which of the three happened.
    in-out property <int> status-code;
    // Whether the edit history has anything to step through.
    in-out property <bool> can-undo;
    in-out property <bool> can-redo;
}

// #827 — the save-take dialog a looper row's floppy opens. Its own global
// because Rust answers it (the save's outcome) without knowing the panel.
export global LooperTake {
    // Which loop the dialog is saving; -1 = closed. The chain is the open
    // panel's (`LooperPanel.chain-index`) — the dialog covers the panel.
    in-out property <int> dialog-uid: -1;
    // The name typed for the take, kept on a refusal so it can be fixed
    // instead of retyped; Rust clears it once the take is saved.
    in-out property <string> name;
    // What the last save did: 0 quiet, 1 saved, 2 name taken, 3 nothing
    // recorded, 4 could not write, 5 the name has nothing usable. Mapped in
    // Rust from the typed refusal.
    in-out property <int> status;
    // (chain-index, uid, name) — keep this loop as a named take in the
    // app-wide library, where every chain's DI can pick it.
    callback save(int, int, string);
}
