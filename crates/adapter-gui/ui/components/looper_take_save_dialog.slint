// Responsibility: renders the looper's save-take dialog.
// #827 — the floppy on a looper row opens this: keep that loop as a named take
// in the app-wide library, where every chain's DI can pick it. A name field,
// Save, and a status line: the outcome is always said, because a silent Save
// is indistinguishable from a broken one. A root-level modal, never a
// PopupWindow (#749/#761), so every control is an in-tree TouchArea.
//
// #398: the dialog card — the dark bar, the captioned name field, the outcome
// under it (green once saved), Cancel and the primary Save in the foot; once
// saved only the primary Close is left.

import { Theme } from "../theme.slint";
import { LooperPanel, LooperTake } from "looper_panel_globals.slint";
import { DialogCard } from "dialog_card.slint";
import { DialogFoot } from "dialog_foot.slint";
import { ToolBar } from "tool_bar.slint";
import { TextField } from "text_field.slint";
import { FieldCaption } from "field_caption.slint";
import { FormButton, FormButtonKind } from "form_button.slint";

export component LooperTakeSaveDialog inherits Rectangle {
    // Blank ⇒ dead. A name of only spaces is refused by the core (status 5):
    // what makes a name usable is decided there, not here.
    private property <bool> can-save: !LooperTake.name.is-empty;
    private property <bool> saved: LooperTake.status == 1;

    function submit() {
        if root.can-save {
            LooperTake.save(LooperPanel.chain-index, LooperTake.dialog-uid, LooperTake.name);
        }
    }

    DialogCard {
        width: root.width;
        height: root.height;
        card-width: 420px;

        ToolBar { title: @tr("looper-take-save-title"); }

        VerticalLayout {
            padding: 18px;
            spacing: 14px;

            VerticalLayout {
                spacing: 6px;

                FieldCaption { text: @tr("looper-take-name-placeholder"); }

                name-edit := TextField {
                    text <=> LooperTake.name;
                    edited => { LooperTake.status = 0; }
                    accepted => { root.submit(); }
                }
            }

            // The outcome is always said: a silent Save is indistinguishable
            // from a broken one.
            if LooperTake.status != 0 : Text {
                wrap: word-wrap;
                text: LooperTake.status == 1 ? @tr("looper-take-saved")
                    : LooperTake.status == 2 ? @tr("looper-take-name-taken")
                    : LooperTake.status == 3 ? @tr("looper-take-nothing-recorded")
                    : LooperTake.status == 4 ? @tr("looper-take-failed")
                    : @tr("looper-take-needs-name");
                color: root.saved ? Theme.ok : Theme.warn;
                font-size: Theme.min-font;
            }
        }

        DialogFoot {
            // Once saved there is nothing to cancel — the same button just
            // closes, and becomes the one answer left.
            cancel-btn := FormButton {
                icon-only: true;
                icon: @image-url("../assets/close.svg");
                kind: root.saved ? FormButtonKind.primary : FormButtonKind.normal;
                label: root.saved ? @tr("btn-close") : @tr("btn-cancel");
                clicked => { LooperTake.dialog-uid = -1; }
            }

            if !root.saved : save-btn := FormButton {
                icon-only: true;
                icon: @image-url("../assets/save.svg");
                kind: FormButtonKind.primary;
                label: @tr("looper-take-save");
                enabled: root.can-save;
                clicked => { root.submit(); }
            }
        }
    }

    init => { name-edit.focus-field(); }
}
