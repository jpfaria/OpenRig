// Responsibility: renders one labelled button of the loop waveform editor.
// Split out of looper_editor_overlay.slint (#827) so the save-take dialog can use
// the same button; the component name is unchanged, so interaction tests that
// find "EditorButton::area" still address the same controls.
//
// #398: the small form button — a field-coloured face with a hairline, an
// optional icon before the label, `primary` for the one answer most takes
// need, `on-bar` for the dark title bar.

import { Theme } from "../theme.slint";
import { IconTooltip } from "icon_tooltip.slint";
import { ElidedText } from "elided_text.slint";

export component EditorButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> on-bar: false;
    // An action its icon says alone (save, delete, add, close): a square with
    // the icon, its name shown on hover and kept for screen readers (#398).
    in property <bool> icon-only: false;
    callback clicked();

    private property <color> ink: root.primary ? Theme.on-accent
        : root.on-bar ? Theme.chrome-fg
        : Theme.ink;

    // A labelled button asks for its whole label but, in a row too narrow
    // for every label, gives way down to an ellipsis instead of pushing the
    // row's last buttons out of the editor's card.
    min-width: root.icon-only ? root.height : row.min-width;
    preferred-width: root.icon-only ? root.height : row.preferred-width;
    max-width: root.icon-only ? root.height : 100000px;
    height: 28px;
    border-radius: 4px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.primary ? (area.has-hover && root.enabled ? Theme.accent.brighter(0.08) : Theme.accent)
        : root.on-bar ? (area.has-hover ? Theme.chrome-2 : Theme.chrome-field)
        : (area.has-hover && root.enabled ? Theme.panel-hi : Theme.field);
    border-width: root.primary ? 0 : 1px;
    border-color: root.on-bar ? Theme.chrome-field-line : Theme.hair;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    row := HorizontalLayout {
        padding-left: root.icon-only ? 0px : 10px;
        padding-right: root.icon-only ? 0px : 10px;
        spacing: 6px;
        alignment: center;

        if root.icon.width > 0 : VerticalLayout {
            alignment: center;
            Image {
                width: 14px;
                height: 14px;
                source: root.icon;
                colorize: root.ink;
            }
        }

        if !root.icon-only : ElidedText {
            text: root.label;
            color: root.ink;
            font-size: Theme.min-font;
            font-weight: 600;
            letter-spacing: 0.04 * Theme.min-font;
            vertical-alignment: center;
            own-hover: false;
            hovered: area.has-hover;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    IconTooltip { text: root.label; show: area.has-hover && root.icon-only; }
}
