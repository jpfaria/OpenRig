// Responsibility: renders the backing-track library list.
// #398: one closed field, rows divided by hairlines; the loaded track takes
// an accent tint with a bar on its left edge.
import { Theme, Gear } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PlayerTrackRow } from "player_globals.slint";

// One track: a click loads it, a double click plays it, the loaded one is
// highlighted. Only the user's own tracks carry a trash.
component PlayerTrackItem inherits Rectangle {
    in property <PlayerTrackRow> track;
    in property <bool> active;
    in property <bool> first;
    callback pick();
    callback play();
    callback delete();
    private property <bool> armed;

    height: 38px;
    background: root.active ? Theme.accent-soft : (ta.has-hover ? Theme.panel-hi : transparent);

    if !root.first : Rectangle {
        y: 0;
        width: 100%; height: 1px;
        background: Theme.hair-2;
    }

    if root.active : Rectangle {
        x: 0;
        width: 3px; height: 100%;
        background: Theme.accent;
    }

    Text {
        x: 12px;
        width: root.track.bundled ? parent.width - 24px : parent.width - 140px;
        height: parent.height;
        text: root.track.name;
        color: Theme.ink;
        font-size: Theme.min-font;
        font-weight: root.active ? 700 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pick(); }
        double-clicked => { root.play(); }
    }

    // The trash on the user's own tracks — first click arms, second deletes.
    if !root.track.bundled : Rectangle {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        width: root.armed ? max(26px, armed-text.preferred-width + 40px) : 26px;
        height: 26px;
        border-radius: 4px;
        background: root.armed ? Theme.bad : del-ta.has-hover ? Theme.panel-lo : transparent;
        Image {
            x: root.armed ? 8px : 5px;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            source: @image-url("../assets/trash.svg");
            colorize: root.armed ? Gear.white : del-ta.has-hover ? Theme.ink : Theme.ink-3;
        }
        armed-text := Text {
            x: 30px;
            width: root.armed ? parent.width - 38px : 0px;
            height: parent.height;
            visible: root.armed;
            text: @tr("label-track-delete-confirm");
            color: Gear.white;
            font-size: Theme.min-font;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        del-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if root.armed {
                    root.armed = false;
                    root.delete();
                } else {
                    root.armed = true;
                }
            }
        }
        accessible-role: button;
        accessible-label: @tr("label-track-delete");
    }
    accessible-role: button;
    accessible-label: root.track.name;
}

export component PlayerLibraryList inherits Rectangle {
    in property <[PlayerTrackRow]> tracks;
    in property <string> active-path;
    callback pick(string);
    callback play(string);
    callback delete(string);

    border-radius: 4px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.hair;
    clip: true;

    if root.tracks.length == 0 : Text {
        x: 16px; width: parent.width - 32px; height: parent.height;
        text: @tr("status-no-backing-tracks");
        color: Theme.ink-3;
        font-size: Theme.min-font;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ScrollView {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        VerticalLayout {
            for track[i] in root.tracks : PlayerTrackItem {
                track: track;
                first: i == 0;
                active: track.path == root.active-path;
                pick => { root.pick(track.path); }
                play => { root.play(track.path); }
                delete => { root.delete(track.path); }
            }
        }
    }
}
