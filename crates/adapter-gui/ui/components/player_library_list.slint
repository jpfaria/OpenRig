// Responsibility: renders the backing-track library list.
import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PlayerTrackRow } from "player_globals.slint";

// One track: a click loads it, a double click plays it, the loaded one is
// highlighted. Only the user's own tracks carry a trash.
component PlayerTrackItem inherits Rectangle {
    in property <PlayerTrackRow> track;
    in property <bool> active;
    callback pick();
    callback play();
    callback delete();
    private property <bool> armed;

    height: 40px;
    border-radius: 5px;
    background: root.active ? Theme.accent-soft : (ta.has-hover ? Theme.panel-hi : transparent);

    Text {
        x: 12px;
        width: root.track.bundled ? parent.width - 24px : parent.width - 140px;
        height: parent.height;
        text: root.track.name;
        color: Theme.ink;
        font-size: 18px;
        font-weight: root.active ? 700 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pick(); }
        double-clicked => { root.play(); }
    }

    // The trash on the user's own tracks — first click arms, second deletes.
    if !root.track.bundled : Rectangle {
        x: parent.width - self.width - 6px;
        y: 4px;
        width: root.armed ? 120px : 32px;
        height: parent.height - 8px;
        border-radius: 5px;
        background: root.armed ? Theme.bad : del-ta.has-hover ? Theme.bad.with-alpha(0.25) : transparent;
        animate width, background { duration: 120ms; }
        Image {
            x: 8px;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            source: @image-url("../assets/trash.svg");
            colorize: root.armed || del-ta.has-hover ? Theme.hero-fg : Theme.ink-2;
        }
        if root.armed : Text {
            x: 30px;
            width: parent.width - 34px;
            height: parent.height;
            text: @tr("label-track-delete-confirm");
            color: Theme.ink;
            font-size: 18px;
            font-weight: 800;
            vertical-alignment: center;
            overflow: elide;
        }
        del-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if root.armed {
                    root.armed = false;
                    root.delete();
                } else {
                    root.armed = true;
                }
            }
        }
        accessible-role: button;
        accessible-label: @tr("label-track-delete");
    }
    accessible-role: button;
    accessible-label: root.track.name;
}

export component PlayerLibraryList inherits Rectangle {
    in property <[PlayerTrackRow]> tracks;
    in property <string> active-path;
    callback pick(string);
    callback play(string);
    callback delete(string);

    border-radius: 6px;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.hair;

    if root.tracks.length == 0 : Text {
        x: 16px; width: parent.width - 32px; height: parent.height;
        text: @tr("status-no-backing-tracks");
        color: Theme.ink-3;
        font-size: 18px;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ScrollView {
        x: 6px; y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        VerticalLayout {
            spacing: 2px;
            for track in root.tracks : PlayerTrackItem {
                track: track;
                active: track.path == root.active-path;
                pick => { root.pick(track.path); }
                play => { root.play(track.path); }
                delete => { root.delete(track.path); }
            }
        }
    }
}
