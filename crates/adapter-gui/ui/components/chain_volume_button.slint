// Responsibility: renders the volume control of a chain header.
// #436 — chain volume behind an icon. Press the speaker icon to reveal
// the volume slider. It lives in a PopupWindow so it renders on the
// top overlay layer (like the ComboBox dropdown) and is never clipped
// or painted under the pedal blocks below the header row. The slider
// itself is the unchanged ChainVolumeControl (#440 behaviour preserved).

import { Theme } from "../theme.slint";
import { HeaderIconStyle } from "header_icon_style.slint";
import { IconTooltip } from "icon_tooltip.slint";
import { ChainVolumeControl } from "chain_chips.slint";

export component ChainVolumeButton inherits Rectangle {
    in-out property <int> volume: 100;
    // #398: sits on the dark chrome bar.
    in property <bool> on-chrome: false;
    callback value-changed(int);

    width: HeaderIconStyle.size;
    height: HeaderIconStyle.size;
    border-radius: HeaderIconStyle.radius;
    background: root.on-chrome ? HeaderIconStyle.chrome-fill(ta.has-hover) : HeaderIconStyle.fill(ta.has-hover);
    animate background { duration: 150ms; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: HeaderIconStyle.icon;
        height: HeaderIconStyle.icon;
        source: @image-url("../assets/volume.svg");
        image-fit: contain;
        colorize: root.on-chrome ? HeaderIconStyle.chrome-tint(false, ta.has-hover) : HeaderIconStyle.tint(false, ta.has-hover);
        animate colorize { duration: 150ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            pop.show();
        }
    }
    IconTooltip { text: @tr("Volume"); show: ta.has-hover; }

    accessible-role: button;
    accessible-label: @tr("Volume");

    pop := PopupWindow {
        x: -184px;
        y: 34px;
        width: 192px;
        height: 40px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 192px;
            height: 40px;
            border-radius: 8px;
            background: Theme.panel-lo.with-alpha(0.95);
            border-width: 1px;
            border-color: Theme.field-line;

            ChainVolumeControl {
                x: 12px;
                y: 8px;
                volume <=> root.volume;
                value-changed(v) => {
                    root.value-changed(v);
                }
            }
        }
    }
}
