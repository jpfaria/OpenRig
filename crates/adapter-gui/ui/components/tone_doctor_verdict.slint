// Responsibility: renders the Tone Doctor verdict card.
// #398: a dark card like the chain bar: the symptom lit in its severity
// colour, the guilty block under it, and when the doctor measured a fix, the
// fix with an Apply button on the green.
import { Theme } from "../theme.slint";
import { ElidedText } from "elided_text.slint";

export component ToneDoctorVerdict inherits Rectangle {
    in property <int> level;
    in property <string> symptom;
    in property <string> culprit;
    in property <string> suggestion;
    in property <bool> has-suggestion;
    callback apply();

    private property <color> lit: root.level >= 2 ? Theme.chrome-bad
        : root.level == 1 ? Theme.chrome-warn
        : Theme.chrome-ok;

    height: col.preferred-height;
    border-radius: 5px;
    background: Theme.chrome;

    col := VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.lit;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: root.lit;
                }
            }

            Text {
                text: root.symptom;
                color: root.lit;
                font-size: Theme.min-font;
                font-weight: 700;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        ElidedText {
            text: root.culprit;
            color: Theme.chrome-fg-2;
            font-size: Theme.min-font;
        }

        if root.has-suggestion : VerticalLayout {
            padding-top: 6px;
            spacing: 10px;

            Rectangle {
                height: 1px;
                background: Theme.chrome-2;
            }

            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    ElidedText {
                        text: @tr("tone-doctor-suggestion");
                        color: Theme.chrome-fg-2;
                        font-size: Theme.min-font;
                    }

                    ElidedText {
                        text: root.suggestion;
                        color: Theme.chrome-fg;
                        font-size: Theme.min-font;
                        font-weight: 700;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    Rectangle {
                        height: 30px;
                        width: apply-lbl.preferred-width + 28px;
                        border-radius: 4px;
                        background: apply-ta.has-hover ? Theme.ok.brighter(0.1) : Theme.ok;

                        apply-lbl := Text {
                            width: parent.width;
                            height: parent.height;
                            text: @tr("tone-doctor-apply");
                            color: Theme.on-ok;
                            font-size: Theme.min-font;
                            font-weight: 600;
                            letter-spacing: 0.06 * Theme.min-font;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        apply-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.apply(); }
                        }

                        accessible-role: button;
                        accessible-label: @tr("tone-doctor-apply");
                        accessible-action-default => { root.apply(); }
                    }
                }
            }
        }
    }
}
