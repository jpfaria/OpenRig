// Responsibility: renders the tone doctor panel.
// #791 — the Tone Doctor "janela": a panel (opened by the stethoscope icon)
// that runs the offline blame-by-ablation and shows the verdict AS AN
// INSTRUMENT — the measurements each against their healthy limit, so the user
// sees the data behind the verdict, plus the guilty block and a measured fix.
//
// #398: a tool window: the dark bar, then two columns — on the left what to
// analyse (seconds, genre) and the diagnose button, on the right the meters
// over a dark verdict card. Narrow, the right column drops under the left.
// Embedded in a compact-view section, the section is the panel: no bar, no
// card, no gutter.
//
// INLINE (inherits Rectangle), NOT a PopupWindow — same reasoning as
// DiLoopPanel: the host renders it at the window root (never clipped by the
// chain list) and every click is a normal in-tree TouchArea.

import { Theme } from "../theme.slint";
import { Select } from "select.slint";
import { ToneDoctorState } from "tone_doctor_globals.slint";
import { ToolBar } from "tool_bar.slint";
import { LooperSlider } from "looper_controls.slint";
import { FieldCaption } from "field_caption.slint";
import { PanelActionButton } from "panel_action_button.slint";
import { ToneDoctorMetric } from "tone_doctor_metric.slint";
import { ToneDoctorVerdict } from "tone_doctor_verdict.slint";

export component ToneDoctorPanel inherits Rectangle {
    in property <int> symptom-level;
    in property <string> symptom-text;
    in property <string> culprit-label;
    in property <string> suggestion-text;
    in property <bool> has-suggestion;
    in property <bool> has-result;
    in property <bool> running;
    in property <int> analyze-seconds;
    in property <bool> can-diagnose;
    in property <float> fizz-value;
    in property <float> fizz-limit;
    in property <float> mud-value;
    in property <float> mud-limit;
    in property <float> boom-value;
    in property <float> boom-limit;
    in property <float> clip-value;
    in property <float> clip-limit;

    // Inside a compact-view section the section is the panel: no box of its
    // own, no title (the section header names it), no inset gutter.
    in property <bool> embedded: false;

    callback run-diagnosis();
    callback apply-suggestion();
    callback seconds-picked(int);

    // The seconds slider runs from 5 s to 30 s.
    private property <int> min-seconds: 5;
    private property <int> span-seconds: 25;

    private property <length> bar-h: root.embedded ? 0px : 46px;
    private property <length> pad: root.embedded ? 0px : 16px;
    private property <length> pad-bottom: root.embedded ? 8px : 16px;
    private property <length> gap: 16px;
    private property <length> inner: root.width - 2 * root.pad;
    private property <bool> two-col: root.inner >= 560px;
    private property <length> col-w: root.two-col ? (root.inner - root.gap) / 2 : root.inner;
    private property <length> left-h: left.preferred-height;
    private property <length> right-h: root.has-result ? right-col.preferred-height : 0px;
    private property <length> body-h: !root.has-result ? root.left-h
        : root.two-col ? max(root.left-h, root.right-h)
        : root.left-h + root.gap + root.right-h;
    private property <bool> can-run: root.can-diagnose && !root.running;

    width: 640px;
    height: root.bar-h + root.pad + root.body-h + root.pad-bottom;
    border-radius: root.embedded ? 0px : 6px;
    background: root.embedded ? transparent : Theme.panel;
    border-width: root.embedded ? 0px : 1px;
    border-color: Theme.hair;
    drop-shadow-blur: root.embedded ? 0px : 24px;
    drop-shadow-offset-y: root.embedded ? 0px : 8px;
    drop-shadow-color: Theme.shadow;
    clip: true;

    // Clicks on the card never reach the overlay's close-on-outside scrim.
    TouchArea { }

    if !root.embedded : title := ToolBar {
        x: 0;
        y: 0;
        width: parent.width;
        icon: @image-url("../assets/stethoscope.svg");
        title: @tr("tone-doctor-title");
    }

    // ── what to analyse ───────────────────────────────────────────────────
    left := VerticalLayout {
        x: root.pad;
        y: root.bar-h + root.pad;
        width: root.col-w;
        spacing: 12px;
        alignment: start;

        LooperSlider {
            label: @tr("tone-doctor-analyze");
            value: Math.max(0, (root.analyze-seconds - root.min-seconds) * 100 / root.span-seconds);
            value-label: (root.min-seconds + Math.round(self.value * root.span-seconds / 100)) + "s";
            value-changed(v) => {
                root.seconds-picked(root.min-seconds + Math.round(v * root.span-seconds / 100));
            }
        }

        // Picks the calibrated limits the doctor judges against (#809);
        // "" = defaults.
        VerticalLayout {
            spacing: 6px;

            FieldCaption {
                text: @tr("tone-doctor-genre");
            }

            Select {
                options: ToneDoctorState.genre-options;
                active-key: ToneDoctorState.tone-genre;
                field-label: ToneDoctorState.tone-genre;
                placeholder: @tr("tone-doctor-genre-default");
                search-placeholder: @tr("tone-doctor-genre-search");
                empty-text: @tr("tone-doctor-genre-none");
                popup-width: root.col-w;
                picked(key) => { ToneDoctorState.tone-genre = key; }
                opened => { ToneDoctorState.genre-query(""); }
                query-changed(q) => { ToneDoctorState.genre-query(q); }
            }
        }

        HorizontalLayout {
            alignment: start;

            PanelActionButton {
                primary: true;
                enabled: root.can-run;
                hovered: diag-ta.has-hover;
                icon: @image-url("../assets/stethoscope.svg");
                label: root.running ? @tr("tone-doctor-diagnosing")
                    : root.has-result ? @tr("tone-doctor-rerun")
                    : @tr("tone-doctor-diagnose");
                clicked => {
                    if (root.can-run) {
                        root.run-diagnosis();
                    }
                }

                diag-ta := TouchArea {
                    mouse-cursor: root.can-run ? MouseCursor.pointer : MouseCursor.default;
                    clicked => {
                        if (root.can-run) {
                            root.run-diagnosis();
                        }
                    }
                }
            }
        }

        // Why the button is off: nothing is playing into the chain.
        if !root.can-diagnose : Text {
            text: @tr("tone-doctor-no-signal");
            color: Theme.ink-3;
            font-size: Theme.min-font;
            wrap: word-wrap;
        }
    }

    // ── the measurements and the verdict ──────────────────────────────────
    Rectangle {
        x: root.two-col ? root.pad + root.col-w + root.gap : root.pad;
        y: root.two-col ? root.bar-h + root.pad : root.bar-h + root.pad + root.left-h + root.gap;
        width: root.col-w;
        height: right-col.preferred-height;
        visible: root.has-result;

        right-col := VerticalLayout {
            spacing: 12px;
            alignment: start;

            ToneDoctorMetric {
                name: "FIZZ";
                value: root.fizz-value;
                limit: root.fizz-limit;
                value-text: "\{Math.round(root.fizz-value * 100) / 100} / \{Math.round(root.fizz-limit * 100) / 100}";
            }

            ToneDoctorMetric {
                name: "MUD";
                value: root.mud-value;
                limit: root.mud-limit;
                value-text: "\{Math.round(root.mud-value * 100) / 100} / \{Math.round(root.mud-limit * 100) / 100}";
            }

            ToneDoctorMetric {
                name: "BOOM";
                value: root.boom-value;
                limit: root.boom-limit;
                value-text: "\{Math.round(root.boom-value * 100) / 100} / \{Math.round(root.boom-limit * 100) / 100}";
            }

            ToneDoctorMetric {
                name: "CLIP";
                value: root.clip-value;
                limit: root.clip-limit;
                value-text: "\{Math.round(root.clip-value * 1000) / 10}%";
            }

            ToneDoctorVerdict {
                level: root.symptom-level;
                symptom: root.symptom-text;
                culprit: root.culprit-label;
                suggestion: root.suggestion-text;
                has-suggestion: root.has-suggestion;
                apply => { root.apply-suggestion(); }
            }
        }
    }
}
