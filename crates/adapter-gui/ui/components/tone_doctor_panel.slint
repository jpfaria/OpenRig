// Responsibility: renders the tone doctor panel.
// #791 — the Tone Doctor "janela": a panel (opened by the stethoscope icon)
// that runs the offline blame-by-ablation and shows the verdict AS AN
// INSTRUMENT — three meters (Fizz / Mud / Clipping) each against their healthy
// limit, so the user sees the data behind the verdict, plus the guilty block
// and a measured fix. The user picks how many seconds of signal to analyse.
//
// INLINE (inherits Rectangle), NOT a PopupWindow — same reasoning as
// DiLoopPanel: the host renders it at the window root (never clipped by the
// chain list) and every click is a normal in-tree TouchArea.

import { Theme } from "../theme.slint";
import { Select } from "select.slint";
import { ToneDoctorState } from "tone_doctor_globals.slint";

// One measurement meter: value fill (green under the limit / red over it), a
// tick at the healthy limit (fixed at 50 % of the track), and the number.
component MeasureRow inherits Rectangle {
    in property <string> name;
    in property <float> value;
    in property <float> limit;
    in property <string> value-text;
    private property <float> track-frac: min(root.value / max(root.limit * 2.0, 0.0001), 1.0);
    private property <bool> over: root.value > root.limit;
    height: 46px;
    Text {
        x: 0; y: 0; height: 22px; text: root.name;
        color: root.over ? Theme.bad : Theme.ok;
        font-size: 18px; font-weight: 800; vertical-alignment: center;
    }
    Text {
        x: parent.width - 150px; y: 0; width: 150px; height: 22px;
        horizontal-alignment: right; vertical-alignment: center; text: root.value-text;
        color: Theme.ink; font-size: 18px; font-weight: 700; overflow: elide;
    }
    track := Rectangle {
        x: 0; y: 28px; width: parent.width; height: 11px;
        border-radius: 5px; background: Theme.well;
        border-width: 1px; border-color: Theme.hair; clip: true;
        Rectangle {
            x: 0; y: 0; width: parent.width * root.track-frac; height: parent.height;
            border-radius: 5px; background: root.over ? Theme.bad : Theme.ok;
        }
    }
    Rectangle {
        x: track.width * 0.5 - 1px; y: 24px; width: 2px; height: 19px; background: Theme.ink-3;
    }
}

// A tap-to-select seconds chip.
component SecondsChip inherits Rectangle {
    in property <int> value;
    in property <bool> selected;
    callback picked(int);
    width: 44px; height: 26px; border-radius: 5px;
    background: root.selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.panel-hi;
    border-width: 1px; border-color: root.selected ? Theme.accent : Theme.hair;
    animate background { duration: 120ms; }
    Text {
        width: parent.width; height: parent.height;
        horizontal-alignment: center; vertical-alignment: center;
        text: "\{root.value}s";
        color: root.selected ? Theme.ink : Theme.ink-2;
        font-size: 18px; font-weight: 700;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(root.value); } }
}

export component ToneDoctorPanel inherits Rectangle {
    in property <int> symptom-level;
    in property <string> symptom-text;
    in property <string> culprit-label;
    in property <string> suggestion-text;
    in property <bool> has-suggestion;
    in property <bool> has-result;
    in property <bool> running;
    in property <int> analyze-seconds;
    in property <bool> can-diagnose;
    in property <float> fizz-value;
    in property <float> fizz-limit;
    in property <float> mud-value;
    in property <float> mud-limit;
    in property <float> boom-value;
    in property <float> boom-limit;
    in property <float> clip-value;
    in property <float> clip-limit;

    // Inside a compact-view section the section is the panel: no box of its
    // own, no title (the section header names it), no inset gutter.
    in property <bool> embedded: false;

    callback run-diagnosis();
    callback apply-suggestion();
    callback seconds-picked(int);

    private property <color> light-color:
        root.symptom-level >= 2 ? Theme.bad
        : root.symptom-level == 1 ? Theme.warn
        : Theme.ok;

    // Label column of the seconds/genre rows follows the translated labels,
    // capped so the four 44px chips (194px) always fit beside it.
    private property <length> label-col: min(max(analyze-lbl.preferred-width, genre-lbl.preferred-width) + 12px, 142px);

    // Embedded, the title row goes and everything moves up by its height.
    private property <length> top: root.embedded ? -34px : 0px;
    private property <length> inset: root.embedded ? 0px : 12px;
    private property <length> inner: root.width - 2 * root.inset;

    width: 360px;
    height: root.top + (root.has-result ? (root.has-suggestion ? 512px : 440px) : 196px);
    border-radius: root.embedded ? 0px : 8px;
    background: root.embedded ? transparent : Theme.panel-lo.with-alpha(0.95);
    border-width: root.embedded ? 0px : 1px; border-color: Theme.field-line;
    clip: true;

    // ── header ────────────────────────────────────────────────────────────
    if !root.embedded : Image {
        x: 12px; y: 12px; width: 18px; height: 18px;
        source: @image-url("../assets/stethoscope.svg"); colorize: Theme.accent;
    }
    if !root.embedded : title := Text {
        x: 38px; y: 10px; height: 22px; text: @tr("tone-doctor-title");
        color: Theme.ink; font-size: 18px; font-weight: 700; vertical-alignment: center;
    }

    // ── seconds selector ───────────────────────────────────────────────────
    analyze-lbl := Text {
        x: root.inset; y: root.top + 42px; width: root.label-col - 12px; height: 26px; text: @tr("tone-doctor-analyze");
        color: Theme.ink-2; font-size: 18px; font-weight: 700; vertical-alignment: center; overflow: elide;
    }
    HorizontalLayout {
        x: root.inset + root.label-col; y: root.top + 42px; width: root.inner - root.label-col; height: 26px; spacing: 6px;
        alignment: start;
        SecondsChip { value: 5; selected: root.analyze-seconds == 5; picked(v) => { root.seconds-picked(v); } }
        SecondsChip { value: 10; selected: root.analyze-seconds == 10; picked(v) => { root.seconds-picked(v); } }
        SecondsChip { value: 20; selected: root.analyze-seconds == 20; picked(v) => { root.seconds-picked(v); } }
        SecondsChip { value: 30; selected: root.analyze-seconds == 30; picked(v) => { root.seconds-picked(v); } }
    }

    // ── genre selector (#809) ──────────────────────────────────────────────
    // Picks the calibrated limits the doctor judges against; "" = defaults.
    genre-lbl := Text {
        x: root.inset; y: root.top + 78px; width: root.label-col - 12px; height: 38px; text: @tr("tone-doctor-genre");
        color: Theme.ink-2; font-size: 18px; font-weight: 700; vertical-alignment: center; overflow: elide;
    }
    Select {
        x: root.inset + root.label-col; y: root.top + 76px; width: root.inner - root.label-col;
        options: ToneDoctorState.genre-options;
        active-key: ToneDoctorState.tone-genre;
        field-label: ToneDoctorState.tone-genre;
        placeholder: @tr("tone-doctor-genre-default");
        search-placeholder: @tr("tone-doctor-genre-search");
        empty-text: @tr("tone-doctor-genre-none");
        field-font-size: 18px; field-font-weight: 700;
        popup-width: 232px;
        picked(key) => { ToneDoctorState.tone-genre = key; }
        opened => { ToneDoctorState.genre-query(""); }
        query-changed(q) => { ToneDoctorState.genre-query(q); }
    }

    // ── diagnose button (gated) ────────────────────────────────────────────
    Rectangle {
        x: root.inset; y: root.top + 122px; width: root.inner; height: 34px;
        border-radius: 6px;
        background: !root.can-diagnose ? Theme.panel
                    : root.running ? Theme.panel-hi
                    : diag-ta.has-hover ? Theme.accent-soft : Theme.panel-hi;
        border-width: 1px; border-color: root.can-diagnose ? Theme.field-line : Theme.hair;
        animate background { duration: 150ms; }
        Text {
            width: parent.width; height: parent.height;
            horizontal-alignment: center; vertical-alignment: center;
            text: !root.can-diagnose ? @tr("tone-doctor-no-signal")
                  : root.running ? @tr("tone-doctor-diagnosing")
                  : root.has-result ? @tr("tone-doctor-rerun")
                  : @tr("tone-doctor-diagnose");
            color: !root.can-diagnose ? Theme.ink-3 : root.running ? Theme.ink-2 : Theme.ink;
            font-size: 18px; font-weight: 700; overflow: elide;
        }
        diag-ta := TouchArea {
            mouse-cursor: (root.can-diagnose && !root.running) ? pointer : default;
            clicked => { if (root.can-diagnose && !root.running) { root.run-diagnosis(); } }
        }
        accessible-role: button;
        accessible-label: @tr("tone-doctor-diagnose");
    }

    // ── the three measurements ─────────────────────────────────────────────
    if root.has-result : VerticalLayout {
        x: root.inset; y: root.top + 166px; width: root.inner; spacing: 4px;
        MeasureRow {
            name: "FIZZ"; value: root.fizz-value; limit: root.fizz-limit;
            value-text: "\{Math.round(root.fizz-value * 100) / 100} / \{Math.round(root.fizz-limit * 100) / 100}";
        }
        MeasureRow {
            name: "MUD"; value: root.mud-value; limit: root.mud-limit;
            value-text: "\{Math.round(root.mud-value * 100) / 100} / \{Math.round(root.mud-limit * 100) / 100}";
        }
        MeasureRow {
            name: "BOOM"; value: root.boom-value; limit: root.boom-limit;
            value-text: "\{Math.round(root.boom-value * 100) / 100} / \{Math.round(root.boom-limit * 100) / 100}";
        }
        MeasureRow {
            name: "CLIP"; value: root.clip-value; limit: root.clip-limit;
            value-text: "\{Math.round(root.clip-value * 1000) / 10}%";
        }
    }

    // ── verdict + culprit ──────────────────────────────────────────────────
    if root.has-result : Rectangle {
        x: root.inset; y: root.top + 370px; width: root.inner; height: 58px;
        border-radius: 6px; background: Theme.well; border-width: 1px; border-color: Theme.hair;
        Rectangle {
            x: 12px; y: parent.height / 2 - 6px; width: 12px; height: 12px;
            border-radius: 6px; background: root.light-color;
        }
        VerticalLayout {
            x: 34px; y: 6px; width: parent.width - 46px; height: parent.height - 12px; spacing: 1px;
            Text {
                height: 22px;
                text: root.symptom-text; color: root.light-color;
                font-size: 18px; font-weight: 700; vertical-alignment: center; overflow: elide;
            }
            Text {
                height: 22px;
                text: root.culprit-label; color: Theme.ink-2;
                font-size: 18px; vertical-alignment: center; overflow: elide;
            }
        }
    }

    // ── measured fix + apply ───────────────────────────────────────────────
    if root.has-result && root.has-suggestion : Rectangle {
        x: root.inset; y: root.top + 436px; width: root.inner; height: 64px;
        border-radius: 6px; background: Theme.well; border-width: 1px; border-color: Theme.hair;
        Text {
            x: 12px; y: 8px; width: parent.width - apply-btn.width - 36px; height: 22px;
            text: @tr("tone-doctor-suggestion"); color: Theme.ink-2; font-size: 18px; font-weight: 700;
            vertical-alignment: center; overflow: elide;
        }
        Text {
            x: 12px; y: 32px; width: parent.width - apply-btn.width - 36px; height: 24px;
            text: root.suggestion-text; color: Theme.ink; font-size: 18px; font-weight: 700;
            vertical-alignment: center; overflow: elide;
        }
        apply-btn := Rectangle {
            x: parent.width - self.width - 12px; y: 16px;
            width: min(max(72px, apply-lbl.preferred-width + 20px), 150px); height: 32px; border-radius: 6px;
            background: apply-ta.has-hover ? Theme.ok : Theme.ok;
            animate background { duration: 150ms; }
            apply-lbl := Text {
                width: parent.width; height: parent.height;
                horizontal-alignment: center; vertical-alignment: center;
                text: @tr("tone-doctor-apply"); color: Theme.on-accent; font-size: 18px; font-weight: 700;
                overflow: elide;
            }
            apply-ta := TouchArea { mouse-cursor: pointer; clicked => { root.apply-suggestion(); } }
            accessible-role: button;
            accessible-label: @tr("tone-doctor-apply");
        }
    }
}
