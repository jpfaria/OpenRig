// Responsibility: draws one node card of the graph view.
// Node card of the graph chain editor (#435, #328, #398). `node.kind` picks
// the face: a block is its piece of gear (GearArt) with the category and the
// model name printed below it, a power button beside the category; the input
// and output are jacks with a translated IN / OUT under them; the split and
// the mixer are the routing hub, one port per path. The wires end on the
// edge of what the card draws (graph_ports.slint); the caption hangs below
// the card; the lanes are told apart by their wire colour, never by a
// written PATH name (#398). Every marker colour comes from BlockTileStyle so
// the graph and the chain row never disagree.
//
// Input: the canvas's node TouchArea is declared UNDER this card and owns
// click and drag. The card's only TouchAreas are the power button (bypass)
// and the × (remove) of a block or a split, which win there.

import { GraphNode } from "graph_view_types.slint";
import { BlockTileStyle } from "block_tile_style.slint";
import { GearArt } from "gear_art.slint";
import { GraphHub } from "graph_hub.slint";
import { GraphPorts } from "graph_ports.slint";
import { Theme, Gear } from "../theme.slint";

export component GraphNodeCard inherits Rectangle {
    in property <GraphNode> node;
    in property <bool> hovered;
    in property <bool> dragging;
    // #591: MIDI markers only show while a MIDI command is recent.
    in property <bool> markers-visible: false;
    // #328 part 6: the host also marks the selection by block id.
    in property <string> selected-node-id;
    in property <string> neighbor-node-id;
    property <bool> is-selected: root.node.selected || (root.node.id != "" && root.node.id == root.selected-node-id);
    property <bool> is-neighbor: root.node.neighbor || (root.node.id != "" && root.node.id == root.neighbor-node-id);
    // Viewport zoom: the gear scales with the card; text keeps
    // Theme.min-font (#954) and elides.
    in property <float> zoom: 1.0;
    in property <length> card_width;
    in property <length> card_height;
    callback bypass-toggled();
    callback remove-requested();

    property <bool> is-block: root.node.kind == "block";
    property <bool> is-io: root.node.kind == "io_input" || root.node.kind == "io_output";
    property <bool> is-routing: root.node.kind == "split" || root.node.kind == "mixer";
    property <bool> enabled: !root.node.bypass;
    property <bool> unavailable: root.is-block && root.node.block.unavailable;
    // Only a block carries a host label; every other name is translated.
    property <string> face-label: root.node.kind == "split" ? @tr("graph-node-split")
        : root.node.kind == "mixer" ? @tr("graph-node-mixer")
        : root.node.kind == "io_input" ? @tr("graph-node-input")
        : root.node.kind == "io_output" ? @tr("graph-node-output")
        : root.node.label;
    // A split is removed from its node (RemoveSplit); the mixer is the same
    // split, so it carries no second ×.
    property <bool> removable: root.is-block || root.node.kind == "split";
    property <length> jack: GraphPorts.jack * root.zoom;
    property <length> hub: GraphPorts.hub-height(root.node.lanes.length) * root.zoom;

    width: root.card_width;
    height: root.card_height;
    background: transparent;
    opacity: root.unavailable ? BlockTileStyle.unavailable-opacity : 1.0;

    // ── Block: its piece of gear ─────────────────────────────────────
    if root.is-block : Rectangle {
        width: parent.width;
        height: parent.height;

        // #591 / #328: the selection and MIDI markers ring the gear.
        Rectangle {
            x: gear.x - 4px * root.zoom;
            y: gear.y - 4px * root.zoom;
            width: gear.width + 8px * root.zoom;
            height: gear.height + 8px * root.zoom;
            border-radius: 8px * root.zoom;
            background: BlockTileStyle.marker-background(root.markers-visible, root.is-selected);
            border-width: BlockTileStyle.marker-border-width(root.markers-visible, root.is-selected, root.is-neighbor);
            border-color: BlockTileStyle.marker-border-color(root.markers-visible, root.is-selected, root.is-neighbor, root.enabled);
        }

        gear := GearArt {
            x: (parent.width - self.art-width) / 2;
            y: (parent.height - self.art-height) / 2;
            icon-kind: root.node.block.icon-kind;
            tint: root.node.block.accent-color;
            short-label: root.node.block.display-name;
            brand: root.node.block.brand;
            knob-count: Math.max(1, root.node.block.param-entries.length);
            bypassed: root.node.bypass;
            s: root.zoom;
        }

        // The caption below the gear: the power button and the category in
        // its colour, then the model name. A bypassed block dims its text;
        // the category keeps its colour and the button stays bright.
        caption := VerticalLayout {
            x: (parent.width - self.width) / 2;
            y: gear.y + gear.height + 4px * root.zoom;
            width: 140px;
            height: self.preferred-height;
            spacing: 0px;
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    // The power button (#328 §5.2 `bypass-toggled`), the
                    // rack module's power disc.
                    bypass-ta := TouchArea {
                        width: 20px * root.zoom;
                        height: 20px * root.zoom;
                        mouse-cursor: pointer;
                        clicked => { root.bypass-toggled(); }
                        accessible-role: switch;
                        accessible-checked: root.enabled;
                        accessible-label: @tr("accessible-graph-node-bypass");

                        Rectangle {
                            border-radius: self.width / 2;
                            background: bypass-ta.has-hover ? Theme.hover : Theme.field;
                            border-width: 1px;
                            border-color: Theme.field-line;

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 12px * root.zoom;
                                height: 12px * root.zoom;
                                source: @image-url("../assets/power-line.svg");
                                colorize: root.enabled ? Theme.accent : Gear.off;
                            }
                        }
                    }
                }
                Text {
                    text: root.node.block.type-label.to-uppercase();
                    color: root.node.block.accent-color;
                    opacity: root.node.bypass ? 0.5 : 1.0;
                    font-size: Theme.min-font;
                    font-weight: 700;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Text {
                text: root.node.block.display-name != "" ? root.node.block.display-name : root.node.label;
                color: Theme.ink;
                opacity: root.node.bypass ? 0.5 : 1.0;
                font-size: Theme.min-font;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    // × at the top right (#328 §5.2 `remove-requested`). Live only while the
    // card is hovered: a tap on a touch screen, which has no hover, can
    // never land on an invisible ×. Scaled with the card so a click meant to
    // select a zoomed-out block never removes it.
    if root.removable : remove-ta := TouchArea {
        x: parent.width - 22px * root.zoom;
        y: -6px * root.zoom;
        width: 24px * root.zoom;
        height: 24px * root.zoom;
        enabled: root.hovered || self.has-hover;
        mouse-cursor: pointer;
        clicked => { root.remove-requested(); }
        accessible-role: button;
        accessible-label: @tr("accessible-graph-node-remove");

        Rectangle {
            x: 2px * root.zoom;
            y: 2px * root.zoom;
            width: 20px * root.zoom;
            height: 20px * root.zoom;
            border-radius: self.width / 2;
            background: Theme.panel-hi;
            border-width: 1px;
            border-color: Theme.field-line;
            visible: root.hovered || remove-ta.has-hover;

            Image {
                x: 4px * root.zoom;
                y: 4px * root.zoom;
                width: 12px * root.zoom;
                height: 12px * root.zoom;
                source: @image-url("../assets/close.svg");
                colorize: remove-ta.has-hover ? Theme.bad : Theme.ink-2;
            }
        }
    }

    // ── Split / mixer: the routing hub, one port per path ────────────
    if root.is-routing : GraphHub {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        mix: root.node.kind == "mixer";
        lanes: root.node.lanes;
        zoom: root.zoom;
        bypassed: root.node.bypass;
    }

    // ── Input / output: a jack with IN / OUT under it ────────────────
    if root.is-io : io-box := Rectangle {
        x: (parent.width - root.jack) / 2;
        y: (parent.height - root.jack) / 2;
        width: root.jack;
        height: root.jack;
        border-radius: root.jack / 2;
        background: @radial-gradient(circle, Gear.jack-hi 0%, Gear.jack-mid 60%, Gear.jack-rim 100%);
        drop-shadow-offset-y: 2px * root.zoom;
        drop-shadow-blur: 3px * root.zoom;
        drop-shadow-color: Gear.jack-shadow;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width * 0.36;
            height: self.width;
            border-radius: self.width / 2;
            background: Gear.jack-hole;
        }
    }

    // The name under a jack (IN / OUT) or a hub (SPLIT / MIX).
    if root.is-io || root.is-routing : Text {
        x: 0px;
        y: (parent.height + (root.is-io ? root.jack : root.hub)) / 2 + 4px * root.zoom;
        width: parent.width;
        text: root.face-label;
        color: Theme.ink-2;
        font-size: Theme.min-font;
        font-weight: 700;
        letter-spacing: 2px;
        horizontal-alignment: center;
        overflow: elide;
    }

    accessible-role: button;
    accessible-label: root.face-label;
    accessible-enabled: !root.unavailable;
}
