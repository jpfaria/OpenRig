// Responsibility: renders the backing track's seek bar.
import { Theme, Gear } from "../theme.slint";
// #398: a thin groove, the played part in the accent, the loop as a tinted
// zone ringed in the accent, and a white thumb. Position fill, the loop's stretch, a pending loop mark and a thumb. A click
// asks to jump there; the bar itself never moves until the player reports the
// new position.
export component PlayerSeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <bool> loop-active;
    in property <float> loop-start;
    in property <float> loop-end;
    in property <float> loop-mark: -1;
    callback seek(float);

    private property <float> span: max(root.duration, 0.001);
    private property <length> rail-x: 7px;
    private property <length> rail-w: root.width - 14px;

    height: 24px;

    // Rail.
    Rectangle {
        x: root.rail-x; y: (parent.height - 3px) / 2;
        width: root.rail-w; height: 3px;
        border-radius: 2px;
        background: Theme.groove;
    }

    // The loop's stretch, under the fill.
    if root.loop-active : Rectangle {
        x: root.rail-x + root.rail-w * clamp(root.loop-start / root.span, 0, 1);
        y: (parent.height - 14px) / 2;
        width: root.rail-w * clamp((root.loop-end - root.loop-start) / root.span, 0, 1);
        height: 14px;
        border-radius: 3px;
        background: Theme.accent.with-alpha(0.22);
        border-width: 1px;
        border-color: Theme.accent;
    }

    // Played so far.
    Rectangle {
        x: root.rail-x; y: (parent.height - 6px) / 2;
        width: root.rail-w * clamp(root.position / root.span, 0, 1);
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }

    if root.loop-mark >= 0 : Rectangle {
        x: root.rail-x + root.rail-w * clamp(root.loop-mark / root.span, 0, 1) - 1px;
        y: 3px;
        width: 2px; height: parent.height - 6px;
        background: Theme.accent;
    }

    // Thumb.
    Rectangle {
        x: root.rail-x + root.rail-w * clamp(root.position / root.span, 0, 1) - 7px;
        y: (parent.height - 14px) / 2;
        width: 14px; height: 14px;
        border-radius: 7px;
        background: Gear.white;
        border-width: 1px;
        border-color: Gear.edge-soft;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Gear.switch-shadow;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.duration > 0) {
                root.seek(clamp((self.mouse-x - root.rail-x) / root.rail-w, 0, 1) * root.duration);
            }
        }
    }
    accessible-role: slider;
    accessible-label: @tr("label-player-position");
    accessible-value: root.position;
}
