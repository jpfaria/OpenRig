// Responsibility: renders the stream meters of the compact view.
import { Theme } from "../theme.slint";
import { StreamMeter } from "../models.slint";

// Compact chain view footer — per-stream IN / OUT peak meter rows
// (#496 / #559). Extracted out of `compact_chain_view.slint` to keep that
// page under the 500-line cap (`scripts/validate.sh`). Stretched to fill
// its host's bounds so `parent.width`/`parent.height` keep meaning "the
// page", exactly as when this was inline.
export component CompactStreamMeters inherits Rectangle {
    in property <[StreamMeter]> stream-meters;
    in property <float> meter-in-dbfs: -120.0;
    in property <float> meter-out-dbfs: -120.0;
    // #717: the DI stream's own IN/OUT meter — rendered as one more row ABOVE
    // the chain's stream rows while the DI plays, with a DI accent so it reads
    // as the DI, not an input.
    in property <StreamMeter> di-meter;
    in property <bool> di-playing: false;

    // Row geometry sized for 18px text (#954): a row shorter than its label
    // makes an elided Text render nothing. The host reserves `row-pitch` per row.
    out property <length> row-pitch: 28px;
    private property <length> row-h: 24px;
    private property <length> bar-y: (root.row-h - 12px) / 2;
    private property <length> db-w: 64px;

    background: transparent;

    // #717: the DI row (one row above the chain's stream rows).
    if root.di-playing : di-row := Rectangle {
        x: 0px;
        y: parent.height - root.row-pitch - root.stream-meters.length * root.row-pitch;
        width: parent.width;
        height: root.row-h;

        Rectangle {
            x: 60px; y: 0px; width: di-in-bar.x + 134px + root.db-w; height: parent.height;
            di-in-label := Text {
                x: 0px; y: 0px; width: Math.max(44px, self.preferred-width); height: parent.height;
                text: "DI";
                font-size: 18px; font-weight: 800; color: Theme.accent;
                horizontal-alignment: right; vertical-alignment: center;
            }
            di-in-bar := Rectangle {
                x: di-in-label.width + 4px; y: root.bar-y; width: 130px; height: 12px;
                border-width: 1px;
                border-color: root.di-meter.in_dbfs > 0.0 ? Theme.bad : Theme.accent-line;
                border-radius: 2px;
                background: @linear-gradient(90deg, Theme.warn.with-alpha(0.38) 0%, Theme.warn 6%, Theme.warn 35%,
                    Theme.ok 50%, Theme.ok 88%, Theme.bad 95%, Theme.bad 100%);
                Rectangle {
                    x: parent.width * Math.max(0.0, Math.min(1.0, (root.di-meter.in_dbfs + 60.0) / 60.0));
                    width: parent.width * (1.0 - Math.max(0.0, Math.min(1.0, (root.di-meter.in_dbfs + 60.0) / 60.0)));
                    height: parent.height;
                    background: Theme.groove;
                }
            }
            Text {
                x: di-in-bar.x + 134px; y: 0px; width: root.db-w; height: parent.height;
                text: root.di-meter.in_dbfs <= -119.0 ? "—" : Math.round(root.di-meter.in_dbfs) + " dB";
                font-size: 18px; font-weight: 700;
                color: root.di-meter.in_dbfs <= -119.0 ? Theme.ink-3
                     : root.di-meter.in_dbfs > -3.0 ? Theme.bad
                     : root.di-meter.in_dbfs >= -30.0 ? Theme.ok : Theme.warn;
                vertical-alignment: center;
            }
        }
        Rectangle {
            width: di-out-bar.x + 134px + root.db-w;
            x: parent.width - self.width - 10px; y: 0px; height: parent.height;
            di-out-label := Text {
                x: 0px; y: 0px; width: Math.max(50px, self.preferred-width); height: parent.height;
                text: "DI OUT";
                font-size: 18px; font-weight: 800; color: Theme.accent;
                horizontal-alignment: right; vertical-alignment: center;
            }
            di-out-bar := Rectangle {
                x: di-out-label.width + 4px; y: root.bar-y; width: 130px; height: 12px;
                border-width: 1px;
                border-color: root.di-meter.out_dbfs > 0.0 ? Theme.bad : Theme.accent-line;
                border-radius: 2px;
                background: @linear-gradient(90deg, Theme.warn.with-alpha(0.38) 0%, Theme.warn 6%, Theme.warn 35%,
                    Theme.ok 50%, Theme.ok 88%, Theme.bad 95%, Theme.bad 100%);
                Rectangle {
                    x: parent.width * Math.max(0.0, Math.min(1.0, (root.di-meter.out_dbfs + 60.0) / 60.0));
                    width: parent.width * (1.0 - Math.max(0.0, Math.min(1.0, (root.di-meter.out_dbfs + 60.0) / 60.0)));
                    height: parent.height;
                    background: Theme.groove;
                }
            }
            Text {
                x: di-out-bar.x + 134px; y: 0px; width: root.db-w; height: parent.height;
                text: root.di-meter.out_dbfs <= -119.0 ? "—" : Math.round(root.di-meter.out_dbfs) + " dB";
                font-size: 18px; font-weight: 700;
                color: root.di-meter.out_dbfs <= -119.0 ? Theme.ink-3
                     : root.di-meter.out_dbfs > -3.0 ? Theme.bad
                     : root.di-meter.out_dbfs >= -30.0 ? Theme.ok : Theme.warn;
                vertical-alignment: center;
            }
        }
    }

    // One IN/OUT pair per `stream-meters` entry. Multi-input chains
    // (e.g. a 3-input chain) get 3 stacked rows here. Empty list ⇒
    // fall back to the single aggregate `meter-in-dbfs` /
    // `meter-out-dbfs` pair so old wiring keeps working.
    for stream[i] in root.stream-meters: Rectangle {
        x: 0px;
        y: parent.height - root.row-pitch
            - (root.stream-meters.length - 1 - i) * root.row-pitch;
        width: parent.width;
        height: root.row-h;

        // #1006: each input is listed once; its other outputs only fill the right.
        if !stream.in_repeated : Rectangle {
            x: 60px; y: 0px;
            width: 418px + root.db-w; height: parent.height;
            // #928 + #1006: the E/S name, then the direction and channels
            // this bar reads — one binding shares its name on both bars.
            HorizontalLayout {
                x: 0px; y: 0px;
                width: 280px; height: parent.height;
                spacing: 6px;
                alignment: end;
                in-name := Text {
                    text: stream.in_label;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.ink-3;
                    overflow: elide;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                in-channels := Text {
                    text: stream.in_channels == "" ? "IN" : "IN " + stream.in_channels;
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.in;
                    horizontal-stretch: 0;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                x: 284px; y: root.bar-y;
                width: 130px; height: 12px;
                border-width: 1px;
                border-color: stream.in_dbfs > 0.0 ? Theme.bad : Theme.hair;
                border-radius: 2px;
                background: @linear-gradient(90deg,
                    Theme.warn.with-alpha(0.38) 0%,
                    Theme.warn 6%,
                    Theme.warn 35%,
                    Theme.ok 50%,
                    Theme.ok 88%,
                    Theme.bad 95%,
                    Theme.bad 100%);
                Rectangle {
                    x: parent.width * Math.max(0.0,
                        Math.min(1.0, (stream.in_dbfs + 60.0) / 60.0));
                    y: 0px;
                    width: parent.width * (1.0 - Math.max(0.0,
                        Math.min(1.0, (stream.in_dbfs + 60.0) / 60.0)));
                    height: parent.height;
                    background: Theme.groove;
                }
            }
            Text {
                x: 418px; y: 0px;
                width: root.db-w; height: parent.height;
                text: stream.in_dbfs <= -119.0
                    ? "—"
                    : Math.round(stream.in_dbfs) + " dB";
                font-size: 18px; font-weight: 700;
                color: stream.in_dbfs <= -119.0 ? Theme.ink-3
                     : stream.in_dbfs > -3.0     ? Theme.bad
                     : stream.in_dbfs >= -30.0   ? Theme.ok
                     :                              Theme.warn;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 454px + root.db-w;
            x: parent.width - self.width - 10px; y: 0px; height: parent.height;
            // #928 + #1006: the E/S name, then the direction and channels
            // this bar reads — one binding shares its name on both bars.
            HorizontalLayout {
                x: 0px; y: 0px;
                width: 310px; height: parent.height;
                spacing: 6px;
                alignment: end;
                out-name := Text {
                    text: stream.out_label;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.ink-3;
                    overflow: elide;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                out-channels := Text {
                    text: stream.out_channels == "" ? "OUT" : "OUT " + stream.out_channels;
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.out;
                    horizontal-stretch: 0;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                x: 320px; y: root.bar-y;
                width: 130px; height: 12px;
                border-width: 1px;
                border-color: stream.out_dbfs > 0.0 ? Theme.bad : Theme.hair;
                border-radius: 2px;
                background: @linear-gradient(90deg,
                    Theme.warn.with-alpha(0.38) 0%,
                    Theme.warn 6%,
                    Theme.warn 35%,
                    Theme.ok 50%,
                    Theme.ok 88%,
                    Theme.bad 95%,
                    Theme.bad 100%);
                Rectangle {
                    x: parent.width * Math.max(0.0,
                        Math.min(1.0, (stream.out_dbfs + 60.0) / 60.0));
                    y: 0px;
                    width: parent.width * (1.0 - Math.max(0.0,
                        Math.min(1.0, (stream.out_dbfs + 60.0) / 60.0)));
                    height: parent.height;
                    background: Theme.groove;
                }
            }
            Text {
                x: 454px; y: 0px;
                width: root.db-w; height: parent.height;
                text: stream.out_dbfs <= -119.0
                    ? "—"
                    : Math.round(stream.out_dbfs) + " dB";
                font-size: 18px; font-weight: 700;
                color: stream.out_dbfs <= -119.0 ? Theme.ink-3
                     : stream.out_dbfs > -3.0     ? Theme.bad
                     : stream.out_dbfs >= -30.0   ? Theme.ok
                     :                               Theme.warn;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }

    // Fallback: when `stream-meters` is empty, render the legacy
    // single aggregate IN/OUT pair so wiring that hasn't migrated
    // to per-stream meters still shows something at the footer.
    if root.stream-meters.length == 0 : Rectangle {
        x: 60px;
        y: parent.height - root.row-pitch;
        width: in-bar.x + 134px + root.db-w;
        height: root.row-h;
        in-label := Text {
            x: 0; y: 0;
            width: Math.max(44px, self.preferred-width); height: parent.height;
            text: "INPUT";
            font-size: 18px; font-weight: 700;
            color: Theme.ink-3;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        in-bar := Rectangle {
            x: in-label.width + 4px; y: root.bar-y;
            width: 130px; height: 12px;
            border-width: 1px;
            border-color: root.meter-in-dbfs > 0.0 ? Theme.bad : Theme.hair;
            border-radius: 2px;
            background: @linear-gradient(90deg,
                Theme.warn.with-alpha(0.38) 0%,
                Theme.warn 6%,
                Theme.warn 35%,
                Theme.ok 50%,
                Theme.ok 88%,
                Theme.bad 95%,
                Theme.bad 100%);
            Rectangle {
                x: parent.width * Math.max(0.0,
                    Math.min(1.0, (root.meter-in-dbfs + 60.0) / 60.0));
                y: 0;
                width: parent.width * (1.0 - Math.max(0.0,
                    Math.min(1.0, (root.meter-in-dbfs + 60.0) / 60.0)));
                height: parent.height;
                background: Theme.groove;
            }
        }
        Text {
            x: in-bar.x + 134px; y: 0;
            width: root.db-w; height: parent.height;
            text: root.meter-in-dbfs <= -119.0
                ? "—"
                : Math.round(root.meter-in-dbfs) + " dB";
            font-size: 18px; font-weight: 700;
            color: root.meter-in-dbfs <= -119.0 ? Theme.ink-3
                 : root.meter-in-dbfs > -3.0     ? Theme.bad
                 : root.meter-in-dbfs >= -30.0   ? Theme.ok
                 :                                  Theme.warn;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }
    if root.stream-meters.length == 0 : Rectangle {
        width: out-bar.x + 134px + root.db-w;
        x: parent.width - self.width - 10px;
        y: parent.height - root.row-pitch;
        height: root.row-h;
        out-label := Text {
            x: 0; y: 0;
            width: Math.max(50px, self.preferred-width); height: parent.height;
            text: "OUTPUT";
            font-size: 18px; font-weight: 700;
            color: Theme.ink-3;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        out-bar := Rectangle {
            x: out-label.width + 4px; y: root.bar-y;
            width: 130px; height: 12px;
            border-width: 1px;
            border-color: root.meter-out-dbfs > 0.0 ? Theme.bad : Theme.hair;
            border-radius: 2px;
            background: @linear-gradient(90deg,
                Theme.warn.with-alpha(0.38) 0%,
                Theme.warn 6%,
                Theme.warn 35%,
                Theme.ok 50%,
                Theme.ok 88%,
                Theme.bad 95%,
                Theme.bad 100%);
            Rectangle {
                x: parent.width * Math.max(0.0,
                    Math.min(1.0, (root.meter-out-dbfs + 60.0) / 60.0));
                y: 0;
                width: parent.width * (1.0 - Math.max(0.0,
                    Math.min(1.0, (root.meter-out-dbfs + 60.0) / 60.0)));
                height: parent.height;
                background: Theme.groove;
            }
        }
        Text {
            x: out-bar.x + 134px; y: 0;
            width: root.db-w; height: parent.height;
            text: root.meter-out-dbfs <= -119.0
                ? "—"
                : Math.round(root.meter-out-dbfs) + " dB";
            font-size: 18px; font-weight: 700;
            color: root.meter-out-dbfs <= -119.0 ? Theme.ink-3
                 : root.meter-out-dbfs > -3.0     ? Theme.bad
                 : root.meter-out-dbfs >= -30.0   ? Theme.ok
                 :                                   Theme.warn;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }
}
