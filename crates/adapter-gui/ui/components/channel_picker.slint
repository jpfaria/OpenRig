// Responsibility: renders the channel picker.
// #880 — the ONE channel picker for the whole app.
//
// Interfaces routinely carry 30 inputs and 30 outputs. A row of checkboxes
// cannot hold that: everything past the right edge is rendered off-screen with
// no wrap and no scrollbar, so those channels are simply unreachable. Picking
// "input 23" out of 30 is a scanning task, and a vertical list with one channel
// per line is what people can scan.
//
// So: one channel per row, in a plain column, and the PAGE does the scrolling.
// The list deliberately has no scroll area of its own — Slint's Flickable
// intercepts a wheel gesture at `TouchPhase::Started` before its children
// (i-slint-core `items/flickable.rs`), so the settings panel's scroll area owns
// the whole gesture and a nested list never sees the wheel: it could only be
// moved by dragging its own scrollbar by hand.

import { Theme } from "../theme.slint";
import { Locale } from "../locale_globals.slint";
import { ChannelOptionItem } from "../models.slint";
import { CheckMark } from "check_mark.slint";
import { ElidedText } from "elided_text.slint";

component ChannelPickerRow inherits Rectangle {
    in property <ChannelOptionItem> channel;
    // Mono takes exactly one channel — a radio, not a checkbox.
    in property <bool> radio: false;
    callback toggled();

    background: ta.has-hover ? Theme.hover : transparent;
    accessible-role: checkbox;
    accessible-label: root.channel.label;
    accessible-checked: root.channel.selected;
    accessible-action-default => { root.toggled(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                opacity: root.channel.available ? 1 : 0.4;

                if root.radio : Rectangle {
                    border-radius: 9px;
                    background: Theme.field;
                    border-width: root.channel.selected ? 5px : 1.5px;
                    border-color: root.channel.selected ? Theme.accent : Theme.field-line;
                }
                if !root.radio : CheckMark {
                    checked: root.channel.selected;
                }
            }
        }

        ElidedText {
            horizontal-stretch: 1;
            text: root.channel.label;
            font-family: Locale.mono-font-family;
            color: root.channel.available
                ? (root.channel.selected ? Theme.ink : Theme.ink-2)
                : Theme.ink-3;
            font-size: Theme.min-font;
            font-weight: root.channel.selected ? 600 : 400;
            vertical-alignment: center;
            own-hover: false;
            hovered: ta.has-hover;
        }
    }

    ta := TouchArea {
        enabled: root.channel.available;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component ChannelPicker inherits Rectangle {
    in property <[ChannelOptionItem]> channels;
    // Single-select (mono) draws radios; multi-select draws checkboxes.
    in property <bool> single-select: false;
    in property <string> empty-hint;
    // #328: the endpoint checklist reuses this list; it counts endpoints, not
    // channels. Default is the channel wording every existing picker shows.
    in property <string> total-caption: @tr("label-channels-total", root.channels.length);
    // The endpoint checklist hides the count: its rows already say it.
    in property <bool> show-total: true;
    callback toggled(int /* index */, bool /* selected */);

    private property <length> row-height: 34px;
    private property <length> list-height: root.channels.length == 0
        ? 24px
        : root.channels.length * root.row-height;
    // Header + capped list + padding. Pinned so the picker never grows with the
    // channel count and never stretches to fill its row.
    private property <length> header-height: root.show-total ? 22px : 0px;
    private property <length> box-height: root.header-height + root.list-height + (root.show-total ? 20px : 16px);

    // Explicit height: layouts read it as a fixed constraint, and an
    // absolutely-positioned instance (the insert editor) needs it too —
    // without it the picker stretches to fill its parent.
    height: root.box-height;

    // #398: one field-coloured box with the field outline; the count heads
    // it above a faint rule.
    background: Theme.field;
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.field-line;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        // How many channels the device has; the checkboxes already show the pick.
        if root.show-total : Rectangle {
            height: root.header-height;

            Text {
                x: parent.width - self.width - 4px;
                width: self.preferred-width;
                height: parent.height;
                text: root.total-caption;
                color: Theme.ink-2;
                font-size: Theme.min-font;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle {
                x: -8px; y: parent.height + 1px;
                width: parent.width + 16px; height: 1px;
                background: Theme.hair-2;
            }
        }

        if root.channels.length == 0 : Text {
            height: root.list-height;
            text: root.empty-hint;
            color: Theme.ink-3;
            font-size: Theme.min-font;
            vertical-alignment: center;
        }

        if root.channels.length > 0 : chan-list := Rectangle {
            height: root.list-height;

            for ch[i] in root.channels : chan-cell := ChannelPickerRow {
                x: 0px;
                y: i * root.row-height;
                width: parent.width;
                height: root.row-height;
                channel: ch;
                radio: root.single-select;
                toggled => { root.toggled(i, !ch.selected); }
            }
        }
    }
}
