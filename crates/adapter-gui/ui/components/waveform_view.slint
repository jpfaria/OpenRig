// Responsibility: renders a recorded loop as an envelope.
// #826 — the recorded loop as a peak envelope, with a draggable selection.
//
// The peaks are computed in Rust (`engine::loop_edit::peaks`) and handed in as
// values in 0..=1, one per bar: the view never sees samples and never decides
// anything. The selection travels back as two ratios of the loop (0..=1), so
// the frame arithmetic stays on the Rust side too.

import { Theme } from "../theme.slint";

export component WaveformView inherits Rectangle {
    in property <[float]> peaks;
    // Where the loop is playing, as a ratio (0..=1); the line is hidden when
    // nothing is sounding.
    in property <bool> playing;
    in property <float> playhead;
    // Selection bounds as a ratio of the loop, `start` <= `end`.
    in-out property <float> sel-start: 0.0;
    in-out property <float> sel-end: 1.0;

    // The grab area around each 2px handle line.
    private property <length> handle-width: 16px;

    background: Theme.field;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.hair;
    clip: true;

    accessible-role: progress-indicator;
    accessible-label: @tr("looper-editor-waveform");

    // The envelope: one step per bucket, mirrored about the mid line.
    HorizontalLayout {
        padding: 1px;
        spacing: 0px;
        for p[i] in root.peaks: Rectangle {
            // Every step takes the same share of the width.
            width: (root.width - 2px) / max(1, root.peaks.length);
            Rectangle {
                width: parent.width;
                height: max(1px, p * (parent.height - 8px));
                y: (parent.height - self.height) / 2;
                background: Theme.in;
                opacity: 0.75;
            }
        }
    }

    Rectangle {
        y: (root.height - 1px) / 2;
        width: root.width;
        height: 1px;
        background: Theme.hair;
    }

    // What an edit keeps (or removes) is the lit stretch.
    Rectangle {
        x: root.width * root.sel-start;
        width: root.width * (root.sel-end - root.sel-start);
        height: root.height;
        background: Theme.accent.with-alpha(0.16);
    }

    // The playhead: drawn over the envelope and under the handles, so a drag
    // is never fighting it for the pointer.
    if root.playing : Rectangle {
        x: root.width * root.playhead - self.width / 2;
        width: 2px;
        height: root.height;
        background: Theme.ink;
    }

    start-handle := Rectangle {
        x: root.width * root.sel-start - self.width / 2;
        width: root.handle-width;
        height: root.height;

        accessible-role: slider;
        accessible-label: @tr("looper-editor-selection-start");
        accessible-value: root.sel-start;

        Rectangle {
            x: (parent.width - self.width) / 2;
            width: start-area.has-hover || start-area.pressed ? 3px : 2px;
            height: parent.height;
            background: Theme.accent;
        }
        Rectangle {
            x: (parent.width - 14px) / 2;
            y: -3px;
            width: 14px;
            height: 17px;
            border-radius: 3px;
            background: Theme.accent;
        }

        start-area := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                // Clamp to the loop and never cross the other handle.
                root.sel-start = max(0.0, min(root.sel-end - 0.02,
                    (self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width));
            }
        }
    }

    end-handle := Rectangle {
        x: root.width * root.sel-end - self.width / 2;
        width: root.handle-width;
        height: root.height;

        accessible-role: slider;
        accessible-label: @tr("looper-editor-selection-end");
        accessible-value: root.sel-end;

        Rectangle {
            x: (parent.width - self.width) / 2;
            width: end-area.has-hover || end-area.pressed ? 3px : 2px;
            height: parent.height;
            background: Theme.accent;
        }
        Rectangle {
            x: (parent.width - 14px) / 2;
            y: -3px;
            width: 14px;
            height: 17px;
            border-radius: 3px;
            background: Theme.accent;
        }

        end-area := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                root.sel-end = min(1.0, max(root.sel-start + 0.02,
                    (self.absolute-position.x + self.mouse-x - root.absolute-position.x) / root.width));
            }
        }
    }
}
