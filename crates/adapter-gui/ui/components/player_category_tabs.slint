// Responsibility: renders the tabs that pick which part the library lists.
// #398: one closed segmented field, four equal parts, the picked one filled
// in the accent.
import { Theme } from "../theme.slint";
import { PlayerBridge } from "player_globals.slint";
import { Locale } from "../locale_globals.slint";

// One part a player can practise over: solo, rhythm, bass, acoustic.
component PlayerCategoryTab inherits Rectangle {
    in property <string> key;
    in property <bool> active;
    callback pick();

    min-width: 0;
    horizontal-stretch: 1;
    background: root.active ? Theme.accent : (ta.has-hover ? Theme.panel-hi : transparent);

    Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.key == "solo" ? @tr("label-category-solo")
            : root.key == "rhythm" ? @tr("label-category-rhythm")
            : root.key == "bass" ? @tr("label-category-bass")
            : root.key == "acoustic" ? @tr("label-category-acoustic")
            : @tr("label-category-other");
        color: root.active ? Theme.on-accent : Theme.ink-2;
        font-family: Locale.display-font-family;
        font-size: Theme.min-font;
        letter-spacing: 0.08 * Theme.min-font;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pick(); }
    }
    accessible-role: tab;
    accessible-label: root.key;
}

export component PlayerCategoryTabs inherits Rectangle {
    height: 32px;
    border-radius: 4px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.field-line;
    clip: true;

    HorizontalLayout {
        padding: 1px;
        for key in PlayerBridge.categories : PlayerCategoryTab {
            key: key;
            active: key == PlayerBridge.category;
            pick => { PlayerBridge.pick-category(key); }
        }
    }
}
