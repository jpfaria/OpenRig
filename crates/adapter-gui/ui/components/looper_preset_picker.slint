// Responsibility: renders the looper preset picker modal.
// #323 phase 2 — a root-level overlay (never a PopupWindow, so every option is
// a reachable in-tree TouchArea, the #749/#761 lesson). Lists the chain's
// preset options; index 0 is "follow the chain" (clears the fixed link).
// #1022: shared by the main window's looper overlay and the compact view.

import { Theme } from "../theme.slint";
import { LooperPanel } from "looper_panel_globals.slint";

export component LooperPresetPicker inherits Rectangle {
    // The chain's bank presets; option 0 ("follow the chain") is injected here.
    in property <[string]> preset-options;
    // (chain-index, uid, option-index) — the picked preset.
    callback preset-picked(int, int, int);

    background: Theme.scrim;

    // Click-outside closes without changing the link.
    TouchArea { clicked => { LooperPanel.preset-picker-uid = -1; } }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 360px;
        // +1 row for the "follow the chain" option the picker injects at 0.
        height: min(root.height - 80px, 96px + (root.preset-options.length + 1) * 48px);
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.palette.border-strong;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: @tr("looper-preset-picker-title");
                color: Theme.palette.text-primary;
                font-size: Theme.min-font;
                font-weight: 700;
            }

            Flickable {
                viewport-height: options-col.preferred-height;
                options-col := VerticalLayout {
                    spacing: 4px;

                    // Option 0 — "follow the chain" (clears the fixed link).
                    follow-row := Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: LooperPanel.preset-picker-selected == 0
                            ? Theme.accent : transparent;
                        background: follow-ta.has-hover
                            ? Theme.accent-soft
                            : (LooperPanel.preset-picker-selected == 0 ? Theme.accent.with-alpha(0.08) : Theme.panel-hi);

                        Text {
                            x: 12px;
                            width: parent.width - 44px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: @tr("looper-preset-follow");
                            color: Theme.palette.text-secondary;
                            font-size: Theme.min-font;
                            overflow: elide;
                        }

                        Text {
                            x: parent.width - 30px;
                            width: 20px;
                            height: parent.height;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            text: LooperPanel.preset-picker-selected == 0 ? "✓" : "";
                            color: Theme.accent;
                            font-size: Theme.min-font;
                            font-weight: 700;
                        }

                        follow-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.preset-picked(LooperPanel.chain-index, LooperPanel.preset-picker-uid, 0);
                                LooperPanel.preset-picker-uid = -1;
                            }
                        }

                        accessible-role: button;
                        accessible-label: @tr("looper-preset-follow");
                    }

                    // Options 1..N — the chain's bank presets.
                    for option[i] in root.preset-options : Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: (i + 1) == LooperPanel.preset-picker-selected
                            ? Theme.accent : transparent;
                        background: opt-ta.has-hover
                            ? Theme.accent-soft
                            : ((i + 1) == LooperPanel.preset-picker-selected ? Theme.accent.with-alpha(0.08) : Theme.panel-hi);

                        Text {
                            x: 12px;
                            width: parent.width - 44px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: option;
                            color: Theme.palette.text-primary;
                            font-size: Theme.min-font;
                            overflow: elide;
                        }

                        Text {
                            x: parent.width - 30px;
                            width: 20px;
                            height: parent.height;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            text: (i + 1) == LooperPanel.preset-picker-selected ? "✓" : "";
                            color: Theme.accent;
                            font-size: Theme.min-font;
                            font-weight: 700;
                        }

                        opt-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.preset-picked(LooperPanel.chain-index, LooperPanel.preset-picker-uid, i + 1);
                                LooperPanel.preset-picker-uid = -1;
                            }
                        }

                        accessible-role: button;
                        accessible-label: option;
                    }
                }
            }
        }
    }
}
