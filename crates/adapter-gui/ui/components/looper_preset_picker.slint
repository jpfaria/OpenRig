// Responsibility: renders the looper preset picker modal.
// #323 phase 2 — a root-level overlay (never a PopupWindow, so every option is
// a reachable in-tree TouchArea, the #749/#761 lesson). Lists the chain's
// preset options; index 0 is "follow the chain" (clears the fixed link).
// #1022: shared by the main window's looper overlay and the compact view.
//
// #398: a dialog card — the title in the display face over one framed list:
// "follow the chain" first, then the numbered presets; the linked one is
// tinted with an accent edge.

import { Theme } from "../theme.slint";
import { LooperPanel } from "looper_panel_globals.slint";
import { ListBox, ListRow } from "list_box.slint";
import { Locale } from "../locale_globals.slint";

export component LooperPresetPicker inherits Rectangle {
    // The chain's bank presets; option 0 ("follow the chain") is injected here.
    in property <[string]> preset-options;
    // (chain-index, uid, option-index) — the picked preset.
    callback preset-picked(int, int, int);

    background: Theme.scrim;

    // Click-outside closes without changing the link.
    TouchArea { clicked => { LooperPanel.preset-picker-uid = -1; } }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 32px, 420px);
        // +1 row for the "follow the chain" option the picker injects at 0.
        height: min(root.height - 80px, 18px + 24px + 10px + (root.preset-options.length + 1) * 44px + 2px + 18px);
        background: Theme.panel;
        border-radius: 6px;
        clip: true;
        border-width: 1px;
        border-color: Theme.hair;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.shadow;

        // Swallow clicks on the card so only the scrim closes it.
        TouchArea { }

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                height: 24px;
                text: @tr("looper-preset-picker-title");
                color: Theme.ink;
                font-family: Locale.display-font-family;
                font-size: 24px;
                letter-spacing: 0.05 * 24px;
                vertical-alignment: center;
            }

            Flickable {
                viewport-height: options-box.preferred-height;
                options-box := ListBox {
                    width: parent.width;
                    // Option 0 — "follow the chain" (clears the fixed link).
                    Rectangle {
                        min-height: 44px;
                        background: follow-ta.has-hover ? Theme.hover : transparent;

                        follow-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.preset-picked(LooperPanel.chain-index, LooperPanel.preset-picker-uid, 0);
                                LooperPanel.preset-picker-uid = -1;
                            }
                        }

                        ListRow {
                            width: parent.width;
                            height: parent.height;
                            divided: false;
                            on: LooperPanel.preset-picker-selected == 0;
                            Text {
                                horizontal-stretch: 1;
                                text: @tr("looper-preset-follow");
                                color: Theme.ink;
                                font-size: Theme.min-font;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        accessible-role: button;
                        accessible-label: @tr("looper-preset-follow");
                        accessible-checked: LooperPanel.preset-picker-selected == 0;
                    }

                    // Options 1..N — the chain's bank presets.
                    for option[i] in root.preset-options : Rectangle {
                        min-height: 44px;
                        background: opt-ta.has-hover ? Theme.hover : transparent;

                        opt-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.preset-picked(LooperPanel.chain-index, LooperPanel.preset-picker-uid, i + 1);
                                LooperPanel.preset-picker-uid = -1;
                            }
                        }

                        ListRow {
                            width: parent.width;
                            height: parent.height;
                            on: (i + 1) == LooperPanel.preset-picker-selected;
                            Text {
                                width: 26px;
                                text: (i < 9 ? "0" : "") + (i + 1);
                                color: Theme.ink-3;
                                font-size: Theme.min-font;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: option;
                                color: Theme.ink;
                                font-size: Theme.min-font;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        accessible-role: button;
                        accessible-label: option;
                        accessible-checked: (i + 1) == LooperPanel.preset-picker-selected;
                    }
                }
            }
        }
    }
}
