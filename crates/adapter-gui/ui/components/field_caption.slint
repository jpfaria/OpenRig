// Responsibility: renders the caption above a form field.
// #398: the small bold uppercase label of a field (`OUTPUT`, `KIT`, `TRACKS`),
// spaced out and quiet so the field below reads first. Callers pass the
// normal translated string; the caption sets it in upper case.
import { Theme } from "../theme.slint";
import { ElidedText } from "elided_text.slint";

export component FieldCaption {
    in property <string> text;
    in property <brush> color: Theme.ink-2;

    min-height: label.min-height;
    preferred-height: label.preferred-height;
    preferred-width: label.preferred-width;
    vertical-stretch: 0;

    label := ElidedText {
        width: 100%;
        height: 100%;
        text: root.text.to-uppercase();
        color: root.color;
        font-size: Theme.min-font;
        font-weight: 700;
        letter-spacing: 0.12 * Theme.min-font;
        vertical-alignment: center;
    }
}
