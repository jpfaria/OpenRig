// Responsibility: renders a model select with a search field.
import { Theme, Gear } from "../theme.slint";
import { BlockModelPickerItem } from "../models.slint";
import { TextField } from "text_field.slint";
import { ModelPickRow } from "model_pick_row.slint";
import { OverlayPlacement } from "overlay_placement.slint";
import { WindowBounds } from "window_bounds.slint";

// Reusable model picker with embedded search field.
//
// The host (Rust) is responsible for filtering: it listens to
// `search-text-changed` and rewrites `filtered-models` accordingly.
// The component is intentionally "dumb" about filter logic so the
// same UI works in every place a model select is needed.
export component ModelSelectWithSearch inherits Rectangle {
    // ── inputs ────────────────────────────────────────────────────────
    in property <[BlockModelPickerItem]> filtered-models;
    in property <BlockModelPickerItem> selected-model;
    in-out property <string> search-text;
    in property <length> popup-height: 220px;
    // #761: a `PopupWindow` renders its content on a separate surface that
    // doesn't reliably receive pointer events when the host is nested
    // inside a `clip: true` ancestor (proven by
    // `issue_761_model_select_popup_interaction.rs` — same defect class
    // #749 hit with the DI loop panel). Hosts that live inside such an
    // ancestor (the compact chain view) set this to `true`: the internal
    // `PopupWindow` is never shown: `open-requested` fires instead, so the
    // host can render the option list itself as a root-level overlay that
    // isn't clipped. Default `false` keeps every other caller (standalone
    // block editor, block-insert flow) on the original behavior.
    in property <bool> external-popup: false;
    // #398: the compact card shows the type badge on its category strip.
    in property <bool> show-badge: true;
    // #398: the editor's model bar is dark chrome; the field follows it.
    in property <bool> on-chrome: false;

    // ── outputs ───────────────────────────────────────────────────────
    callback select(string);
    callback search-text-changed(string);
    // #761: window-absolute (x, y, width) of the closed button, fired
    // instead of opening the internal popup when `external-popup` is true.
    callback open-requested(length, length, length);

    // ── closed-button visuals ─────────────────────────────────────────
    // #398: a quiet field with a chevron.
    height: 40px;
    background: root.on-chrome ? Theme.chrome-field : Theme.field;
    border-width: 1px;
    border-color: root.on-chrome
        ? (main-ta.has-hover ? Theme.chrome-fg-2 : Theme.chrome-field-line)
        : (main-ta.has-hover ? Theme.ink-3 : Theme.field-line);
    border-radius: 3px;

    // Composed in Rust (`block_model_picker_items`): the brand as the catalog
    // writes it, then the model.
    private property <string> selected-button-label:
        root.selected-model.label != "" ? root.selected-model.label : root.selected-model.display_name;

    // The backend's colour: a tinted chip on a light field, solid on the chrome.
    private property <color> backend-color:
        root.selected-model.type_label == "NATIVE" ? Theme.b-native
        : root.selected-model.type_label == "NAM/A2" ? Theme.warn
        : (root.selected-model.type_label == "NAM" || root.selected-model.type_label == "NAM/A1") ? Theme.b-nam
        : root.selected-model.type_label == "IR" ? Theme.b-ir
        : root.selected-model.type_label == "LV2" ? Theme.b-lv2
        : Theme.b-vst3;

    private property <length> badge-reserve:
        root.selected-model.type_label == "" || !root.show-badge ? 0px : badge.width + 14px;

    Text {
        x: 10px;
        y: 0;
        width: parent.width - 30px - root.badge-reserve;
        height: parent.height;
        text: root.on-chrome ? root.selected-button-label.to-uppercase() : root.selected-button-label;
        color: root.on-chrome ? Theme.chrome-fg : Theme.ink;
        font-size: Theme.min-font;
        font-weight: 600;
        letter-spacing: root.on-chrome ? 0.06 * Theme.min-font : 0px;
        vertical-alignment: center;
        overflow: elide;
    }

    // Always present (hidden when empty) so the label can reserve its width;
    // the badge follows its text ("NATIVE" no longer fits 42px at 18px).
    badge := Rectangle {
        visible: root.selected-model.type_label != "" && root.show-badge;
        x: parent.width - 28px - self.width;
        y: (parent.height - 22px) / 2;
        width: max(42px, badge-text.preferred-width + 10px);
        height: 22px;
        border-radius: 3px;
        background: root.on-chrome ? root.backend-color : root.backend-color.with-alpha(0.14);
        border-width: root.on-chrome ? 0px : 1px;
        border-color: root.backend-color.with-alpha(0.5);

        badge-text := Text {
            width: parent.width;
            height: parent.height;
            text: root.selected-model.type_label;
            color: root.on-chrome ? Gear.white : root.backend-color;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 0.5px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    Image {
        x: parent.width - 20px;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        source: @image-url("../assets/chevron-down.svg");
        colorize: root.on-chrome ? Theme.chrome-fg-2 : Theme.ink-3;
    }

    main-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // Search resets every time the popup is reopened so the
            // filter is never sticky between selections.
            root.search-text = "";
            root.search-text-changed("");
            if root.external-popup {
                root.open-requested(self.absolute-position.x, self.absolute-position.y, root.width);
            } else {
                popup.show();
            }
        }
    }

    // ── popup ─────────────────────────────────────────────────────────
    // #398: the search field (focused on open) over one framed list, grouped
    // by block type, each model with its backend as a solid badge.
    popup := PopupWindow {
        x: 0;
        // Under the field, above it when the window has no room below (#398).
        y: OverlayPlacement.top(root.absolute-position.y - 4px, root.absolute-position.y + root.height + 4px,
            self.height, WindowBounds.height) - root.absolute-position.y;
        width: max(root.width, 320px);
        height: OverlayPlacement.fit(root.popup-height, WindowBounds.height);
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.hair;
            border-radius: 6px;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 8px;
            clip: true;

            VerticalLayout {
                padding: 10px;
                spacing: 10px;

                TextField {
                    text <=> root.search-text;
                    placeholder: @tr("placeholder-search-models");
                    edited(t) => { root.search-text-changed(t); }
                    init => { self.focus-field(); }
                }

                // Empty state.
                if root.filtered-models.length == 0 : Text {
                    height: 36px;
                    text: @tr("status-no-models-found");
                    color: Theme.ink-3;
                    font-size: Theme.min-font;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                // Filtered list. Flickable supports wheel/trackpad scroll
                // without rendering a visible scrollbar — the visual noise
                // of std-widgets ScrollView's track was rejected.
                if root.filtered-models.length > 0 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: 4px;
                    clip: true;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: Theme.hair;

                    Flickable {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        viewport-width: self.width;
                        viewport-height: rows.preferred-height;

                        rows := VerticalLayout {
                            alignment: start;

                            for model[i] in root.filtered-models : Rectangle {
                                height: pick.height;

                                pick := ModelPickRow {
                                    width: parent.width;
                                    model: model;
                                    on: model.model_id == root.selected-model.model_id;
                                    divided: i > 0;
                                    header: i == 0 || model.effect_type != root.filtered-models[i - 1].effect_type
                                        ? model.effect_type.to-uppercase() : "";
                                }

                                row-ta := TouchArea {
                                    y: pick.header-height;
                                    height: parent.height - pick.header-height;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.select(model.model_id);
                                        popup.close();
                                    }
                                    // Bubble wheel/trackpad scroll up to the
                                    // Flickable — without this, the row's
                                    // TouchArea swallows the scroll event and
                                    // the list stops scrolling under the cursor.
                                    scroll-event(_) => {
                                        reject
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
