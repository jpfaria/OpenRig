// Responsibility: renders the architecture choice of a TONE3000 tone.
// #398 vocabulary: a small field-coloured square that fills in the accent
// when picked; an architecture the tone has no captures for stays dim.
import { Theme } from "../theme.slint";

export component Tone3000Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback pick();

    width: 40px;
    height: 28px;
    border-radius: 4px;
    opacity: root.enabled ? 1.0 : 0.35;
    background: root.active ? Theme.accent : (ta.has-hover && root.enabled ? Theme.panel-hi : Theme.field);
    border-width: root.active ? 0 : 1px;
    border-color: Theme.field-line;

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.active ? Theme.on-accent : Theme.ink-2;
        font-size: Theme.min-font;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.pick(); }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.pick(); }
}
