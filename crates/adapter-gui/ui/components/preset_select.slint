// Responsibility: renders the preset bank dropdown.
// The chain preset bank dropdown. #398: a field (the same input surface as
// every form control) with a chevron. The popup is a search-as-you-type
// finder with a bounded, scrolling list — mirrors the block model picker
// (`ModelSelectWithSearch`) so a large bank no longer overflows the screen
// (issue #659). Extracted from chain_title_preset.slint to keep that file
// under the 500-line cap.
//
// Filtering lives in Rust (Slint has no string `contains`): on open we hand
// the full label list to `PresetPicker.open`; each keystroke fires
// `PresetPicker.query-changed`; Rust republishes `PresetPicker.options`
// (each row carrying its original bank slot). `picked` reports that slot, so
// selection stays correct regardless of the filtered order.

import { Theme } from "../theme.slint";
import { PresetOption } from "../models.slint";
import { OverlayPlacement } from "overlay_placement.slint";
import { WindowBounds } from "window_bounds.slint";
import { PresetPicker } from "../preset_picker_globals.slint";

export component PresetSelect inherits Rectangle {
    in property <[string]> labels;
    in property <int> active-index;
    // Caps the popup so it never runs past the screen; it shrinks for short
    // banks and scrolls for long ones.
    in property <length> max-popup-height: 380px;
    // #398: sits on the dark chrome bar (the compact view's header).
    in property <bool> on-chrome: false;
    callback picked(int);
    height: 32px;
    border-radius: 3px;
    background: root.on-chrome ? Theme.chrome-field : Theme.field;
    border-width: 1px;
    border-color: root.on-chrome
        ? (ta.has-hover ? Theme.chrome-fg-2 : Theme.chrome-field-line)
        : (ta.has-hover ? Theme.ink-3 : Theme.field-line);
    animate border-color { duration: 150ms; }

    private property <length> header-height: 54px;
    private property <length> row-height: 34px;
    private property <length> list-height:
        PresetPicker.options.length > 0
            ? PresetPicker.options.length * root.row-height
            : root.row-height;

    Text {
        x: 10px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.active-index >= 0 && root.active-index < root.labels.length
            ? root.labels[root.active-index]
            : "";
        color: root.on-chrome ? Theme.chrome-fg : Theme.ink;
        font-size: Theme.min-font;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 24px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("../assets/chevron-down.svg");
        image-fit: contain;
        colorize: root.on-chrome
            ? (ta.has-hover ? Theme.chrome-fg : Theme.chrome-fg-2)
            : (ta.has-hover ? Theme.ink : Theme.ink-3);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // Reset the filter on every open so a stale query never hides
            // half the bank, then hand the full list to Rust to publish.
            PresetPicker.search = "";
            PresetPicker.open(root.labels);
            pop.show();
        }
    }
    accessible-role: button;
    accessible-label: @tr("Preset selector");

    pop := PopupWindow {
        x: 0px;
        // Under the field, above it when the window has no room below (#398).
        y: OverlayPlacement.top(root.absolute-position.y - 4px, root.absolute-position.y + root.height + 4px,
            self.height, WindowBounds.height) - root.absolute-position.y;
        // PopupWindow has no intrinsic size — size it explicitly or it
        // collapses to 0. Cap to `max-popup-height` and to the window.
        width: root.width;
        height: OverlayPlacement.fit(min(
            root.header-height + root.list-height + 8px,
            root.max-popup-height), WindowBounds.height);
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.panel-hi;
            border-width: 1px;
            border-color: Theme.hair;
            border-radius: 4px;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 6px;
            clip: true;

            // Sticky search header.
            Rectangle {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: 40px;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.field-line;
                border-radius: 3px;

                Image {
                    x: 10px;
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../modules/surrealism-ui/icons/search.svg");
                    colorize: Theme.ink-3;
                }

                input := TextInput {
                    x: 30px;
                    y: 0;
                    width: parent.width - 30px - (PresetPicker.search == "" ? 8px : 28px);
                    height: parent.height;
                    text <=> PresetPicker.search;
                    color: Theme.ink;
                    font-size: Theme.min-font;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    single-line: true;
                    edited => {
                        PresetPicker.query-changed(self.text);
                    }
                }

                if PresetPicker.search == "" : Text {
                    x: 30px;
                    y: 0;
                    width: parent.width - 38px;
                    height: parent.height;
                    text: @tr("preset-search-placeholder");
                    color: Theme.ink-3;
                    font-size: Theme.min-font;
                    vertical-alignment: center;
                }

                if PresetPicker.search != "" : TouchArea {
                    x: parent.width - 28px;
                    y: 0;
                    width: 24px;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => {
                        PresetPicker.search = "";
                        PresetPicker.query-changed("");
                    }
                    Image {
                        x: (parent.width - 12px) / 2;
                        y: (parent.height - 12px) / 2;
                        width: 12px;
                        height: 12px;
                        source: @image-url("../modules/surrealism-ui/icons/close.svg");
                        colorize: Theme.ink-2;
                    }
                }
            }

            // Empty state.
            if PresetPicker.options.length == 0 : Text {
                x: 0;
                y: 58px;
                width: parent.width;
                height: 36px;
                text: @tr("status-no-presets-found");
                color: Theme.ink-3;
                font-size: Theme.min-font;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            // Scrolling list. Flickable scrolls with wheel/trackpad and
            // renders no visible scrollbar — same choice as the block picker.
            if PresetPicker.options.length > 0 : Flickable {
                x: 0;
                y: root.header-height;
                width: parent.width;
                height: parent.height - root.header-height - 4px;
                content-width: self.width;
                content-height: PresetPicker.options.length * root.row-height + 4px;

                for option[i] in PresetPicker.options : Rectangle {
                    x: 4px;
                    y: i * root.row-height;
                    width: parent.width - 8px;
                    height: root.row-height;
                    border-radius: 3px;
                    background: option.slot == root.active-index
                        ? Theme.accent
                        : (row-ta.has-hover ? Theme.panel-lo : transparent);
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: option.label;
                        color: option.slot == root.active-index ? Theme.on-accent : Theme.ink;
                        font-size: Theme.min-font;
                        font-weight: option.slot == root.active-index ? 700 : 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    row-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.picked(option.slot);
                            pop.close();
                        }
                        // Let wheel/trackpad scroll bubble to the Flickable
                        // instead of being swallowed by the row.
                        scroll-event(_) => {
                            reject
                        }
                    }
                }
            }
        }
    }
}
