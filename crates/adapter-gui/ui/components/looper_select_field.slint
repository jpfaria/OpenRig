// Responsibility: renders a select field of a looper drawer.
// The caption above, the closed field below (its value and a chevron);
// pressing it asks the host to open the option list as a root-level modal
// (never a PopupWindow, so every option stays a reachable in-tree TouchArea).
//
// #398: the field look lives in `LooperSelectBox`, so the preset field (whose
// touch target belongs to the row) draws the same box.

import { Theme } from "../theme.slint";
import { FieldCaption } from "field_caption.slint";

// The closed field: the value, elided, and a chevron. The host puts the touch
// target inside it.
export component LooperSelectBox inherits Rectangle {
    in property <string> value;
    in property <bool> hovered;
    // A default value ("follow the chain") reads quieter than a picked one.
    in property <bool> muted;

    height: 32px;
    border-radius: 3px;
    background: Theme.field;
    border-width: 1px;
    border-color: root.hovered ? Theme.ink-3 : Theme.field-line;

    Text {
        x: 10px;
        width: parent.width - 36px;
        height: parent.height;
        vertical-alignment: center;
        text: root.value;
        color: root.muted ? Theme.ink-3 : Theme.ink;
        font-size: Theme.min-font;
        font-weight: 500;
        overflow: elide;
    }

    Image {
        x: parent.width - 21px;
        y: (parent.height - 11px) / 2;
        width: 11px;
        height: 11px;
        source: @image-url("../assets/chevron-down.svg");
        image-fit: contain;
        colorize: Theme.ink-3;
    }

    @children
}

export component LooperSelectField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback open();

    height: 60px;

    FieldCaption {
        x: 0;
        y: 0;
        width: parent.width;
        height: 22px;
        text: root.label;
    }

    LooperSelectBox {
        x: 0;
        y: 28px;
        width: parent.width;
        value: root.value;
        hovered: field-ta.has-hover;

        field-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(); }
        }

        accessible-role: combobox;
        accessible-label: root.label;
        accessible-value: root.value;
        accessible-action-default => { root.open(); }
    }
}
