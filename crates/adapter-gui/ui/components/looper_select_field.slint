// Responsibility: renders a labelled select field of a looper drawer row.
// A field showing the current value with a caret; pressing it asks the host to
// open the option list as a root-level modal (never a PopupWindow, so every
// option stays a reachable in-tree TouchArea).

import { Theme } from "../theme.slint";

export component LooperSelectField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback open();
    // The label column width shared with sibling rows (so columns line up);
    // the column still grows to fit this row's own (translated) label.
    in property <length> label-width: 74px;
    out property <length> label-natural: label-text.preferred-width;

    private property <length> label-w: max(root.label-width, root.label-natural);

    height: max(28px, label-text.preferred-height);

    label-text := Text {
        x: 0;
        width: root.label-w;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        color: Theme.palette.text-muted;
        font-size: Theme.min-font;
    }

    Rectangle {
        x: root.label-w + 6px;
        width: parent.width - root.label-w - 6px;
        height: parent.height;
        border-radius: 6px;
        border-width: 1px;
        border-color: field-ta.has-hover ? Theme.accent : Theme.palette.border;
        background: field-ta.has-hover ? Theme.accent-soft : transparent;

        Text {
            x: 10px;
            width: parent.width - 34px;
            height: parent.height;
            vertical-alignment: center;
            text: root.value;
            color: Theme.palette.text-primary;
            font-size: Theme.min-font;
            overflow: elide;
        }

        Image {
            x: parent.width - 24px;
            y: (parent.height - 14px) / 2;
            width: 14px;
            height: 14px;
            source: @image-url("../assets/arrow-down.svg");
            image-fit: contain;
            colorize: Theme.palette.text-muted;
        }

        field-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(); }
        }

        accessible-role: combobox;
        accessible-label: root.label;
        accessible-value: root.value;
        accessible-action-default => { root.open(); }
    }
}
