// Responsibility: asks the user to confirm deleting a chain.
// Modal dialog asking the user to confirm deletion of a chain (issue #511).
// Same shape as `ConfirmDeleteBlockDialog`, distinct copy lives separately so
// each dialog stays single-responsibility and easy to translate.
// Used as an overlay inside AppWindow when `show-confirm-delete-chain` is true.
//
// #398: the shared dialog card — the title in the display face, the question,
// then Cancel and the red confirm on the footer.
import { DialogCard, ConfirmBody } from "dialog_card.slint";
import { DialogFoot } from "dialog_foot.slint";
import { FormButton, FormButtonKind } from "form_button.slint";

export component ConfirmDeleteChainDialog inherits Rectangle {
    in property <string> chain-name;
    callback cancel();
    callback confirm();

    DialogCard {
        width: parent.width;
        height: parent.height;

        ConfirmBody {
            title: @tr("title-dialog-delete-chain");
            // Match the literal-as-msgid pattern used by
            // ConfirmDeleteBlockDialog so translators see the source
            // text directly.
            message: @tr("Excluir a chain \"{}\"?", root.chain-name);
        }

        DialogFoot {
            cancel-area := FormButton {
                icon-only: true;
                icon: @image-url("../assets/close.svg");
                label: @tr("btn-cancel");
                clicked => { root.cancel(); }
            }
            confirm-area := FormButton {
                icon-only: true;
                icon: @image-url("../assets/trash.svg");
                kind: FormButtonKind.danger;
                label: @tr("btn-delete");
                clicked => { root.confirm(); }
            }
        }
    }
}
