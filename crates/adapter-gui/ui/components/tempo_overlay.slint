// Responsibility: hosts the tempo panel as an overlay over the chain list.
// A chain header's chip flips `TempoPanel.open` and records where it sits;
// this renders the panel there, above the list (so it is never clipped by it),
// with a click-outside backdrop. The panel reads the opened chain's rig
// navigation from `navs`, so a store or a clear shows as soon as Rust
// refreshes it.

import { ChainRigNav } from "../models.slint";
import { TempoPanel } from "tempo_panel_globals.slint";
import { TempoPanelView } from "tempo_panel_view.slint";

export component TempoOverlay inherits Rectangle {
    in property <[ChainRigNav]> navs;

    visible: TempoPanel.open;
    backdrop := TouchArea {
        clicked => { TempoPanel.open = false; }
    }
    if TempoPanel.open : TempoPanelView {
        // The chip reports window coordinates; keep the panel inside the overlay.
        x: Math.max(0px, Math.min(TempoPanel.x - root.absolute-position.x, root.width - self.width));
        y: Math.max(0px, Math.min(TempoPanel.y - root.absolute-position.y, root.height - self.height));
        nav: root.navs[TempoPanel.chain-index];
    }
}
