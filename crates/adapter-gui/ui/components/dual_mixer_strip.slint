// Responsibility: renders one endpoint's global fader beside a chain's own fader.
// The compact view's IN / OUT strip: one frame, a console dual-fader width,
// one shared label at the bottom. The LEFT fader is the endpoint's GLOBAL
// strip (tinted, captioned, the same one the Mixer window moves); the RIGHT
// fader is this chain's own gain on that endpoint. Each fader keeps its own
// readout, mute and reset; there is no SOLO here.
// #398: a raised card; the GLOBAL half sits on a wash of the input colour.

import { MixerStripRow, MixerBridge } from "mixer_globals.slint";
import { ChainMixerBridge } from "chain_mixer_globals.slint";
import { MixerStripView } from "mixer_strip.slint";
import { StripLabel } from "strip_label.slint";
import { Theme } from "../theme.slint";

export component DualMixerStripView inherits Rectangle {
    in property <MixerStripRow> global;
    in property <MixerStripRow> chain;

    private property <length> half: 96px;
    private property <length> gap: 6px;
    private property <length> pad: 8px;
    private property <length> caption-height: 24px;
    private property <length> label-height: 54px;
    private property <length> faders-height: root.height - root.label-height - 3 * root.pad;

    width: 2 * root.half + root.gap + 2 * root.pad;
    border-radius: 5px;
    background: Theme.panel-hi;
    border-width: 1px;
    border-color: Theme.hair;

    // ── GLOBAL half: washed in the input colour, so it never reads as the
    // chain's own fader ──
    Rectangle {
        x: root.pad; y: root.pad;
        width: root.half; height: root.faders-height;
        border-radius: 4px;
        background: Theme.in.with-alpha(0.1);
        border-width: 1px;
        border-color: Theme.in.with-alpha(0.3);
    }

    Text {
        x: root.pad; y: root.pad + 6px;
        width: root.half; height: root.caption-height - 6px;
        text: @tr("label-mixer-global");
        color: Theme.in;
        font-size: Theme.min-font;
        font-weight: 700;
        letter-spacing: 0.12 * Theme.min-font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: root.pad + root.half + root.gap; y: root.pad + 6px;
        width: root.half; height: root.caption-height - 6px;
        text: @tr("label-mixer-chain");
        color: Theme.ink-3;
        font-size: Theme.min-font;
        font-weight: 700;
        letter-spacing: 0.12 * Theme.min-font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    MixerStripView {
        x: root.pad; y: root.pad + root.caption-height;
        width: root.half; height: root.faders-height - root.caption-height;
        strip: root.global;
        tint: Theme.in;
        has-solo: false;
        has-label: false;
        framed: false;
        face: transparent;
        fader-moved(id, position) => { MixerBridge.fader-moved(id, position); }
        fader-reset(id) => { MixerBridge.fader-reset(id); }
        mute-toggled(id) => { MixerBridge.mute-toggled(id); }
    }

    // ── CHAIN half: this chain's own gain on the same endpoint ──
    MixerStripView {
        x: root.pad + root.half + root.gap; y: root.pad + root.caption-height;
        width: root.half; height: root.faders-height - root.caption-height;
        strip: root.chain;
        has-solo: false;
        has-label: false;
        framed: false;
        face: transparent;
        // The chain fader is addressed by the global strip it sits on.
        fader-moved(_, position) => { ChainMixerBridge.chain-fader-moved(root.global.id, position); }
        fader-reset(_) => { ChainMixerBridge.chain-fader-reset(root.global.id); }
        mute-toggled(_) => { ChainMixerBridge.chain-mute-toggled(root.global.id); }
    }

    StripLabel {
        x: root.pad; y: root.height - root.label-height - root.pad;
        width: root.width - 2 * root.pad; height: root.label-height;
        name: root.global.name;
        detail: root.global.detail;
        is-input: root.global.is-input;
    }
}
