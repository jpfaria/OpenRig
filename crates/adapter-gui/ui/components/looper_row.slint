// Responsibility: renders one looper of the panel.
// #323 — one looper in the panel: the transport line, plus a drawer with the
// finer parameters. State is signalled by colour AND label, never colour
// alone, and every target is 40 px so the row stays usable on the Orange Pi
// touch screen.
//
// The transport is an absolute cluster of fixed 40 px buttons (the pattern of
// every other icon cluster in this app); the drawer below uses layouts.

import { Theme } from "../theme.slint";
import { LooperItem } from "../models.slint";
import { LooperIconButton, LooperSlider, LooperSegmented } from "looper_controls.slint";
import { LooperSelectField } from "looper_select_field.slint";

export component LooperRow inherits Rectangle {
    in property <LooperItem> looper;
    in property <bool> expanded;
    // #323: the chain's input / output endpoint labels — options for the
    // record-from and play-to selects in this row's drawer.
    in property <[string]> input-options;
    in property <[string]> output-options;
    // #323 phase 2: the preset options this loop can play through (index 0 =
    // "follow the chain"); the picker button shows the current one.
    in property <[string]> preset-options;

    callback record();
    callback play-stop();
    callback undo();
    callback redo();
    callback clear();
    callback remove();
    callback toggle-drawer();
    callback mix-changed(int);
    callback decay-changed(int);
    callback speed-picked(int);
    callback reverse-toggled(bool);
    // Open the record-from / play-to option list (a root-level modal).
    callback input-open();
    callback output-open();
    callback preset-open();
    // #826: open the waveform editor for this loop.
    callback edit();
    // #827: open the save-take dialog for this loop.
    callback save-take();

    // 0 empty · 1 recording · 2 playing · 3 overdubbing · 4 stopped
    private property <bool> recording: root.looper.state_code == 1 || root.looper.state_code == 3;
    private property <bool> playing: root.looper.state_code == 2 || root.looper.state_code == 3;
    private property <bool> has-material: root.looper.state_code != 0;
    private property <color> state-color:
        root.looper.state_code == 1 ? Theme.bad       // recording
        : root.looper.state_code == 3 ? Theme.warn     // overdubbing
        : root.looper.state_code == 2 ? Theme.accent     // playing
        : root.looper.state_code == 4 ? Theme.ink-2     // stopped
        : Theme.ink-3;                                  // empty

    height: root.expanded ? 282px : 60px;
    border-radius: 10px;
    background: Theme.palette.card-secondary;
    border-width: 1px;
    border-color: root.recording ? root.state-color : Theme.palette.border;
    clip: true;

    // ── transport ───────────────────────────────────────────────────────
    rec-btn := LooperIconButton {
        x: 8px;
        y: 10px;
        icon: @image-url("../assets/record.svg");
        label: @tr("looper-record");
        tint: root.recording ? Theme.hero-fg : Theme.bad;
        active-background: root.recording ? Theme.bad : transparent;
        // REC only arms while the chain is running — recording captures the
        // live input through the chain's runtime, which exists only then.
        is-enabled: root.looper.can_record;
        clicked => { root.record(); }
    }

    play-btn := LooperIconButton {
        x: 52px;
        y: 10px;
        icon: root.playing
            ? @image-url("../assets/stop.svg")
            : @image-url("../assets/play.svg");
        label: root.playing ? @tr("looper-stop") : @tr("looper-play");
        tint: root.playing ? Theme.accent : Theme.ink;
        is-enabled: root.has-material;
        clicked => { root.play-stop(); }
    }

    // #323: single-take looper — no overdub layers, so there is no undo/redo.
    // Stacking parts is done with SEPARATE loopers.
    clear-btn := LooperIconButton {
        x: 96px;
        y: 10px;
        icon: @image-url("../assets/trash.svg");
        label: @tr("looper-clear");
        is-enabled: root.has-material;
        clicked => { root.clear(); }
    }

    // #826: reshape the take. Stopped-only — the store refuses an edit on a
    // live loop, so an enabled button there would be a lie.
    edit-btn := LooperIconButton {
        x: 140px;
        y: 10px;
        icon: @image-url("../assets/pencil.svg");
        label: @tr("looper-edit");
        is-enabled: root.looper.can_edit;
        clicked => { root.edit(); }
    }

    // #827: keep this loop as a named take any chain's DI can play. Needs
    // material, and a closed take — a loop still recording has no end yet.
    save-btn := LooperIconButton {
        x: 184px;
        y: 10px;
        icon: @image-url("../assets/save.svg");
        label: @tr("looper-take-save-title");
        is-enabled: root.has-material && !root.recording;
        clicked => { root.save-take(); }
    }

    // ── state + progress ────────────────────────────────────────────────
    Rectangle {
        x: 232px;
        y: 10px;
        width: parent.width - 232px - 96px;
        height: 40px;
        clip: true;
        background: transparent;

        Rectangle {
            x: 0;
            y: 6px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.state-color;
        }

        Text {
            x: 14px;
            y: 0;
            width: parent.width - 14px - time-text.width - 4px;
            height: 22px;
            vertical-alignment: center;
            // The label is picked here so every state string lives in the
            // Slint catalog — the Rust side ships a code, not a sentence.
            text: root.looper.state_code == 1 ? @tr("looper-state-recording")
                : root.looper.state_code == 2 ? @tr("looper-state-playing")
                : root.looper.state_code == 3 ? @tr("looper-state-overdubbing")
                : root.looper.state_code == 4 ? @tr("looper-state-stopped")
                : @tr("looper-state-empty");
            color: root.state-color;
            font-size: Theme.min-font;
            font-weight: 600;
            overflow: elide;
        }

        // Width follows the time text so "0:00 / 0:00" is never cut.
        time-text := Text {
            x: parent.width - self.width;
            y: 0;
            width: max(100px, self.preferred-width);
            height: 22px;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: root.looper.time_label;
            color: Theme.palette.text-muted;
            font-size: Theme.min-font;
        }

        Rectangle {
            x: 0;
            y: 26px;
            width: parent.width;
            height: 4px;
            border-radius: 2px;
            background: Theme.ktrack;

            Rectangle {
                x: 0;
                width: parent.width * root.looper.progress;
                height: parent.height;
                border-radius: 2px;
                background: root.state-color;
            }
        }
    }

    gear-btn := LooperIconButton {
        x: parent.width - 92px;
        y: 10px;
        icon: @image-url("../assets/gear.svg");
        label: @tr("looper-parameters");
        tint: root.expanded ? Theme.accent : Theme.ink;
        clicked => { root.toggle-drawer(); }
    }

    remove-btn := LooperIconButton {
        x: parent.width - 48px;
        y: 10px;
        icon: @image-url("../assets/close.svg");
        label: @tr("looper-remove");
        tint: Theme.bad;
        clicked => { root.remove(); }
    }

    // ── parameter drawer ────────────────────────────────────────────────
    if root.expanded : VerticalLayout {
        x: 12px;
        y: 58px;
        width: parent.width - 24px;
        height: 216px;
        spacing: 8px;

        Rectangle {
            height: 1px;
            background: Theme.palette.border;
        }

        // A select, never a row of buttons: a chain can have many endpoints
        // with long names.
        in-seg := LooperSelectField {
            label-width: preset-label.width;
            label: @tr("looper-input");
            value: root.input-options[root.looper.input_index];
            open => { root.input-open(); }
        }

        out-seg := LooperSelectField {
            label-width: preset-label.width;
            label: @tr("looper-output");
            value: root.output-options[root.looper.output_index];
            open => { root.output-open(); }
        }

        // #323 phase 2: which preset renders this loop. A modal picker (not a
        // segmented row) because a bank can hold many presets with long names.
        preset-btn := Rectangle {
            height: 28px;

            // The drawer's label column: fits the widest (translated) label
            // of every drawer row, which all share it so their controls align.
            preset-label := Text {
                x: 0;
                width: max(74px, self.preferred-width, in-seg.label-natural,
                    out-seg.label-natural, level-slider.label-natural,
                    decay-slider.label-natural, speed-seg.label-natural);
                height: parent.height;
                vertical-alignment: center;
                text: @tr("looper-preset");
                color: Theme.palette.text-muted;
                font-size: Theme.min-font;
            }

            Rectangle {
                x: preset-label.width + 6px;
                width: parent.width - preset-label.width - 6px;
                height: parent.height;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.looper.preset_index > 0 ? Theme.accent : Theme.palette.border;
                background: preset-ta.has-hover
                    ? Theme.accent-soft
                    : (root.looper.preset_index > 0 ? Theme.accent.with-alpha(0.08) : transparent);

                Text {
                    x: 10px;
                    width: parent.width - 34px;
                    height: parent.height;
                    vertical-alignment: center;
                    // Option 0 is "follow the chain" (translated here); 1..N map
                    // to preset-options[index - 1], the chain's bank names.
                    text: root.looper.preset_index == 0
                        ? @tr("looper-preset-follow")
                        : root.preset-options[root.looper.preset_index - 1];
                    color: root.looper.preset_index > 0
                        ? Theme.palette.text-primary
                        : Theme.palette.text-muted;
                    font-size: Theme.min-font;
                    overflow: elide;
                }

                Text {
                    x: parent.width - 22px;
                    width: 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    text: "▸";
                    color: Theme.palette.text-muted;
                    font-size: Theme.min-font;
                }

                preset-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.preset-open(); }
                }

                accessible-role: button;
                accessible-label: @tr("looper-preset");
                accessible-action-default => { root.preset-open(); }
            }
        }

        level-slider := LooperSlider {
            label-width: preset-label.width;
            label: @tr("looper-level");
            value: root.looper.mix;
            value-changed(v) => { root.mix-changed(v); }
        }

        decay-slider := LooperSlider {
            label-width: preset-label.width;
            label: @tr("looper-decay");
            value: root.looper.decay;
            value-changed(v) => { root.decay-changed(v); }
        }

        HorizontalLayout {
            height: 28px;
            spacing: 12px;

            speed-seg := LooperSegmented {
                label-width: preset-label.width;
                label: @tr("looper-speed");
                options: ["½×", "1×", "2×"];
                selected-index: root.looper.speed_index;
                picked(i) => { root.speed-picked(i); }
            }

            Rectangle {
                // Follows the (translated) label.
                width: max(132px, reverse-label.preferred-width + 20px);
                border-radius: 6px;
                border-width: 1px;
                border-color: root.looper.reverse ? Theme.accent : Theme.palette.border;
                background: root.looper.reverse ? Theme.accent-soft : transparent;

                reverse-label := Text {
                    text: @tr("looper-reverse");
                    color: root.looper.reverse
                        ? Theme.palette.text-primary
                        : Theme.palette.text-muted;
                    font-size: Theme.min-font;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.reverse-toggled(!root.looper.reverse); }
                }

                accessible-role: checkbox;
                accessible-label: @tr("looper-reverse");
                accessible-checked: root.looper.reverse;
            }
        }
    }
}
