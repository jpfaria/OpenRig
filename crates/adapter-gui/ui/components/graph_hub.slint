// Responsibility: draws a split or mixer hub with one port per path.
// #398: a dark slate tile with the trunk in light ink and one curve per path
// in its lane colour, fanning out (split) or folding in (mixer), lettered A,
// B, C… The hub grows a port every `GraphPorts.pitch` for as many paths as
// the split has; the wires end on these ports (graph_ports.slint). Drawn in
// unscaled units (54 wide) and scaled by `zoom`.

import { Theme, Gear } from "../theme.slint";
import { GraphLanes } from "graph_lanes.slint";
import { GraphPorts } from "graph_ports.slint";

export component GraphHub inherits Rectangle {
    // A mixer folds the paths in; a split fans them out.
    in property <bool> mix;
    // One letter per path ("A", "B", …).
    in property <[string]> lanes;
    in property <float> zoom: 1.0;
    in property <bool> bypassed;

    property <int> count: Math.max(2, root.lanes.length);
    property <length> u: 1px * root.zoom;
    // Unscaled height and centre line, in drawing units.
    property <float> h: GraphPorts.hub-height(root.count) / 1px;
    property <float> cy: root.h / 2;
    // Where the paths gather: left of centre on a split, right on a mixer.
    property <float> join: root.mix ? 35 : 19;

    width: GraphPorts.hub-width * root.zoom;
    height: GraphPorts.hub-height(root.count) * root.zoom;
    background: transparent;
    opacity: root.bypassed ? 0.45 : 1.0;

    Rectangle {
        border-radius: 7 * root.u;
        background: @linear-gradient(180deg, Gear.hub-hi 0%, Gear.hub-lo 100%);
        border-width: 1px;
        border-color: Gear.hub-edge;
    }

    // The trunk: the one wire on the hub's other side.
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 54;
        viewbox-height: root.h;
        stroke: Gear.hub-line;
        stroke-width: 3 * root.u;
        stroke-line-cap: round;
        MoveTo { x: root.mix ? 50 : 4; y: root.cy; }
        LineTo { x: root.join; y: root.cy; }
    }

    // One curve per path, from the junction to that path's port.
    for lane[i] in root.lanes : curve := Path {
        property <float> py: 14 + 26 * i;
        width: root.width;
        height: root.height;
        viewbox-width: 54;
        viewbox-height: root.h;
        stroke: GraphLanes.color(i);
        stroke-width: 3 * root.u;
        stroke-line-cap: round;
        MoveTo { x: root.mix ? 4 : 50; y: curve.py; }
        CubicTo {
            control-1-x: root.mix ? 24 : 30;
            control-1-y: curve.py;
            control-2-x: root.mix ? 23 : 31;
            control-2-y: root.cy;
            x: root.join;
            y: root.cy;
        }
    }

    Rectangle {
        x: (root.join - 3.4) * root.u;
        y: (root.cy - 3.4) * root.u;
        width: 6.8 * root.u;
        height: self.width;
        border-radius: self.width / 2;
        background: Gear.hub-line;
    }

    // The path letters, printed on the hub like the text on a piece of gear:
    // over each path's curve, the last one under it.
    for lane[i] in root.lanes : lane-letter := Text {
        property <float> py: 14 + 26 * i;
        x: ((root.mix ? 17 : 43) - 6) * root.u;
        y: ((i == root.lanes.length - 1 ? self.py + 9 : self.py - 8) - 6) * root.u;
        width: 12 * root.u;
        height: 12 * root.u;
        visible: root.zoom >= 0.9;
        text: lane;
        color: GraphLanes.ink(i);
        font-size: Theme.knob-option-font;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // The ports: one per path on the fanned side, one on the trunk.
    for lane[i] in root.lanes : lane-port := Rectangle {
        x: ((root.mix ? 0 : 54) - 4.6) * root.u;
        y: (14 + 26 * i - 4.6) * root.u;
        width: 9.2 * root.u;
        height: self.width;
        border-radius: self.width / 2;
        background: Gear.port-fill;
        border-width: 1.8 * root.u;
        border-color: Gear.port-ring;
    }
    trunk-port := Rectangle {
        x: ((root.mix ? 54 : 0) - 4.6) * root.u;
        y: (root.cy - 4.6) * root.u;
        width: 9.2 * root.u;
        height: self.width;
        border-radius: self.width / 2;
        background: Gear.port-fill;
        border-width: 1.8 * root.u;
        border-color: Gear.port-ring;
    }
}
