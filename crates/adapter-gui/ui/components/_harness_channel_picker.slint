// #880 render harness — the shared ChannelPicker at the size that broke the
// old horizontal row: a 30-in / 30-out interface. Not compiled into the app;
// rendered headlessly with tools/slint-render to check the layout.
import { ChannelPicker } from "channel_picker.slint";
import "../fonts/BebasNeue.ttf";

export component Harness inherits Window {
    default-font-size: 14px;
    preferred-width: 720px;
    preferred-height: 340px;
    background: #09090b;

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        HorizontalLayout {
            spacing: 16px;
            Text {
                text: "Canais";
                color: #a1a1aa;
                font-size: 14px;
                width: 92px;
                vertical-alignment: center;
            }
            ChannelPicker {
                single-select: true;
                channels: [
                    { index: 0, label: "1", selected: false, available: true },
                    { index: 1, label: "2", selected: false, available: true },
                    { index: 2, label: "3", selected: true, available: true },
                    { index: 3, label: "4", selected: false, available: true },
                    { index: 4, label: "5", selected: false, available: true },
                    { index: 5, label: "6", selected: false, available: true },
                    { index: 6, label: "7", selected: false, available: true },
                    { index: 7, label: "8", selected: false, available: true },
                    { index: 8, label: "9", selected: false, available: true },
                    { index: 9, label: "10", selected: false, available: true },
                    { index: 10, label: "11", selected: false, available: true },
                    { index: 11, label: "12", selected: false, available: true },
                    { index: 12, label: "13", selected: false, available: true },
                    { index: 13, label: "14", selected: false, available: true },
                    { index: 14, label: "15", selected: false, available: true },
                    { index: 15, label: "16", selected: false, available: true },
                    { index: 16, label: "17", selected: false, available: true },
                    { index: 17, label: "18", selected: false, available: true },
                    { index: 18, label: "19", selected: false, available: true },
                    { index: 19, label: "20", selected: false, available: true },
                    { index: 20, label: "21", selected: false, available: true },
                    { index: 21, label: "22", selected: false, available: true },
                    { index: 22, label: "23", selected: false, available: true },
                    { index: 23, label: "24", selected: false, available: true },
                    { index: 24, label: "25", selected: false, available: true },
                    { index: 25, label: "26", selected: false, available: true },
                    { index: 26, label: "27", selected: false, available: true },
                    { index: 27, label: "28", selected: false, available: true },
                    { index: 28, label: "29", selected: false, available: true },
                    { index: 29, label: "30", selected: false, available: true },
                ];
            }
        }
    }
}
