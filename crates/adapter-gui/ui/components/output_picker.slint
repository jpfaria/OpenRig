// Responsibility: renders the output endpoint field with its picker rows.
import { Theme } from "../theme.slint";
import { ElidedText } from "elided_text.slint";
// Shared by every independent pipeline window (metronome, backing tracks): a
// closed field showing the chosen endpoint, and the clickable rows of the
// picker overlay. Plain Rectangle + TouchArea, never a PopupWindow, whose rows
// do not receive clicks in this app.

// Closed field showing the current output endpoint; click opens the picker.
// #398: a flat field with a thin line, the endpoint icon and a small chevron.
export component OutputField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    callback open();

    height: 32px;
    border-radius: 3px;
    background: Theme.field;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.ink-3 : Theme.field-line;

    Image {
        x: 10px; y: (parent.height - 16px) / 2;
        width: 16px; height: 16px;
        source: @image-url("../assets/headphones.svg");
        colorize: Theme.ink-3;
    }
    ElidedText {
        x: 34px;
        width: parent.width - 60px;
        height: parent.height;
        text: root.label != "" ? root.label : root.placeholder;
        color: root.label != "" ? Theme.ink : Theme.ink-3;
        font-size: Theme.min-font;
        font-weight: 500;
        vertical-alignment: center;
        own-hover: false;
        hovered: ta.has-hover;
    }
    Image {
        x: parent.width - 19px; y: (parent.height - 9px) / 2;
        width: 9px; height: 9px;
        source: @image-url("../assets/chevron-down.svg");
        colorize: Theme.ink-3;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    accessible-role: combobox;
    accessible-label: root.label != "" ? root.label : root.placeholder;
    accessible-action-default => { root.open(); }
}

// One clickable endpoint row in the picker.
export component OutputRow inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback pick();

    height: 40px;
    border-radius: 5px;
    background: root.active ? Theme.accent-soft : (ta.has-hover ? Theme.panel-hi : transparent);

    ElidedText {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: Theme.ink;
        font-size: 18px;
        font-weight: root.active ? 700 : 500;
        vertical-alignment: center;
        own-hover: false;
        hovered: ta.has-hover;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pick(); }
    }
    accessible-role: button;
    accessible-label: root.label;
}
