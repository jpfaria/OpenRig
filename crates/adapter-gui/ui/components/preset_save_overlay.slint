// Responsibility: renders the save-preset overlay.
// In-window save-preset overlay (issue #510). Replaces the native
// FileDialog: the user only types a name; the directory is the
// configured `presets_path` (the adapter resolves the full path).
// A second overlay (rendered by AppWindow) asks for overwrite
// confirmation when the chosen name collides with an existing file.
//
// #398: the dialog card — the dark bar, the name field, Cancel and the primary
// save; the overwrite step keeps the name and adds a warning box above
// Cancel / Overwrite.

import { Theme } from "../theme.slint";
import { DialogCard } from "dialog_card.slint";
import { DialogFoot } from "dialog_foot.slint";
import { ToolBar } from "tool_bar.slint";
import { TextField } from "text_field.slint";
import { FormButton, FormButtonKind } from "form_button.slint";

export component PresetSaveOverlay inherits Rectangle {
    in property <bool> visible-overlay;
    in property <string> default-name;
    in-out property <string> name-input;
    callback request-save(string);
    callback cancel();

    visible: root.visible-overlay;

    if root.visible-overlay: DialogCard {
        width: root.width;
        height: root.height;
        card-width: 460px;
        // Issue #510 bug fix: focus the name field when the overlay
        // appears so the user can type immediately. Without this the
        // field waits for an extra click before accepting keys.
        init => { name-edit.focus-field(); }

        ToolBar { title: @tr("title-dialog-save-preset"); }

        VerticalLayout {
            padding: 18px;
            name-edit := TextField {
                text <=> root.name-input;
                placeholder: root.default-name;
                accepted(t) => {
                    root.request-save(t == "" ? root.default-name : t);
                }
            }
        }

        DialogFoot {
            cancel-area := FormButton {
                icon-only: true;
                icon: @image-url("../assets/close.svg");
                label: @tr("btn-cancel");
                clicked => { root.cancel(); }
            }
            confirm-area := FormButton {
                icon-only: true;
                icon: @image-url("../assets/save.svg");
                kind: FormButtonKind.primary;
                label: @tr("btn-save");
                clicked => {
                    root.request-save(root.name-input == "" ? root.default-name : root.name-input);
                }
            }
        }
    }
}

export component PresetOverwriteOverlay inherits Rectangle {
    in property <bool> visible-overlay;
    in property <string> preset-name;
    callback cancel();
    callback confirm();

    visible: root.visible-overlay;

    if root.visible-overlay: DialogCard {
        width: root.width;
        height: root.height;
        card-width: 460px;

        ToolBar { title: @tr("title-dialog-save-preset"); }

        VerticalLayout {
            padding: 18px;
            spacing: 14px;

            TextField {
                text: root.preset-name;
                read-only: true;
            }

            // The warning: a warm box with an amber edge.
            Rectangle {
                background: Theme.warn-soft;
                border-radius: 4px;
                height: warn-col.preferred-height;

                Rectangle { x: 0; y: 0; width: 3px; height: parent.height; background: Theme.warn; }

                warn-col := VerticalLayout {
                    padding: 12px;
                    padding-left: 15px;
                    spacing: 4px;
                    Text {
                        text: @tr("title-dialog-overwrite-preset");
                        color: Theme.ink;
                        font-size: Theme.min-font;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("msg-overwrite-preset", root.preset-name);
                        color: Theme.ink-2;
                        font-size: Theme.min-font;
                        wrap: word-wrap;
                    }
                }
            }
        }

        DialogFoot {
            cancel-area := FormButton {
                icon-only: true;
                icon: @image-url("../assets/close.svg");
                label: @tr("btn-cancel");
                clicked => { root.cancel(); }
            }
            confirm-area := FormButton {
                kind: FormButtonKind.primary;
                label: @tr("btn-overwrite");
                clicked => { root.confirm(); }
            }
        }
    }
}
