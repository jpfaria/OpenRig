// Responsibility: renders the save-preset overlay.
// In-window save-preset overlay (issue #510). Replaces the native
// FileDialog: the user only types a name; the directory is the
// configured `presets_path` (the adapter resolves the full path).
// A second overlay (rendered by AppWindow) asks for overwrite
// confirmation when the chosen name collides with an existing file.

import { Theme } from "../theme.slint";
import { LineEdit } from "std-widgets.slint";

export component PresetSaveOverlay inherits Rectangle {
    in property <bool> visible-overlay;
    in property <string> default-name;
    in-out property <string> name-input;
    callback request-save(string);
    callback cancel();

    visible: root.visible-overlay;
    background: Theme.scrim;

    if root.visible-overlay: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width * 0.7, 420px);
        height: max(200px, save-col.preferred-height);
        background: Theme.panel;
        border-radius: 10px;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.shadow;
        // Issue #510 bug fix: focus the name field when the overlay
        // appears so the user can type immediately. Without this the
        // LineEdit waits for an extra click before accepting keys.
        init => { name-edit.focus(); }

        save-col := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: @tr("title-dialog-save-preset");
                font-size: 18px;
                color: Theme.ink;
                font-weight: 700;
                horizontal-alignment: center;
            }
            name-edit := LineEdit {
                text <=> root.name-input;
                placeholder-text: root.default-name;
                accepted(t) => {
                    root.request-save(t == "" ? root.default-name : t);
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: 6px;
                    background: cancel-area.has-hover ? Theme.panel-hi : Theme.panel;
                    cancel-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel(); }
                    }
                    Text {
                        text: @tr("btn-cancel");
                        font-size: 18px;
                        color: Theme.ink-2;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: 6px;
                    background: confirm-area.has-hover ? Theme.accent : Theme.accent;
                    confirm-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.request-save(root.name-input == "" ? root.default-name : root.name-input);
                        }
                    }
                    Text {
                        text: @tr("btn-save");
                        font-size: 18px;
                        color: Theme.on-accent;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component PresetOverwriteOverlay inherits Rectangle {
    in property <bool> visible-overlay;
    in property <string> preset-name;
    callback cancel();
    callback confirm();

    visible: root.visible-overlay;
    background: Theme.scrim;

    if root.visible-overlay: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width * 0.7, 420px);
        // Grows with the (wrapped) message.
        height: max(170px, overwrite-col.preferred-height);
        background: Theme.panel;
        border-radius: 10px;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.shadow;

        overwrite-col := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: @tr("title-dialog-overwrite-preset");
                font-size: 18px;
                color: Theme.ink;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: @tr("msg-overwrite-preset", root.preset-name);
                font-size: 18px;
                color: Theme.ink-2;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: 6px;
                    background: cancel-area.has-hover ? Theme.panel-hi : Theme.panel;
                    cancel-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel(); }
                    }
                    Text {
                        text: @tr("btn-cancel");
                        font-size: 18px;
                        color: Theme.ink-2;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: 6px;
                    background: confirm-area.has-hover ? Theme.bad : Theme.bad;
                    confirm-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.confirm(); }
                    }
                    Text {
                        text: @tr("btn-overwrite");
                        font-size: 18px;
                        color: Theme.hero-fg;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
