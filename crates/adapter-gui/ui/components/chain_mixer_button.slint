// Responsibility: renders the mixer trigger of a chain header.
// #1007 — beside the meters and the looper: a click opens THIS chain's mixer
// over the chain list through the `ChainMixerPanel` global (the looper
// button's pattern, #323). Lit while that mixer is open. Offered on every
// chain, running or not: the faders are settings, not live levels.

import { ChainMixerPanel } from "chain_mixer_panel_globals.slint";
import { IconTooltip } from "icon_tooltip.slint";

export component ChainMixerButton inherits Rectangle {
    in property <int> chain-index;
    private property <bool> active:
        ChainMixerPanel.open && ChainMixerPanel.chain-index == root.chain-index;

    width: 28px;
    height: 28px;
    border-radius: 5px;
    background: root.active ? #6e8aff28
                : ta.has-hover ? #ffffff10
                : transparent;
    animate background { duration: 150ms; }

    Image {
        x: 5px;
        y: 5px;
        width: 18px;
        height: 18px;
        source: @image-url("../assets/mixer-faders.svg");
        image-fit: contain;
        colorize: root.active ? #6e8aff
                  : ta.has-hover ? #ffffff
                  : #8a94a2;
        animate colorize { duration: 150ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open-mixer(); }
    }

    IconTooltip { text: @tr("tooltip-chain-mixer"); show: ta.has-hover; }

    function open-mixer() {
        ChainMixerPanel.chain-index = root.chain-index;
        ChainMixerPanel.open = true;
        ChainMixerPanel.opened(root.chain-index);
    }

    accessible-role: button;
    accessible-label: @tr("tooltip-chain-mixer");
    accessible-action-default => { root.open-mixer(); }
}
