// Responsibility: renders the mixer trigger of a chain header.
// Beside the meters and the looper: a click opens THIS chain's mixer at the
// bottom of its card through the `ChainMixerPanel` global, and a second click
// closes it. One chain's mixer is open at a time. Lit while that mixer is
// open. Offered on every chain, running or not: the faders are settings, not
// live levels.

import { Theme } from "../theme.slint";
import { ChainMixerPanel } from "chain_mixer_panel_globals.slint";
import { IconTooltip } from "icon_tooltip.slint";

export component ChainMixerButton inherits Rectangle {
    in property <int> chain-index;
    private property <bool> active:
        ChainMixerPanel.open && ChainMixerPanel.chain-index == root.chain-index;

    width: 28px;
    height: 28px;
    border-radius: 5px;
    background: root.active ? Theme.accent-soft
                : ta.has-hover ? Theme.hover
                : transparent;
    animate background { duration: 150ms; }

    Image {
        x: 5px;
        y: 5px;
        width: 18px;
        height: 18px;
        source: @image-url("../assets/mixer-faders.svg");
        image-fit: contain;
        colorize: root.active ? Theme.accent
                  : ta.has-hover ? Theme.ink
                  : Theme.ink-2;
        animate colorize { duration: 150ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle-mixer(); }
    }

    IconTooltip { text: @tr("tooltip-chain-mixer"); show: ta.has-hover; }

    function toggle-mixer() {
        if root.active {
            ChainMixerPanel.open = false;
            return;
        }
        ChainMixerPanel.chain-index = root.chain-index;
        ChainMixerPanel.open = true;
        ChainMixerPanel.opened(root.chain-index);
    }

    accessible-role: button;
    accessible-label: @tr("tooltip-chain-mixer");
    accessible-action-default => { root.toggle-mixer(); }
}
