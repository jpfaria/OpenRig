// Responsibility: renders a knob.
// #398: a drawn knob (no sprite) — a quiet track arc, the value arc in the
// block's colour (lit from the centre for a bipolar range), a white cap with
// a dark pointer, and the value in a field below. The knob is `width` square;
// the value box shows when the caller leaves room under it.
import { Theme, Gear } from "../theme.slint";
import { Locale } from "../locale_globals.slint";
import { KnobArc } from "knob_arc.slint";

export component PanelKnob inherits Rectangle {
    in property <float> value;
    in property <float> min-val;
    in property <float> max-val;
    in property <float> step: 1.0;
    in property <string> path;
    // One display text per step from `min-val` (the plugin's own "2.5 s");
    // empty shows the number (#1011).
    in property <[string]> value-labels: [];
    // The value arc's colour: the block's category colour.
    in property <color> tint: Theme.accent;
    callback changed(string, float);

    private property <int> label-index: root.step > 0.0
        ? Math.round((root.current-val - root.min-val) / root.step)
        : -1;

    private property <float> current-val: root.preview-active ? root.preview-val : root.value;
    private property <float> norm: root.max-val > root.min-val
        ? Math.max(0.0, Math.min(1.0, (root.current-val - root.min-val) / (root.max-val - root.min-val)))
        : 0.0;
    // Pointer angle in degrees, 0 at twelve o'clock: -135 (min) .. 135 (max).
    private property <float> angle: -135 + 270 * root.norm;
    private property <bool> bipolar: root.min-val < 0 && root.max-val > 0;
    private property <float> drag-y0: 0;
    private property <float> drag-val0: 0;
    private property <bool> preview-active: false;
    private property <float> preview-val: 0;
    private property <length> ks: root.width;

    background: transparent;

    KnobArc {
        x: 0;
        y: 0;
        width: root.ks;
        height: root.ks;
        angle: root.angle;
        from: root.bipolar ? 0 : -135;
        tint: root.tint;
    }

    // ── Value box below the knob ──
    Rectangle {
        visible: root.height > root.ks + 4px;
        x: (root.width - self.width) / 2;
        y: root.ks + 3px;
        width: max(root.ks * 1.2, value-text.preferred-width + 8px);
        height: max(18px, root.height - root.ks - 4px);
        border-radius: 2px;
        background: Theme.field;
        border-width: 1px;
        border-color: ta.has-hover ? Theme.field-line : Theme.hair;

        value-text := Text {
            width: parent.width;
            height: parent.height;
            font-family: Locale.mono-font-family;
            text: root.label-index >= 0 && root.label-index < root.value-labels.length
                ? root.value-labels[root.label-index]
                : root.step >= 1.0
                ? Math.round(root.current-val) + ""
                : Math.round(root.current-val * 10) / 10 + "";
            color: Theme.ink;
            font-size: Theme.knob-caption-font;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ── Touch/drag ──
    ta := TouchArea {
        mouse-cursor: ta.pressed ? none : ns-resize;

        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.drag-y0 = ta.mouse-y / 1px;
                root.drag-val0 = root.value;
                root.preview-active = true;
                root.preview-val = root.value;
            }
            if ev.kind == PointerEventKind.up {
                if root.preview-active {
                    root.changed(root.path, root.preview-val);
                    root.preview-active = false;
                }
            }
        }

        moved => {
            if ta.pressed {
                let delta = root.drag-y0 - ta.mouse-y / 1px;
                let range = root.max-val - root.min-val;
                let raw = root.drag-val0 + delta * range / 120.0;
                let clamped = raw < root.min-val ? root.min-val : (raw > root.max-val ? root.max-val : raw);
                let stepped = root.step > 0.0 ? Math.round(clamped / root.step) * root.step : clamped;
                root.preview-val = stepped;
            }
        }
    }
}
