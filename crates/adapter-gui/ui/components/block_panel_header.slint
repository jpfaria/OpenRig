// Responsibility: renders the header of the block panel.
import { Theme } from "../theme.slint";
import { BlockModelPickerItem } from "../models.slint";
import { ModelSelectWithSearch } from "model_select_with_search.slint";
import { ElidedText } from "elided_text.slint";

// Top-most strip of BlockPanelEditor: type icon, type label, model selector with
// embedded search (it carries the backend badge), and trailing action buttons
// (info + delete in edit mode, save in insert mode).
export component BlockPanelHeader inherits Rectangle {
    in property <image> selected-icon-source;
    in property <string> block-type-label;
    in property <bool> edit-mode;
    // Issue #608: false for generic NAM/IR file-loader blocks → hide the
    // catalog model select/search picker (they load a file, not a model).
    in property <bool> show-model-picker: true;
    in property <[BlockModelPickerItem]> filtered-models;
    in property <BlockModelPickerItem> selected-model;
    in-out property <string> search-text;
    in property <string> icon-kind;
    in property <string> selected-model-id;
    // #398: the block's category colour (the type icon and its name).
    in property <color> category: Theme.accent;

    callback choose-model-by-id(string);
    callback search-model(string);
    callback show-plugin-info(string, string);
    callback delete-block();
    callback save-block();

    // #398: the model bar is dark chrome. The category sits in its colour on
    // the left, the model field takes the middle (at most 460px), and the
    // icon buttons close the row.
    background: Theme.chrome;

    private property <length> picker-x: Math.max(100px, type-label-text.x + type-label-text.width + 12px);
    private property <length> buttons-w: root.edit-mode ? 76px : 42px;
    private property <length> picker-w: Math.min(460px, root.width - root.picker-x - root.buttons-w - 16px);

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.chrome-line;
    }

    // The category: its icon and its name, in its colour.
    Image {
        x: 14px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        source: root.selected-icon-source;
        image-fit: contain;
        colorize: root.category;
    }

    type-label-text := Text {
        x: 40px;
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        text: root.block-type-label.to-uppercase();
        color: root.category;
        font-size: Theme.min-font;
        font-weight: 700;
        letter-spacing: 0.16 * Theme.min-font;
        vertical-alignment: center;
    }

    // Model selector with embedded search. Hidden for the generic NAM/IR
    // file-loader blocks (#608) — they have no catalog model to pick; the
    // loaded model name is shown as a static label.
    if root.show-model-picker : ModelSelectWithSearch {
        x: root.picker-x;
        y: (parent.height - 32px) / 2;
        width: root.picker-w;
        height: 32px;
        on-chrome: true;
        filtered-models: root.filtered-models;
        selected-model: root.selected-model;
        search-text <=> root.search-text;
        select(model-id) => { root.choose-model-by-id(model-id); }
        search-text-changed(text) => { root.search-model(text); }
    }

    if !root.show-model-picker : ElidedText {
        x: root.picker-x;
        y: 0;
        width: root.picker-w;
        height: parent.height;
        text: root.selected-model.display_name.to-uppercase();
        color: Theme.chrome-fg;
        font-size: Theme.min-font;
        font-weight: 600;
        letter-spacing: 0.06 * Theme.min-font;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    // Info (edit mode).
    if root.edit-mode : Rectangle {
        x: parent.width - 76px;
        y: (parent.height - 30px) / 2;
        width: 30px;
        height: 30px;
        border-radius: 4px;
        background: ta-info.has-hover ? Theme.chrome-2 : transparent;

        Image {
            x: 7px;
            y: 7px;
            width: 16px;
            height: 16px;
            source: @image-url("../assets/info.svg");
            image-fit: contain;
            colorize: ta-info.has-hover ? Theme.chrome-fg : Theme.chrome-fg-2;
        }

        ta-info := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.show-plugin-info(root.icon-kind, root.selected-model-id);
            }
        }
        accessible-role: button;
        accessible-label: @tr("block-editor-info");
    }

    // Remove (edit mode).
    if root.edit-mode : Rectangle {
        x: parent.width - 42px;
        y: (parent.height - 30px) / 2;
        width: 30px;
        height: 30px;
        border-radius: 4px;
        background: ta-del.has-hover ? Theme.chrome-2 : transparent;

        Image {
            x: 7px;
            y: 7px;
            width: 16px;
            height: 16px;
            source: @image-url("../assets/trash.svg");
            image-fit: contain;
            colorize: ta-del.has-hover ? Theme.bad : Theme.chrome-fg-2;
        }

        ta-del := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.delete-block(); }
        }
        accessible-role: button;
        accessible-label: @tr("block-editor-remove");
    }

    // Save (insert mode).
    if !root.edit-mode : Rectangle {
        x: parent.width - 42px;
        y: (parent.height - 30px) / 2;
        width: 30px;
        height: 30px;
        border-radius: 4px;
        background: ta-save.has-hover ? Theme.chrome-2 : transparent;

        Image {
            x: 7px;
            y: 7px;
            width: 16px;
            height: 16px;
            source: @image-url("../assets/save.svg");
            image-fit: contain;
            colorize: ta-save.has-hover ? Theme.accent : Theme.chrome-fg-2;
        }

        ta-save := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.save-block(); }
        }
        accessible-role: button;
        accessible-label: @tr("block-editor-save");
    }
}
