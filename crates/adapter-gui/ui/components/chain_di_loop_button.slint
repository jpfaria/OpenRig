// Responsibility: renders the DI loop trigger of a chain header.
// #614 / #749 — the DI loop trigger in a chain header: just the fone icon.
// Clicking it opens the DI panel (a janela with a select + play) at the window
// root via the `DiPanel` global, seeded with this chain's data and the fone's
// absolute position. The panel itself (DiLoopPanel) lives in app-window's root
// overlay so it is never clipped by the chain list.

import { HeaderIconStyle } from "header_icon_style.slint";
import { DiPanel } from "di_panel_globals.slint";
import { IconTooltip } from "icon_tooltip.slint";

export component ChainDiLoopButton inherits Rectangle {
    in property <bool> playing: false;
    in property <[string]> sources: [];
    in property <int> selected-index: -1;
    in property <int> chain-index;
    // #771: the chain's bound output endpoints + the persisted pick.
    in property <[string]> outputs: [];
    in property <int> output-selected-index: -1;
    // Which `sources` entries are deletable saved takes.
    in property <[bool]> take-rows: [];

    width: HeaderIconStyle.size;
    height: HeaderIconStyle.size;
    border-radius: HeaderIconStyle.radius;
    background: HeaderIconStyle.fill(ta.has-hover);
    animate background { duration: 150ms; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: HeaderIconStyle.icon;
        height: HeaderIconStyle.icon;
        source: @image-url("../assets/headphones.svg");
        image-fit: contain;
        colorize: HeaderIconStyle.tint(root.playing, ta.has-hover);
        animate colorize { duration: 150ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            DiPanel.chain-index = root.chain-index;
            DiPanel.sources = root.sources;
            DiPanel.selected-index = root.selected-index;
            DiPanel.take-rows = root.take-rows;
            DiPanel.playing = root.playing;
            DiPanel.outputs = root.outputs;
            DiPanel.output-selected-index = root.output-selected-index;
            // Open below the fone, the panel's right edge near it.
            DiPanel.x = root.absolute-position.x - 332px;
            DiPanel.y = root.absolute-position.y + 32px;
            DiPanel.open = true;
        }
    }

    IconTooltip { text: @tr("di-loop-button-label"); show: ta.has-hover; }

    accessible-role: button;
    accessible-label: @tr("di-loop-button-label");
}
