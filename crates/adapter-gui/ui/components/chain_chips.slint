// Responsibility: renders the chips that decorate a chain row.
import { Theme } from "../theme.slint";
import { HeaderIconStyle } from "header_icon_style.slint";
import { IconTooltip } from "icon_tooltip.slint";
import { ElidedText } from "elided_text.slint";
// Small, reusable chips that decorate a ChainRow header and inline action
// surfaces — endpoint summary chips, the chain power toggle, header icons.
// Pure visual primitives.

export component ChainActionIcon inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    // #398: sits on the dark chrome bar.
    in property <bool> on-chrome: false;
    callback clicked();

    width: HeaderIconStyle.size;
    height: HeaderIconStyle.size;
    border-radius: HeaderIconStyle.radius;
    background: root.on-chrome ? HeaderIconStyle.chrome-fill(hover-area.has-hover) : HeaderIconStyle.fill(hover-area.has-hover);

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: HeaderIconStyle.icon;
        height: HeaderIconStyle.icon;
        source: root.icon;
        image-fit: contain;
        colorize: root.on-chrome ? HeaderIconStyle.chrome-tint(false, hover-area.has-hover) : HeaderIconStyle.tint(false, hover-area.has-hover);
    }

    hover-area := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // The hover label, inside the window (IconTooltip, #398).
    IconTooltip { text: root.tooltip; show: hover-area.has-hover; }
}


export component ChainEndpointChip inherits Rectangle {
    in property <string> label;
    in property <string> tooltip;
    in property <bool> is-input: true;
    // #716: when false the chip is illustrative only — no click, no pointer
    // cursor, no hover highlight (the chain's I/O comes from its binding, not
    // from editing this chip).
    in property <bool> interactive: true;
    callback clicked();
    out property <bool> is-hovered: hover-area.has-hover;

    width: root.is-input ? 72px : 90px;
    height: 72px;
    background: transparent;

    Image {
        x: (parent.width - 48px) / 2;
        y: 4px;
        width: 48px;
        height: 48px;
        source: root.is-input
            ? @image-url("../assets/connector-input.png")
            : @image-url("../assets/connector-output.png");
        image-fit: contain;
        opacity: hover-area.has-hover ? 1.0 : 0.7;
    }

    // Label
    ElidedText {
        x: 4px;
        y: 50px;
        width: parent.width - 8px;
        height: 22px;
        text: root.label;
        color: hover-area.has-hover ? Theme.ink : Theme.ink-2;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        own-hover: !root.interactive;
        hovered: hover-area.has-hover;
    }

    hover-area := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.interactive;
        mouse-cursor: root.interactive ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}


export component ChainPowerToggle inherits Rectangle {
    in property <bool> enabled: false;
    in property <string> tooltip;
    callback clicked();

    width: 28px;
    height: 28px;
    background: hover-area.has-hover ? Theme.hover : transparent;

    Rectangle {
        x: 4px;
        y: 4px;
        width: 20px;
        height: 20px;
        background: transparent;
        border-width: 2px;
        border-color: root.enabled ? Theme.ok : Theme.ink-3;
        border-radius: 10px;
    }

    Rectangle {
        x: 13px;
        y: 3px;
        width: 2px;
        height: 10px;
        background: root.enabled ? Theme.ok : Theme.ink-3;
        border-radius: 1px;
    }

    hover-area := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // The hover label, inside the window (IconTooltip, #398).
    IconTooltip { text: root.tooltip; show: hover-area.has-hover; }
}


export component HeaderIconAction inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    // #398: on the dark top bar the icon is chrome-fg-2 and hovers on chrome-2.
    in property <bool> on-chrome: false;
    // Unsaved work: the icon turns to the warning colour.
    in property <bool> warn: false;
    in property <color> tint: root.warn ? Theme.warn
        : root.active ? Theme.accent
        : root.on-chrome ? (action-area.has-hover ? Theme.chrome-fg : Theme.chrome-fg-2)
        : HeaderIconStyle.tint(false, action-area.has-hover);
    in property <string> tooltip;
    callback clicked();

    width: HeaderIconStyle.size;
    height: HeaderIconStyle.size;
    border-radius: HeaderIconStyle.radius;
    background: !action-area.has-hover ? transparent
        : root.on-chrome ? Theme.chrome-2 : HeaderIconStyle.fill(true);

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: HeaderIconStyle.icon;
        height: HeaderIconStyle.icon;
        source: root.icon;
        image-fit: contain;
        colorize: root.tint;
    }

    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    action-area := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // The hover label, inside the window (IconTooltip, #398).
    IconTooltip { text: root.tooltip; show: action-area.has-hover; }
}


// Volume control for a chain row (issue #440). Ícone de speaker SVG +
// slider horizontal 0-200 + readout numérico. Bind read-write via
// `volume` (i32 0-200, 100 = unity). Emite `value-changed(new_value)`
// quando o usuário arrasta — caller (ChainRow) dispara o callback Rust
// que persiste no `Chain.volume` e propaga pro `RuntimeGraph`.
export component ChainVolumeControl inherits Rectangle {
    in-out property <int> volume: 100;
    callback value-changed(int);

    width: 168px;
    height: 24px;
    background: transparent;

    Image {
        x: 0px;
        y: 4px;
        width: 16px;
        height: 16px;
        source: @image-url("../assets/volume.svg");
        image-fit: contain;
        colorize: Theme.ink-2;
    }

    track := Rectangle {
        x: 22px;
        y: 10px;
        // Leaves room for a "200%" readout at 18px (#954).
        width: 86px;
        height: 4px;
        background: Theme.ktrack;
        border-radius: 2px;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * Math.min(1.0, root.volume / 200);
            height: parent.height;
            background: root.volume > 100 ? Theme.warn : Theme.accent;
            border-radius: 2px;
        }

        Rectangle {
            x: parent.width * Math.min(1.0, root.volume / 200) - 6px;
            y: -4px;
            width: 12px;
            height: 12px;
            background: drag-area.has-hover || drag-area.pressed ? Theme.ink : Theme.ink-2;
            border-radius: 6px;
        }

        Rectangle {
            x: parent.width * 0.5 - 0.5px;
            y: -2px;
            width: 1px;
            height: parent.height + 4px;
            background: Theme.ink.with-alpha(0.25);
        }

        drag-area := TouchArea {
            x: -6px;
            y: -6px;
            width: parent.width + 12px;
            height: parent.height + 12px;
            mouse-cursor: pointer;

            // Durante o arrasto só atualiza o preview visual (root.volume).
            // O Command só é disparado no `up` — senão cada pixel rebuilda o
            // RuntimeGraph e o slider fica impossível de usar.
            moved => {
                if (self.pressed) {
                    let raw = (self.mouse-x - 6px) / track.width * 200;
                    root.volume = Math.max(0, Math.min(200, Math.round(raw)));
                }
            }

            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    let raw = (self.mouse-x - 6px) / track.width * 200;
                    root.volume = Math.max(0, Math.min(200, Math.round(raw)));
                }
                if (e.kind == PointerEventKind.up) {
                    root.value-changed(root.volume);
                }
            }

            double-clicked => {
                root.volume = 100;
                root.value-changed(100);
            }
        }
    }

    Text {
        x: 114px;
        y: 0px;
        width: 54px;
        height: 24px;
        text: root.volume + "%";
        color: drag-area.has-hover ? Theme.ink : Theme.ink-2;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
}
