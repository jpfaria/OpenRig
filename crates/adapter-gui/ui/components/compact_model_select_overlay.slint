// Responsibility: renders the model select of the compact view.
import { Theme } from "../theme.slint";
import { BlockModelPickerItem } from "../models.slint";
import { TextField } from "text_field.slint";
import { ModelPickRow } from "model_pick_row.slint";

// #398: the same card as the block editor's popup — the focused search field
// over one framed list grouped by block type.
export component CompactModelSelectOverlay inherits Rectangle {
    in property <[BlockModelPickerItem]> filtered-models;
    in property <BlockModelPickerItem> selected-model;
    in-out property <string> search-text;
    in property <length> popup-height: 320px;

    callback select(string);
    callback search-text-changed(string);

    width: 320px;
    height: root.popup-height;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.hair;
    border-radius: 6px;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.shadow;
    drop-shadow-offset-y: 8px;
    clip: true;

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        TextField {
            text <=> root.search-text;
            placeholder: @tr("placeholder-search-models");
            edited(t) => { root.search-text-changed(t); }
            init => { self.focus-field(); }
        }

        if root.filtered-models.length == 0 : Text {
            height: 60px;
            text: @tr("status-no-models-found");
            wrap: word-wrap;
            color: Theme.ink-3;
            font-size: Theme.min-font;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        if root.filtered-models.length > 0 : Rectangle {
            vertical-stretch: 1;
            border-radius: 4px;
            clip: true;
            background: Theme.field;
            border-width: 1px;
            border-color: Theme.hair;

            Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                viewport-width: self.width;
                viewport-height: rows.preferred-height;

                rows := VerticalLayout {
                    alignment: start;

                    for model[i] in root.filtered-models : Rectangle {
                        height: pick.height;

                        pick := ModelPickRow {
                            width: parent.width;
                            model: model;
                            on: model.model_id == root.selected-model.model_id;
                            divided: i > 0;
                            header: i == 0 || model.effect_type != root.filtered-models[i - 1].effect_type
                                ? model.effect_type.to-uppercase() : "";
                        }

                        row-ta := TouchArea {
                            y: pick.header-height;
                            height: parent.height - pick.header-height;
                            mouse-cursor: pointer;
                            clicked => {
                                root.select(model.model_id);
                            }
                            scroll-event(_) => {
                                reject
                            }
                        }
                    }
                }
            }
        }
    }
}
