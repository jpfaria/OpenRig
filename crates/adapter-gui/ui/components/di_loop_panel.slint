// Responsibility: renders the DI loop panel.
// #749 — the DI loop "janela": a panel (opened by the fone) containing a SELECT
// + a play/stop button. Clicking the select expands its options INLINE; picking
// one collapses them and leaves it selected; play/stop sits beside it.
//
// INLINE (inherits Rectangle), NOT a PopupWindow — on purpose:
//   * a panel can grow/shrink when the select expands (a PopupWindow can't
//     resize after show), and
//   * every click is a normal in-tree TouchArea, so the headless interaction
//     test can actuate it (PopupWindow content is a separate surface the test
//     backend can't click).
// The host renders this at the window root (so it is not clipped by the chain
// list) — see the DiPanel global + the root overlay.
//
// #398: a tool window — the dark bar, then captioned fields on the panel. The
// source list opens as a framed list under its field; play is the round
// transport button, lit in the input colour while the DI plays.

import { Theme, Gear } from "../theme.slint";
import { ToolBar } from "tool_bar.slint";
import { FieldCaption } from "field_caption.slint";

// The closed field of a select: its value and a chevron, ringed while open.
component SelectBox inherits Rectangle {
    in property <string> value;
    in property <bool> open;
    in property <bool> hovered;

    height: 36px;
    border-radius: 3px;
    background: Theme.field;
    border-width: 1px;
    border-color: root.open ? Theme.accent : root.hovered ? Theme.ink-3 : Theme.field-line;

    Text {
        x: 10px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.value;
        color: Theme.ink;
        font-size: Theme.min-font;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }

    Image {
        x: parent.width - 22px;
        y: (parent.height - 11px) / 2;
        width: 11px;
        height: 11px;
        source: @image-url("../assets/chevron-down.svg");
        colorize: root.open ? Theme.accent : Theme.ink-3;
        transform-rotation: root.open ? 180deg : 0deg;
    }
}

export component DiLoopPanel inherits Rectangle {
    in property <[string]> sources;
    in property <int> selected-index;
    in property <bool> playing;
    // #771: the chain's already-bound output endpoints + the persisted pick.
    in property <[string]> outputs;
    in property <int> output-selected-index;
    // Per entry of `sources`, true when it is a deletable saved take.
    in property <[bool]> take-rows;

    // Inside a compact-view section the section is the panel: no box of its
    // own, no title (the section header names it), no inset gutter.
    in property <bool> embedded: false;
    // The most the panel may take: its host caps it to the window, and the
    // body scrolls under the bar past that (#398).
    in property <length> height-cap: 100000px;

    callback source-picked(int, string);
    callback choose-file();
    callback play();
    callback stop();
    // #771: an output endpoint was picked (index into `outputs`, label).
    callback output-picked(int, string);
    // A take row's trash, confirmed (index into `sources`, label).
    callback delete-take(int, string);

    private property <bool> expanded;
    // The take row whose trash was clicked once and now asks to
    // confirm; -1 ⇒ none. Two clicks delete, so a stray one never loses a take.
    private property <int> armed-delete: -1;
    // The armed trash grows to fit "Delete?" in the active language.
    private property <length> armed-w: min(confirm-probe.preferred-width + 20px, 150px);
    // #771: the output select's own expansion — opening one collapses the other.
    private property <bool> out-expanded;
    private property <bool> has-selection:
        root.selected-index >= 0 && root.selected-index < root.sources.length;
    private property <string> selected-source:
        root.has-selection ? root.sources[root.selected-index] : "";
    private property <bool> has-outputs: root.outputs.length > 0;
    private property <string> selected-output:
        (root.output-selected-index >= 0 && root.output-selected-index < root.outputs.length)
            ? root.outputs[root.output-selected-index] : "";
    private property <length> row-h: 40px;
    private property <length> bar-h: root.embedded ? 0px : 46px;
    // An open list shows at most six rows and scrolls the rest.
    private property <length> list-max: 6 * root.row-h + 2px;

    width: 360px;
    height: min(root.bar-h + body.preferred-height, root.height-cap);
    border-radius: root.embedded ? 0px : 6px;
    background: root.embedded ? transparent : Theme.panel;
    border-width: root.embedded ? 0px : 1px;
    border-color: Theme.hair;
    clip: true;
    drop-shadow-blur: root.embedded ? 0px : 24px;
    drop-shadow-offset-y: root.embedded ? 0px : 8px;
    drop-shadow-color: Theme.shadow;

    // Clicks on the panel stay on the panel (the overlay behind closes it).
    TouchArea { }

    // Measures the confirm label; never shown.
    confirm-probe := Text {
        visible: false;
        text: @tr("di-take-delete-confirm");
        font-size: Theme.min-font;
        font-weight: 700;
    }

    if !root.embedded : ToolBar {
        x: 0; y: 0;
        width: parent.width;
        icon: @image-url("../assets/headphones.svg");
        title: @tr("di-loop-button-label");
    }

    scroll := Flickable {
        x: 0;
        y: root.bar-h;
        width: parent.width;
        height: parent.height - self.y;
        content-width: self.width;
        content-height: body.preferred-height;
        // Wheel always; drag only when there is something to scroll, so a
        // short panel's sliders are never taken for a flick.
        interactive: self.content-height > self.height;

        body := VerticalLayout {
            width: parent.width;
            height: self.preferred-height;
            padding-left: root.embedded ? 0px : 16px;
            padding-right: root.embedded ? 0px : 16px;
            padding-top: root.embedded ? 0px : 14px;
            padding-bottom: root.embedded ? 0px : 16px;
            spacing: 12px;

            // ── the source field + play / stop ───────────────────────────────
            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;

                    FieldCaption { text: @tr("di-source-label"); }

                    select-field := SelectBox {
                        value: root.selected-source;
                        open: root.expanded;
                        hovered: sel-ta.has-hover;

                        sel-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.expanded = !root.expanded;
                                root.out-expanded = false;
                                root.armed-delete = -1;
                            }
                        }
                        accessible-role: combobox;
                        accessible-label: @tr("di-source-label");
                        accessible-value: root.selected-source;
                    }
                }

                // Once a source is picked: the round transport button.
                if root.has-selection : VerticalLayout {
                    alignment: end;

                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: root.playing ? Theme.in
                            : play-ta.has-hover ? Theme.panel-hi
                            : Theme.field;
                        border-width: root.playing ? 0px : 1px;
                        border-color: Theme.field-line;

                        Image {
                            x: 11px; y: 11px;
                            width: 18px; height: 18px;
                            source: root.playing
                                ? @image-url("../assets/stop.svg")
                                : @image-url("../assets/play.svg");
                            colorize: root.playing ? Gear.white : Theme.ink-2;
                        }

                        play-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if root.playing {
                                    root.stop();
                                } else {
                                    root.play();
                                }
                            }
                        }
                        accessible-role: button;
                        accessible-label: root.playing ? @tr("looper-stop") : @tr("looper-play");
                    }
                }
            }

            // ── the source options (inline, only when expanded) ──────────────
            if root.expanded : Rectangle {
                height: min(root.sources.length * root.row-h + 2px, root.list-max);
                border-radius: 4px;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.hair;
                clip: true;

                Flickable {
                    x: 1px; y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    content-width: self.width;
                    content-height: root.sources.length * root.row-h;

                    for src[i] in root.sources : Rectangle {
                        property <bool> is-take: i < root.take-rows.length && root.take-rows[i];
                        property <bool> is-file: src == "Choose file…";

                        x: 0;
                        y: i * root.row-h;
                        width: parent.width;
                        height: root.row-h;
                        background: i == root.selected-index ? Theme.accent-soft
                            : row-ta.has-hover ? Theme.hover
                            : transparent;

                        if i > 0 : Rectangle {
                            x: 0; y: 0;
                            width: parent.width; height: 1px;
                            background: Theme.hair-2;
                        }
                        if i == root.selected-index : Rectangle {
                            x: 0; y: 0;
                            width: 3px; height: parent.height;
                            background: Theme.accent;
                        }

                        Text {
                            x: 12px;
                            width: parent.width - 24px - (parent.is-take
                                ? (root.armed-delete == i ? root.armed-w + 8px : 34px) : 0px);
                            height: parent.height;
                            text: src;
                            color: parent.is-file ? Theme.ink-2 : Theme.ink;
                            font-size: Theme.min-font;
                            font-weight: i == root.selected-index ? 600 : 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if src == "Choose file…" {
                                    root.choose-file();
                                } else {
                                    root.source-picked(i, src);
                                }
                                root.expanded = false;
                                root.armed-delete = -1;
                            }
                        }
                        accessible-role: button;
                        accessible-label: src;

                        // A saved take's trash — first click arms, second deletes.
                        if i < root.take-rows.length && root.take-rows[i] : Rectangle {
                            x: parent.width - self.width - 8px;
                            y: (parent.height - self.height) / 2;
                            width: root.armed-delete == i ? root.armed-w : 26px;
                            height: 26px;
                            border-radius: 4px;
                            background: root.armed-delete == i ? Theme.bad
                                : del-ta.has-hover ? Theme.panel-lo : transparent;

                            if root.armed-delete != i : Image {
                                x: 5px; y: 5px;
                                width: 16px; height: 16px;
                                source: @image-url("../assets/trash.svg");
                                colorize: del-ta.has-hover ? Theme.ink : Theme.ink-3;
                            }
                            if root.armed-delete == i : del-confirm := Text {
                                width: parent.width;
                                height: parent.height;
                                text: @tr("di-take-delete-confirm");
                                color: Gear.white;
                                font-size: Theme.min-font;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            del-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.armed-delete == i {
                                        root.armed-delete = -1;
                                        root.delete-take(i, src);
                                    } else {
                                        root.armed-delete = i;
                                    }
                                }
                            }
                            accessible-role: button;
                            accessible-label: @tr("di-take-delete-label");
                        }
                    }
                }
            }

            // ── #771: the OUTPUT select (chain's bound output endpoints) ─────
            if root.has-outputs : VerticalLayout {
                spacing: 6px;

                FieldCaption { text: @tr("di-output-select-label"); }

                SelectBox {
                    value: root.selected-output;
                    open: root.out-expanded;
                    hovered: out-sel-ta.has-hover;

                    out-sel-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.out-expanded = !root.out-expanded;
                            root.expanded = false;
                        }
                    }
                    accessible-role: combobox;
                    accessible-label: @tr("di-output-select-label");
                    accessible-value: root.selected-output;
                }
            }

            // ── #771: the OUTPUT select's options (inline, only when expanded) ─
            if root.out-expanded : Rectangle {
                height: min(root.outputs.length * root.row-h + 2px, root.list-max);
                border-radius: 4px;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.hair;
                clip: true;

                Flickable {
                    x: 1px; y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    content-width: self.width;
                    content-height: root.outputs.length * root.row-h;

                    for out[i] in root.outputs : Rectangle {
                        x: 0;
                        y: i * root.row-h;
                        width: parent.width;
                        height: root.row-h;
                        background: i == root.output-selected-index ? Theme.accent-soft
                            : out-row-ta.has-hover ? Theme.hover
                            : transparent;

                        if i > 0 : Rectangle {
                            x: 0; y: 0;
                            width: parent.width; height: 1px;
                            background: Theme.hair-2;
                        }
                        if i == root.output-selected-index : Rectangle {
                            x: 0; y: 0;
                            width: 3px; height: parent.height;
                            background: Theme.accent;
                        }

                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text: out;
                            color: Theme.ink;
                            font-size: Theme.min-font;
                            font-weight: i == root.output-selected-index ? 600 : 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        out-row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.output-picked(i, out);
                                root.out-expanded = false;
                            }
                        }
                        accessible-role: button;
                        accessible-label: out;
                    }
                }
            }
        }
    }
}
