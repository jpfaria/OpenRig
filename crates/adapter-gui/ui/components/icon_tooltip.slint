// Responsibility: renders the hover label of a header icon.
// #323 — a small hover label for the chain-header icon buttons (looper, DI,
// Tone Doctor, volume). Same look as ChainActionIcon's tooltip; extracted so
// the icon-cluster buttons that are their own components can reuse it. Renders
// BELOW the icon (the project header paints over anything above — issue #329).
// Placed as a child of a ~28 px button; the box follows its (translated) label
// and self-centres on the button.
export component IconTooltip inherits Rectangle {
    in property <string> text;
    in property <bool> show;

    visible: root.show && root.text != "";
    // ~28 px button → centre with x = (28 - width) / 2.
    x: (28px - self.width) / 2;
    y: 30px;
    width: max(104px, label.preferred-width + 16px);
    height: label.preferred-height + 6px;
    background: #11141aef;
    border-width: 1px;
    border-color: #3b4250;
    border-radius: 4px;
    z: 60;

    label := Text {
        text: root.text;
        color: #dde4ef;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: root.width;
        height: root.height;
    }
}
