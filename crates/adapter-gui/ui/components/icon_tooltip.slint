// Responsibility: hands the hover label of an icon or a button to its window.
// #398 — the label itself is drawn by the window's `HoverTipLayer`, above
// everything and inside the window; this says what to show and where the
// hovered control is, and keeps saying it while the hover lasts.
import { HoverTip } from "hover_tip_globals.slint";

export component IconTooltip inherits Rectangle {
    in property <string> text;
    in property <bool> show;
    in property <bool> prefer-above;

    private property <bool> on: root.show && root.text != "";
    private property <int> mine: -1;

    function publish() {
        HoverTip.text = root.text;
        HoverTip.host-x = root.absolute-position.x;
        HoverTip.host-y = root.absolute-position.y;
        HoverTip.host-w = root.width;
        HoverTip.host-h = root.height;
        HoverTip.prefer-above = root.prefer-above;
        HoverTip.beat += 1;
    }

    function take() {
        HoverTip.owner += 1;
        root.mine = HoverTip.owner;
        root.publish();
        HoverTip.show = true;
    }

    init => {
        if root.on {
            root.take();
        }
    }

    changed on => {
        if root.on {
            root.take();
        } else if HoverTip.owner == root.mine {
            HoverTip.show = false;
        }
    }

    // While hovered, the label follows its control (a list that scrolls).
    Timer {
        interval: 100ms;
        running: root.on && HoverTip.owner == root.mine;
        triggered => { root.publish(); }
    }
}
