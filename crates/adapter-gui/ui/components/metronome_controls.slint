// Responsibility: renders the metronome's controls.
// Issue #14 — the metronome's building blocks, kept out of
// `pages/metronome_window.slint` so the page stays about layout.
//
// #398: drawn controls only, no sprites. Lamps sit on the LCD glass, every
// setting is a knob cell (caption, knob, value in a field), the tempo nudges
// are small field buttons and TAP is a white key.
import { Theme, Gear } from "../theme.slint";
import { KnobArc } from "knob_arc.slint";
import { ElidedText } from "elided_text.slint";

// One beat lamp on the LCD. The downbeat keeps a dim ring even when unlit, so
// the bar has a visible starting point at a glance.
export component BeatLamp inherits Rectangle {
    in property <bool> lit;
    in property <bool> downbeat;
    in property <bool> counting-in;

    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: root.downbeat && !root.lit ? 2px : 1px;
    border-color: root.downbeat && !root.lit ? Theme.lcd-dim : Theme.lcd-rim;
    background: !root.lit ? Theme.lcd-lamp : root.counting-in ? Theme.accent : Theme.lcd-glow;
    drop-shadow-blur: root.lit ? 12px : 0;
    drop-shadow-color: root.counting-in ? Theme.accent : Theme.lcd-glow;

    // The hot spot of a lit lamp, up and to the left.
    if root.lit && !root.counting-in : Rectangle {
        x: 6px; y: 5px;
        width: 10px; height: 10px;
        border-radius: 5px;
        background: Theme.lcd-lamp-hi;
        opacity: 0.8;
    }
}

// A knob cell: the caption above, the knob centred, the value in a field
// below. The knob is the child; a knob that draws its own value box leaves
// `value` empty.
export component ControlCell inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    out property <length> knob-y: 20px;
    out property <length> knob-size: 46px;

    width: 76px;
    height: 92px;

    caption-text := ElidedText {
        x: 0; y: 0;
        width: parent.width; height: 16px;
        text: root.caption;
        color: Theme.ink-2;
        font-size: Theme.knob-caption-font;
        font-weight: 600;
        letter-spacing: 0.1 * Theme.knob-caption-font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    @children

    if root.value != "" : Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.knob-y + root.knob-size + 3px;
        width: max(56px, value-text.preferred-width + 8px);
        height: 20px;
        border-radius: 2px;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.hair;

        value-text := Text {
            width: parent.width; height: parent.height;
            text: root.value;
            color: Theme.ink;
            font-size: Theme.knob-caption-font;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A two-position knob: seven o'clock off, five o'clock on; a click flips it.
// Used for count-in.
export component ToggleKnob inherits Rectangle {
    in property <bool> active;
    in property <string> label;
    callback toggled();

    KnobArc {
        width: root.width; height: root.width;
        angle: root.active ? 135 : -135;
        show-value: root.active;
    }

    // Named so the headless interaction test can find and press it.
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    accessible-role: switch;
    accessible-checked: root.active;
    accessible-label: root.label;
    accessible-action-default => { root.toggled(); }
}

// A small field button (the tempo nudges). With `key` set it is the white
// TAP key instead.
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> key: false;
    callback clicked();

    height: root.key ? 44px : 24px;
    min-width: max(root.key ? 72px : 30px, label-text.preferred-width + 20px);
    border-radius: root.key ? 5px : 4px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.key
        ? (ta.pressed
            ? @linear-gradient(180deg, Gear.key-mid 0%, Gear.key-lo 100%)
            : @linear-gradient(180deg, Gear.white 0%, Gear.key-mid 55%, Gear.key-lo 100%))
        : (ta.has-hover && root.enabled ? Theme.panel-hi : Theme.field);
    border-width: 1px;
    border-color: root.key ? Gear.edge-soft : Theme.hair;
    drop-shadow-blur: root.key && !ta.pressed ? 5px : 0;
    drop-shadow-offset-y: root.key ? 3px : 0;
    drop-shadow-color: Gear.switch-shadow;

    label-text := Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.key ? Gear.key-ink : Theme.ink;
        font-size: root.key ? 20px : Theme.min-font;
        font-weight: root.key ? 400 : 600;
        letter-spacing: root.key ? 2px : 0;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

// TAP — the white key. A PillButton underneath, so the tempo row keeps one
// button vocabulary for the interaction tests.
export component TapKey inherits PillButton {
    key: true;
    width: 72px;
}
