// Responsibility: renders the level meters trigger of a chain header.
// #1007 — beside the DI fone and the looper: a click asks to show or hide the
// chain's IN / OUT meter rows through `toggled`. The owner keeps the state and
// feeds it back into `shown`; the header only offers it on a running chain.

import { HeaderIconStyle } from "header_icon_style.slint";
import { IconTooltip } from "icon_tooltip.slint";

export component ChainMetersButton inherits Rectangle {
    in property <bool> shown: false;
    callback toggled(bool);

    width: HeaderIconStyle.size;
    height: HeaderIconStyle.size;
    border-radius: HeaderIconStyle.radius;
    background: HeaderIconStyle.fill(ta.has-hover);
    animate background { duration: 150ms; }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: HeaderIconStyle.icon;
        height: HeaderIconStyle.icon;
        source: @image-url("../assets/meters.svg");
        image-fit: contain;
        colorize: HeaderIconStyle.tint(root.shown, ta.has-hover);
        animate colorize { duration: 150ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.shown); }
    }

    IconTooltip { text: @tr("label-meters"); show: ta.has-hover; }

    accessible-role: button;
    accessible-label: @tr("label-meters");
    accessible-action-default => { root.toggled(!root.shown); }
}
