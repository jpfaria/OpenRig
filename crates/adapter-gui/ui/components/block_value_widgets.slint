// Responsibility: renders the compact value editors of a block.
// Compact value-editing widgets used by the block editor and chain row drawer.
// Split out of pages/project_chains.slint to keep each Slint file under the
// 500-line cap. Visual semantics unchanged — these are pure layout wrappers
// over standard widgets and a few custom touch targets.

import { Theme } from "../theme.slint";
import { ComboBox } from "std-widgets.slint";
import { BlockTypePickerItem } from "../models.slint";
import { EffectTypeIcon } from "./effect_type_icon.slint";
import { ElidedText } from "elided_text.slint";

export component ToolbarButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();

    // Grows with its translated label (#954); the old widths stay the minimum.
    width: Math.max(primary ? 140px : 116px, label-text.preferred-width + 24px);
    height: 40px;
    background: primary ? Theme.accent : Theme.panel-hi;
    border-width: 1px;
    border-color: primary ? Theme.accent : Theme.field-line;
    border-radius: 4px;

    label-text := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.primary ? Theme.on-accent : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 18px;
        font-weight: 600;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


export component ParamFieldBox inherits Rectangle {
    in-out property <string> text;
    callback changed(string);

    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.field-line;
    border-radius: 4px;

    TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: Theme.ink;
        single-line: true;
        vertical-alignment: center;
        font-size: 18px;
        edited => {
            root.text = self.text;
            root.changed(self.text);
        }
    }
}


export component BlockValueStepper inherits Rectangle {
    in property <string> label;
    in property <string> value-text;
    in property <string> unit-text;
    in property <float> numeric-value: 0;
    in property <float> numeric-min: 0;
    in property <float> numeric-max: 1;
    in property <float> numeric-step: 1;
    callback changed(float);
    callback text-changed(string);

    pure function previous-value() -> float {
        let next = root.numeric-value - root.numeric-step;
        return next < root.numeric-min ? root.numeric-min : next;
    }

    pure function next-value() -> float {
        let next = root.numeric-value + root.numeric-step;
        return next > root.numeric-max ? root.numeric-max : next;
    }

    width: 320px;
    height: 72px;
    background: transparent;

    ElidedText {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 22px;
        text: root.label;
        color: Theme.ink;
        font-size: 18px;
        font-weight: 800;
    }

    // Tall enough for the value line plus the unit line at 18px (#954).
    Rectangle {
        x: 0px;
        y: 24px;
        width: parent.width;
        height: 48px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.field-line;
        border-radius: 6px;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 42px;
            height: parent.height;
            background: dec-hover.has-hover ? Theme.hover : transparent;
            border-width: 0px;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: @tr("−");
                color: Theme.ink;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            dec-hover := TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.changed(root.previous-value()); }
            }
        }

        Rectangle {
            x: 42px;
            y: 0px;
            width: parent.width - 84px;
            height: parent.height;
            background: transparent;

            TextInput {
                x: 8px;
                y: root.unit-text != "" ? 2px : 0px;
                width: parent.width - 16px;
                height: root.unit-text != "" ? 22px : parent.height;
                text: root.value-text;
                color: Theme.ink;
                font-size: 18px;
                font-weight: 800;
                single-line: true;
                horizontal-alignment: center;
                vertical-alignment: center;
                edited => { root.text-changed(self.text); }
            }

            if root.unit-text != "" : ElidedText {
                x: 0px;
                y: 24px;
                width: parent.width;
                height: 22px;
                text: root.unit-text;
                color: Theme.ink-2;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width - 42px;
            y: 0px;
            width: 42px;
            height: parent.height;
            background: inc-hover.has-hover ? Theme.hover : transparent;
            border-width: 0px;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: @tr("+");
                color: Theme.ink;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            inc-hover := TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.changed(root.next-value()); }
            }
        }
    }
}


export component BlockValueSlider inherits Rectangle {
    in property <string> label;
    in property <string> value-text;
    in property <string> unit-text;
    in property <float> progress: 0;
    callback moved(float);
    callback text-changed(string);

    width: 320px;
    height: 78px;
    background: transparent;

    ElidedText {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 22px;
        text: root.label;
        color: Theme.ink;
        font-size: 18px;
        font-weight: 800;
    }

    Rectangle {
        x: 0px;
        y: 44px;
        width: parent.width - 112px;
        height: 8px;
        background: Theme.ktrack;
        border-radius: 4px;

        Rectangle {
            x: 0px;
            y: 0px;
            width: Math.max(10px, parent.width * root.progress);
            height: parent.height;
            background: Theme.accent;
            border-radius: 4px;
        }

        Rectangle {
            x: (parent.width * root.progress) - 8px;
            y: -4px;
            width: 16px;
            height: 16px;
            background: Theme.ink;
            border-width: 1px;
            border-color: Theme.field-line;
            border-radius: 8px;
        }

        TouchArea {
            x: 0px;
            y: -8px;
            width: parent.width;
            height: 24px;
            mouse-cursor: pointer;
            moved => {
                if self.pressed {
                    let next = self.mouse-x / parent.width;
                    root.moved(next < 0 ? 0 : next > 1 ? 1 : next);
                }
            }
        }
    }

    Rectangle {
        // Below the label, tall enough for value + unit at 18px (#954).
        x: parent.width - 92px;
        y: 24px;
        width: 92px;
        height: 48px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.field-line;
        border-radius: 6px;

        TextInput {
            x: 8px;
            y: root.unit-text != "" ? 2px : 0px;
            width: parent.width - 16px;
            height: root.unit-text != "" ? 22px : parent.height;
            text: root.value-text;
            color: Theme.ink;
            font-size: 18px;
            font-weight: 800;
            single-line: true;
            horizontal-alignment: center;
            vertical-alignment: center;
            edited => { root.text-changed(self.text); }
        }

        if root.unit-text != "" : ElidedText {
            x: 4px;
            y: 24px;
            width: parent.width - 8px;
            height: 22px;
            text: root.unit-text;
            color: Theme.ink-2;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}


export component BlockFootswitch inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback toggled(bool);

    // Grows with its translated label (#954); 160px stays the minimum.
    width: Math.max(160px, footswitch-label.preferred-width + 24px);
    height: 42px;
    background: transparent;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 42px;
        background: root.active ? Theme.ok-soft : Theme.panel;
        border-width: 1px;
        border-color: root.active ? Theme.ok : Theme.field-line;
        border-radius: 6px;

        footswitch-label := Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.label;
            color: root.active ? Theme.ink : Theme.ink-2;
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { root.toggled(!root.active); }
        }
    }
}


// Add-block picker tile sizes, shared by the card and the grids that place it.
export global BlockTypeGrid {
    out property <length> cell: 132px;
    out property <length> icon: 72px;
    out property <length> step: 144px;
}

export component BlockTypeCard inherits Rectangle {
    in property <BlockTypePickerItem> item;
    in property <bool> selected: false;
    property <color> accent-color: root.item.accent-color;
    callback clicked();

    width: BlockTypeGrid.cell;
    height: BlockTypeGrid.cell;
    background: touch.has-hover ? Theme.panel : Theme.panel-hi;
    border-width: Theme.line;
    border-color: touch.has-hover ? root.accent-color : Theme.hair;
    border-radius: 4px;

    // Category strip along the top edge (#398 mockup tile).
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: Theme.mark;
        background: root.accent-color;
    }

    // Label under the icon (#398): the icon is what the eye scans first.
    ElidedText {
        x: 6px;
        y: parent.height - 30px;
        width: parent.width - 12px;
        height: 22px;
        text: root.item.label;
        color: Theme.ink;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        own-hover: false;
        hovered: touch.has-hover;
    }

    if root.item.icon-kind == "vst3" : Image {
        x: (parent.width - BlockTypeGrid.icon) / 2;
        y: 14px;
        width: BlockTypeGrid.icon;
        height: BlockTypeGrid.icon;
        source: @image-url("../assets/vst3-logo.svg");
        image-fit: contain;
        colorize: root.accent-color;
    }

    if root.item.icon-kind != "vst3" : Image {
        x: (parent.width - BlockTypeGrid.icon) / 2;
        y: 14px;
        width: BlockTypeGrid.icon;
        height: BlockTypeGrid.icon;
        source: root.item.icon-kind == "input"        ? @image-url("../assets/input.svg")
            : root.item.icon-kind == "output"         ? @image-url("../assets/output.svg")
            : root.item.icon-kind == "insert"         ? @image-url("../assets/insert_loop.svg")
            : root.item.icon-kind == "preamp"         ? @image-url("../assets/amp-head.svg")
            : root.item.icon-kind == "amp"            ? @image-url("../assets/amp-combo.svg")
            : root.item.icon-kind == "cab"            ? @image-url("../assets/cab.svg")
            : root.item.icon-kind == "body"           ? @image-url("../assets/body.svg")
            : root.item.icon-kind == "ir"             ? @image-url("../assets/ir-loader.svg")
            : root.item.icon-kind == "full_rig"       ? @image-url("../assets/full-rig.svg")
            : root.item.icon-kind == "gain"           ? @image-url("../assets/gain.svg")
            : root.item.icon-kind == "dynamics"       ? @image-url("../assets/dyn.svg")
            : root.item.icon-kind == "filter"         ? @image-url("../assets/filter.svg")
            : root.item.icon-kind == "wah"            ? @image-url("../assets/expression.svg")
            : root.item.icon-kind == "modulation"     ? @image-url("../assets/mod.svg")
            : root.item.icon-kind == "delay"          ? @image-url("../assets/delay.svg")
            : root.item.icon-kind == "reverb"         ? @image-url("../assets/reverb.svg")
            : root.item.icon-kind == "utility"        ? @image-url("../assets/util.svg")
            : root.item.icon-kind == "nam"            ? @image-url("../assets/nam.svg")
            : root.item.icon-kind == "pitch"          ? @image-url("../assets/pitch.svg")
            : root.item.icon-kind == "split"          ? @image-url("../assets/graph-split.svg")
            : @image-url("../assets/gear.svg");
        image-fit: contain;
        colorize: root.accent-color;
    }

    touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

