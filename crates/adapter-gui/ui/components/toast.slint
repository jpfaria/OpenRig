// Responsibility: renders a transient message.
import { Theme } from "../theme.slint";
export component Toast inherits Rectangle {
    in property <string> message;
    in property <string> level: "info"; // "error", "warning", "info"
    in property <length> container-width;
    in property <length> container-height;

    // Visible when message is not empty
    visible: root.message != "";

    x: (root.container-width - self.width) / 2;
    // Bottom edge stays 20px above the container; grows upward as it wraps.
    y: root.container-height - 20px - self.height;
    width: Math.min(root.container-width - 40px, 500px);
    height: max(40px, msg.preferred-height + 16px);
    border-radius: 8px;
    background: root.level == "error" ? Theme.bad.with-alpha(0.80)
             : root.level == "warning" ? Theme.warn.with-alpha(0.80)
             : Theme.in.with-alpha(0.80);

    msg := Text {
        width: parent.width - 24px;
        height: parent.height;
        x: 12px;
        text: root.message;
        color: Theme.hero-fg;
        font-size: 18px;
        font-weight: 600;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}
