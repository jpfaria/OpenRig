// Responsibility: renders a transient message.
// #398: a dark chip on the chrome, its level marked by a coloured edge on the
// left (red error, amber warning, blue info), sized to its text.
import { Theme } from "../theme.slint";
export component Toast inherits Rectangle {
    in property <string> message;
    in property <string> level: "info"; // "error", "warning", "info"
    in property <length> container-width;
    in property <length> container-height;

    // Visible when message is not empty
    visible: root.message != "";

    x: (root.container-width - self.width) / 2;
    // Bottom edge stays 20px above the container; grows upward as it wraps.
    y: root.container-height - 20px - self.height;
    width: Math.min(root.container-width - 40px, 520px, msg.preferred-width + 32px);
    height: max(40px, msg.preferred-height + 20px);
    border-radius: 5px;
    clip: true;
    background: Theme.chrome;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;

    Rectangle {
        x: 0; y: 0;
        width: 3px; height: parent.height;
        background: root.level == "error" ? Theme.bad
            : root.level == "warning" ? Theme.warn
            : Theme.in;
    }

    msg := Text {
        x: 17px;
        width: parent.width - 31px;
        height: parent.height;
        text: root.message;
        color: Theme.chrome-fg;
        font-size: Theme.min-font;
        font-weight: 500;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}
