// Responsibility: renders a pill switch.
// #398: a slim pill — accent while on with its knob on the right, a grey
// track with the knob on the left while off. The owner keeps the state.

import { Theme, Gear } from "../theme.slint";

export component ToggleSwitch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    // The track while off; a settings row uses the field outline colour.
    in property <brush> off-track: Gear.off;
    callback toggled();

    width: 40px;
    height: 20px;
    border-radius: self.height / 2;
    background: root.on ? Theme.accent : root.off-track;
    animate background { duration: 150ms; }

    knob := Rectangle {
        x: root.on ? root.width - self.width - 2px : 2px;
        y: 2px;
        width: root.height - 4px;
        height: self.width;
        border-radius: self.width / 2;
        background: Gear.switch-hi;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 2px;
        drop-shadow-color: Gear.switch-shadow;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    accessible-role: switch;
    accessible-checked: root.on;
    accessible-label: root.label;
    accessible-action-default => { root.toggled(); }
}
