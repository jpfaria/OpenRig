// Responsibility: asks the user to confirm a deletion.
import { Theme } from "../theme.slint";
// Modal dialog asking the user to confirm deletion of a block.
// Used as an overlay inside AppWindow when `show-confirm-delete-block` is true.

export component ConfirmDeleteBlockDialog inherits Rectangle {
    in property <string> block-name;
    callback cancel();
    callback confirm();

    background: Theme.scrim;
    TouchArea { }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width * 0.7, 400px);
        // Grows with its (translated, wrapped) content (#954).
        height: dialog-content.preferred-height;
        background: Theme.panel;
        border-radius: 10px;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.shadow;

        dialog-content := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: @tr("title-dialog-delete-block");
                font-size: 18px;
                color: Theme.ink;
                font-weight: 700;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                // Slint @tr supports `{}` placeholders. The msgid is the
                // pt-BR source string with the placeholder.
                text: @tr("Excluir \"{}\"?", root.block-name);
                font-size: 18px;
                color: Theme.ink-2;
                horizontal-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: 6px;
                    background: cancel-area.has-hover ? Theme.hover : Theme.panel-hi;
                    cancel-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel(); }
                    }
                    Text {
                        text: @tr("btn-cancel");
                        font-size: 18px;
                        color: Theme.ink-2;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: 6px;
                    background: confirm-area.has-hover ? Theme.bad.darker(0.15) : Theme.bad;
                    confirm-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.confirm(); }
                    }
                    Text {
                        text: @tr("btn-delete");
                        font-size: 18px;
                        color: Theme.hero-fg;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
