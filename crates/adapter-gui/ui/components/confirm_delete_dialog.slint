// Responsibility: asks the user to confirm a deletion.
// Modal dialog asking the user to confirm deletion of a block.
// Used as an overlay inside AppWindow when `show-confirm-delete-block` is true.
//
// #398: the shared dialog card — the title in the display face, the question,
// then Cancel and the red confirm on the footer.
import { DialogCard, ConfirmBody } from "dialog_card.slint";
import { DialogFoot } from "dialog_foot.slint";
import { FormButton, FormButtonKind } from "form_button.slint";

export component ConfirmDeleteBlockDialog inherits Rectangle {
    in property <string> block-name;
    callback cancel();
    callback confirm();

    DialogCard {
        width: parent.width;
        height: parent.height;

        ConfirmBody {
            title: @tr("title-dialog-delete-block");
            // Slint @tr supports `{}` placeholders. The msgid is the
            // pt-BR source string with the placeholder.
            message: @tr("Excluir \"{}\"?", root.block-name);
        }

        DialogFoot {
            cancel-area := FormButton {
                icon-only: true;
                icon: @image-url("../assets/close.svg");
                label: @tr("btn-cancel");
                clicked => { root.cancel(); }
            }
            confirm-area := FormButton {
                icon-only: true;
                icon: @image-url("../assets/trash.svg");
                kind: FormButtonKind.danger;
                label: @tr("btn-delete");
                clicked => { root.confirm(); }
            }
        }
    }
}
