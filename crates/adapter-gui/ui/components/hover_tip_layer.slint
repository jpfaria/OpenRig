// Responsibility: draws a window's hover label above everything.
// #398 — declared last in every window (next to `WindowBoundsProbe`), so the
// label paints over every bar, dialog and panel and is never clipped by one.
// Under the control, above it when there is no room (or when the control
// prefers above), never past the window's edges.
import { Theme } from "../theme.slint";
import { HoverTip } from "hover_tip_globals.slint";
import { OverlayPlacement } from "overlay_placement.slint";

export component HoverTipLayer inherits Rectangle {
    // A PopupWindow paints over the whole window, window layer included, so
    // every popup that holds hover labels declares its own layer, last, with
    // `for-popup: true`; each layer draws only the labels of its own side, and
    // a popup's label stays inside the popup.
    in property <bool> for-popup;

    private property <length> gap: 2px;
    // Window-absolute host, made local to this layer (a popup layer is not
    // at the window's origin).
    private property <length> host-x: HoverTip.host-x - root.absolute-position.x;
    private property <length> host-y: HoverTip.host-y - root.absolute-position.y;
    private property <length> above: root.host-y - root.gap;
    private property <length> below: root.host-y + HoverTip.host-h + root.gap;
    private property <int> seen-beat: -1;

    // Drops a label whose control went away while hovered.
    Timer {
        interval: 300ms;
        running: HoverTip.show;
        triggered => {
            if HoverTip.beat == root.seen-beat {
                HoverTip.show = false;
            }
            root.seen-beat = HoverTip.beat;
        }
    }

    tip := Rectangle {
        visible: HoverTip.show && HoverTip.text != "" && HoverTip.in-popup == root.for-popup;
        // A long text (a full preset or plug-in name) wraps instead of
        // leaving the layer.
        width: min(root.width - 2 * OverlayPlacement.margin, max(104px, label.preferred-width + 16px));
        height: label.preferred-height + 6px;
        x: OverlayPlacement.left(root.host-x + (HoverTip.host-w - self.width) / 2, self.width, root.width);
        y: HoverTip.prefer-above
            ? OverlayPlacement.top-above(root.above, root.below, self.height, root.height)
            : OverlayPlacement.top(root.above, root.below, self.height, root.height);
        background: Theme.panel-lo.with-alpha(0.94);
        border-width: 1px;
        border-color: Theme.field-line;
        border-radius: 4px;

        label := Text {
            text: HoverTip.text;
            color: Theme.ink;
            font-size: Theme.min-font;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
        }
    }
}
