// Responsibility: asks the user to confirm removing a recent project.
// Modal dialog asking the user to confirm removal of a recent-project
// entry from the launcher list (issue #360). Mirrors the block/chain
// dialog shape; copy is per-component so each translation file stays
// self-explanatory for translators.
// Used as an overlay inside AppWindow when `show-confirm-delete-recent-project` is true.
//
// #398: the shared dialog card — the title in the display face, the question,
// then Cancel and the red confirm on the footer.
import { DialogCard, ConfirmBody } from "dialog_card.slint";
import { DialogFoot } from "dialog_foot.slint";
import { FormButton, FormButtonKind } from "form_button.slint";

export component ConfirmDeleteRecentProjectDialog inherits Rectangle {
    in property <string> project-name;
    callback cancel();
    callback confirm();

    DialogCard {
        width: parent.width;
        height: parent.height;

        ConfirmBody {
            title: @tr("title-dialog-delete-recent-project");
            // Literal pt-BR source string with `{}` placeholder.
            message: @tr("Remover o projeto \"{}\" dos recentes?", root.project-name);
        }

        DialogFoot {
            cancel-area := FormButton {
                label: @tr("btn-cancel");
                clicked => { root.cancel(); }
            }
            confirm-area := FormButton {
                kind: FormButtonKind.danger;
                label: @tr("btn-remove");
                clicked => { root.confirm(); }
            }
        }
    }
}
