// Responsibility: places the offered update button beside the running version label.
import { Theme, Gear } from "../theme.slint";
import { AppUpdate } from "app_update_globals.slint";
import { UpdateButton } from "update_button.slint";

export component AppVersionBadge inherits HorizontalLayout {
    in property <string> version;

    spacing: 10px;
    alignment: end;

    // The running version, a small dark chip over the photo.
    Rectangle {
        width: ver.preferred-width + 16px;
        border-radius: 3px;
        background: Gear.black.with-alpha(0.35);

        ver := Text {
            x: 8px;
            width: self.preferred-width;
            height: parent.height;
            text: "v" + root.version;
            color: Theme.chrome-fg-2;
            font-size: 18px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    if AppUpdate.latest-version != "" : UpdateButton {
        latest-version: AppUpdate.latest-version;
        clicked => { AppUpdate.install-update(); }
    }
}
