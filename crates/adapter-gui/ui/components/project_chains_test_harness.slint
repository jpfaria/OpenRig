// Responsibility: hosts the chain list page for a test.
// #1007 TEST-ONLY harness: hosts ProjectChainsPage in a real Window so the
// headless interaction tests (i-slint-backend-testing) can click a chain
// card and read back the row model it writes. Imported by app-window.slint
// purely so slint-build emits the Rust type; never shown in the running app.

import { ProjectChainItem } from "../models.slint";
import { ProjectChainsPage } from "../pages/project_chains.slint";

export component ProjectChainsHarness inherits Window {
    in property <[ProjectChainItem]> chains;
    width: 1100px;
    height: 700px;

    ProjectChainsPage {
        width: 100%;
        height: 100%;
        project-chains: root.chains;
    }
}
