// Responsibility: renders the preset picker overlay.
// In-app preset picker overlay. Shared by TouchMain and DesktopMain so
// the bundled presets are reachable in both modes (issue #479: on
// desktop the old native FileDialog left users with no visible preset
// list). Pure UI — the parent owns the data + load logic.
//
// #398: the dialog card — the dark bar, the search field, the numbered list
// (a click loads, the trash deletes), Cancel on the footer.

import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { DialogCard } from "dialog_card.slint";
import { DialogFoot } from "dialog_foot.slint";
import { ToolBar } from "tool_bar.slint";
import { TextField } from "text_field.slint";
import { FormButton } from "form_button.slint";
import { ListBox, ListRow } from "list_box.slint";

export component PresetPickerOverlay {
    in property <bool> visible-overlay;
    in property <[string]> items;
    in-out property <string> search-query;
    callback confirm(int);
    callback cancel();
    callback delete(int);
    callback query-changed(string);

    if root.visible-overlay: DialogCard {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        card-width: 560px;
        card-height: 620px;

        ToolBar {
            vertical-stretch: 0;
            title: @tr("btn-load-preset");
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding: 18px;
            spacing: 10px;

            TextField {
                vertical-stretch: 0;
                placeholder: @tr("preset-search-placeholder");
                text <=> root.search-query;
                edited(t) => { root.query-changed(t); }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;

                    ListBox {
                        for item[i] in root.items : Rectangle {
                            min-height: 44px;
                            background: item-area.has-hover ? Theme.accent-soft : transparent;

                            item-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.confirm(i); }
                            }

                            ListRow {
                                width: parent.width;
                                height: parent.height;
                                divided: i > 0;

                                Text {
                                    width: 26px;
                                    text: (i < 9 ? "0" : "") + (i + 1);
                                    color: Theme.ink-3;
                                    font-size: Theme.min-font;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: item;
                                    color: Theme.ink;
                                    font-size: Theme.min-font;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle {
                                    width: 32px;
                                    del-box := Rectangle {
                                        x: 0; y: (parent.height - 32px) / 2;
                                        width: 32px; height: 32px;
                                        border-radius: 4px;
                                        background: del-area.has-hover ? Theme.bad-soft : transparent;
                                        Image {
                                            x: (parent.width - 18px) / 2;
                                            y: (parent.height - 18px) / 2;
                                            width: 18px;
                                            height: 18px;
                                            source: @image-url("../assets/trash.svg");
                                            colorize: del-area.has-hover ? Theme.bad : Theme.ink-3;
                                        }
                                        del-area := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.delete(i); }
                                        }
                                        accessible-role: button;
                                        accessible-label: @tr("btn-delete");
                                        accessible-action-default => { root.delete(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        DialogFoot {
            vertical-stretch: 0;
            cancel-area := FormButton {
                icon-only: true;
                icon: @image-url("../assets/close.svg");
                label: @tr("btn-cancel");
                clicked => { root.cancel(); }
            }
        }
    }
}
