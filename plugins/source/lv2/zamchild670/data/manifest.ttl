@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<urn:zamaudio:ZamChild670>
    a lv2:Plugin ;
    lv2:binary <ZamChild670_dsp.dylib> ;
    rdfs:seeAlso <ZamChild670_dsp.ttl> .

<urn:zamaudio:ZamChild670#DPF_UI>
    a ui:CocoaUI ;
    ui:binary <ZamChild670_ui.dylib> ;
    rdfs:seeAlso <ZamChild670_ui.ttl> .

<urn:zamaudio:ZamChild670#preset001>
    a pset:Preset ;
    lv2:appliesTo <urn:zamaudio:ZamChild670> ;
    rdfs:label "Default" ;
    rdfs:seeAlso <presets.ttl> .

